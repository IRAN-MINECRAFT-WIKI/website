---
/**
 * InventorySlot.astro — Minecraft inventory slot with REAL texture
 *
 * Renders a 32x32 styled square with the actual Minecraft PNG texture inside.
 * Falls back to SVG pixel sprite if PNG doesn't exist.
 *
 * Usage:
 *   <InventorySlot icon="diamond" />           <!-- looks in /textures/items/diamond.png -->
 *   <InventorySlot icon="stone" type="block" />  <!-- looks in /textures/blocks/stone.png -->
 *   <InventorySlot icon="stick" count={64} />
 *   <InventorySlot icon="diamond-sword" tooltip="شمشیر الماس" />
 *   <InventorySlot />                          <!-- empty slot -->
 */
import '@components/pixel-sprites.astro';

interface Props {
  icon?: string;        // texture name (without .png)
  count?: number;       // stack count (hidden if 1 or undefined)
  tooltip?: string;     // hover tooltip
  size?: 'sm' | 'md' | 'lg';
  large?: boolean;
  type?: 'item' | 'block';
}

const { icon, count, tooltip, size = 'md', large = false, type = 'item' } = Astro.props;
const actualSize = large ? 'lg' : size;
const pxSize = actualSize === 'sm' ? 24 : actualSize === 'lg' ? 48 : 32;
const folder = type === 'block' ? 'blocks' : 'items';
const BASE = import.meta.env.BASE_URL;
const textureUrl = icon ? `${BASE}textures/${folder}/${icon}.png` : null;
const svgFallback = icon ? `px-${icon}` : null;
---

<div
  class={`invslot invslot-${actualSize}`}
  title={tooltip}
  data-minetip-text={tooltip}
>
  {icon && textureUrl && (
    <span class="invslot-item">
      <img
        src={textureUrl}
        alt={tooltip || icon}
        width={Math.floor(pxSize * 0.65)}
        height={Math.floor(pxSize * 0.65)}
        loading="lazy"
        decoding="async"
        class="pixel-img"
        onerror={`this.style.display='none'; this.nextElementSibling.style.display='inline-block';`}
      />
      {svgFallback && (
        <svg
          width={Math.floor(pxSize * 0.65)}
          height={Math.floor(pxSize * 0.65)}
          viewBox="0 0 16 16"
          shape-rendering="crispEdges"
          style="display: none; image-rendering: pixelated;"
        >
          <use href={`#${svgFallback}`} />
        </svg>
      )}
    </span>
  )}
  {count && count > 1 && (
    <span class="invslot-count">{count}</span>
  )}
</div>

<style>
  .invslot {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #8b8b8b 0%, #6e6e6e 50%, #565656 100%);
    border-top: 2px solid #373737;
    border-left: 2px solid #373737;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    box-shadow:
      inset 2px 2px 0 rgba(0, 0, 0, 0.4),
      inset -2px -2px 0 rgba(255, 255, 255, 0.25);
    color: #ffffff;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.6);
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    vertical-align: middle;
  }
  .invslot-sm { width: 24px; height: 24px; }
  .invslot-md { width: 32px; height: 32px; }
  .invslot-lg { width: 48px; height: 48px; }

  .invslot-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 0 1px rgba(0, 0, 0, 0.4));
  }

  .pixel-img {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    -ms-interpolation-mode: nearest-neighbor;
  }

  .invslot-count {
    position: absolute;
    bottom: -2px;
    right: 0;
    font-family: 'Courier New', monospace;
    font-weight: 700;
    font-size: 0.625rem;
    color: #ffffff;
    text-shadow:
      2px 2px 0 rgba(0, 0, 0, 0.8),
      -1px -1px 0 rgba(0, 0, 0, 0.4);
    padding: 0 2px;
    pointer-events: none;
    line-height: 1;
  }

  .invslot:hover {
    background: linear-gradient(135deg, #a0a0a0 0%, #828282 50%, #6a6a6a 100%);
  }
</style>
