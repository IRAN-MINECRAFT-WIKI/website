---
/**
 * QuickAccess.astro — EXPANDED Control Center
 *
 * Bigger trigger button. When clicked, tiles expand OUTWARD from
 * underneath the button — one by one, with a smooth spring animation.
 *
 * Like Xiaomi Control Center but more dramatic:
 * - Tiles start at scale(0) at the button position
 * - Each tile pops out with delay (staggered)
 * - Full-screen dark backdrop
 * - Large, colorful tiles with real Minecraft textures
 */
import '@components/pixel-sprites.astro';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const links = [
  { href: base('/'), label: 'خانه', icon: 'grass-block', type: 'block', color: '#5fa838' },
  { href: base('/mods'), label: 'افزونه‌ها', icon: 'chest', type: 'block', color: '#9c7b4e' },
  { href: base('/crafting'), label: 'کرافت', icon: 'crafting-table-top', type: 'block', color: '#9c7b4e' },
  { href: base('/3d'), label: 'دنیای سه‌بعدی', icon: 'grass-block', type: 'block', color: '#4aedd9' },
  { href: base('/wiki'), label: 'ویکی', icon: 'book', type: 'item', color: '#7cc84a' },
  { href: base('/speedrun'), label: 'سرعت‌رانی', icon: 'clock', type: 'item', color: '#fcb32b' },
  { href: base('/versions'), label: 'نسخه‌ها', icon: 'grass-block', type: 'block', color: '#5fa838' },
  { href: base('/seeds'), label: 'سیدها', icon: 'grass-block', type: 'block', color: '#5fa838' },
  { href: base('/categories'), label: 'دسته‌ها', icon: 'cobblestone', type: 'block', color: '#7e7e7e' },
  { href: base('/blog'), label: 'وبلاگ', icon: 'book', type: 'item', color: '#fcb32b' },
  { href: base('/guide'), label: 'آموزش', icon: 'stick', type: 'item', color: '#9c7b4e' },
  { href: base('/about'), label: 'درباره', icon: 'apple', type: 'item', color: '#ff3b3b' },
];
---

<!-- Bigger trigger button -->
<button id="qaBtn" class="qa-btn" aria-label="دسترسی سریع" title="دسترسی سریع به بخش‌ها">
  <div class="qa-btn-grid">
    <span></span><span></span>
    <span></span><span></span>
  </div>
</button>

<!-- Full-screen overlay -->
<div class="qa-overlay" id="qaOverlay" hidden>
  <div class="qa-bg" id="qaBg"></div>

  <div class="qa-content">
    <header class="qa-header">
      <div class="qa-header-title">
        <span class="qa-header-icon">🎮</span>
        <h2>کنترول سنتر ماین‌بد</h2>
      </div>
      <p class="qa-header-sub">دسترسی سریع به همه‌ی بخش‌های سایت</p>
    </header>

    <div class="qa-cards">
      {links.map((link, i) => (
        <a
          href={link.href}
          class="qa-card"
          style={`--i:${i}; --c:${link.color};`}
          data-route
        >
          <div class="qa-card-icon">
            <img
              src={`${BASE}textures/${link.type === 'block' ? 'blocks' : 'items'}/${link.icon}.png`}
              alt=""
              width="56"
              height="56"
              loading="lazy"
              class="pixel-img"
              onerror="this.style.display='none'"
            />
          </div>
          <span class="qa-card-label">{link.label}</span>
          <span class="qa-card-sub">{link.label === 'خانه' ? 'صفحه اصلی' : link.label === 'افزونه‌ها' ? 'ماد‌ها' : link.label === 'کرافت' ? 'Crafting' : link.label === 'دنیای سه‌بعدی' ? '3D World' : link.label === 'ویکی' ? 'Wiki' : link.label === 'نسخه‌ها' ? 'Versions' : link.label === 'سیدها' ? 'Seeds' : link.label === 'دسته‌ها' ? 'Categories' : link.label === 'وبلاگ' ? 'Blog' : link.label === 'آموزش' ? 'Tutorials' : 'About'}</span>
        </a>
      ))}
    </div>

    <footer class="qa-footer">
      <span>می‌تونی با کلیک روی هر کارت وارد بشی · ESC برای بستن</span>
    </footer>
  </div>

  <button class="qa-close" id="qaCloseBtn" aria-label="بستن">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
</div>

<style is:global>
  /* ─── Bigger trigger button ─── */
  .qa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, rgba(123,197,92,0.12), rgba(123,197,92,0.03));
    border: 2px solid rgba(123,197,92,0.3);
    color: var(--grass-2, #7cc84a);
    cursor: pointer;
    border-radius: 10px;
    padding: 0;
    transition: all 0.2s cubic-bezier(0.16,1,0.3,1);
    position: relative;
  }

  .qa-btn:hover {
    background: linear-gradient(135deg, rgba(123,197,92,0.2), rgba(123,197,92,0.08));
    border-color: var(--grass-2, #7cc84a);
    transform: scale(1.08);
    box-shadow: 0 4px 16px rgba(123,197,92,0.3);
  }

  .qa-btn:active {
    transform: scale(0.92);
    transition: transform 0.08s;
  }

  .qa-btn-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3px;
  }

  .qa-btn-grid span {
    width: 8px;
    height: 8px;
    background: currentColor;
    border-radius: 2px;
    transition: all 0.2s;
  }

  .qa-btn:hover .qa-btn-grid span {
    border-radius: 50%;
  }

  /* ─── Overlay ─── Control Center takes MOST of the viewport */
  .qa-overlay {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: flex;
    /* safe center → falls back to flex-start if cards overflow,
       so the top row is never clipped by the viewport edge. */
    align-items: safe center;
    justify-content: center;
    /* Phase 1 fix: use dvh (dynamic viewport height) instead of vh.
       On mobile, 100vh includes the browser address bar, causing
       the overlay to be taller than the visible area → buttons
       clipped. 100dvh adapts when the address bar shows/hides.
       Fallback: 100vh for browsers without dvh support. */
    height: 100vh;
    height: 100dvh;
    padding: 4rem 1.5rem 2rem;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .qa-overlay[hidden] { display: none !important; }

  /* ─── Backdrop ─── */
  .qa-bg {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.3s ease-out;
    pointer-events: none;
  }

  .qa-overlay:not([hidden]) .qa-bg { opacity: 1; }

  .qa-overlay.closing .qa-bg { opacity: 0; transition: opacity 0.2s ease-in; }

  /* ─── Cards container ─── BIGGER (user asked for more display space) */
  .qa-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 960px;
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* ─── Header ─── */
  .qa-header {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .qa-header-title {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.5rem;
  }

  .qa-header-icon {
    font-size: 1.75rem;
  }

  .qa-header-title h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #f0f0fa;
    margin: 0;
    line-height: 1.3;
  }

  .qa-header-sub {
    font-size: 0.875rem;
    color: #b8b8d0;
    margin: 0;
  }

  /* ─── Cards container ─── BIGGER (user asked for more display space) */
  .qa-cards {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.25rem;
    width: 100%;
  }

  /* ─── Footer ─── */
  .qa-footer {
    text-align: center;
    font-size: 0.75rem;
    color: #8585a3;
    margin-top: 0.5rem;
  }

  /* ─── Each card (pops out from center) — BIGGER for more display space */
  .qa-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem 0.75rem 1.25rem;
    background: rgba(28,28,52,0.92);
    border: 2px solid var(--c, #4a8a2c);
    border-radius: 16px;
    text-decoration: none;
    color: #e0e0f0;
    opacity: 0;
    /* Use opacity + visibility instead of scale(0) — scale(0) collapses
       the layout box and on some browsers the layout shifts upward,
       causing the top row to be clipped. */
    visibility: hidden;
    transform: translateY(20px);
    transition:
      opacity 0.35s cubic-bezier(0.16,1,0.3,1),
      transform 0.35s cubic-bezier(0.16,1,0.3,1),
      visibility 0s linear 0.35s,
      background 0.2s,
      box-shadow 0.2s;
    /* Stagger: each card delayed */
    transition-delay: calc(var(--i, 0) * 0.05s + 0.05s);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* When overlay is visible, cards pop out */
  .qa-overlay:not([hidden]) .qa-card {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition:
      opacity 0.35s cubic-bezier(0.16,1,0.3,1),
      transform 0.35s cubic-bezier(0.16,1,0.3,1),
      visibility 0s linear 0s,
      background 0.2s,
      box-shadow 0.2s;
    transition-delay: calc(var(--i, 0) * 0.05s + 0.05s);
  }

  /* Closing: cards shrink back */
  .qa-overlay.closing .qa-card {
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition-delay: 0s;
    transition-duration: 0.15s;
  }

  .qa-card:hover {
    background: var(--c, #4a8a2c);
    transform: translateY(-4px) !important;
    box-shadow: 0 12px 32px rgba(0,0,0,0.4), 0 0 24px var(--c, #4a8a2c);
    border-color: var(--c, #4a8a2c);
  }

  .qa-card:active {
    transform: scale(0.96) !important;
    transition: transform 0.08s;
  }

  /* ─── Card icon — BIGGER (was 64px → 80px) */
  .qa-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #8b8b8b 0%, #6e6e6e 50%, #565656 100%);
    border-top: 2px solid #373737;
    border-left: 2px solid #373737;
    border-right: 2px solid #fff;
    border-bottom: 2px solid #fff;
    box-shadow: inset 2px 2px 0 rgba(0,0,0,0.4), inset -2px -2px 0 rgba(255,255,255,0.25);
    border-radius: 12px;
    image-rendering: pixelated;
  }

  .qa-card:hover .qa-card-icon {
    box-shadow: inset 2px 2px 0 rgba(0,0,0,0.3), inset -2px -2px 0 rgba(255,255,255,0.35), 0 0 16px var(--c, #4a8a2c);
  }

  /* ─── Card label — BIGGER (was 0.8125rem → 0.9375rem) */
  .qa-card-label {
    font-size: 0.9375rem;
    font-weight: 800;
    text-align: center;
    line-height: 1.4;
  }

  /* ─── Card sub-label (English subtitle for clarity) ─── */
  .qa-card-sub {
    font-size: 0.6875rem;
    font-weight: 600;
    text-align: center;
    color: var(--c, #4a8a2c);
    opacity: 0.7;
    font-family: 'Press Start 2P', monospace;
    letter-spacing: 0.5px;
  }

  /* ─── Close button ─── */
  .qa-close {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 2;
    width: 44px;
    height: 44px;
    background: rgba(255,59,59,0.15);
    border: 2px solid #8a1a1a;
    color: #ff8b8b;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 0.2s;
    opacity: 0;
    transition: opacity 0.3s ease-out 0.3s, transform 0.2s, background 0.2s;
  }

  .qa-overlay:not([hidden]) .qa-close { opacity: 1; }

  .qa-close:hover {
    background: rgba(255,59,59,0.3);
    transform: rotate(90deg);
  }

  /* ─── Responsive ─── */
  /* P1-4 fix: mobile — smaller cards so all 10 fit within viewport.
     Phase 1: also use dvh for max-height so mobile address bar
     doesn't cause clipping. */
  @media (max-width: 640px) {
    .qa-overlay {
      padding: 3rem 0.75rem 1rem;
      align-items: flex-start;
      overflow-y: auto;
      height: 100vh;
      height: 100dvh;
    }
    .qa-content {
      gap: 1rem;
    }
    .qa-header-title h2 {
      font-size: 1.125rem;
    }
    .qa-header-sub {
      font-size: 0.75rem;
    }
    .qa-cards {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
    }
    .qa-card {
      padding: 0.75rem 0.25rem 0.5rem;
      gap: 0.375rem;
    }
    .qa-card-icon {
      width: 40px;
      height: 40px;
    }
    .qa-card-icon img {
      width: 28px !important;
      height: 28px !important;
    }
    .qa-card-label {
      font-size: 0.625rem;
      line-height: 1.3;
    }
    .qa-card-sub {
      font-size: 0.5rem;
      letter-spacing: 0;
    }
    .qa-footer {
      font-size: 0.625rem;
    }
  }

  @media (max-width: 400px) {
    .qa-cards {
      grid-template-columns: repeat(3, 1fr);
    }
    .qa-card-icon {
      width: 36px;
      height: 36px;
    }
  }

  /* Short viewports (landscape phones, short desktop windows) */
  @media (max-height: 600px) {
    .qa-overlay {
      padding: 3rem 1rem 0.5rem;
      align-items: flex-start;
      height: 100vh;
      height: 100dvh;
    }
    .qa-cards {
      max-height: 85vh;
      max-height: 85dvh;
    }
    .qa-card {
      padding: 0.5rem 0.25rem;
    }
    .qa-card-icon {
      width: 36px;
      height: 36px;
    }
  }

  /* iOS safe area — respect notch / home indicator */
  @supports (padding: env(safe-area-inset-top)) {
    .qa-overlay {
      padding-top: max(4rem, env(safe-area-inset-top));
      padding-bottom: max(2rem, env(safe-area-inset-bottom));
      padding-left: max(1.5rem, env(safe-area-inset-left));
      padding-right: max(1.5rem, env(safe-area-inset-right));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qa-card, .qa-bg, .qa-close {
      transition: none !important;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }
</style>

<script is:inline>
  // ============================================================
  // QuickAccess / Control Center — Phase 1 (portal fix) + Phase 2 (cinematic animation)
  // ============================================================
  (function () {
    var PORTED = false;

    function setupQA() {
      var btn = document.getElementById('qaBtn');
      var overlay = document.getElementById('qaOverlay');
      var closeBtn = document.getElementById('qaCloseBtn');
      var bg = document.getElementById('qaBg');
      if (!btn || !overlay) return;

      // ─── Phase 1: PORTAL FIX ─────────────────────────────
      // The overlay is inside <header> which has backdrop-filter:blur.
      // backdrop-filter creates a NEW containing block for position:fixed
      // descendants → the overlay was constrained to the header's ~84px
      // height instead of the viewport. Move it to document.body so
      // position:fixed works correctly.
      if (!PORTED && overlay.parentNode !== document.body) {
        document.body.appendChild(overlay);
        PORTED = true;
      }

      // ─── Phase 2: CINEMATIC ANIMATION ────────────────────
      // Uses Web Animations API for precise timeline control.
      // Sequence: button glow → title slides in → cards emerge from
      // button position one-by-one → sparkles. Close = reverse.

      var ANIM_ENABLED = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function openCinematic() {
        overlay.hidden = false;
        overlay.classList.remove('closing');

        if (!ANIM_ENABLED) return; // skip animation for reduced-motion

        // ─── Phase 1 fix: PRECISE TIMELINE ──────────────────
        // 0ms:     click
        // 0-150ms: button glow (scale 1→1.15→1.08)
        // 150ms:   blur backdrop STARTS fade-in (not 0ms)
        // 150-500ms: title slides down from top
        // 500ms:   blur backdrop FULLY visible (opacity 1)
        // 500+i×120ms: card i starts emerging from button position
        // 1500ms:  all cards settled

        // Step 1: Button glow (0-150ms) — scale 1.0 → 1.15 → 1.08
        btn.animate([
          { transform: 'scale(1)', boxShadow: '0 0 0 rgba(124,200,74,0)' },
          { transform: 'scale(1.15)', boxShadow: '0 0 20px rgba(124,200,74,0.4)', offset: 0.5 },
          { transform: 'scale(1.08)', boxShadow: '0 0 12px rgba(124,200,74,0.2)' }
        ], { duration: 150, easing: 'ease-out', fill: 'forwards' });

        // Step 2: Backdrop blur STARTS at 150ms (coordinated with button settle)
        // Uses cubic-bezier(0.4, 0, 0.2, 1) — smooth material design easing
        // Duration: 350ms (150→500ms) → fully visible at 500ms
        if (bg) {
          bg.animate([
            { opacity: 0, backdropFilter: 'blur(0px)' },
            { opacity: 1, backdropFilter: 'blur(8px)' }
          ], { duration: 350, delay: 150, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' });
        }

        // Step 3: Title slides from top (150-500ms) — spring easing
        var header = overlay.querySelector('.qa-header');
        if (header) {
          header.animate([
            { transform: 'translateY(-100%)', opacity: 0 },
            { transform: 'translateY(0)', opacity: 1 }
          ], { duration: 350, delay: 150, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)', fill: 'forwards' });
        }

        // Step 4: Cards emerge from button position (500ms + i×120ms each)
        var cards = overlay.querySelectorAll('.qa-card');
        var btnRect = btn.getBoundingClientRect();
        var btnCenterX = btnRect.left + btnRect.width / 2;
        var btnCenterY = btnRect.top + btnRect.height / 2;

        cards.forEach(function (card, i) {
          var cardRect = card.getBoundingClientRect();
          var cardCenterX = cardRect.left + cardRect.width / 2;
          var cardCenterY = cardRect.top + cardRect.height / 2;
          var dx = btnCenterX - cardCenterX;
          var dy = btnCenterY - cardCenterY;

          var delay = 500 + (i * 120);

          var anim = card.animate([
            { transform: 'translate(' + dx + 'px,' + dy + 'px) scale(0.3) rotate(-15deg)', opacity: 0 },
            { transform: 'translate(' + (dx * 0.1) + 'px,' + (dy * 0.1) + 'px) scale(1.1) rotate(5deg)', opacity: 1, offset: 0.7 },
            { transform: 'translate(0,0) scale(1) rotate(0deg)', opacity: 1 }
          ], { duration: 600, delay: delay, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)', fill: 'forwards' });

          // Sparkle effect when card arrives
          anim.onfinish = function () {
            createSparkle(card);
          };
        });

        // Footer fade-in (after all cards)
        var footer = overlay.querySelector('.qa-footer');
        if (footer) {
          footer.animate([
            { opacity: 0 },
            { opacity: 1 }
          ], { duration: 300, delay: 1500, easing: 'ease-out', fill: 'forwards' });
        }
      }

      function createSparkle(card) {
        if (!ANIM_ENABLED) return;
        var rect = card.getBoundingClientRect();
        var sparkle = document.createElement('div');
        sparkle.style.cssText =
          'position:fixed;' +
          'left:' + (rect.left + rect.width / 2 - 4) + 'px;' +
          'top:' + (rect.top + rect.height / 2 - 4) + 'px;' +
          'width:8px;height:8px;' +
          'background:radial-gradient(circle, rgba(124,200,74,0.9), transparent);' +
          'border-radius:50%;' +
          'pointer-events:none;' +
          'z-index:2147483648;' +
          'box-shadow:0 0 12px rgba(124,200,74,0.6);';
        document.body.appendChild(sparkle);
        sparkle.animate([
          { transform: 'scale(0)', opacity: 1 },
          { transform: 'scale(2.5)', opacity: 0 }
        ], { duration: 400, easing: 'ease-out', fill: 'forwards' });
        setTimeout(function () { sparkle.remove(); }, 450);
      }

      function closeCinematic() {
        if (!ANIM_ENABLED) {
          overlay.hidden = true;
          return;
        }

        overlay.classList.add('closing');

        // ─── Phase 1 fix: CLOSE = reverse of open ──────────
        // 1. Cards sucked back to button position in REVERSE order (0-300ms)
        // 2. Title slides up (200-500ms)
        // 3. Blur fades out LAST (300-600ms) — after all content is gone

        var cards = Array.from(overlay.querySelectorAll('.qa-card'));
        var btnRect = btn.getBoundingClientRect();
        var btnCenterX = btnRect.left + btnRect.width / 2;
        var btnCenterY = btnRect.top + btnRect.height / 2;

        // Reverse order: last card first
        cards.reverse().forEach(function (card, i) {
          var cardRect = card.getBoundingClientRect();
          var cardCenterX = cardRect.left + cardRect.width / 2;
          var cardCenterY = cardRect.top + cardRect.height / 2;
          var dx = btnCenterX - cardCenterX;
          var dy = btnCenterY - cardCenterY;

          card.animate([
            { transform: 'translate(0,0) scale(1) rotate(0deg)', opacity: 1 },
            { transform: 'translate(' + dx + 'px,' + dy + 'px) scale(0.3) rotate(15deg)', opacity: 0 }
          ], { duration: 300, delay: i * 40, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' });
        });

        // Title slides up (starts at 200ms)
        var header = overlay.querySelector('.qa-header');
        if (header) {
          header.animate([
            { transform: 'translateY(0)', opacity: 1 },
            { transform: 'translateY(-100%)', opacity: 0 }
          ], { duration: 300, delay: 200, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' });
        }

        // BLUR fades out LAST (starts at 300ms, ends at 600ms)
        // This ensures the backdrop stays visible until all content is gone
        if (bg) {
          bg.animate([
            { opacity: 1, backdropFilter: 'blur(8px)' },
            { opacity: 0, backdropFilter: 'blur(0px)' }
          ], { duration: 300, delay: 300, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' });
        }

        // Footer fade-out (immediately)
        var footer = overlay.querySelector('.qa-footer');
        if (footer) {
          footer.animate([
            { opacity: 1 },
            { opacity: 0 }
          ], { duration: 150, easing: 'ease-in', fill: 'forwards' });
        }

        // Final: hide overlay after all animations complete (600ms)
        setTimeout(function () {
          overlay.hidden = true;
          overlay.classList.remove('closing');
        }, 600);
      }

      // ─── Wire up ────────────────────────────────────────
      btn.onclick = function () { openCinematic(); };
      if (closeBtn) closeBtn.onclick = function () { closeCinematic(); };
      if (bg) bg.onclick = function () { closeCinematic(); };

      if (!window.__qaKb) {
        window.__qaKb = true;
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            var o = document.getElementById('qaOverlay');
            if (o && !o.hidden) {
              closeCinematic();
            }
          }
        });
      }

      // Close on navigation
      document.addEventListener('astro:before-swap', function () {
        var o = document.getElementById('qaOverlay');
        if (o && !o.hidden) {
          o.hidden = true;
          o.classList.remove('closing');
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupQA);
    } else {
      setupQA();
    }
    document.addEventListener('astro:page-load', setupQA);
  })();
</script>
