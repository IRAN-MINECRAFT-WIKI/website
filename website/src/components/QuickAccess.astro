---
/**
 * QuickAccess.astro — EXPANDED Control Center
 *
 * Bigger trigger button. When clicked, tiles expand OUTWARD from
 * underneath the button — one by one, with a smooth spring animation.
 *
 * Like Xiaomi Control Center but more dramatic:
 * - Tiles start at scale(0) at the button position
 * - Each tile pops out with delay (staggered)
 * - Full-screen dark backdrop
 * - Large, colorful tiles with real Minecraft textures
 */
import '@components/pixel-sprites.astro';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const links = [
  { href: base('/'), label: 'خانه', icon: 'grass-block', type: 'block', color: '#5fa838' },
  { href: base('/mods'), label: 'افزونه‌ها', icon: 'chest', type: 'block', color: '#9c7b4e' },
  { href: base('/crafting'), label: 'کرافت', icon: 'crafting-table-top', type: 'block', color: '#9c7b4e' },
  { href: base('/wiki'), label: 'ویکی', icon: 'book', type: 'item', color: '#7cc84a' },
  { href: base('/versions'), label: 'نسخه‌ها', icon: 'grass-block', type: 'block', color: '#5fa838' },
  { href: base('/seeds'), label: 'سیدها', icon: 'grass-block', type: 'block', color: '#5fa838' },
  { href: base('/categories'), label: 'دسته‌ها', icon: 'cobblestone', type: 'block', color: '#7e7e7e' },
  { href: base('/blog'), label: 'وبلاگ', icon: 'book', type: 'item', color: '#fcb32b' },
  { href: base('/guide'), label: 'آموزش', icon: 'stick', type: 'item', color: '#9c7b4e' },
  { href: base('/about'), label: 'درباره', icon: 'apple', type: 'item', color: '#ff3b3b' },
];
---

<!-- Bigger trigger button -->
<button id="qaBtn" class="qa-btn" aria-label="دسترسی سریع" title="دسترسی سریع به بخش‌ها">
  <div class="qa-btn-grid">
    <span></span><span></span>
    <span></span><span></span>
  </div>
</button>

<!-- Full-screen overlay -->
<div class="qa-overlay" id="qaOverlay" hidden>
  <div class="qa-bg" id="qaBg"></div>

  <div class="qa-content">
    <header class="qa-header">
      <div class="qa-header-title">
        <span class="qa-header-icon">🎮</span>
        <h2>کنترول سنتر ماین‌بد</h2>
      </div>
      <p class="qa-header-sub">دسترسی سریع به همه‌ی بخش‌های سایت</p>
    </header>

    <div class="qa-cards">
      {links.map((link, i) => (
        <a
          href={link.href}
          class="qa-card"
          style={`--i:${i}; --c:${link.color};`}
          data-route
        >
          <div class="qa-card-icon">
            <img
              src={`${BASE}textures/${link.type === 'block' ? 'blocks' : 'items'}/${link.icon}.png`}
              alt=""
              width="56"
              height="56"
              loading="lazy"
              class="pixel-img"
              onerror="this.style.display='none'"
            />
          </div>
          <span class="qa-card-label">{link.label}</span>
          <span class="qa-card-sub">{link.label === 'خانه' ? 'صفحه اصلی' : link.label === 'افزونه‌ها' ? 'ماد‌ها' : link.label === 'کرافت' ? 'Crafting' : link.label === 'ویکی' ? 'Wiki' : link.label === 'نسخه‌ها' ? 'Versions' : link.label === 'سیدها' ? 'Seeds' : link.label === 'دسته‌ها' ? 'Categories' : link.label === 'وبلاگ' ? 'Blog' : link.label === 'آموزش' ? 'Tutorials' : 'About'}</span>
        </a>
      ))}
    </div>

    <footer class="qa-footer">
      <span>می‌تونی با کلیک روی هر کارت وارد بشی · ESC برای بستن</span>
    </footer>
  </div>

  <button class="qa-close" id="qaCloseBtn" aria-label="بستن">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
</div>

<style is:global>
  /* ─── Bigger trigger button ─── */
  .qa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, rgba(123,197,92,0.12), rgba(123,197,92,0.03));
    border: 2px solid rgba(123,197,92,0.3);
    color: var(--grass-2, #7cc84a);
    cursor: pointer;
    border-radius: 10px;
    padding: 0;
    transition: all 0.2s cubic-bezier(0.16,1,0.3,1);
    position: relative;
  }

  .qa-btn:hover {
    background: linear-gradient(135deg, rgba(123,197,92,0.2), rgba(123,197,92,0.08));
    border-color: var(--grass-2, #7cc84a);
    transform: scale(1.08);
    box-shadow: 0 4px 16px rgba(123,197,92,0.3);
  }

  .qa-btn:active {
    transform: scale(0.92);
    transition: transform 0.08s;
  }

  .qa-btn-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3px;
  }

  .qa-btn-grid span {
    width: 8px;
    height: 8px;
    background: currentColor;
    border-radius: 2px;
    transition: all 0.2s;
  }

  .qa-btn:hover .qa-btn-grid span {
    border-radius: 50%;
  }

  /* ─── Overlay ─── Control Center takes MOST of the viewport */
  .qa-overlay {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: flex;
    /* safe center → falls back to flex-start if cards overflow,
       so the top row is never clipped by the viewport edge. */
    align-items: safe center;
    justify-content: center;
    padding: 4rem 1.5rem 2rem;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .qa-overlay[hidden] { display: none !important; }

  /* ─── Backdrop ─── */
  .qa-bg {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.3s ease-out;
    pointer-events: none;
  }

  .qa-overlay:not([hidden]) .qa-bg { opacity: 1; }

  .qa-overlay.closing .qa-bg { opacity: 0; transition: opacity 0.2s ease-in; }

  /* ─── Cards container ─── BIGGER (user asked for more display space) */
  .qa-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 960px;
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* ─── Header ─── */
  .qa-header {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .qa-header-title {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.5rem;
  }

  .qa-header-icon {
    font-size: 1.75rem;
  }

  .qa-header-title h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #f0f0fa;
    margin: 0;
    line-height: 1.3;
  }

  .qa-header-sub {
    font-size: 0.875rem;
    color: #b8b8d0;
    margin: 0;
  }

  /* ─── Cards container ─── BIGGER (user asked for more display space) */
  .qa-cards {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.25rem;
    width: 100%;
  }

  /* ─── Footer ─── */
  .qa-footer {
    text-align: center;
    font-size: 0.75rem;
    color: #8585a3;
    margin-top: 0.5rem;
  }

  /* ─── Each card (pops out from center) — BIGGER for more display space */
  .qa-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem 0.75rem 1.25rem;
    background: rgba(28,28,52,0.92);
    border: 2px solid var(--c, #4a8a2c);
    border-radius: 16px;
    text-decoration: none;
    color: #e0e0f0;
    opacity: 0;
    /* Use opacity + visibility instead of scale(0) — scale(0) collapses
       the layout box and on some browsers the layout shifts upward,
       causing the top row to be clipped. */
    visibility: hidden;
    transform: translateY(20px);
    transition:
      opacity 0.35s cubic-bezier(0.16,1,0.3,1),
      transform 0.35s cubic-bezier(0.16,1,0.3,1),
      visibility 0s linear 0.35s,
      background 0.2s,
      box-shadow 0.2s;
    /* Stagger: each card delayed */
    transition-delay: calc(var(--i, 0) * 0.05s + 0.05s);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* When overlay is visible, cards pop out */
  .qa-overlay:not([hidden]) .qa-card {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition:
      opacity 0.35s cubic-bezier(0.16,1,0.3,1),
      transform 0.35s cubic-bezier(0.16,1,0.3,1),
      visibility 0s linear 0s,
      background 0.2s,
      box-shadow 0.2s;
    transition-delay: calc(var(--i, 0) * 0.05s + 0.05s);
  }

  /* Closing: cards shrink back */
  .qa-overlay.closing .qa-card {
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition-delay: 0s;
    transition-duration: 0.15s;
  }

  .qa-card:hover {
    background: var(--c, #4a8a2c);
    transform: translateY(-4px) !important;
    box-shadow: 0 12px 32px rgba(0,0,0,0.4), 0 0 24px var(--c, #4a8a2c);
    border-color: var(--c, #4a8a2c);
  }

  .qa-card:active {
    transform: scale(0.96) !important;
    transition: transform 0.08s;
  }

  /* ─── Card icon — BIGGER (was 64px → 80px) */
  .qa-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #8b8b8b 0%, #6e6e6e 50%, #565656 100%);
    border-top: 2px solid #373737;
    border-left: 2px solid #373737;
    border-right: 2px solid #fff;
    border-bottom: 2px solid #fff;
    box-shadow: inset 2px 2px 0 rgba(0,0,0,0.4), inset -2px -2px 0 rgba(255,255,255,0.25);
    border-radius: 12px;
    image-rendering: pixelated;
  }

  .qa-card:hover .qa-card-icon {
    box-shadow: inset 2px 2px 0 rgba(0,0,0,0.3), inset -2px -2px 0 rgba(255,255,255,0.35), 0 0 16px var(--c, #4a8a2c);
  }

  /* ─── Card label — BIGGER (was 0.8125rem → 0.9375rem) */
  .qa-card-label {
    font-size: 0.9375rem;
    font-weight: 800;
    text-align: center;
    line-height: 1.4;
  }

  /* ─── Card sub-label (English subtitle for clarity) ─── */
  .qa-card-sub {
    font-size: 0.6875rem;
    font-weight: 600;
    text-align: center;
    color: var(--c, #4a8a2c);
    opacity: 0.7;
    font-family: 'Press Start 2P', monospace;
    letter-spacing: 0.5px;
  }

  /* ─── Close button ─── */
  .qa-close {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 2;
    width: 44px;
    height: 44px;
    background: rgba(255,59,59,0.15);
    border: 2px solid #8a1a1a;
    color: #ff8b8b;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 0.2s;
    opacity: 0;
    transition: opacity 0.3s ease-out 0.3s, transform 0.2s, background 0.2s;
  }

  .qa-overlay:not([hidden]) .qa-close { opacity: 1; }

  .qa-close:hover {
    background: rgba(255,59,59,0.3);
    transform: rotate(90deg);
  }

  /* ─── Responsive ─── */
  @media (max-width: 640px) {
    .qa-overlay {
      padding: 4.5rem 1rem 1.5rem;
    }
    .qa-cards {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.625rem;
      max-height: 75vh;
    }
    .qa-card {
      padding: 0.875rem 0.375rem;
    }
    .qa-card-icon {
      width: 48px;
      height: 48px;
    }
    .qa-card-label {
      font-size: 0.6875rem;
    }
  }

  @media (max-width: 400px) {
    .qa-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Short viewports (landscape phones, short desktop windows) */
  @media (max-height: 600px) {
    .qa-overlay {
      padding: 4rem 1.5rem 1rem;
      align-items: flex-start;
    }
    .qa-cards {
      max-height: 85vh;
    }
    .qa-card {
      padding: 0.625rem 0.375rem;
    }
    .qa-card-icon {
      width: 40px;
      height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qa-card, .qa-bg, .qa-close {
      transition: none !important;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }
</style>

<script is:inline>
  (function () {
    function setupQA() {
      var btn = document.getElementById('qaBtn');
      var overlay = document.getElementById('qaOverlay');
      var closeBtn = document.getElementById('qaCloseBtn');
      var bg = document.getElementById('qaBg');
      if (!btn || !overlay) return;

      btn.onclick = function () {
        overlay.hidden = false;
        overlay.classList.remove('closing');
      };

      function close() {
        overlay.classList.add('closing');
        setTimeout(function () {
          overlay.hidden = true;
          overlay.classList.remove('closing');
        }, 250);
      }

      if (closeBtn) closeBtn.onclick = close;
      if (bg) bg.onclick = close;

      if (!window.__qaKb) {
        window.__qaKb = true;
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            var o = document.getElementById('qaOverlay');
            if (o && !o.hidden) {
              o.classList.add('closing');
              setTimeout(function () {
                o.hidden = true;
                o.classList.remove('closing');
              }, 250);
            }
          }
        });
      }

      // Close on navigation
      document.addEventListener('astro:before-swap', function () {
        var o = document.getElementById('qaOverlay');
        if (o && !o.hidden) {
          o.hidden = true;
          o.classList.remove('closing');
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupQA);
    } else {
      setupQA();
    }
    document.addEventListener('astro:page-load', setupQA);
  })();
</script>
