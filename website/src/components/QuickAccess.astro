---
/**
 * QuickAccess.astro — Xiaomi-style Control Center with pop-out buttons
 *
 * When the trigger button is clicked:
 * 1. Full-screen overlay fades in
 * 2. A large panel slides down from the top
 * 3. Navigation buttons "pop out" one by one (staggered animation)
 *    — each button scales from 0 to 1 with a delay
 * 4. Clicking a link navigates
 * 5. Closing: buttons shrink back (reverse stagger), panel slides up
 *
 * Animation pattern: cubic-bezier(0.16, 1, 0.3, 1) — smooth overshoot
 */
import '@components/pixel-sprites.astro';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const quickLinks = [
  { href: base('/'), label: 'خانه', icon: 'grass-block', type: 'block', color: '#5fa838' },
  { href: base('/mods'), label: 'افزونه‌ها', icon: 'chest', type: 'block', color: '#9c7b4e' },
  { href: base('/crafting'), label: 'کرافت', icon: 'crafting-table-top', type: 'block', color: '#9c7b4e' },
  { href: base('/versions'), label: 'نسخه‌ها', icon: 'grass-block', type: 'block', color: '#5fa838' },
  { href: base('/seeds'), label: 'سیدها', icon: 'grass-block', type: 'block', color: '#5fa838' },
  { href: base('/categories'), label: 'دسته‌ها', icon: 'cobblestone', type: 'block', color: '#7e7e7e' },
  { href: base('/wiki'), label: 'ویکی', icon: 'book', type: 'item', color: '#9c7b4e' },
  { href: base('/blog'), label: 'وبلاگ', icon: 'book', type: 'item', color: '#9c7b4e' },
  { href: base('/guide'), label: 'آموزش', icon: 'stick', type: 'item', color: '#9c7b4e' },
  { href: base('/about'), label: 'درباره', icon: 'apple', type: 'item', color: '#ff3b3b' },
];
---

<!-- Trigger button (grid icon) -->
<button id="quickAccessBtn" class="qa-trigger" aria-label="دسترسی سریع" title="دسترسی سریع">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3" width="7" height="7"/>
    <rect x="14" y="3" width="7" height="7"/>
    <rect x="14" y="14" width="7" height="7"/>
    <rect x="3" y="14" width="7" height="7"/>
  </svg>
</button>

<!-- Full-screen overlay (Xiaomi Control Center style) -->
<div class="qa-overlay" id="quickAccessOverlay" hidden>
  <div class="qa-backdrop" id="qaBackdrop" data-close></div>
  
  <div class="qa-panel">
    <div class="qa-panel-header">
      <h3 class="qa-panel-title">دسترسی سریع</h3>
      <button class="qa-panel-close" id="qaClose" data-close aria-label="بستن">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </div>
    
    <!-- Grid of large buttons that pop out one by one -->
    <nav class="qa-grid">
      {quickLinks.map((link, i) => (
        <a
          href={link.href}
          class="qa-tile"
          data-route
          style={`--pop-delay: ${i * 0.05 + 0.15}s; --tile-color: ${link.color};`}
        >
          <div class="qa-tile-icon">
            <img
              src={`${BASE}textures/${link.type === 'block' ? 'blocks' : 'items'}/${link.icon}.png`}
              alt=""
              width="40"
              height="40"
              loading="lazy"
              decoding="async"
              class="pixel-img"
              onerror="this.style.display='none'"
            />
          </div>
          <span class="qa-tile-label">{link.label}</span>
        </a>
      ))}
    </nav>
    
    <div class="qa-panel-footer">
      <span class="qa-footer-logo">MINEBED</span>
      <span class="qa-footer-text">مرجع فارسی ماینکرفت بدراک</span>
    </div>
  </div>
</div>

<style is:global>
  /* ─── Trigger button ─── */
  .qa-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line, #2e2e4a);
    color: var(--text-2, #9a9ab8);
    cursor: pointer;
    border-radius: 6px;
    transition: all 0.15s;
    padding: 0;
  }
  
  .qa-trigger:hover {
    background: rgba(123, 197, 92, 0.1);
    border-color: var(--grass-2, #7cc84a);
    color: var(--grass-2, #7cc84a);
  }
  
  .qa-trigger:active {
    transform: scale(0.88);
  }
  
  /* ─── Full-screen overlay ─── */
  .qa-overlay {
    position: fixed !important;
    inset: 0 !important;
    z-index: 2147483647 !important;  /* max z-index — always on top */
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: flex-start !important;
    padding: 1rem !important;
  }
  
  .qa-overlay[hidden] { display: none; }
  
  /* ─── Backdrop (fade in) ─── */
  .qa-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    animation: qaBackdropIn 0.3s ease-out forwards;
  }
  
  @keyframes qaBackdropIn {
    to { opacity: 1; }
  }
  
  .qa-overlay.closing .qa-backdrop {
    animation: qaBackdropOut 0.2s ease-in forwards;
  }
  
  @keyframes qaBackdropOut {
    to { opacity: 0; }
  }
  
  /* ─── Panel (slide down from top) ─── */
  .qa-panel {
    position: relative;
    width: 100%;
    max-width: 600px;
    min-height: auto;
    margin-top: 5vh;
    background: linear-gradient(180deg, #1c1c34 0%, #14142a 100%);
    border: 3px solid #2d5018;
    border-right-color: #4a8a2c;
    border-bottom-color: #4a8a2c;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(123, 197, 92, 0.1);
    overflow: visible;
    /* Slide down from top + scale up */
    opacity: 0;
    transform: translateY(-50px) scale(0.95);
    animation: qaPanelIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    z-index: 2;
  }
  
  @keyframes qaPanelIn {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  
  .qa-overlay.closing .qa-panel {
    animation: qaPanelOut 0.2s ease-in forwards;
  }
  
  @keyframes qaPanelOut {
    to {
      opacity: 0;
      transform: translateY(-30px) scale(0.95);
    }
  }
  
  /* ─── Panel header ─── */
  .qa-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    background: linear-gradient(135deg, rgba(123, 197, 92, 0.15) 0%, rgba(123, 197, 92, 0.05) 100%);
    border-bottom: 2px solid var(--line, #2e2e4a);
  }
  
  .qa-panel-title {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.75rem;
    color: var(--grass-2, #7cc84a);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);
    letter-spacing: 2px;
  }
  
  .qa-panel-close {
    background: rgba(255, 59, 59, 0.1);
    border: 2px solid #8a1a1a;
    color: #ff8b8b;
    width: 36px;
    height: 36px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: all 0.15s;
    padding: 0;
  }
  
  .qa-panel-close:hover {
    background: rgba(255, 59, 59, 0.25);
    transform: rotate(90deg);
  }
  
  /* ─── Grid of large tiles ─── */
  .qa-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.75rem;
    padding: 1.5rem;
  }
  
  /* ─── Each tile (pops out one by one!) ─── */
  .qa-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 0.5rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 2px solid var(--tile-color, #4a8a2c);
    border-radius: 10px;
    text-decoration: none;
    color: var(--text, #e0e0f0);
    transition: background 0.15s, border-color 0.15s, transform 0.15s;
    /* POP OUT animation: starts at scale(0) + rotated, pops to scale(1) */
    opacity: 0;
    transform: scale(0) rotate(-15deg);
    animation: qaPopOut 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--pop-delay, 0.15s);
  }
  
  @keyframes qaPopOut {
    0% {
      opacity: 0;
      transform: scale(0) rotate(-15deg);
    }
    60% {
      opacity: 1;
      transform: scale(1.1) rotate(5deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }
  
  /* Closing: tiles shrink back (reverse stagger) */
  .qa-overlay.closing .qa-tile {
    animation: qaPopIn 0.15s ease-in forwards;
    animation-delay: 0s;
  }
  
  @keyframes qaPopIn {
    to {
      opacity: 0;
      transform: scale(0) rotate(15deg);
    }
  }
  
  .qa-tile:hover {
    background: linear-gradient(135deg, var(--tile-color, #4a8a2c) 0%, rgba(123, 197, 92, 0.1) 100%);
    transform: scale(1.05) translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3), 0 0 16px var(--tile-color, #4a8a2c);
  }
  
  .qa-tile:active {
    transform: scale(0.95);
  }
  
  /* ─── Tile icon (inventory-style slot) ─── */
  .qa-tile-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, #8b8b8b 0%, #6e6e6e 50%, #565656 100%);
    border-top: 2px solid #373737;
    border-left: 2px solid #373737;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    box-shadow:
      inset 2px 2px 0 rgba(0, 0, 0, 0.4),
      inset -2px -2px 0 rgba(255, 255, 255, 0.25);
    border-radius: 8px;
    image-rendering: pixelated;
    transition: box-shadow 0.15s;
  }
  
  .qa-tile:hover .qa-tile-icon {
    box-shadow:
      inset 2px 2px 0 rgba(0, 0, 0, 0.3),
      inset -2px -2px 0 rgba(255, 255, 255, 0.35),
      0 0 12px var(--tile-color, #4a8a2c);
  }
  
  .qa-tile-icon img {
    image-rendering: pixelated;
  }
  
  /* ─── Tile label ─── */
  .qa-tile-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-align: center;
    line-height: 1.3;
  }
  
  /* ─── Footer ─── */
  .qa-panel-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.75rem 1.5rem;
    border-top: 2px solid var(--line, #2e2e4a);
    background: rgba(0, 0, 0, 0.2);
  }
  
  .qa-footer-logo {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.625rem;
    color: var(--grass-2, #7cc84a);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.5);
    letter-spacing: 2px;
  }
  
  .qa-footer-text {
    font-size: 0.6875rem;
    color: var(--text-3, #5c5c7a);
  }
  
  /* ─── Responsive ─── */
  @media (max-width: 640px) {
    .qa-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
      padding: 1rem;
    }
    .qa-panel {
      margin-top: 3vh;
      max-width: 95vw;
    }
    .qa-tile {
      padding: 0.75rem 0.5rem;
    }
    .qa-tile-icon {
      width: 48px;
      height: 48px;
    }
    .qa-tile-label {
      font-size: 0.6875rem;
    }
  }
  
  @media (max-width: 400px) {
    .qa-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (prefers-reduced-motion: reduce) {
    .qa-panel, .qa-backdrop, .qa-tile {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script is:inline>
  (function () {
    function setupQuickAccess() {
      var btn = document.getElementById('quickAccessBtn');
      var overlay = document.getElementById('quickAccessOverlay');
      if (!btn || !overlay) return;
      
      btn.onclick = function () {
        overlay.hidden = false;
        overlay.classList.remove('closing');
      };
      
      overlay.querySelectorAll('[data-close]').forEach(function (el) {
        el.onclick = function () {
          overlay.classList.add('closing');
          setTimeout(function () {
            overlay.hidden = true;
            overlay.classList.remove('closing');
          }, 300);
        };
      });
      
      if (!window.__qaKeyboardBound) {
        window.__qaKeyboardBound = true;
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            var o = document.getElementById('quickAccessOverlay');
            if (o && !o.hidden) {
              o.classList.add('closing');
              setTimeout(function () {
                o.hidden = true;
                o.classList.remove('closing');
              }, 300);
            }
          }
        });
      }
    }
    
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupQuickAccess);
    } else {
      setupQuickAccess();
    }
    document.addEventListener('astro:page-load', setupQuickAccess);
  })();
</script>
