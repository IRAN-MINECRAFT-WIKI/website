---
/**
 * CraftingHelper.astro — FULL-SCREEN Minecraft crafting experience
 *
 * Layout (like the real Minecraft inventory):
 * - Landscape: Steve + Crafting Table in a scene
 * - Portrait mobile: show "rotate device" overlay
 *
 * Interaction flow:
 * 1. User clicks/taps the Crafting Table → Inventory modal opens
 * 2. Inventory modal layout (like Minecraft's "E" inventory):
 *    Left:   Steve character preview + 4 armor slots + offhand slot
 *    Middle: 3x3 crafting grid + arrow + result slot
 *    Right:  3x9 = 27 inventory slots
 *    Bottom: 9 hotbar slots (outside the modal)
 * 3. Click on Steve → search input is focused → type item name
 * 4. Type + Enter → crafting grid fills with correct items + result
 *
 * Sounds: 8-bit Web Audio API (no external files)
 *
 * Performance:
 * - Pure vanilla JS (no libraries)
 * - CSS animations only
 * - Mobile-friendly
 */
import '@components/pixel-sprites.astro';
import recipesJson from '@/data/crafting-recipes.json';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';

const PUBLIC_DIR = join(process.cwd(), 'public');
const itemsDir = join(PUBLIC_DIR, 'textures', 'items');
const blocksDir = join(PUBLIC_DIR, 'textures', 'blocks');

let itemTextures: string[] = [];
let blockTextures: string[] = [];
try {
  itemTextures = readdirSync(itemsDir).filter(f => f.endsWith('.png')).map(f => f.replace('.png', ''));
} catch (e) { /* ignore */ }
try {
  blockTextures = readdirSync(blocksDir).filter(f => f.endsWith('.png')).map(f => f.replace('.png', ''));
} catch (e) { /* ignore */ }

const allTextures = [
  ...itemTextures.map(name => ({ name, type: 'item' as const })),
  ...blockTextures.map(name => ({ name, type: 'block' as const })),
];

const recipes = recipesJson.recipes;
const recipesData = JSON.stringify(recipes.map(r => ({
  id: r.id, nameFa: r.nameFa, nameEn: r.nameEn,
  aliases: r.aliases, grid: r.grid, output: r.output,
  wikiSlug: r.wikiSlug, shapeless: r.shapeless, description: r.description,
})));

const BASE = import.meta.env.BASE_URL;
---

<div class="crafting-scene" id="craftingScene" data-recipes={recipesData}>
  <!-- ═══════════════════════════════════════════════════════════
       ROTATE DEVICE OVERLAY (portrait mobile only)
       ═══════════════════════════════════════════════════════════ -->
  <div class="rotate-overlay" id="rotateOverlay">
    <div class="rotate-phone" aria-hidden="true">
      <div class="rotate-phone-screen"></div>
    </div>
    <h2 class="rotate-title">صفحه رو بچرخون!</h2>
    <p class="rotate-text">این تجربه بهترین حالت رو در حالت افقی (Landscape) داره</p>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       MAIN SCENE (visible only in landscape / desktop)
       ═══════════════════════════════════════════════════════════ -->
  <div class="scene-content" id="sceneContent">
    <!-- Sky gradient -->
    <div class="sky-gradient" aria-hidden="true"></div>
    
    <!-- Clouds -->
    <div class="clouds" aria-hidden="true">
      <div class="cloud cloud-1"></div>
      <div class="cloud cloud-2"></div>
      <div class="cloud cloud-3"></div>
    </div>
    
    <!-- Ground -->
    <div class="ground" aria-hidden="true"></div>
    
    <!-- Side inventory panel (only on desktop, large screens) -->
    <aside class="inventory-panel" id="inventoryPanel">
      <div class="inventory-header">
        <span class="inventory-title inline-flex items-center gap-2"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-palette"/></svg> بلاک‌ها</span>
      </div>
      <div class="inventory-grid" id="inventoryGrid">
        {allTextures.map((tex) => (
          <button
            class="inv-slot"
            data-name={tex.name}
            data-type={tex.type}
            title={tex.name}
            aria-label={tex.name}
          >
            <img
              src={`${BASE}textures/${tex.type === 'block' ? 'blocks' : 'items'}/${tex.name}.png`}
              alt={tex.name}
              width="32"
              height="32"
              loading="lazy"
              decoding="async"
              class="pixel-img"
            />
          </button>
        ))}
      </div>
    </aside>
    
    <!-- Main stage: Steve + Crafting Table -->
    <div class="scene-stage">
      <!-- Crafting Table (3D perspective, click to open inventory) -->
      <button
        class="crafting-table-3d"
        id="craftingTableBtn"
        aria-label="میز کار — برای باز کردن اینونتوری کلیک کنید"
      >
        <div class="ct-top">
          <img src={`${BASE}textures/blocks/crafting-table-top.png`} alt="" width="120" height="120" class="pixel-img" />
        </div>
        <div class="ct-front">
          <img src={`${BASE}textures/blocks/crafting-table-side.png`} alt="" width="120" height="80" class="pixel-img" />
        </div>
        <div class="ct-shadow"></div>
        <div class="ct-glow" id="tableGlow"></div>
        <div class="ct-hint"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;vertical-align:middle;"><use href="#icon-zap"/></svg> کلیک کن!</div>
      </button>
      
      <!-- Steve character -->
      <div class="steve" id="steve">
        <!-- Thought bubble -->
        <div class="thought-bubble" id="thoughtBubble" hidden>
          <span id="thoughtText">؟</span>
        </div>
        
        <!-- Head -->
        <div class="steve-head">
          <svg width="64" height="64" viewBox="0 0 8 8" shape-rendering="crispEdges" style="image-rendering: pixelated;">
            <rect x="0" y="0" width="8" height="2" fill="#3a2410"/>
            <rect x="0" y="2" width="2" height="1" fill="#3a2410"/>
            <rect x="6" y="2" width="2" height="1" fill="#3a2410"/>
            <rect x="0" y="3" width="1" height="2" fill="#3a2410"/>
            <rect x="7" y="3" width="1" height="2" fill="#3a2410"/>
            <rect x="1" y="2" width="6" height="4" fill="#c89568"/>
            <rect x="1" y="3" width="1" height="1" fill="#ffffff"/>
            <rect x="2" y="3" width="1" height="1" fill="#5a7ab8"/>
            <rect x="5" y="3" width="1" height="1" fill="#ffffff"/>
            <rect x="6" y="3" width="1" height="1" fill="#5a7ab8"/>
            <rect x="3" y="4" width="2" height="1" fill="#a87648"/>
            <rect x="3" y="5" width="2" height="1" fill="#7a5028"/>
            <rect x="1" y="5" width="2" height="1" fill="#a87648"/>
            <rect x="5" y="5" width="2" height="1" fill="#a87648"/>
            <rect x="0" y="5" width="1" height="1" fill="#3a2410"/>
            <rect x="7" y="5" width="1" height="1" fill="#3a2410"/>
          </svg>
        </div>
        <div class="steve-body"></div>
        <div class="steve-arm left"></div>
        <div class="steve-arm right" id="steveRightArm">
          <div class="steve-hand"></div>
        </div>
        <div class="steve-leg left"></div>
        <div class="steve-leg right"></div>
      </div>
    </div>
    
    <!-- Hint text below the scene -->
    <div class="scene-hint">
      <p class="inline-flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-pushpin"/></svg> روی میز کار کلیک کن تا اینونتوری باز بشه</p>
    </div>
  </div>
  
  <!-- ═══════════════════════════════════════════════════════════
       INVENTORY MODAL (like Minecraft's "E" inventory)
       ═══════════════════════════════════════════════════════════ -->
  <div class="inv-modal" id="invModal" hidden>
    <div class="inv-modal-backdrop" id="invBackdrop"></div>
    
    <div class="inv-modal-content">
      <div class="inv-modal-header">
        <h3 class="inv-modal-title">اینونتوری</h3>
        <button class="inv-modal-close" id="invClose" aria-label="بستن">✕</button>
      </div>
      
      <!-- Search input (hidden by default, shown when Steve is clicked) -->
      <div class="search-area" id="searchArea" hidden>
        <div class="search-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <path d="M21 21l-4.35-4.35"/>
          </svg>
          <input
            type="text"
            id="craftingSearch"
            placeholder="به استیو بگو چی بسازه... (شمشیر الماس، کلنگ، میز کار...)"
            autocomplete="off"
          />
        </div>
        <div class="search-chips">
          <button class="search-chip" data-recipe-id="diamond-sword"><img src="https://huggingface.co/datasets/Habib91700/minebed-assets/resolve/main/items/diamond-sword.png" alt="" width="16" height="16" loading="lazy" decoding="async" style="image-rendering:pixelated; vertical-align:middle;" onerror="this.style.display='none'" /> شمشیر الماس</button>
          <button class="search-chip" data-recipe-id="iron-pickaxe"><img src="https://huggingface.co/datasets/Habib91700/minebed-assets/resolve/main/items/iron-pickaxe.png" alt="" width="16" height="16" loading="lazy" decoding="async" style="image-rendering:pixelated; vertical-align:middle;" onerror="this.style.display='none'" /> کلنگ آهنی</button>
          <button class="search-chip" data-recipe-id="crafting-table"><img src="https://huggingface.co/datasets/Habib91700/minebed-assets/resolve/main/blocks/crafting-table.png" alt="" width="16" height="16" loading="lazy" decoding="async" style="image-rendering:pixelated; vertical-align:middle;" onerror="this.style.display='none'" /> میز کار</button>
          <button class="search-chip" data-recipe-id="torch"><img src="https://huggingface.co/datasets/Habib91700/minebed-assets/resolve/main/items/torch.png" alt="" width="16" height="16" loading="lazy" decoding="async" style="image-rendering:pixelated; vertical-align:middle;" onerror="this.style.display='none'" /> مشعل</button>
        </div>
      </div>
      
      <!-- Main inventory area (Minecraft-like) -->
      <div class="inv-modal-body" style="direction: ltr;">
        <!-- Left: Steve preview + armor slots -->
        <div class="inv-left">
          <!-- Click Steve to focus search -->
          <button class="inv-steve-preview" id="invStevePreview" aria-label="روی استیو کلیک کن تا تایپ کنی" title="کلیک کن تا تایپ کنی">
            <div class="inv-steve">
              <div class="inv-steve-head">
                <svg width="40" height="40" viewBox="0 0 8 8" shape-rendering="crispEdges" style="image-rendering: pixelated;">
                  <rect x="0" y="0" width="8" height="2" fill="#3a2410"/>
                  <rect x="0" y="2" width="2" height="1" fill="#3a2410"/>
                  <rect x="6" y="2" width="2" height="1" fill="#3a2410"/>
                  <rect x="0" y="3" width="1" height="2" fill="#3a2410"/>
                  <rect x="7" y="3" width="1" height="2" fill="#3a2410"/>
                  <rect x="1" y="2" width="6" height="4" fill="#c89568"/>
                  <rect x="1" y="3" width="1" height="1" fill="#ffffff"/>
                  <rect x="2" y="3" width="1" height="1" fill="#5a7ab8"/>
                  <rect x="5" y="3" width="1" height="1" fill="#ffffff"/>
                  <rect x="6" y="3" width="1" height="1" fill="#5a7ab8"/>
                  <rect x="3" y="4" width="2" height="1" fill="#a87648"/>
                  <rect x="3" y="5" width="2" height="1" fill="#7a5028"/>
                </svg>
              </div>
              <div class="inv-steve-body"></div>
              <div class="inv-steve-arm left"></div>
              <div class="inv-steve-arm right"></div>
              <div class="inv-steve-leg left"></div>
              <div class="inv-steve-leg right"></div>
              <div class="inv-steve-tap-hint" id="steveTapHint">کلیک کن</div>
            </div>
          </button>
          
          <!-- Armor slots (4) + offhand -->
          <div class="armor-slots">
            <div class="armor-slot" data-slot="helmet" title="کلاه"></div>
            <div class="armor-slot" data-slot="chestplate" title="زره تن"></div>
            <div class="armor-slot" data-slot="leggings" title="شلوار"></div>
            <div class="armor-slot" data-slot="boots" title="چکمه"></div>
            <div class="armor-slot offhand" data-slot="offhand" title="دست چپ"></div>
          </div>
        </div>
        
        <!-- Center: 3x3 Crafting grid + arrow + result -->
        <div class="inv-crafting">
          <div class="crafting-grid-3x3" id="craftingGrid3x3">
            {Array.from({ length: 9 }).map((_, i) => (
              <div class="craft-slot" data-craft-slot={i}></div>
            ))}
          </div>
          <div class="crafting-arrow" aria-hidden="true">
            <svg width="32" height="16" viewBox="0 0 32 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 8h22M21 3l5 5-5 5"/>
            </svg>
          </div>
          <div class="craft-result-slot" id="craftResultSlot"></div>
        </div>
        
        <!-- Right: 27 inventory slots (3 rows of 9) -->
        <div class="inv-storage">
          {Array.from({ length: 27 }).map((_, i) => (
            <div class="storage-slot" data-storage-slot={i}></div>
          ))}
        </div>
      </div>
      
      <!-- Bottom: 9 hotbar slots (outside main body, always visible) -->
      <div class="inv-hotbar">
        {Array.from({ length: 9 }).map((_, i) => (
          <div class="hotbar-slot" data-hotbar-slot={i}>
            <span class="hotbar-num">{i + 1}</span>
          </div>
        ))}
      </div>
      
      <!-- Recipe info (shown when a recipe is revealed) -->
      <div class="recipe-info" id="recipeInfo" hidden>
        <div class="recipe-info-content">
          <h4 class="recipe-title" id="recipeTitle"></h4>
          <p class="recipe-desc" id="recipeDesc"></p>
          <a href="#" class="mc-btn pixel small" id="wikiLink" target="_blank">
            <svg width="14" height="14"><use href="#icon-wiki" /></svg>
            صفحه‌ی ویکی
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ═══════════════════════════════════════════════════════════
     ROTATE DEVICE OVERLAY (portrait mobile)
     ═══════════════════════════════════════════════════════════ */
  .rotate-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: linear-gradient(135deg, #1c1c34 0%, #14142a 100%);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 2rem;
    text-align: center;
  }
  
  .rotate-phone {
    width: 80px;
    height: 140px;
    border: 4px solid #7cc84a;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.4);
    animation: rotateAnim 2s ease-in-out infinite;
    position: relative;
  }
  
  .rotate-phone-screen {
    position: absolute;
    inset: 8px 4px;
    background: linear-gradient(135deg, rgba(95, 168, 56, 0.3), rgba(95, 168, 56, 0.1));
    border-radius: 4px;
  }
  
  @keyframes rotateAnim {
    0%, 40% { transform: rotate(0); }
    60%, 100% { transform: rotate(-90deg); }
  }
  
  .rotate-title {
    font-family: 'Press Start 2P', monospace;
    font-size: 1rem;
    color: #7cc84a;
    text-shadow: 2px 2px 0 #1a3010;
    letter-spacing: 1px;
  }
  
  .rotate-text {
    color: #9a9ab8;
    font-size: 0.875rem;
    line-height: 1.6;
    max-width: 280px;
  }
  
  /* Show rotate overlay only on portrait mobile */
  @media (max-width: 768px) and (orientation: portrait) {
    .rotate-overlay { display: flex; }
    .scene-content { display: none; }
  }
  
  /* ═══════════════════════════════════════════════════════════
     MAIN SCENE (landscape + desktop)
     ═══════════════════════════════════════════════════════════ */
  .crafting-scene {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 400px;
    overflow: hidden;
    background: linear-gradient(180deg, #87ceeb 0%, #b0d8f0 40%, #c8e8b0 70%, #7ab558 100%);
  }
  
  .scene-content {
    position: relative;
    width: 100%;
    height: 100%;
  }
  
  .sky-gradient {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 65%;
    background: linear-gradient(180deg, rgba(135, 206, 235, 0.4) 0%, rgba(176, 216, 240, 0.2) 100%);
    pointer-events: none;
  }
  
  .ground {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 35%;
    background:
      linear-gradient(180deg, transparent 0%, transparent 25%, rgba(122, 85, 58, 0.9) 25%, rgba(92, 63, 30, 1) 100%),
      repeating-conic-gradient(from 0deg, rgba(0, 0, 0, 0.06) 0deg 90deg, rgba(255, 255, 255, 0.02) 90deg 180deg) 0 0 / 16px 16px,
      linear-gradient(180deg, #5fa838 0%, #3d7521 100%);
    image-rendering: pixelated;
  }
  
  .clouds {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 30%;
    pointer-events: none;
  }
  
  .cloud {
    position: absolute;
    width: 80px;
    height: 32px;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 16px;
    box-shadow:
      20px 0 0 rgba(255, 255, 255, 0.85),
      -20px 0 0 rgba(255, 255, 255, 0.85),
      0 -16px 0 -8px rgba(255, 255, 255, 0.85);
    animation: cloudDrift 60s linear infinite;
  }
  
  .cloud-1 { top: 15%; left: -10%; animation-duration: 80s; }
  .cloud-2 { top: 25%; left: -10%; animation-duration: 60s; animation-delay: -30s; }
  .cloud-3 { top: 10%; left: -10%; animation-duration: 100s; animation-delay: -50s; }
  
  @keyframes cloudDrift {
    0% { transform: translateX(0); }
    100% { transform: translateX(120vw); }
  }
  
  /* ─── Side inventory panel (desktop only) ─── */
  .inventory-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 220px;
    background: linear-gradient(135deg, rgba(28, 28, 52, 0.95) 0%, rgba(20, 20, 42, 0.98) 100%);
    border-left: 3px solid #2d5018;
    box-shadow: -4px 0 16px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    z-index: 30;
  }
  
  .inventory-header {
    padding: 0.625rem 0.875rem;
    background: linear-gradient(135deg, rgba(123, 197, 92, 0.15) 0%, rgba(123, 197, 92, 0.05) 100%);
    border-bottom: 2px solid var(--line, #2e2e4a);
  }
  
  .inventory-title {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.65rem;
    color: var(--grass-2, #7cc84a);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.5);
  }
  
  .inventory-grid {
    flex: 1;
    overflow-y: auto;
    padding: 0.4rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
    direction: ltr;
  }
  
  .inv-slot {
    width: 100%;
    aspect-ratio: 1;
    background: linear-gradient(135deg, #8b8b8b 0%, #6e6e6e 50%, #565656 100%);
    border-top: 2px solid #373737;
    border-left: 2px solid #373737;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    box-shadow: inset 2px 2px 0 rgba(0, 0, 0, 0.4), inset -2px -2px 0 rgba(255, 255, 255, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: transform 0.1s;
    border-radius: 0;
  }
  
  .inv-slot:hover {
    transform: scale(1.1);
    background: linear-gradient(135deg, #a0a0a0 0%, #828282 50%, #6a6a6a 100%);
  }
  
  .inv-slot img {
    width: 70%;
    height: 70%;
    image-rendering: pixelated;
    pointer-events: none;
  }
  
  @media (max-width: 900px) {
    .inventory-panel { display: none; }
  }
  
  /* ─── Scene stage ─── */
  .scene-stage {
    position: absolute;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 1.5rem;
    z-index: 10;
  }
  
  /* ─── Crafting table (clickable button) ─── */
  .crafting-table-3d {
    position: relative;
    width: 110px;
    height: 90px;
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0;
    transform-style: preserve-3d;
    perspective: 400px;
    transition: transform 0.2s;
  }
  
  .crafting-table-3d:hover {
    transform: scale(1.08);
  }
  
  .crafting-table-3d:active {
    transform: scale(0.95);
  }
  
  .ct-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 110px;
    height: 28px;
    background: #5c3f1e;
    border: 3px solid #1a1a1a;
    box-shadow: inset 2px 2px 0 rgba(255, 255, 255, 0.15);
    overflow: hidden;
    image-rendering: pixelated;
    transform: rotateX(60deg);
    transform-origin: bottom;
    z-index: 2;
  }
  
  .ct-top img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }
  
  .ct-front {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 110px;
    height: 62px;
    background: #9c7b4e;
    border: 3px solid #1a1a1a;
    border-top: none;
    overflow: hidden;
    image-rendering: pixelated;
    z-index: 1;
  }
  
  .ct-front img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }
  
  .ct-shadow {
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 14px;
    background: radial-gradient(ellipse, rgba(0, 0, 0, 0.5) 0%, transparent 70%);
    filter: blur(4px);
    z-index: 0;
  }
  
  .ct-glow {
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle, rgba(255, 200, 60, 0.6) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
    z-index: 5;
  }
  
