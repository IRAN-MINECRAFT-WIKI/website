<script is:inline define:vars={{ recipesData, BASE }}>
  (function () {
    let audioCtx = null;
    
    function getAudioCtx() {
      if (!audioCtx) {
        try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
        catch (e) { return null; }
      }
      return audioCtx;
    }
    
    function playTone(freq, duration, type = 'square', volume = 0.08) {
      const ctx = getAudioCtx();
      if (!ctx) return;
      try {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(volume, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + duration);
      } catch (e) { /* ignore */ }
    }
    
    function soundClick() { playTone(800, 0.04, 'square', 0.04); }
    function soundPop() {
      playTone(600, 0.06, 'sine', 0.06);
      setTimeout(() => playTone(900, 0.04, 'sine', 0.06), 50);
    }
    function soundChime() {
      playTone(523, 0.12, 'sine', 0.08);
      setTimeout(() => playTone(659, 0.12, 'sine', 0.08), 100);
      setTimeout(() => playTone(784, 0.25, 'sine', 0.08), 200);
    }
    function soundError() { playTone(200, 0.2, 'sawtooth', 0.08); }
    function soundThink() {
      playTone(400, 0.08, 'square', 0.04);
      setTimeout(() => playTone(450, 0.08, 'square', 0.04), 130);
      setTimeout(() => playTone(400, 0.08, 'square', 0.04), 260);
    }
    function soundTableOpen() {
      playTone(440, 0.08, 'sine', 0.06);
      setTimeout(() => playTone(660, 0.08, 'sine', 0.06), 80);
    }
    
    // ── State ──────────────────────────────────────────────
    let recipes = [];
    try { recipes = JSON.parse(recipesData); }
    catch (e) { console.error('Failed to parse recipes', e); return; }
    
    let currentPhase = 'idle';
    let searchRevealed = false;
    
    // ── DOM refs ─────────────────────────────────────────────
    const scene = document.getElementById('craftingScene');
    const steve = document.getElementById('steve');
    const thoughtBubble = document.getElementById('thoughtBubble');
    const thoughtText = document.getElementById('thoughtText');
    const tableBtn = document.getElementById('craftingTableBtn');
    const tableGlow = document.getElementById('tableGlow');
    const invModal = document.getElementById('invModal');
    const invBackdrop = document.getElementById('invBackdrop');
    const invClose = document.getElementById('invClose');
    const invStevePreview = document.getElementById('invStevePreview');
    const steveTapHint = document.getElementById('steveTapHint');
    const searchArea = document.getElementById('searchArea');
    const searchInput = document.getElementById('craftingSearch');
    const chips = document.querySelectorAll('.search-chip');
    const craftSlots = document.querySelectorAll('.craft-slot');
    const craftResultSlot = document.getElementById('craftResultSlot');
    const storageSlots = document.querySelectorAll('.storage-slot');
    const hotbarSlots = document.querySelectorAll('.hotbar-slot');
    const recipeInfo = document.getElementById('recipeInfo');
    const recipeTitle = document.getElementById('recipeTitle');
    const recipeDesc = document.getElementById('recipeDesc');
    const wikiLink = document.getElementById('wikiLink');
    const inventoryGrid = document.getElementById('inventoryGrid');
    
    if (!scene || !invModal || !tableBtn) return;
    
    // ── Recipe search ──────────────────────────────────────
    function findRecipe(query) {
      const q = query.trim().toLowerCase();
      if (!q) return null;
      let r = recipes.find(r => r.id === q);
      if (r) return r;
      r = recipes.find(r => r.nameFa.toLowerCase() === q);
      if (r) return r;
      r = recipes.find(r => r.nameEn.toLowerCase() === q);
      if (r) return r;
      r = recipes.find(r => r.aliases.some(a => a.toLowerCase() === q));
      if (r) return r;
      r = recipes.find(r => r.nameFa.toLowerCase().includes(q) || r.nameEn.toLowerCase().includes(q) || r.aliases.some(a => a.toLowerCase().includes(q)));
      if (r) return r;
      r = recipes.find(r => q.includes(r.nameFa.toLowerCase()) || q.includes(r.nameEn.toLowerCase()) || r.aliases.some(a => q.includes(a.toLowerCase())));
      return r || null;
    }
    
    // ── Open/close inventory modal ────────────────────────
    function openInventory() {
      invModal.hidden = false;
      soundTableOpen();
      tableBtn.classList.add('active');
      setTimeout(() => tableBtn.classList.remove('active'), 600);
      // Hide search by default — user must click Steve to reveal it
      searchArea.hidden = true;
      searchRevealed = false;
      invStevePreview.classList.remove('active');
      recipeInfo.hidden = true;
      // Clear crafting grid
      craftSlots.forEach(s => { s.innerHTML = ''; s.classList.add('empty'); });
      craftResultSlot.innerHTML = '';
      craftResultSlot.classList.add('empty');
    }
    
    function closeInventory() {
      invModal.hidden = true;
      soundClick();
    }
    
    // ── Click Steve in inventory → reveal search ──────────
    function clickSteveInInventory() {
      soundClick();
      searchRevealed = !searchRevealed;
      if (searchRevealed) {
        searchArea.hidden = false;
        invStevePreview.classList.add('active');
        if (steveTapHint) steveTapHint.style.display = 'none';
        // Focus the search input
        setTimeout(() => searchInput && searchInput.focus(), 100);
      } else {
        searchArea.hidden = true;
        invStevePreview.classList.remove('active');
        if (steveTapHint) steveTapHint.style.display = '';
      }
    }
    
    // ── Render recipe into crafting grid ───────────────────
    function renderRecipe(recipe) {
      // Clear slots first
      craftSlots.forEach(s => { s.innerHTML = ''; s.classList.add('empty'); });
      craftResultSlot.innerHTML = '';
      craftResultSlot.classList.add('empty');
      recipeInfo.hidden = true;
      
      // Animate Steve reaching
      steve.classList.add('reaching', 'crafting');
      thoughtBubble.hidden = false;
      thoughtText.textContent = '؟';
      soundThink();
      
      // After 1s, fill the grid + reveal
      setTimeout(() => {
        steve.classList.remove('reaching');
        thoughtBubble.hidden = true;
        
        const blockNames = ['oak-planks', 'cobblestone', 'crafting-table-top', 'chest', 'furnace-side', 'tnt', 'ladder', 'bookshelf'];
        
        // Fill 3x3 grid
        for (let r = 0; r < 3; r++) {
          for (let c = 0; c < 3; c++) {
            const idx = r * 3 + c;
            const itemName = recipe.grid[r] && recipe.grid[r][c];
            const slot = craftSlots[idx];
            if (!slot) continue;
            
            if (itemName) {
              setTimeout(() => {
                slot.classList.remove('empty');
                const folder = blockNames.includes(itemName) ? 'blocks' : 'items';
                const img = document.createElement('img');
                img.src = BASE + 'textures/' + folder + '/' + itemName + '.png';
                img.alt = itemName;
                img.style.cssText = 'width: 70%; height: 70%; image-rendering: pixelated;';
                img.onerror = function () { this.style.display = 'none'; };
                slot.innerHTML = '';
                slot.appendChild(img);
                soundPop();
              }, idx * 80);
            }
          }
        }
        
        // Output slot
        const outFolder = (recipe.output && recipe.output.type === 'block') ? 'blocks' : 'items';
        setTimeout(() => {
          craftResultSlot.classList.remove('empty');
          const outImg = document.createElement('img');
          outImg.src = BASE + 'textures/' + outFolder + '/' + recipe.output.item + '.png';
          outImg.alt = recipe.nameFa;
          outImg.style.cssText = 'width: 70%; height: 70%; image-rendering: pixelated;';
          outImg.onerror = function () { this.style.display = 'none'; };
          craftResultSlot.innerHTML = '';
          craftResultSlot.appendChild(outImg);
          
          if (recipe.output.count && recipe.output.count > 1) {
            const count = document.createElement('span');
            count.textContent = recipe.output.count;
            count.style.cssText = 'position: absolute; bottom: 0; right: 2px; font-family: \'Courier New\', monospace; font-size: 0.625rem; color: #fff; text-shadow: 1px 1px 0 #000; font-weight: 700;';
            craftResultSlot.appendChild(count);
            craftResultSlot.style.position = 'relative';
          }
          
          soundChime();
          
          // Show recipe info card
          recipeTitle.textContent = recipe.nameFa;
          recipeDesc.textContent = recipe.description || '';
          wikiLink.href = BASE + 'wiki/' + recipe.wikiSlug;
          recipeInfo.hidden = false;
        }, 9 * 80 + 200);
      }, 1000);
    }
    
    // ── Search and reveal ─────────────────────────────────
    function searchAndReveal(query) {
      const recipe = findRecipe(query);
      if (!recipe) {
        soundError();
        thoughtText.textContent = '!';
        thoughtBubble.hidden = false;
        steve.classList.add('thinking');
        setTimeout(() => {
          thoughtBubble.hidden = true;
          steve.classList.remove('thinking');
        }, 1200);
        return;
      }
      renderRecipe(recipe);
    }
    
    // ── Event handlers ─────────────────────────────────────
    
    // Click crafting table → open inventory
    if (tableBtn) {
      tableBtn.addEventListener('click', openInventory);
    }
    
    // Click Steve in inventory → reveal search
    if (invStevePreview) {
      invStevePreview.addEventListener('click', clickSteveInInventory);
    }
    
    // Modal close
    if (invClose) invClose.addEventListener('click', closeInventory);
    if (invBackdrop) invBackdrop.addEventListener('click', closeInventory);
    
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !invModal.hidden) {
        closeInventory();
      }
    });
    
    // Search input
    let searchTimer = null;
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const q = e.target.value.trim();
        clearTimeout(searchTimer);
        if (!q || q.length < 3) {
          // Clear crafting grid
          craftSlots.forEach(s => { s.innerHTML = ''; s.classList.add('empty'); });
          craftResultSlot.innerHTML = '';
          craftResultSlot.classList.add('empty');
          recipeInfo.hidden = true;
          steve.classList.remove('reaching', 'thinking', 'crafting');
          thoughtBubble.hidden = true;
          return;
        }
        searchTimer = setTimeout(() => searchAndReveal(q), 600);
      });
      
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          clearTimeout(searchTimer);
          const q = searchInput.value.trim();
          if (q.length >= 3) searchAndReveal(q);
        }
      });
    }
    
    // Chips
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        soundClick();
        const recipeId = chip.dataset.recipeId;
        const recipe = recipes.find(r => r.id === recipeId);
        if (recipe) {
          searchInput.value = recipe.nameFa;
          searchAndReveal(recipe.nameFa);
        }
      });
    });
    
    // Inventory panel slots (desktop) → fill hotbar
    if (inventoryGrid) {
      inventoryGrid.querySelectorAll('.inv-slot').forEach(slot => {
        slot.addEventListener('click', () => {
          soundClick();
          const name = slot.dataset.name;
          const type = slot.dataset.type;
          // Add to first empty hotbar slot
          for (let i = 0; i < hotbarSlots.length; i++) {
            if (!hotbarSlots[i].querySelector('img')) {
              const img = document.createElement('img');
              img.src = BASE + 'textures/' + (type === 'block' ? 'blocks' : 'items') + '/' + name + '.png';
              img.alt = name;
              img.style.cssText = 'width: 70%; height: 70%; image-rendering: pixelated;';
              img.onerror = function () { this.style.display = 'none'; };
              hotbarSlots[i].appendChild(img);
              soundPop();
              break;
            }
          }
        });
      });
    }
    
    // Click hotbar slot → remove item
    hotbarSlots.forEach(slot => {
      slot.addEventListener('click', () => {
        const img = slot.querySelector('img');
        if (img) {
          img.remove();
          soundClick();
        }
      });
    });
    
    // Click storage slot → no-op (decorative for now)
    storageSlots.forEach(slot => {
      slot.addEventListener('click', () => soundClick());
    });
    
    // Initial state
    craftSlots.forEach(s => s.classList.add('empty'));
    craftResultSlot.classList.add('empty');
  })();
</script>
