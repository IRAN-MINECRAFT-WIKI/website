---
/**
 * SearchBox.astro — Unified search component (used in header + /search page)
 *
 * Architecture:
 * - Primary: Pagefind (built at build time, indexes all HTML pages)
 * - Fallback: In-memory search of mods.json data (no build step required)
 *
 * Robustness:
 * - Uses `astro:page-load` event to rebind events after EVERY view transition
 *   (Astro skips re-executing is:inline scripts that are present in both
 *   old and new page, so the initial IIFE only runs ONCE — the page-load
 *   handler rebinds to the new DOM elements on every navigation).
 * - Keyboard: Ctrl/Cmd+K to open, Esc to close, ↑↓ Enter to navigate
 * - XSS-safe: textContent + createElement everywhere
 */
import { mods } from '@/lib/data';
const modsJson = JSON.stringify(mods.map(m => ({
  id: m.id, name: m.name, nameFa: m.nameFa, tagline: m.tagline,
  keywords: m.keywords, category: m.category, catName: m.catName,
  icon: 'mod', version: m.version, size: m.size,
})));
const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);
---

<button id="searchOpen" class="search-trigger" aria-label="جستجو در سایت" title="جستجو (Ctrl+K)">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="11" cy="11" r="8" />
    <path d="M21 21l-4.35-4.35" />
  </svg>
  <span class="search-trigger-kbd">Ctrl K</span>
</button>

<div id="searchModal" class="search-modal" hidden role="dialog" aria-modal="true" aria-label="جستجو در MineBed">
  <div class="search-modal-backdrop" data-close></div>
  <div class="search-modal-panel">
    <div class="search-modal-input-wrap">
      <svg class="search-modal-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8" />
        <path d="M21 21l-4.35-4.35" />
      </svg>
      <input
        type="search"
        id="searchInput"
        class="search-modal-input"
        placeholder="جستجو در همه‌ی محتوا — افزونه، سید، مقاله، آموزش..."
        autocomplete="off"
        aria-label="عبارت جستجو"
      />
      <button class="search-modal-close" data-close aria-label="بستن">Esc</button>
    </div>

    <div id="searchResults" class="search-modal-results" role="listbox"></div>

    <div id="searchHint" class="search-modal-hint">
      <span>برای شروع، چند حرف تایپ کنید</span>
      <span class="search-modal-hint-shortcut">↑ ↓ برای جابه‌جایی، Enter برای باز کردن</span>
    </div>
  </div>
</div>

<style>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line, #2e2e4a);
    color: var(--text-2, #9a9ab8);
    font-size: 0.8125rem;
    cursor: pointer;
    border-radius: 6px;
    transition: all 0.15s;
    font-family: inherit;
  }
  .search-trigger:hover {
    background: rgba(123, 197, 92, 0.1);
    border-color: var(--grass-2, #7cc84a);
    color: var(--grass-2, #7cc84a);
  }
  .search-trigger-kbd {
    font-size: 0.625rem;
    padding: 1px 5px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--line, #2e2e4a);
    border-radius: 3px;
    opacity: 0.7;
  }
  @media (max-width: 640px) {
    .search-trigger-kbd { display: none; }
  }

  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
  }
  .search-modal[hidden] { display: none; }

  .search-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .search-modal-panel {
    position: relative;
    width: 90%;
    max-width: 640px;
    background: var(--bg, #0d0d18);
    border: 1px solid var(--line, #2e2e4a);
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }

  .search-modal-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--line, #2e2e4a);
  }
  .search-modal-icon { color: var(--text-3, #5c5c7a); flex-shrink: 0; }
  .search-modal-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text, #e0e0f0);
    font-size: 1rem;
    outline: none;
    font-family: inherit;
  }
  .search-modal-input::placeholder { color: var(--text-3, #5c5c7a); }

  .search-modal-close {
    padding: 4px 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line, #2e2e4a);
    color: var(--text-3, #5c5c7a);
    font-size: 0.6875rem;
    border-radius: 3px;
    cursor: pointer;
    font-family: inherit;
  }
  .search-modal-close:hover { color: var(--text, #e0e0f0); }

  .search-modal-results {
    max-height: 60vh;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .search-result-item {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background 0.1s;
  }
  .search-result-item:hover,
  .search-result-item.active {
    background: rgba(123, 197, 92, 0.08);
  }
  .search-result-item-icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(123, 197, 92, 0.1);
    border-radius: 4px;
    color: var(--grass-2, #7cc84a);
    font-size: 1.125rem;
  }
  .search-result-item-body {
    flex: 1;
    min-width: 0;
  }
  .search-result-item-title {
    font-weight: 700;
    color: var(--text, #e0e0f0);
    font-size: 0.875rem;
    margin-bottom: 0.125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-result-item-excerpt {
    color: var(--text-2, #9a9ab8);
    font-size: 0.75rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-result-item-cat {
    display: inline-block;
    font-size: 0.625rem;
    color: var(--grass-2, #7cc84a);
    background: rgba(123, 197, 92, 0.1);
    padding: 1px 6px;
    border-radius: 8px;
    margin-right: 0.375rem;
  }

  .search-modal-hint {
    padding: 0.625rem 1rem;
    border-top: 1px solid var(--line, #2e2e4a);
    color: var(--text-3, #5c5c7a);
    font-size: 0.6875rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    background: rgba(0, 0, 0, 0.2);
  }

  .search-error {
    padding: 1.5rem;
    text-align: center;
    color: var(--text-2, #9a9ab8);
    font-size: 0.875rem;
  }
  .search-error-icon { font-size: 2rem; margin-bottom: 0.5rem; }

  @media (max-width: 640px) {
    .search-modal { padding-top: 0; align-items: stretch; }
    .search-modal-panel { width: 100%; max-width: none; height: 100vh; border-radius: 0; border: none; }
    .search-modal-results { max-height: calc(100vh - 110px); }
  }
</style>

<script is:inline define:vars={{ modsJson, BASE }}>
  // ============ Module-level state (persists across view transitions) ============
  window.__searchBox = window.__searchBox || {
    pagefind: null,
    pagefindFailed: false,
    fallbackMods: null,
    boundEls: new WeakSet(),  // tracks which elements have listeners
  };
  var SB = window.__searchBox;

  // ============ Helpers ============
  function escapeHtml(s) {
    return String(s || '').replace(/<[^>]+>/g, '');
  }

  function fallbackSearch(q) {
    if (!SB.fallbackMods) {
      try { SB.fallbackMods = JSON.parse(modsJson); } catch { SB.fallbackMods = []; }
    }
    var ql = q.toLowerCase();
    return SB.fallbackMods
      .map(function (m) {
        var haystack = [m.name, m.nameFa, m.tagline, m.keywords, m.catName]
          .filter(Boolean).join(' ').toLowerCase();
        return { m: m, hit: haystack.includes(ql) };
      })
      .filter(function (x) { return x.hit; })
      .slice(0, 20)
      .map(function (x) {
        return {
          url: BASE + 'mods/' + x.m.id,
          title: x.m.nameFa || x.m.name,
          excerpt: x.m.tagline || '',
          icon: 'mod',
          cat: x.m.catName || '',
        };
      });
  }

  function renderResult(r) {
    var a = document.createElement('a');
    a.className = 'search-result-item';
    a.href = r.url;
    a.setAttribute('role', 'option');

    var icon = document.createElement('div');
    icon.className = 'search-result-item-icon';
    // Use SVG icon (not emoji) for search results.
    // Icon name comes from r.icon (string), prefixed with 'icon-'.
    var iconName = r.icon || 'mod';
    if (iconName.indexOf('icon-') !== 0) iconName = 'icon-' + iconName;
    icon.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><use href="#' + iconName + '"></use></svg>';

    var body = document.createElement('div');
    body.className = 'search-result-item-body';

    var title = document.createElement('div');
    title.className = 'search-result-item-title';
    title.textContent = r.title;

    var excerpt = document.createElement('div');
    excerpt.className = 'search-result-item-excerpt';
    if (r.cat) {
      var cat = document.createElement('span');
      cat.className = 'search-result-item-cat';
      cat.textContent = r.cat;
      excerpt.appendChild(cat);
    }
    excerpt.appendChild(document.createTextNode(escapeHtml(r.excerpt)));

    body.appendChild(title);
    body.appendChild(excerpt);
    a.appendChild(icon);
    a.appendChild(body);
    return a;
  }

  async function loadPagefind() {
    if (SB.pagefind || SB.pagefindFailed) return SB.pagefind;
    try {
      var url = BASE + 'pagefind/pagefind.js';
      var mod = await import(/* @vite-ignore */ url);
      SB.pagefind = mod.default || mod;
      await SB.pagefind.init();
      SB.pagefind.options({ excerptLength: 12 });
    } catch (e) {
      console.warn('Pagefind unavailable, using fallback:', e.message);
      SB.pagefindFailed = true;
    }
    return SB.pagefind;
  }

  // ============ Setup (called on EVERY page load + view transition) ============
  var currentResults = [];
  var activeIdx = -1;
  var timer = null;

  function setupSearch() {
    var openBtn = document.getElementById('searchOpen');
    var modal = document.getElementById('searchModal');
    var input = document.getElementById('searchInput');
    var results = document.getElementById('searchResults');
    var hint = document.getElementById('searchHint');
    if (!openBtn || !modal || !input || !results) return;

    // Skip if already bound to these EXACT elements (WeakSet tracks DOM nodes)
    if (SB.boundEls.has(openBtn)) return;
    SB.boundEls.add(openBtn);
    SB.boundEls.add(modal);
    SB.boundEls.add(input);

    function open() {
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      setTimeout(function () { input.focus(); }, 30);
    }
    function close() {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', open);
    modal.querySelectorAll('[data-close]').forEach(function (el) {
      el.addEventListener('click', close);
    });

    function renderActive() {
      var items = results.querySelectorAll('.search-result-item');
      items.forEach(function (el, i) { el.classList.toggle('active', i === activeIdx); });
      var active = items[activeIdx];
      if (active && active.scrollIntoView) {
        active.scrollIntoView({ block: 'nearest' });
      }
    }

    async function runSearch(q) {
      if (!SB.pagefindFailed) { await loadPagefind(); }
      var hits = [];
      if (SB.pagefind) {
        try {
          var search = await SB.pagefind.search(q);
          if (search && search.results) {
            for (var i = 0; i < Math.min(20, search.results.length); i++) {
              var r = await search.results[i].data();
              hits.push({
                url: r.url,
                title: (r.meta && r.meta.title) || r.url,
                excerpt: escapeHtml(r.excerpt || ''),
                icon: '📄', cat: '',
              });
            }
          }
        } catch (e) {
          console.warn('Pagefind search failed, using fallback:', e);
        }
      }
      if (hits.length === 0) hits = fallbackSearch(q);
      currentResults = hits;
      activeIdx = -1;
      results.innerHTML = '';
      if (hits.length === 0) {
        var empty = document.createElement('div');
        empty.className = 'search-error';
        var icon = document.createElement('div');
        icon.className = 'search-error-icon';
        icon.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>';
        var msg = document.createElement('div');
        msg.textContent = 'نتیجه‌ای پیدا نشد. عبارت دیگری امتحان کن.';
        empty.appendChild(icon);
        empty.appendChild(msg);
        results.appendChild(empty);
        return;
      }
      hits.forEach(function (h) { results.appendChild(renderResult(h)); });
    }

    input.addEventListener('input', function () {
      var q = input.value.trim();
      clearTimeout(timer);
      if (!q) {
        results.innerHTML = '';
        currentResults = [];
        if (hint) hint.style.display = '';
        return;
      }
      if (hint) hint.style.display = 'none';
      timer = setTimeout(function () { runSearch(q); }, 200);
    });

    // Keyboard navigation (bound once to document, persists across transitions)
    if (!SB.keyboardBound) {
      SB.keyboardBound = true;
      document.addEventListener('keydown', function (e) {
        // Ctrl/Cmd+K opens search
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          var m = document.getElementById('searchModal');
          var i = document.getElementById('searchInput');
          if (m && m.hidden) {
            m.hidden = false;
            m.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            setTimeout(function () { i && i.focus(); }, 30);
          } else if (i) {
            i.focus();
            i.select();
          }
          return;
        }
        // Esc closes
        if (e.key === 'Escape') {
          var mm = document.getElementById('searchModal');
          if (mm && !mm.hidden) {
            mm.hidden = true;
            mm.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            return;
          }
        }
        // Arrow keys + Enter only work when modal is open
        var mod = document.getElementById('searchModal');
        if (!mod || mod.hidden) return;
        if (e.key === 'ArrowDown' && currentResults.length) {
          e.preventDefault();
          activeIdx = (activeIdx + 1) % currentResults.length;
          updateActive();
        } else if (e.key === 'ArrowUp' && currentResults.length) {
          e.preventDefault();
          activeIdx = (activeIdx - 1 + currentResults.length) % currentResults.length;
          updateActive();
        } else if (e.key === 'Enter' && activeIdx >= 0 && currentResults[activeIdx]) {
          e.preventDefault();
          window.location.href = currentResults[activeIdx].url;
        }
      });
    }

    function updateActive() {
      var items = results.querySelectorAll('.search-result-item');
      items.forEach(function (el, i) { el.classList.toggle('active', i === activeIdx); });
      var active = items[activeIdx];
      if (active && active.scrollIntoView) {
        active.scrollIntoView({ block: 'nearest' });
      }
    }
  }

  // ============ Run on initial load ============
  setupSearch();

  // ============ Re-bind on EVERY view transition ============
  // Astro skips re-executing is:inline scripts present in both old + new pages,
  // so we listen for `astro:page-load` to rebind to the new DOM elements.
  document.addEventListener('astro:page-load', setupSearch);
  document.addEventListener('astro:after-swap', setupSearch);
</script>
