---
/**
 * BackButton.astro — دکمه‌ی برگشت ساده و استاندارد
 * کاربرد: در همه‌ی صفحات محتوایی (blog, wiki, tutorials, mod detail, etc.)
 */
import '@components/icons.astro';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

export interface Props {
  /** URL برای برگشت (اگه خالی باشه، history.back() */
  href?: string;
  label?: string;
}

const { href = '', label = 'برگشت' } = Astro.props;
---

{href ? (
  <a href={base(href)} class="back-btn" data-route>
    <svg width="14" height="14"><use href="#icon-chevron-right" /></svg>
    <span>{label}</span>
  </a>
) : (
  <button class="back-btn" onclick="history.back()" type="button">
    <svg width="14" height="14"><use href="#icon-chevron-right" /></svg>
    <span>{label}</span>
  </button>
)}
