---
/**
 * PrevNextNav.astro — Previous / Next navigation at the bottom of
 * content pages (tutorials, blog, wiki).  Encourages users to keep
 * reading instead of bouncing back to the index.
 *
 * Usage:
 *   <PrevNextNav kind="tutorial" currentId="mob-farm" />
 *
 * The component figures out prev/next based on pubDate order.
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  kind: 'blog' | 'wiki' | 'tutorials';
  currentId: string;
}

const { kind, currentId } = Astro.props;

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

let all: CollectionEntry<typeof kind>[] = [];
try {
  all = await getCollection(kind, ({ data }) => !(data as any).draft);
} catch {
  all = [];
}

// Sort newest first (same as the index pages)
all.sort((a, b) => {
  const ad = (a.data as any).pubDate?.valueOf() || 0;
  const bd = (b.data as any).pubDate?.valueOf() || 0;
  return bd - ad;
});

const currentIndex = all.findIndex((e) => e.id === currentId);
if (currentIndex === -1) {
  // Current item not in collection — render nothing
  return Astro.redirect(base('/404'));
}

// In a newest-first list: prev = older (next item in array), next = newer (prev item in array)
const prevEntry = currentIndex < all.length - 1 ? all[currentIndex + 1] : null;
const nextEntry = currentIndex > 0 ? all[currentIndex - 1] : null;
---

{(prevEntry || nextEntry) && (
  <nav class="prev-next-nav" aria-label="مقاله قبلی و بعدی">
    <div class="pn-row">
      {prevEntry && (
        <a href={base(`/${kind}/${prevEntry.id}`)} class="pn-card pn-prev group">
          <span class="pn-arrow">→</span>
          <span class="pn-label">قبلی</span>
          <span class="pn-title">{(prevEntry.data as any).title}</span>
        </a>
      )}
      {!prevEntry && <span class="pn-card pn-spacer" />}

      {nextEntry && (
        <a href={base(`/${kind}/${nextEntry.id}`)} class="pn-card pn-next group">
          <span class="pn-arrow">←</span>
          <span class="pn-label">بعدی</span>
          <span class="pn-title">{(nextEntry.data as any).title}</span>
        </a>
      )}
      {!nextEntry && <span class="pn-card pn-spacer" />}
    </div>
  </nav>
)}

<style>
  .prev-next-nav {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px dashed var(--line);
  }

  .pn-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .pn-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    background: rgba(28, 28, 52, 0.6);
    border: 2px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s;
    min-height: 80px;
  }

  .pn-card.pn-spacer {
    background: transparent;
    border-color: transparent;
    pointer-events: none;
  }

  .pn-card:hover {
    border-color: var(--grass-2);
    background: rgba(28, 28, 52, 0.9);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  /* RTL: prev on the right, next on the left (arrows point the right way) */
  .pn-prev {
    text-align: right;
  }

  .pn-next {
    text-align: left;
  }

  .pn-arrow {
    font-size: 1.25rem;
    color: var(--grass-2);
    font-weight: bold;
  }

  .pn-label {
    font-size: 0.6875rem;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .pn-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pn-card:hover .pn-title {
    color: var(--grass-2);
  }

  @media (max-width: 640px) {
    .pn-row {
      grid-template-columns: 1fr;
    }
    .pn-card.pn-spacer {
      display: none;
    }
  }
</style>
