    <rect x="3" y="2" width="10" height="1" fill="#c0c0c0"/>
    <!-- Bottom -->
    <rect x="4" y="13" width="8" height="1" fill="#5a5a5a"/>
  </symbol>

  <!-- Water Bucket (16x16) -->
  <symbol id="px-water-bucket" viewBox="0 0 16 16">
    <!-- Bucket body (gray) -->
    <rect x="4" y="3" width="8" height="11" fill="#c0c0c0"/>
    <rect x="5" y="4" width="2" height="9" fill="#e0e0e0"/>
    <rect x="4" y="3" width="1" height="11" fill="#7a7a7a"/>
    <rect x="11" y="3" width="1" height="11" fill="#7a7a7a"/>
    <rect x="3" y="2" width="10" height="2" fill="#9a9a9a"/>
    <!-- Water (blue) - inside the bucket -->
    <rect x="5" y="3" width="6" height="3" fill="#3a7ad8"/>
    <rect x="6" y="3" width="4" height="1" fill="#5a9aea"/>
    <rect x="5" y="6" width="6" height="1" fill="#2a5ab8"/>
    <rect x="4" y="13" width="8" height="1" fill="#5a5a5a"/>
  </symbol>

  <!-- Bone (16x16) -->
  <symbol id="px-bone" viewBox="0 0 16 16">
    <!-- Left end -->
    <rect x="2" y="6" width="3" height="4" fill="#e8e8d8"/>
    <rect x="1" y="5" width="2" height="2" fill="#e8e8d8"/>
    <rect x="1" y="9" width="2" height="2" fill="#e8e8d8"/>
    <!-- Right end -->
    <rect x="11" y="6" width="3" height="4" fill="#e8e8d8"/>
    <rect x="13" y="5" width="2" height="2" fill="#e8e8d8"/>
    <rect x="13" y="9" width="2" height="2" fill="#e8e8d8"/>
    <!-- Middle shaft -->
    <rect x="5" y="7" width="6" height="2" fill="#e8e8d8"/>
    <!-- Shadows -->
    <rect x="2" y="9" width="3" height="1" fill="#a8a890"/>
    <rect x="11" y="9" width="3" height="1" fill="#a8a890"/>
    <rect x="5" y="8" width="6" height="1" fill="#a8a890"/>
  </symbol>

  <!-- ===== MOB FACES (kid-friendly designs) ===== -->

  <!-- Creeper Face (16x16) -->
  <symbol id="px-creeper-face" viewBox="0 0 16 16">
    <!-- Green background -->
    <rect x="0" y="0" width="16" height="16" fill="#5cc44c"/>
    <!-- Texture spots (darker green) -->
    <rect x="2" y="2" width="2" height="2" fill="#3d8a2c"/>
    <rect x="11" y="3" width="2" height="2" fill="#3d8a2c"/>
    <rect x="3" y="11" width="2" height="2" fill="#3d8a2c"/>
    <rect x="11" y="11" width="2" height="2" fill="#3d8a2c"/>
    <!-- Eyes (black, two squares) -->
    <rect x="4" y="6" width="2" height="3" fill="#1a3010"/>
    <rect x="10" y="6" width="2" height="3" fill="#1a3010"/>
    <!-- Mouth (creeper mouth: vertical + two legs) -->
    <rect x="7" y="9" width="2" height="3" fill="#1a3010"/>
    <rect x="5" y="11" width="2" height="3" fill="#1a3010"/>
    <rect x="9" y="11" width="2" height="3" fill="#1a3010"/>
    <!-- Border -->
    <rect x="0" y="0" width="16" height="1" fill="#2d5018"/>
    <rect x="0" y="15" width="16" height="1" fill="#2d5018"/>
  </symbol>

  <!-- Pig Face (16x16) - pink + snout -->
  <symbol id="px-pig-face" viewBox="0 0 16 16">
    <rect x="0" y="0" width="16" height="16" fill="#f0a8b8"/>
    <!-- Eyes -->
    <rect x="4" y="5" width="2" height="2" fill="#1a1a1a"/>
    <rect x="10" y="5" width="2" height="2" fill="#1a1a1a"/>
    <!-- Snout (pink, oval-ish) -->
    <rect x="5" y="9" width="6" height="4" fill="#e88aa0"/>
    <rect x="6" y="10" width="1" height="2" fill="#3a1a20"/>
    <rect x="9" y="10" width="1" height="2" fill="#3a1a20"/>
    <!-- Ears (top corners, darker pink) -->
    <rect x="1" y="1" width="3" height="2" fill="#c87090"/>
    <rect x="12" y="1" width="3" height="2" fill="#c87090"/>
  </symbol>

  <!-- Cow Face (16x16) - brown + white -->
  <symbol id="px-cow-face" viewBox="0 0 16 16">
    <!-- Brown base -->
    <rect x="0" y="0" width="16" height="16" fill="#5c3f1e"/>
    <!-- White patches -->
    <rect x="2" y="2" width="3" height="2" fill="#ffffff"/>
    <rect x="11" y="3" width="3" height="2" fill="#ffffff"/>
    <rect x="6" y="6" width="4" height="2" fill="#ffffff"/>
    <!-- Eyes -->
    <rect x="4" y="6" width="2" height="2" fill="#1a1a1a"/>
    <rect x="10" y="6" width="2" height="2" fill="#1a1a1a"/>
    <!-- Snout -->
    <rect x="5" y="10" width="6" height="3" fill="#c8a890"/>
    <rect x="6" y="11" width="1" height="1" fill="#3a2710"/>
    <rect x="9" y="11" width="1" height="1" fill="#3a2710"/>
    <!-- Horns -->
    <rect x="3" y="1" width="2" height="2" fill="#e0e0e0"/>
    <rect x="11" y="1" width="2" height="2" fill="#e0e0e0"/>
  </symbol>

  <!-- Skeleton Face (16x16) - white skull -->
  <symbol id="px-skeleton-face" viewBox="0 0 16 16">
    <!-- Skull (white) -->
    <rect x="2" y="2" width="12" height="10" fill="#e0e0d0"/>
    <!-- Forehead shadow -->
    <rect x="2" y="2" width="12" height="1" fill="#a0a090"/>
    <!-- Eye sockets (black) -->
    <rect x="4" y="5" width="3" height="3" fill="#1a1a1a"/>
    <rect x="9" y="5" width="3" height="3" fill="#1a1a1a"/>
    <!-- Nose (small triangle-ish) -->
    <rect x="7" y="8" width="2" height="2" fill="#1a1a1a"/>
    <!-- Teeth (small grid) -->
    <rect x="4" y="10" width="2" height="2" fill="#1a1a1a"/>
    <rect x="7" y="10" width="2" height="2" fill="#1a1a1a"/>
    <rect x="10" y="10" width="2" height="2" fill="#1a1a1a"/>
    <!-- Border -->
    <rect x="1" y="1" width="14" height="1" fill="#3a3a30"/>
    <rect x="1" y="12" width="14" height="1" fill="#3a3a30"/>
  </symbol>

</svg>
