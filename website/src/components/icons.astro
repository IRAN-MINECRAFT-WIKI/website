---
// icons.astro — SVG sprite with all Minecraft pixel icons
// Must be included in BaseLayout for <use href="#icon-*"> to work
---

<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true" is:inline>

  <symbol id="icon-home" viewBox="0 0 24 24">
    <path fill="currentColor" d="M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
  </symbol>

  <symbol id="icon-cube" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <path d="M12 2L22 7v10l-10 5L2 17V7L12 2z"/>
      <path d="M2 7l10 5 10-5M12 12v10"/>
    </g>
  </symbol>

  <symbol id="icon-seed" viewBox="0 0 24 24">
    <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M12 2C8 6 6 9 6 13a6 6 0 0012 0c0-4-2-7-6-11z"/>
    <path fill="currentColor" d="M12 7v9" stroke="currentColor" stroke-width="1.5"/>
  </symbol>

  <symbol id="icon-version" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="6" width="18" height="4" rx="0"/>
      <rect x="3" y="14" width="18" height="4" rx="0"/>
      <path d="M7 6v4M7 14v4"/>
    </g>
  </symbol>

  <symbol id="icon-category" viewBox="0 0 24 24">
    <g fill="currentColor">
      <rect x="3" y="3" width="8" height="8" rx="0"/>
      <rect x="13" y="3" width="8" height="8" rx="0"/>
      <rect x="3" y="13" width="8" height="8" rx="0"/>
      <rect x="13" y="13" width="8" height="8" rx="0"/>
    </g>
  </symbol>

  <symbol id="icon-blog" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <path d="M4 4h16v12H7l-3 3V4z"/>
      <path d="M8 8h8M8 11h6" stroke-linecap="round"/>
    </g>
  </symbol>

  <symbol id="icon-wiki" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <path d="M5 4h14v16l-7-3-7 3V4z"/>
      <path d="M9 8h6M9 11h6" stroke-linecap="round"/>
    </g>
  </symbol>

  <symbol id="icon-tutorial" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <path d="M4 5h12a2 2 0 012 2v12a2 2 0 01-2 2H4V5z"/>
      <path d="M4 5L20 3" stroke-linecap="round"/>
      <path d="M8 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
  </symbol>

  <symbol id="icon-pipeline" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <path d="M3 12h4M9 12h2M13 12h2M17 12h4" stroke-linecap="round"/>
      <rect x="5" y="6" width="4" height="12" rx="0"/>
      <rect x="15" y="6" width="4" height="12" rx="0"/>
    </g>
  </symbol>

  <symbol id="icon-bell" viewBox="0 0 24 24">
    <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M12 3a6 6 0 016 6v5l2 3H4l2-3V9a6 6 0 016-6zM10 19a2 2 0 004 0"/>
  </symbol>

  <symbol id="icon-media" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <rect x="3" y="5" width="18" height="14" rx="0"/>
      <circle cx="9" cy="11" r="2"/>
      <path d="M3 17l5-5 4 4 3-3 6 6"/>
    </g>
  </symbol>

  <symbol id="icon-eye" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/>
      <circle cx="12" cy="12" r="3"/>
    </g>
  </symbol>

  <symbol id="icon-stats" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round">
      <path d="M3 3v18h18"/>
      <path d="M7 14l4-4 4 4 5-7"/>
    </g>
  </symbol>

  <symbol id="icon-settings" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <circle cx="12" cy="12" r="3"/>
      <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09A1.65 1.65 0 008 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H2a2 2 0 110-4h.09A1.65 1.65 0 004.6 8a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V2a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H22a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"/>
    </g>
  </symbol>

  <symbol id="icon-search" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"/>
      <path d="M21 21l-4.35-4.35"/>
    </g>
  </symbol>

  <symbol id="icon-plus" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M12 5v14M5 12h14"/>
    </g>
  </symbol>

  <symbol id="icon-trash" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6h14z"/>
      <path d="M10 11v6M14 11v6"/>
    </g>
  </symbol>

  <symbol id="icon-edit" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 20h9"/>
      <path d="M16.5 3.5a2.121 2.121 0 113 3L7 19l-4 1 1-4L16.5 3.5z"/>
    </g>
  </symbol>

  <symbol id="icon-download" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
      <path d="M7 10l5 5 5-5"/>
      <path d="M12 15V3"/>
    </g>
  </symbol>

  <symbol id="icon-heart" viewBox="0 0 24 24">
    <path fill="currentColor" stroke="none" d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 10-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 000-7.78z"/>
  </symbol>

  <symbol id="icon-diamond" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
      <path d="M6 3h12l4 6-10 12L2 9l4-6z"/>
      <path d="M2 9h20M12 21V9M6 3l4 6h8l4-6M10 9l-4-6M14 9l4-6"/>
    </g>
  </symbol>

  <symbol id="icon-sword" viewBox="0 0 24 24">
    <!-- Vertical sword, blade pointing up — clean and recognizable -->
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round">
      <!-- Blade: long thin triangle, point at top -->
      <path d="M12 2L9 5v8h6V5z" />
      <!-- Center fuller (groove down the middle of the blade) -->
      <path d="M12 4v9" stroke-width="1" />
      <!-- Crossguard: horizontal bar at base of blade -->
      <path d="M6.5 14h11" stroke-width="2.2" />
      <!-- Grip: short vertical bar below crossguard -->
      <path d="M12 14v6" />
      <!-- Pommel: circle at the very bottom -->
      <circle cx="12" cy="21" r="1.5" stroke-width="1.8" />
    </g>
  </symbol>

  <symbol id="icon-map" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3V6z"/>
      <path d="M9 3v15M15 6v15"/>
    </g>
  </symbol>

  <symbol id="icon-mob" viewBox="0 0 24 24">
    <!-- Pixel-style Creeper face (square head + classic creeper expression) -->
    <g fill="currentColor" stroke="none">
      <!-- Eyes (two squares) -->
      <rect x="6" y="7" width="3" height="4" />
      <rect x="15" y="7" width="3" height="4" />
      <!-- Mouth: vertical bar from middle down -->
      <rect x="10.5" y="11" width="3" height="3" />
      <!-- Mouth: two vertical legs at bottom -->
      <rect x="8" y="14" width="2" height="3" />
      <rect x="14" y="14" width="2" height="3" />
    </g>
    <!-- Head outline -->
    <rect x="4" y="4" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" />
  </symbol>

  <symbol id="icon-decoration" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <rect x="3" y="3" width="18" height="18" rx="0"/>
      <path d="M3 12h18M12 3v18"/>
    </g>
  </symbol>

  <symbol id="icon-creeper" viewBox="0 0 24 24">
    <g fill="currentColor" stroke="none">
      <rect x="5" y="6" width="4" height="5" />
      <rect x="15" y="6" width="4" height="5" />
      <rect x="10" y="11" width="4" height="3" />
      <rect x="7" y="14" width="3" height="4" />
      <rect x="14" y="14" width="3" height="4" />
    </g>
    <rect x="3" y="3" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" />
  </symbol>

  <symbol id="icon-world" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <path d="M2 12h20M12 2a15 15 0 010 20 15 15 0 010-20z"/>
    </g>
  </symbol>

  <symbol id="icon-tool" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round">
      <path d="M14.7 6.3a4 4 0 00-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 005.4-5.4l-2.7 2.7-3-3 2.7-2.7z"/>
    </g>
  </symbol>

  <symbol id="icon-play" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <path d="M10 9l5 3-5 3V9z" fill="currentColor"/>
    </g>
  </symbol>

  <symbol id="icon-pause" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <path d="M10 9v6M14 9v6" stroke-linecap="round"/>
    </g>
  </symbol>

  <symbol id="icon-next" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <path d="M9 8l5 4-5 4V8z" fill="currentColor"/>
      <path d="M16 8v8" stroke-linecap="round"/>
    </g>
  </symbol>

  <symbol id="icon-up" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 19V5"/>
      <path d="M5 12l7-7 7 7"/>
    </g>
  </symbol>

  <symbol id="icon-close" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M6 6l12 12M18 6L6 18"/>
    </g>
  </symbol>

  <symbol id="icon-filter" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <path d="M3 4h18l-7 8v6l-4 2v-8L3 4z"/>
    </g>
  </symbol>

  <symbol id="icon-telegram" viewBox="0 0 24 24">
    <path fill="currentColor" d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.27 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/>
  </symbol>

  <symbol id="icon-instagram" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <rect x="2" y="2" width="20" height="20" rx="5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="18" cy="6" r="0.5" fill="currentColor"/>
    </g>
  </symbol>

  <symbol id="icon-youtube" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <rect x="2" y="5" width="20" height="14" rx="3"/>
      <path d="M10 9l5 3-5 3V9z" fill="currentColor" stroke="none"/>
    </g>
  </symbol>

  <symbol id="icon-chevron-left" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 18l-6-6 6-6"/>
    </g>
  </symbol>

  <symbol id="icon-chevron-right" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 18l6-6-6-6"/>
    </g>
  </symbol>

  <symbol id="icon-external" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
      <path d="M15 3h6v6M10 14L21 3"/>
    </g>
  </symbol>

  <symbol id="icon-menu" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M3 12h18M3 6h18M3 18h18"/>
    </g>
  </symbol>

</svg>
