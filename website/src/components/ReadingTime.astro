---
/**
 * ReadingTime.astro — shows "⏱️ X دقیقه مطالعه" badge.
 *
 * Usage:
 *   <ReadingTime text={post.body} />
 *   <ReadingTime minutes={5} />
 *
 * If `text` is provided, calculates based on word count (Persian ~200 wpm).
 * If `minutes` is provided directly, uses that.
 */
export interface Props {
  text?: string;
  minutes?: number;
}

const { text, minutes } = Astro.props;

let mins = minutes || 1;
if (!minutes && text) {
  // Count words (Persian + English) — average reading speed ~200 wpm
  const words = text.trim().split(/\s+/).length;
  mins = Math.max(1, Math.round(words / 200));
}
---

<span class="reading-time" title="زمان تخمینی مطالعه">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10"/>
    <polyline points="12 6 12 12 16 14"/>
  </svg>
  <span>{mins}</span>
  <span>دقیقه مطالعه</span>
</span>

<style>
  .reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-2);
    background: rgba(28, 28, 52, 0.6);
    border: 1px solid var(--line);
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
  }

  .reading-time svg {
    color: var(--grass-2);
  }
</style>
