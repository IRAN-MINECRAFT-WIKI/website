---
/**
 * MusicPlayer.astro — پخش‌کننده موسیقی شناور
 *
 * 🎯 ویژگی‌ها:
 * - بارگذاری اولین آهنگ از music.json
 * - دکمه واضح Play/Pause (سبز برای Play، خاکستری برای Pause)
 * - دکمه Next (آهنگ بعدی)
 * - خودکار بعد از اولین کلیک کاربر (هر جا روی صفحه) شروع به پخش می‌کنه
 * - transition:persist بین صفحات (موزیک قطع نمی‌شه)
 * - نمایش عنوان آهنگ + آیکون موزیک
 * - وضعیت در localStorage ذخیره می‌شه (اگه کاربر pause کرده، می‌مونه pause)
 */
import { musicTracks } from '@/lib/data';
const tracksJson = JSON.stringify(musicTracks);
---

<div
  id="bgMusicPlayer"
  class="bg-music-player"
  transition:persist
  data-tracks={tracksJson}
>
  <div class="player-info">
    <span class="music-icon">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18V5l12-2v13"/>
        <circle cx="6" cy="18" r="3"/>
        <circle cx="18" cy="16" r="3"/>
      </svg>
    </span>
    <span id="musicTitle" class="music-title">در حال بارگذاری...</span>
  </div>
  <div class="player-controls">
    <button class="player-btn" id="playPauseBtn" title="پخش / توقف" aria-label="پخش یا توقف">
      <svg id="playIcon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5v14l11-7z"/>
      </svg>
      <svg id="pauseIcon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:none">
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
      </svg>
    </button>
    <button class="player-btn next" id="nextBtn" title="آهنگ بعدی" aria-label="آهنگ بعدی">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18l6-6-6-6"/>
      </svg>
    </button>
  </div>
  <audio id="bgAudio" preload="auto" loop></audio>
</div>

<style>
  .bg-music-player {
    position: fixed;
    bottom: 1.25rem;
    left: 1.25rem;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    background: rgba(28, 28, 52, 0.96);
    border: 2px solid var(--line);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-family: var(--font);
    max-width: calc(100vw - 2.5rem);
    transition: border-color 0.15s, transform 0.2s;
  }

  .bg-music-player:hover {
    border-color: var(--grass);
  }

  .bg-music-player.hidden {
    transform: translateY(150%);
    opacity: 0;
    pointer-events: none;
  }

  .player-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 700;
    min-width: 0;
  }

  .music-icon {
    color: var(--grass-2);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bg-music-player.playing .music-icon {
    animation: musicPulse 1.5s ease-in-out infinite;
  }

  @keyframes musicPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  .music-title {
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text);
  }

  .player-controls {
    display: flex;
    gap: 0.375rem;
    align-items: center;
  }

  .player-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--line);
    border: 2px solid #3e3e5a;
    color: var(--text);
    font-size: 13px;
    cursor: pointer;
    transition: all 0.15s;
    flex-shrink: 0;
    font-family: inherit;
    font-weight: 700;
  }

  .player-btn:hover {
    background: var(--grass);
    border-color: var(--grass-3);
    color: #fff;
  }

  .player-btn.playing {
    background: var(--grass);
    border-color: var(--grass-3);
    color: #fff;
  }

  .player-btn.playing:hover {
    background: var(--grass-2);
  }

  @media (max-width: 480px) {
    .bg-music-player {
      bottom: 0.75rem;
      left: 0.75rem;
      right: 0.75rem;
      padding: 0.5rem 0.625rem;
      justify-content: space-between;
      max-width: none;
    }
    .music-title {
      max-width: 100px;
      font-size: 0.7rem;
    }
    .player-btn {
      width: 28px;
      height: 28px;
      font-size: 11px;
    }
  }
</style>

<script>
  (function () {
    // Skip if already initialized (after view transition — player persists)
    if (window.__musicPlayerInit) return;
    window.__musicPlayerInit = true;

    const player = document.getElementById('bgMusicPlayer');
    const audio = document.getElementById('bgAudio');
    const playBtn = document.getElementById('playPauseBtn');
    const nextBtn = document.getElementById('nextBtn');
    const titleEl = document.getElementById('musicTitle');
    const playIcon = document.getElementById('playIcon');
    const pauseIcon = document.getElementById('pauseIcon');

    if (!player || !audio || !playBtn || !nextBtn || !titleEl) return;

    let tracks = [];
    try {
      tracks = JSON.parse(player.dataset.tracks || '[]');
    } catch (e) { tracks = []; }

    if (!tracks.length) {
      player.classList.add('hidden');
      return;
    }

    let current = 0;
    let isPlaying = false;

    // Restore from localStorage — if user paused, stay paused
    const userPausedMusic = localStorage.getItem('musicUserPaused') === 'true';

    function loadTrack(idx) {
      const t = tracks[idx];
      if (!t) return;
      audio.src = t.src;
      if (titleEl) titleEl.textContent = t.title || 'موسیقی نامشخص';
      current = idx;
    }

    function play() {
      const promise = audio.play();
      if (promise) {
        promise.then(() => {
          isPlaying = true;
          player.classList.add('playing');
          playBtn.classList.add('playing');
          if (playIcon) playIcon.style.display = 'none';
          if (pauseIcon) pauseIcon.style.display = '';
        }).catch((err) => {
          // Autoplay blocked by browser policy — waiting for user interaction
        });
      }
    }

    function pause() {
      audio.pause();
      isPlaying = false;
      player.classList.remove('playing');
      playBtn.classList.remove('playing');
      if (playIcon) playIcon.style.display = '';
      if (pauseIcon) pauseIcon.style.display = 'none';
      localStorage.setItem('musicUserPaused', 'true');
    }

    function toggle() {
      if (isPlaying) {
        pause();
      } else {
        localStorage.setItem('musicUserPaused', 'false');
        play();
      }
    }

    function next() {
      current = (current + 1) % tracks.length;
      loadTrack(current);
      if (isPlaying) {
        play();
      } else {
        // User wants to play next — start playing
        localStorage.setItem('musicUserPaused', 'false');
        play();
      }
    }

    loadTrack(0);

    playBtn.addEventListener('click', toggle);
    nextBtn.addEventListener('click', next);

    // Auto-start after first user interaction (browser autoplay policy)
    // But ONLY if user hasn't explicitly paused before
    function startOnInteraction() {
      if (isPlaying) return;
      if (localStorage.getItem('musicUserPaused') === 'true') {
        // User explicitly paused — don't auto-start
        return;
      }
      play();
      // Clean up listeners once started
      ['click', 'keydown', 'touchstart'].forEach((ev) =>
        document.removeEventListener(ev, startOnInteraction, true)
      );
    }

    if (!userPausedMusic) {
      ['click', 'keydown', 'touchstart'].forEach((ev) =>
        document.addEventListener(ev, startOnInteraction, true)
      );
    }

    // When track ends, go to next (only if not loop)
    audio.addEventListener('ended', () => {
      // The audio has loop=true, so this shouldn't fire normally
      // But just in case:
      next();
    });
  })();
</script>
