---
/**
 * MusicPlayer.astro — compact floating music player
 *
 * Redesigned to NOT overlap content:
 * - Collapsed state: a small 44×44 floating button (just the icon)
 * - Expanded state (on hover): shows title + controls
 * - Auto-collapses after 3s of no interaction
 * - User can dismiss entirely (state persisted in localStorage)
 * - Sits in the bottom-left, but with a smaller footprint so it
 *   doesn't cover content cards.
 */
import { musicTracks } from '@/lib/data';
const tracksJson = JSON.stringify(musicTracks);
---

<div
  id="bgMusicPlayer"
  class="bg-music-player collapsed"
  transition:persist
  data-tracks={tracksJson}
>
  <button class="player-toggle" id="playerToggle" title="نمایش پخش‌کننده" aria-label="نمایش پخش‌کننده موسیقی">
    <span class="music-icon">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18V5l12-2v13"/>
        <circle cx="6" cy="18" r="3"/>
        <circle cx="18" cy="16" r="3"/>
      </svg>
    </span>
  </button>

  <div class="player-body">
    <div class="player-info">
      <span class="music-icon-small">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18V5l12-2v13"/>
          <circle cx="6" cy="18" r="3"/>
          <circle cx="18" cy="16" r="3"/>
        </svg>
      </span>
      <span id="musicTitle" class="music-title">در حال بارگذاری...</span>
    </div>
    <div class="player-controls">
      <button class="player-btn" id="playPauseBtn" title="پخش / توقف" aria-label="پخش یا توقف">
        <svg id="playIcon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg id="pauseIcon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="display:none">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
      </button>
      <button class="player-btn next" id="nextBtn" title="آهنگ بعدی" aria-label="آهنگ بعدی">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </button>
      <button class="player-btn dismiss" id="dismissBtn" title="بستن پخش‌کننده" aria-label="بستن">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </div>
  </div>

  <audio id="bgAudio" preload="none" loop></audio>
</div>

<style>
  .bg-music-player {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    background: rgba(28, 28, 52, 0.96);
    border: 2px solid var(--line);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-family: var(--font);
    border-radius: 999px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
    max-width: calc(100vw - 2rem);
  }

  .bg-music-player:hover {
    border-color: var(--grass);
  }

  .bg-music-player.hidden {
    transform: translateY(150%);
    opacity: 0;
    pointer-events: none;
  }

  /* Collapsed: only the toggle button shows */
  .bg-music-player.collapsed .player-body {
    width: 0;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Expanded: show body */
  .bg-music-player:not(.collapsed) .player-body {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding-right: 0.625rem;
    opacity: 1;
    transition: opacity 0.2s 0.1s;
  }

  .player-toggle {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--grass-2);
    cursor: pointer;
    flex-shrink: 0;
    border-radius: 50%;
    transition: background 0.15s;
  }

  .player-toggle:hover {
    background: rgba(124, 200, 74, 0.15);
  }

  .bg-music-player.playing .player-toggle .music-icon {
    animation: musicPulse 1.5s ease-in-out infinite;
  }

  @keyframes musicPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  .player-body {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .player-info {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text);
    font-size: 0.7rem;
    font-weight: 700;
    min-width: 0;
  }

  .music-icon-small {
    color: var(--grass-2);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .music-title {
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text);
  }

  .player-controls {
    display: flex;
    gap: 0.25rem;
    align-items: center;
  }

  .player-btn {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--line);
    border: 1.5px solid #3e3e5a;
    color: var(--text);
    cursor: pointer;
    transition: all 0.15s;
    flex-shrink: 0;
    font-family: inherit;
    font-weight: 700;
    border-radius: 50%;
  }

  .player-btn:hover {
    background: var(--grass);
    border-color: var(--grass-3);
    color: #fff;
  }

  .player-btn.playing {
    background: var(--grass);
    border-color: var(--grass-3);
    color: #fff;
  }

  .player-btn.dismiss:hover {
    background: var(--redstone, #c63b3b);
    border-color: #8a1a1a;
  }

  @media (max-width: 480px) {
    .bg-music-player {
      bottom: 0.5rem;
      left: 0.5rem;
    }
    .music-title {
      max-width: 80px;
      font-size: 0.65rem;
    }
    .player-btn {
      width: 26px;
      height: 26px;
    }
  }
</style>

<script>
  (function () {
    // Skip if already initialized (after view transition — player persists)
    if (window.__musicPlayerInit) return;
    window.__musicPlayerInit = true;

    const player = document.getElementById('bgMusicPlayer');
    const audio = document.getElementById('bgAudio');
    const playBtn = document.getElementById('playPauseBtn');
    const nextBtn = document.getElementById('nextBtn');
    const dismissBtn = document.getElementById('dismissBtn');
    const toggleBtn = document.getElementById('playerToggle');
    const titleEl = document.getElementById('musicTitle');
    const playIcon = document.getElementById('playIcon');
    const pauseIcon = document.getElementById('pauseIcon');

    if (!player || !audio || !playBtn || !nextBtn || !titleEl) return;

    let tracks = [];
    try {
      tracks = JSON.parse(player.dataset.tracks || '[]');
    } catch (e) { tracks = []; }

    if (!tracks.length) {
      player.classList.add('hidden');
      return;
    }

    // P1-1 fix: if musicDismissed is true, hide the player, BUT
    // still attach the toggle click handler so the user can click
    // the (visible-after-dismiss) footer "فعال‌سازی موسیقی" button
    // to bring the player back without a page reload.
    if (localStorage.getItem('musicDismissed') === 'true') {
      player.classList.add('hidden');
    }

    let current = 0;
    let isPlaying = false;
    let collapseTimer = null;

    // Restore from localStorage — if user paused, stay paused
    const userPausedMusic = localStorage.getItem('musicUserPaused') === 'true';

    function expand() {
      player.classList.remove('collapsed');
      if (collapseTimer) clearTimeout(collapseTimer);
      // Auto-collapse after 4 seconds of no interaction
      collapseTimer = setTimeout(() => {
        if (!isPlaying) player.classList.add('collapsed');
      }, 4000);
    }

    function collapse() {
      player.classList.add('collapsed');
      if (collapseTimer) {
        clearTimeout(collapseTimer);
        collapseTimer = null;
      }
    }

    function loadTrack(idx) {
      const t = tracks[idx];
      if (!t) return;
      audio.src = t.src;
      if (titleEl) titleEl.textContent = t.title || 'موسیقی نامشخص';
      current = idx;
    }

    function play() {
      const promise = audio.play();
      if (promise) {
        promise.then(() => {
          isPlaying = true;
          player.classList.add('playing');
          playBtn.classList.add('playing');
          if (playIcon) playIcon.style.display = 'none';
          if (pauseIcon) pauseIcon.style.display = '';
        }).catch((err) => {
          // Autoplay blocked by browser policy — waiting for user interaction
        });
      }
    }

    function pause() {
      audio.pause();
      isPlaying = false;
      player.classList.remove('playing');
      playBtn.classList.remove('playing');
      if (playIcon) playIcon.style.display = '';
      if (pauseIcon) pauseIcon.style.display = 'none';
      localStorage.setItem('musicUserPaused', 'true');
    }

    function toggle() {
      if (isPlaying) {
        pause();
      } else {
        localStorage.setItem('musicUserPaused', 'false');
        play();
      }
    }

    function next() {
      current = (current + 1) % tracks.length;
      loadTrack(current);
      if (isPlaying) {
        play();
      } else {
        // User wants to play next — start playing
        localStorage.setItem('musicUserPaused', 'false');
        play();
      }
    }

    function dismiss() {
      pause();
      player.classList.add('hidden');
      localStorage.setItem('musicDismissed', 'true');
      // P2-3 fix: immediately show the footer "فعال‌سازی موسیقی"
      // button via a custom event (Footer.astro listens for this).
      document.dispatchEvent(new CustomEvent('music:dismissed'));
      var footerBtn = document.getElementById('footerMusicToggle');
      if (footerBtn) footerBtn.style.display = '';
    }

    loadTrack(0);

    // Wire up the toggle (expand on click, also start playing on first interaction)
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        if (player.classList.contains('collapsed')) {
          expand();
          // First click on the toggle also tries to start playing
          if (!isPlaying && !localStorage.getItem('musicUserPaused')) {
            play();
          }
        } else {
          collapse();
        }
      });
    }

    // Hover on collapsed player expands it; mouseleave collapses (if not playing)
    player.addEventListener('mouseenter', expand);
    player.addEventListener('mouseleave', () => {
      if (!isPlaying) collapse();
    });

    playBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle();
    });
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      next();
    });
    if (dismissBtn) {
      dismissBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        dismiss();
      });
    }

    // Auto-start after first user interaction (browser autoplay policy)
    // But ONLY if user hasn't explicitly paused before AND not on mobile
    const isMobileDevice = window.matchMedia('(max-width: 900px)').matches;
    function startOnInteraction() {
      if (isPlaying) return;
      if (localStorage.getItem('musicUserPaused') === 'true') return;
      if (localStorage.getItem('musicDismissed') === 'true') return;
      play();
      expand(); // Show the player expanded when it starts playing
      ['click', 'keydown', 'touchstart'].forEach((ev) =>
        document.removeEventListener(ev, startOnInteraction, true)
      );
    }

    if (!userPausedMusic && !isMobileDevice) {
      ['click', 'keydown', 'touchstart'].forEach((ev) =>
        document.addEventListener(ev, startOnInteraction, true)
      );
    }

    // When track ends, go to next
    audio.addEventListener('ended', () => {
      next();
    });
  })();
</script>
