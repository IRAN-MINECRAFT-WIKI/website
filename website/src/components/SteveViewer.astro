---
/**
 * SteveViewer.astro — Three.js + skinview3d based Steve viewer
 *
 * Renders a real Minecraft Steve model with:
 * - Actual skin texture (64×64 from Crafatar/Mojang)
 * - Real proportions (1.8 blocks tall = 32 pixels)
 * - idle/walk/run animations
 * - Drag to rotate, scroll to zoom
 * - Skin selector (Steve / Alex / custom)
 *
 * Uses skinview3d — the official Minecraft skin rendering library.
 */

const BASE = import.meta.env.BASE_URL;
---

<div class="steve-viewer-wrap">
  <div class="steve-canvas-wrap">
    <canvas id="steveCanvas" class="steve-canvas" width="400" height="500"></canvas>
    <div class="steve-loading" id="steveLoading">
      <div class="steve-loading-spinner"></div>
      <p>در حال بارگذاری استیو…</p>
    </div>
  </div>

  <div class="steve-controls">
    <div class="steve-anim-row">
      <button class="steve-btn active" data-anim="idle" id="animIdle">
        <span class="inline-flex"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-stand"/></svg></span> ایستاده
      </button>
      <button class="steve-btn" data-anim="walk" id="animWalk">
        <span class="inline-flex"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-walk"/></svg></span> راه می‌ره
      </button>
      <button class="steve-btn" data-anim="run" id="animRun">
        <span class="inline-flex"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-run"/></svg></span> می‌دوه
      </button>
    </div>
    <div class="steve-action-row">
      <button class="steve-btn-ghost" id="steveRotate">
        <span class="inline-flex"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-refresh"/></svg></span> چرخش خودکار
      </button>
      <button class="steve-btn-ghost" id="steveReset">
        <span class="inline-flex"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-target"/></svg></span> بازنشانی دید
      </button>
    </div>
    <div class="steve-skin-row">
      <label class="steve-skin-label">Skin:</label>
      <select id="steveSkin" class="steve-skin-select">
        <option value="steve">Steve (کلاسیک)</option>
        <option value="alex">Alex</option>
        <option value="custom">آپلود فایل...</option>
        <option value="username">از نام کاربری...</option>
        <option value="url">از URL...</option>
      </select>
    </div>

    <!-- Custom skin upload (file input) -->
    <div class="steve-custom-row" id="steveCustomRow" hidden>
      <input type="file" id="steveSkinFile" accept="image/png" class="steve-file-input" />
      <p class="steve-custom-hint">یه فایل PNG با ابعاد ۶۴×۶۴ یا ۶۴×۳۲ (ساختار استاندارد Minecraft) آپلود کن.</p>
    </div>

    <!-- Username input (fetches skin from Mojang via Crafatar) -->
    <div class="steve-custom-row" id="steveUsernameRow" hidden>
      <input type="text" id="steveUsernameInput" placeholder="مثلاً: Notch یا Habib91700" class="steve-text-input" dir="ltr" autocomplete="off" />
      <button id="steveUsernameBtn" class="steve-btn">دریافت</button>
      <p class="steve-custom-hint">پوسته از دیتابیس رسمی Mojang دریافت می‌شه (از طریق Crafatar API).</p>
    </div>

    <!-- URL input -->
    <div class="steve-custom-row" id="steveUrlRow" hidden>
      <input type="text" id="steveUrlInput" placeholder="https://example.com/skin.png" class="steve-text-input" dir="ltr" autocomplete="off" />
      <button id="steveUrlBtn" class="steve-btn">بارگذاری</button>
      <p class="steve-custom-hint">URL فایل PNG با ساختار Minecraft رو وارد کن.</p>
    </div>

    <!-- Download / Share -->
    <div class="steve-action-row">
      <button class="steve-btn-ghost" id="steveDownload" title="دانلود پوسته‌ی فعلی">
        ⬇ دانلود پوسته
      </button>
      <button class="steve-btn-ghost" id="steveSnapshot" title="عکس‌ گرفتن از استیو">
        📸 عکس‌ گرفتن
      </button>
    </div>
  </div>
</div>

<style>
  .steve-viewer-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: linear-gradient(180deg, #1a2a1a 0%, #0d1d0d 100%);
    border: 2px solid var(--line, #2e2e4a);
    border-radius: 12px;
    padding: 1rem;
    overflow: hidden;
  }

  .steve-canvas-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 500px;
    border-radius: 8px;
    overflow: hidden;
    background: linear-gradient(180deg, #87ceeb 0%, #b0e0e6 50%, #90ee90 100%);
  }

  .steve-canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
    cursor: grab;
  }

  .steve-canvas:active {
    cursor: grabbing;
  }

  .steve-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font-size: 0.875rem;
    transition: opacity 0.3s;
  }

  .steve-loading.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .steve-loading-spinner {
    width: 32px;
    height: 32px;
    border: 3px solid rgba(124, 200, 74, 0.3);
    border-top-color: #7cc84a;
    border-radius: 50%;
    animation: steveSpin 0.8s linear infinite;
  }

  @keyframes steveSpin {
    to { transform: rotate(360deg); }
  }

  .steve-controls {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .steve-anim-row,
  .steve-action-row {
    display: flex;
    gap: 0.375rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .steve-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text, #e6e6f2);
    background: rgba(28, 28, 52, 0.8);
    border: 1px solid var(--line, #2e2e4a);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
  }

  .steve-btn:hover {
    background: rgba(124, 200, 74, 0.15);
    border-color: var(--grass-2, #7cc84a);
  }

  .steve-btn.active {
    background: var(--grass, #5fa838);
    color: #fff;
    border-color: var(--grass-3, #3d7521);
  }

  .steve-btn-ghost {
    padding: 0.375rem 0.75rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-2, #b8b8d0);
    background: transparent;
    border: 1px solid var(--line, #2e2e4a);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
  }

  .steve-btn-ghost:hover {
    border-color: var(--grass-2, #7cc84a);
    color: var(--grass-2, #7cc84a);
  }

  .steve-btn-ghost.active {
    background: rgba(124, 200, 74, 0.15);
    color: var(--grass-2, #7cc84a);
  }

  .steve-skin-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
  }

  .steve-skin-label {
    font-size: 0.75rem;
    color: var(--text-2, #b8b8d0);
  }

  .steve-skin-select {
    background: rgba(28, 28, 52, 0.8);
    color: var(--text, #e6e6f2);
    border: 1px solid var(--line, #2e2e4a);
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-family: inherit;
    cursor: pointer;
  }

  .steve-custom-row {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.5rem;
    background: rgba(28, 28, 52, 0.5);
    border: 1px dashed var(--line, #2e2e4a);
    border-radius: 6px;
  }

  .steve-custom-row[hidden] {
    display: none;
  }

  .steve-file-input,
  .steve-text-input {
    background: rgba(13, 13, 24, 0.8);
    color: var(--text, #e6e6f2);
    border: 1px solid var(--line, #2e2e4a);
    border-radius: 4px;
    padding: 0.375rem 0.5rem;
    font-size: 0.75rem;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
  }

  .steve-file-input::file-selector-button {
    background: var(--grass, #5fa838);
    color: #fff;
    border: none;
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    margin-left: 0.25rem;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.7rem;
  }

  .steve-text-input:focus {
    outline: none;
    border-color: var(--grass-2, #7cc84a);
  }

  .steve-custom-hint {
    font-size: 0.65rem;
    color: var(--text-3, #8585a3);
    margin: 0;
    line-height: 1.4;
  }

  .steve-custom-row > .steve-btn {
    align-self: flex-start;
    margin-top: 0.25rem;
  }

  @media (max-width: 640px) {
    .steve-canvas-wrap {
      max-height: 350px;
    }
    .steve-btn,
    .steve-btn-ghost {
      font-size: 0.6875rem;
      padding: 0.3rem 0.5rem;
    }
  }
</style>

<script>
  import { SkinViewer, IdleAnimation, WalkingAnimation, RunningAnimation } from 'skinview3d';

  let viewer = null;
  let currentAnim = 'idle';

  function initSteveViewer() {
    const canvas = document.getElementById('steveCanvas');
    const loading = document.getElementById('steveLoading');
    if (!canvas) return;

    // Already initialized?
    if (viewer) return;

    try {
      viewer = new SkinViewer({
        canvas: canvas,
        width: canvas.clientWidth || 400,
        height: canvas.clientHeight || 500,
        skin: 'steve.png'.startsWith('http')
          ? 'steve.png'
          : (import.meta.env.BASE_URL || '/') + 'textures/steve.png',
      });

      // Default animation: idle
      viewer.animation = new IdleAnimation();
      viewer.autoRotate = true;
      viewer.autoRotateSpeed = 0.5;

      // Hide loading indicator
      if (loading) loading.classList.add('hidden');

      // Wire up animation buttons
      const animButtons = document.querySelectorAll('.steve-btn[data-anim]');
      animButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const anim = btn.dataset.anim;
          currentAnim = anim;
          animButtons.forEach((b) => b.classList.toggle('active', b === btn));
          if (viewer) {
            if (anim === 'idle') viewer.animation = new IdleAnimation();
            else if (anim === 'walk') viewer.animation = new WalkingAnimation();
            else if (anim === 'run') viewer.animation = new RunningAnimation();
          }
        });
      });

      // Auto-rotate toggle
      const rotateBtn = document.getElementById('steveRotate');
      if (rotateBtn) {
        rotateBtn.classList.add('active');
        rotateBtn.addEventListener('click', () => {
          if (!viewer) return;
          viewer.autoRotate = !viewer.autoRotate;
          rotateBtn.classList.toggle('active', viewer.autoRotate);
        });
      }

      // Reset view
      const resetBtn = document.getElementById('steveReset');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (!viewer) return;
          viewer.camera.position.set(15, 20, 30);
          viewer.controls.target.set(0, 12, 0);
          viewer.controls.update();
        });
      }

      // Skin selector
      const skinSelect = document.getElementById('steveSkin');
      const customRow = document.getElementById('steveCustomRow');
      const usernameRow = document.getElementById('steveUsernameRow');
      const urlRow = document.getElementById('steveUrlRow');
      if (skinSelect) {
        skinSelect.addEventListener('change', async () => {
          if (!viewer) return;
          const skin = skinSelect.value;
          const BASE = import.meta.env.BASE_URL || '/';
          // Hide all custom rows first
          if (customRow) customRow.hidden = true;
          if (usernameRow) usernameRow.hidden = true;
          if (urlRow) urlRow.hidden = true;

          if (skin === 'steve') {
            await viewer.loadSkin(BASE + 'textures/steve.png');
          } else if (skin === 'alex') {
            await viewer.loadSkin(BASE + 'textures/alex.png');
          } else if (skin === 'custom') {
            if (customRow) customRow.hidden = false;
          } else if (skin === 'username') {
            if (usernameRow) usernameRow.hidden = false;
          } else if (skin === 'url') {
            if (urlRow) urlRow.hidden = false;
          }
        });
      }

      // File upload (reads as Data URL, loads into viewer)
      const skinFile = document.getElementById('steveSkinFile');
      if (skinFile) {
        skinFile.addEventListener('change', (e) => {
          if (!viewer) return;
          const file = e.target.files && e.target.files[0];
          if (!file) return;
          if (!file.type.startsWith('image/')) {
            alert('فقط فایل تصویری (PNG) قابل قبوله');
            return;
          }
          if (file.size > 200 * 1024) {
            alert('فایل خیلی بزرگه (بیشتر از ۲۰۰KB). فقط پوسته‌ی استاندارد ۶۴×۶۴ رو آپلود کن.');
            return;
          }
          const reader = new FileReader();
          reader.onload = (ev) => {
            viewer.loadSkin(ev.target.result).catch((err) => {
              alert('خطا در بارگذاری پوسته: ' + err.message);
            });
          };
          reader.readAsDataURL(file);
        });
      }

      // Username input (Crafatar API fetches the skin texture)
      const usernameBtn = document.getElementById('steveUsernameBtn');
      const usernameInput = document.getElementById('steveUsernameInput');
      if (usernameBtn && usernameInput) {
        usernameBtn.addEventListener('click', async () => {
          if (!viewer) return;
          const username = usernameInput.value.trim();
          if (!username) {
            alert('نام کاربری رو وارد کن');
            return;
          }
          usernameBtn.textContent = 'در حال بارگذاری…';
          usernameBtn.disabled = true;
          try {
            // Crafatar serves the skin texture at this endpoint
            const skinUrl = 'https://crafatar.com/skins/' + encodeURIComponent(username);
            await viewer.loadSkin(skinUrl);
          } catch (err) {
            alert('پوسته پیدا نشد. آیا نام کاربری درسته؟ (این کاربر شاید حساب Minecraft نداره)');
          } finally {
            usernameBtn.textContent = 'دریافت';
            usernameBtn.disabled = false;
          }
        });
        // Submit on Enter
        usernameInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') usernameBtn.click();
        });
      }

      // URL input
      const urlBtn = document.getElementById('steveUrlBtn');
      const urlInput = document.getElementById('steveUrlInput');
      if (urlBtn && urlInput) {
        urlBtn.addEventListener('click', async () => {
          if (!viewer) return;
          const url = urlInput.value.trim();
          if (!url) {
            alert('URL رو وارد کن');
            return;
          }
          if (!/^https?:\/\//.test(url)) {
            alert('URL باید با http:// یا https:// شروع بشه');
            return;
          }
          urlBtn.textContent = 'در حال بارگذاری…';
          urlBtn.disabled = true;
          try {
            await viewer.loadSkin(url);
          } catch (err) {
            alert('خطا در بارگذاری URL: ' + err.message);
          } finally {
            urlBtn.textContent = 'بارگذاری';
            urlBtn.disabled = false;
          }
        });
        urlInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') urlBtn.click();
        });
      }

      // Download current skin (if it has a source URL or file, fetch + download)
      const downloadBtn = document.getElementById('steveDownload');
      if (downloadBtn) {
        downloadBtn.addEventListener('click', () => {
          if (!viewer) return;
          try {
            // skinview3d exposes the skin texture via viewer.skinCanvas or similar
            const canvas = viewer.skinCanvas;
            if (!canvas) {
              alert('دسترسی به تکسچر پوسته ممکن نیست.');
              return;
            }
            // Convert canvas to PNG and download
            canvas.toBlob((blob) => {
              if (!blob) return;
              const url = URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.href = url;
              a.download = 'minebed-skin.png';
              document.body.appendChild(a);
              a.click();
              a.remove();
              setTimeout(() => URL.revokeObjectURL(url), 1000);
            }, 'image/png');
          } catch (e) {
            alert('دانلود پوسته ناموفق بود: ' + e.message);
          }
        });
      }

      // Snapshot (save current canvas render as PNG)
      const snapshotBtn = document.getElementById('steveSnapshot');
      if (snapshotBtn) {
        snapshotBtn.addEventListener('click', () => {
          if (!viewer) return;
          try {
            const canvas = document.getElementById('steveCanvas');
            if (!canvas) return;
            canvas.toBlob((blob) => {
              if (!blob) return;
              const url = URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.href = url;
              a.download = 'steve-snapshot.png';
              document.body.appendChild(a);
              a.click();
              a.remove();
              setTimeout(() => URL.revokeObjectURL(url), 1000);
            }, 'image/png');
          } catch (e) {
            alert('عکس‌ گرفتن ناموفق بود: ' + e.message);
          }
        });
      }
    } catch (e) {
      console.error('SteveViewer init error:', e);
      if (loading) {
        loading.innerHTML = '<p style="color:#ff8b8b;margin:0;display:flex;align-items:center;gap:6px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-warning"/></svg> خطا در بارگذاری ۳D — مرورگر شما ممکنه قدیمی باشه</p>';
      }
    }
  }

  // Respect reduced motion
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSteveViewer);
    } else {
      initSteveViewer();
    }
    document.addEventListener('astro:page-load', initSteveViewer);
  } else {
    // Still init but disable auto-rotate
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initSteveViewer();
        if (viewer) viewer.autoRotate = false;
      });
    } else {
      initSteveViewer();
      if (viewer) viewer.autoRotate = false;
    }
  }
</script>
