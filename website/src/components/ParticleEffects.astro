---
/**
 * ParticleEffects.astro — Lightweight pixel particles (optimized for mobile)
 *
 * Performance optimizations:
 * - Reduced burst count: 30 → 12 (60% fewer DOM nodes per click)
 * - Reduced trail throttle: 30ms → 100ms (66% fewer trail particles)
 * - DISABLED on mobile (screen < 768px) — saves CPU + battery
 * - DISABLED on prefers-reduced-motion
 * - Removed `will-change` (was causing layer thrashing on long sessions)
 * - Cleanup timeout reduced 1.3s → 0.7s (frees DOM nodes sooner)
 * - Pause particles when tab is hidden (visibilitychange)
 * - Use passive listeners everywhere
 */
---

<div id="fxLayer" class="fx-layer" transition:persist></div>

<style>
  .fx-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9998;
    overflow: hidden;
  }

  .particle {
    position: absolute;
    width: 10px;
    height: 10px;
    image-rendering: pixelated;
    border: 1.5px solid rgba(0, 0, 0, 0.45);
    box-shadow: inset -1.5px -1.5px 0 rgba(0, 0, 0, 0.35),
                inset 1.5px 1.5px 0 rgba(255, 255, 255, 0.18);
    animation: particleBurst 0.7s cubic-bezier(0.15, 0.7, 0.35, 1) forwards;
    pointer-events: none;
  }

  @keyframes particleBurst {
    0% {
      transform: translate(0, 0) scale(1.2) rotate(0deg);
      opacity: 1;
    }
    40% {
      transform: translate(calc(var(--tx) * 0.6), calc(var(--ty) * 0.6)) scale(1) rotate(calc(var(--rot) * 0.4));
      opacity: 1;
    }
    100% {
      transform: translate(var(--tx), var(--ty)) scale(0.3) rotate(var(--rot));
      opacity: 0;
    }
  }

  .trail-particle {
    position: absolute;
    width: 6px;
    height: 6px;
    border: 1px solid rgba(0, 0, 0, 0.4);
    animation: trailFade 0.6s ease-out forwards;
    pointer-events: none;
  }

  @keyframes trailFade {
    0% { opacity: 0.9; transform: scale(1); }
    100% { opacity: 0; transform: scale(0.3) translateY(8px); }
  }

  /* On mobile + tablets: hide fx layer completely to save CPU + battery */
  @media (max-width: 900px), (prefers-reduced-motion: reduce) {
    .fx-layer { display: none !important; }
  }
</style>

<script>
  (function () {
    const fxLayer = document.getElementById('fxLayer');
    if (!fxLayer) return;

    // Skip on mobile / tablet / reduced motion
    const isMobile = window.matchMedia('(max-width: 900px)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (isMobile || reducedMotion) return;

    let paused = false;
    document.addEventListener('visibilitychange', () => {
      paused = document.hidden;
    });

    function getLayer() {
      // Avoid orphaning: if layer was wiped by view transition, return null
      return document.getElementById('fxLayer') || null;
    }

    const palette = [
      '#7bc55c', '#5cc44c', '#4aedd9', '#ff3b3b',
      '#17dd62', '#79553a', '#ffd142',
    ];

    // ─── Burst particles on click (reduced count for performance) ───
    function burstAt(x, y, count = 12) {
      if (paused) return;
      const layer = getLayer();
      if (!layer) return;

      // Cap concurrent particles to avoid runaway DOM growth
      if (layer.childElementCount > 80) return;

      for (let i = 0; i < count; i++) {
        const p = document.createElement('div');
        p.className = 'particle';
        p.style.left = x + 'px';
        p.style.top = y + 'px';
        p.style.background = palette[Math.floor(Math.random() * palette.length)];

        const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.4;
        const distance = 60 + Math.random() * 70;
        const tx = Math.cos(angle) * distance;
        const ty = Math.sin(angle) * distance - 20;

        p.style.setProperty('--tx', tx + 'px');
        p.style.setProperty('--ty', ty + 'px');
        p.style.setProperty('--rot', (Math.random() * 540 - 270) + 'deg');

        layer.appendChild(p);
        // Cleanup faster — 700ms matches animation duration
        setTimeout(() => p.remove(), 750);
      }
    }

    window.burstParticles = function (x, y, count) {
      burstAt(x, y, count);
    };

    // ─── Trail particles on mousemove (heavily throttled) ───
    let lastTrailTime = 0;
    function trailAt(x, y) {
      if (paused) return;
      const now = Date.now();
      // 100ms throttle (was 30ms) — 70% fewer trail particles
      if (now - lastTrailTime < 100) return;
      lastTrailTime = now;

      const layer = getLayer();
      if (!layer) return;
      if (layer.childElementCount > 50) return;

      const p = document.createElement('div');
      p.className = 'trail-particle';
      p.style.left = (x + (Math.random() - 0.5) * 6) + 'px';
      p.style.top = (y + (Math.random() - 0.5) * 6) + 'px';
      p.style.background = palette[Math.floor(Math.random() * palette.length)];
      layer.appendChild(p);
      setTimeout(() => p.remove(), 650);
    }

    function onBurst(e) {
      const x = e.touches ? e.touches[0].clientX : e.clientX;
      const y = e.touches ? e.touches[0].clientY : e.clientY;
      burstAt(x, y, 12);
    }

    function onTrail(e) {
      const x = e.touches ? e.touches[0].clientX : e.clientX;
      const y = e.touches ? e.touches[0].clientY : e.clientY;
      trailAt(x, y);
    }

    // Use passive listeners — improves scroll perf on touch devices
    document.addEventListener('click', onBurst, { passive: true });
    document.addEventListener('touchstart', onBurst, { passive: true });
    document.addEventListener('mousemove', onTrail, { passive: true });
    document.addEventListener('touchmove', onTrail, { passive: true });
  })();
</script>
