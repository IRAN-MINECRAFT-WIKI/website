---
/**
 * RelatedContent.astro — shows a "شاید برایت جالب باشد" (you might like)
 * section at the bottom of any content page.  Helps users stay on
 * the site longer (the user's explicit goal).
 *
 * Usage:
 *   <RelatedContent kind="blog" tags={post.data.tags} exclude={post.id} />
 *   <RelatedContent kind="wiki" tags={[]}/ exclude={wiki.id} />
 *   <RelatedContent kind="tutorial" tags={tut.data.tags} exclude={tut.id} />
 *
 * The component pulls related items from the same content collection
 * matching at least one tag, falling back to "most recent" if no tag
 * matches.
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  kind: 'blog' | 'wiki' | 'tutorials';
  tags?: string[];
  exclude?: string;
  limit?: number;
}

const { kind, tags = [], exclude = '', limit = 3 } = Astro.props;

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

// Fetch the whole collection once
let all: CollectionEntry<typeof kind>[] = [];
try {
  all = await getCollection(kind, ({ data }) => !(data as any).draft);
} catch {
  all = [];
}

// Exclude the current item
const candidates = all.filter((e) => e.id !== exclude);

// Score each candidate by tag overlap (1 point per shared tag)
const scored = candidates.map((e) => {
  const eTags = ((e.data as any).tags || []) as string[];
  const overlap = tags.filter((t) => eTags.includes(t)).length;
  return { entry: e, overlap, date: (e.data as any).pubDate?.valueOf() || 0 };
});

// Sort by overlap desc, then by date desc
scored.sort((a, b) => {
  if (a.overlap !== b.overlap) return b.overlap - a.overlap;
  return b.date - a.date;
});

// Take the top N (but only those with overlap > 0 if any exist)
const withOverlap = scored.filter((s) => s.overlap > 0);
const pickFrom = withOverlap.length > 0 ? withOverlap : scored;
const items = pickFrom.slice(0, limit);
---

{items.length > 0 && (
  <section class="related-content mt-12" aria-label="شاید برایت جالب باشد">
    <div class="related-head">
      <h2 class="related-title">
        <span class="related-icon">💡</span>
        شاید برایت جالب باشد
      </h2>
      <p class="related-sub">محتوای مرتبط — ادامه بده!</p>
    </div>

    <div class="related-grid">
      {items.map(({ entry }) => {
        const data = entry.data as any;
        const cover = data.cover || `${BASE}images/placeholder-${kind === 'blog' ? 'blog' : kind === 'wiki' ? 'blog' : 'tutorial'}.svg`;
        const title = data.title || entry.id;
        const description = data.description || '';
        const date = data.pubDate;
        const tags = (data.tags || []).slice(0, 2);
        return (
          <a href={base(`/${kind}/${entry.id}`)} class="related-card group">
            <div class="related-cover">
              <img
                src={cover}
                alt={title}
                loading="lazy"
                decoding="async"
                class="related-cover-img"
                onerror={`this.src='${BASE}images/placeholder-${kind === 'blog' ? 'blog' : 'tutorial'}.svg'`}
              />
            </div>
            <div class="related-body">
              <h3 class="related-card-title">{title}</h3>
              <p class="related-card-desc">{description}</p>
              {tags.length > 0 && (
                <div class="related-card-tags">
                  {tags.map((t: string) => (
                    <span class="related-tag">#{t}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}

<style>
  .related-content {
    border-top: 1px dashed var(--line);
    padding-top: 2rem;
  }

  .related-head {
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .related-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .related-icon {
    font-size: 1.25rem;
  }

  .related-sub {
    font-size: 0.875rem;
    color: var(--text-2);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    background: rgba(28, 28, 52, 0.6);
    border: 2px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .related-card:hover {
    border-color: var(--grass-2);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 16px rgba(124, 200, 74, 0.15);
  }

  .related-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(135deg, #1c1c34, #14142a);
  }

  .related-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .related-card:hover .related-cover-img {
    transform: scale(1.05);
  }

  .related-body {
    padding: 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .related-card-title {
    font-size: 0.9375rem;
    font-weight: 800;
    color: var(--text);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s;
  }

  .related-card:hover .related-card-title {
    color: var(--grass-2);
  }

  .related-card-desc {
    font-size: 0.75rem;
    color: var(--text-2);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .related-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }

  .related-tag {
    font-size: 0.6875rem;
    color: var(--grass-2);
    background: rgba(124, 200, 74, 0.08);
    border: 1px solid rgba(124, 200, 74, 0.2);
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
  }
</style>
