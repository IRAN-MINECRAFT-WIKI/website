---
/**
 * ItemSprite.astro — Minecraft item icon (uses REAL Minecraft textures)
 *
 * Renders a 16x16 PNG texture from /textures/items/ (or /textures/blocks/).
 * Falls back to pixel-art SVG sprite if no PNG exists for the item.
 *
 * Pattern from minecraft.wiki's `sprite-file` + `pixel-image` markup.
 *
 * Usage:
 *   <ItemSprite name="diamond" label="الماس" />
 *   <ItemSprite name="stick" label="چوب" href="/wiki/stick" />
 *   <ItemSprite name="stone" label="سنگ" type="block" />
 */
import '@components/pixel-sprites.astro';

interface Props {
  name: string;        // texture name (e.g., 'diamond', 'stick', 'stone')
  label: string;       // Persian text label
  href?: string;       // optional link
  size?: 'sm' | 'md' | 'lg';  // 16/24/32px
  type?: 'item' | 'block';  // which folder to look in (default: 'item')
}

const { name, label, href, size = 'md', type = 'item' } = Astro.props;
const pxSize = size === 'sm' ? 16 : size === 'lg' ? 32 : 24;
const folder = type === 'block' ? 'blocks' : 'items';
const BASE = import.meta.env.BASE_URL;
const textureUrl = `${BASE}textures/${folder}/${name}.png`;
// SVG fallback if PNG doesn't exist
const svgFallback = `px-${name}`;
---

<span class="sprite-file nowrap">
  <span class="pixel-image">
    <img
      src={textureUrl}
      alt={label}
      width={pxSize}
      height={pxSize}
      loading="lazy"
      decoding="async"
      class="pixel-img"
      onerror={`this.style.display='none'; this.nextElementSibling.style.display='inline-block';`}
    />
    <!-- SVG fallback (hidden by default, shown if PNG fails to load) -->
    <svg
      width={pxSize}
      height={pxSize}
      viewBox="0 0 16 16"
      shape-rendering="crispEdges"
      style="display: none; image-rendering: pixelated;"
    >
      <use href={`#${svgFallback}`} />
    </svg>
  </span>
  {
    href ? (
      <a href={href} class="sprite-text">{label}</a>
    ) : (
      <span class="sprite-text">{label}</span>
    )
  }
</span>

<style is:global>
  /* Pattern from minecraft.wiki: `sprite-file` + `pixel-image` */
  .sprite-file {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    vertical-align: middle;
    white-space: nowrap;
  }
  .sprite-file .pixel-image {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--grass-2, #7cc84a);
    flex-shrink: 0;
  }
  .sprite-file .pixel-img {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    -ms-interpolation-mode: nearest-neighbor;
    vertical-align: middle;
  }
  .sprite-file .sprite-text {
    color: inherit;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .sprite-file .sprite-text:hover {
    color: var(--grass-2, #7cc84a);
    text-decoration: underline;
  }
</style>
