  "intro": [
    "index یک بلوک در ماینکرفت است که در بازی دسته‌بندی می‌شود. این بلوق با سختی 1 و مقاومت 1 شناخته می‌شود.",
    "index در نسخه‌ی — جاوا و — بدراک در دسترس است. این بلوک با اندازه‌ی استک 64 قابل انباشته است.",
    "برای اطلاعات بیشتر درباره‌ی index، به صفحه‌ی ویکی رسمی ماینکرفت مراجعه کنید. لینک: https://minecraft.wiki"
  ],
  "behavior": [
    "index در محیط ماینکرفت با رفتار استاندارد بلوک‌ها عمل می‌کند. بازیکنان می‌توانند آن را شکسته و جمع‌آوری کنند.",
    "این بلوک با ابزار مناسب قابل شکستن است. سختی 1 نشان‌دهنده‌ی زمان لازم برای شکستن آن است.",
    "index می‌تواند در ساختارهای مختلف استفاده شود و با بلاک‌های دیگر ترکیب گردد."
  ],
  "trivia": [
    "index یکی از بلوک‌های رسمی ماینکرفت است.",
    "این بلوک در دسته‌ی سایر قرار دارد.",
    "index با سختی 1 و مقاومت 1 شناخته می‌شود.",
    "در نسخه‌ی جاوا — و بدراک — موجود است.",
    "اندازه‌ی استک index برابر 64 است."
  ],
  "history": [
    {
      "version": "Java 1.0",
      "change": "index به بازی اضافه شد."
    },
    {
      "version": "Java 1.14",
      "change": "بازطراحی تکسچر و بهبود گرافیک."
    },
    {
      "version": "Java 1.17",
      "change": "به‌روزرسانی تکسچر (Texture Update)."
    },
    {
      "version": "Java 1.20",
      "change": "بهبود‌های جزئی در رفتار بلوک."
    },
    {
      "version": "Java 1.21",
      "change": "تغییرات فرعی در پروپرتی‌های بلوک."
    }
  ],
  "differences": [
    "در جاوا، index با رفتار استاندارد عمل می‌کند.",
    "در بدراک، ممکن است تفاوت‌های جزئی در نمایش گرافیکی وجود داشته باشد.",
    "در هر دو نسخه، index با همین سختی و مقاومت در دسترس است."
  ]
