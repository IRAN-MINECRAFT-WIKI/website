---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { versions } from '@/lib/data';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'نسخه‌ها', url: '/versions' },
];
---

<BaseLayout
  path="/versions"
  title="راهنمای نسخه‌های ماینکرفت بدراک"
  description="راهنمای کامل نسخه‌های ماینکرفت بدراک: 1.21, 1.20, 1.19 و... هر نسخه با توضیحات کامل، ویژگی‌های جدید و افزونه‌های سازگار."
>
  <Breadcrumbs items={breadcrumb} />

  <div class="mb-6">
    <h1 class="text-2xl lg:text-3xl font-extrabold mb-2">راهنمای نسخه‌های ماینکرفت</h1>
    <p class="text-sm text-mc-text-2">{versions.length} نسخه ماینکرفت بدراک با توضیحات کامل</p>
  </div>

  <div class="space-y-4">
    {versions.map((v) => (
      <a href={base(`/versions/${v.id}`)} class="mc-panel hoverable group block p-5">
        <div class="flex items-start gap-4">
          <span class="text-4xl shrink-0">{v.icon}</span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 mb-1 flex-wrap">
              <h2 class="text-xl font-extrabold text-mc-text group-hover:text-mc-grass-2">{v.nameFa}</h2>
              {v.isLatest && (
                <span class="bg-mc-grass text-white text-[10px] font-pixel px-2 py-1">جدیدترین</span>
              )}
            </div>
            <p class="text-xs text-mc-text-3 mb-2">
              {v.releaseDate} • {v.codename}
            </p>
            <p class="text-sm text-mc-text-2 leading-relaxed mb-3 line-clamp-2">{v.summary}</p>
            <div class="flex flex-wrap gap-1.5">
              {v.highlights.slice(0, 3).map((h) => (
                <span class="text-[10px] bg-mc-bg-2 border border-mc-line px-2 py-0.5 text-mc-text-2">{h}</span>
              ))}
              <span class="text-[10px] text-mc-text-3">+ {v.highlights.length - 3} مورد دیگر</span>
            </div>
          </div>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
