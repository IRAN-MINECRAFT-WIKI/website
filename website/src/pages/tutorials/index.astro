---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'آموزش‌ها', url: '/tutorials' },
];

const tutorials = (await getCollection('tutorials', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const difficultyNames = {
  beginner: 'مقدماتی',
  intermediate: 'متوسط',
  advanced: 'پیشرفته',
};
const difficultyColors = {
  beginner: 'text-mc-grass-2',
  intermediate: 'text-mc-gold',
  advanced: 'text-mc-redstone',
};
---

<BaseLayout
  path="/tutorials"
  title="آموزش‌های ماینکرفت بدراک — از مقدماتی تا پیشرفته"
  description="آموزش‌های کامل ماینکرفت بدراک به فارسی: نصب افزونه، ردستون، فارم، ساحتم و ترفندهای حرفه‌ای."
>
  <Breadcrumbs items={breadcrumb} />

  <div class="mb-6">
    <h1 class="text-2xl lg:text-3xl font-extrabold mb-2">آموزش‌ها</h1>
    <p class="text-sm text-mc-text-2">{tutorials.length} آموزش از مقدماتی تا پیشرفته</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {tutorials.map((tut) => (
      <a href={base(`/tutorials/${tut.id}`)} class="mc-card group flex flex-col">
        <div class="aspect-video overflow-hidden bg-mc-panel-2">
          <img src={tut.data.cover || `${BASE}images/placeholder-tutorial.svg`} alt={tut.data.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform" onerror={`this.src='${BASE}images/placeholder-tutorial.svg'`} />
        </div>
        <div class="p-5 flex-1 flex flex-col">
          <div class="flex items-center gap-2 mb-2">
            <span class={`text-xs font-bold ${difficultyColors[tut.data.difficulty]}`}>
              {difficultyNames[tut.data.difficulty]}
            </span>
            <span class="text-xs text-mc-text-3">⏱️ {tut.data.duration} دقیقه</span>
          </div>
          <h2 class="text-lg font-extrabold text-mc-text group-hover:text-mc-grass-2 mb-2">{tut.data.title}</h2>
          <p class="text-xs text-mc-text-2 line-clamp-2 flex-1">{tut.data.description}</p>
        </div>
      </a>
    ))}
  </div>

  {tutorials.length === 0 && (
    <div class="mc-panel text-center py-12">
      <div class="text-5xl mb-4">📖</div>
      <h3 class="text-xl font-bold text-mc-text-2 mb-2">هنوز آموزشی نیست</h3>
      <p class="text-sm text-mc-text-3">به‌زودی آموزش‌های تخصصی اضافه می‌شه!</p>
    </div>
  )}
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
