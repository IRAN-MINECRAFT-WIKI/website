---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import BackButton from "@components/BackButton.astro";
import StructuredData from '@components/StructuredData.astro';
import RelatedContent from '@components/RelatedContent.astro';
import PrevNextNav from '@components/PrevNextNav.astro';
import { articleJsonLd, breadcrumbJsonLd, howToJsonLd } from '@/lib/seo';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

export async function getStaticPaths() {
  const tutorials = await getCollection('tutorials', ({ data }) => !data.draft);
  return tutorials.map((tut) => ({
    params: { slug: tut.id },
    props: { tut },
  }));
}

const { tut } = Astro.props as { tut: CollectionEntry<'tutorials'> };
const { Content } = await render(tut);
const coverUrl = (tut.data.cover || '').startsWith('http')
  ? tut.data.cover
  : base(tut.data.cover || '');

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'آموزش‌ها', url: '/tutorials' },
  { name: tut.data.title, url: base(`/tutorials/${tut.id}`) },
];

const ldArticle = articleJsonLd({
  title: tut.data.title,
  description: tut.data.description,
  image: coverUrl,
  datePublished: tut.data.pubDate.toISOString(),
  dateModified: (tut.data.modDate || tut.data.pubDate).toISOString(),
  authorName: tut.data.author,
  url: base(`/tutorials/${tut.id}`),
});
const ldBread = breadcrumbJsonLd(breadcrumb);
// HowTo schema — Google rewards this for tutorial pages
const ldHowTo = howToJsonLd({
  title: tut.data.title,
  description: tut.data.description,
  totalTime: `PT${tut.data.duration}M`,
  steps: [{ name: 'شروع', text: tut.data.description }],
  url: base(`/tutorials/${tut.id}`),
});
---

<BaseLayout
  path={`/tutorials/${tut.id}`}
  title={`${tut.data.title} — آموزش ماینکرفت`}
  description={tut.data.description}
  image={coverUrl}
  type="article"
>
  <Breadcrumbs items={breadcrumb} />
  <BackButton />
  <StructuredData data={ldArticle} />
  <StructuredData data={ldBread} />
  <StructuredData data={ldHowTo} />

  <article class="mc-panel p-5 lg:p-8">
    <header class="mb-6 pb-6 border-b border-mc-line">
      <div class="flex items-center gap-2 mb-3">
        <span class={`text-xs font-bold px-2 py-1 rounded-full ${
          tut.data.difficulty === 'beginner' ? 'bg-mc-grass-3/30 text-mc-grass-2 border border-mc-grass-3' :
          tut.data.difficulty === 'intermediate' ? 'bg-mc-gold/15 text-mc-gold border border-mc-gold/30' :
          'bg-mc-redstone/15 text-mc-redstone border border-mc-redstone/30'
        }`}>
          {tut.data.difficulty === 'beginner' ? 'مقدماتی' : tut.data.difficulty === 'intermediate' ? 'متوسط' : 'پیشرفته'}
        </span>
        <span class="text-xs text-mc-text-3 flex items-center gap-1">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {tut.data.duration} دقیقه
        </span>
      </div>
      <h1 class="text-2xl lg:text-4xl font-extrabold mb-2">{tut.data.title}</h1>
      <p class="text-sm text-mc-text-2 mb-3">{tut.data.description}</p>
      <div class="flex items-center gap-3 text-xs text-mc-text-3">
        <span>📅 {tut.data.pubDate.toLocaleDateString('fa-IR')}</span>
        <span>👤 {tut.data.author}</span>
      </div>
      {tut.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-3">
          {tut.data.tags.map((t) => <span class="mc-chip">#{t}</span>)}
        </div>
      )}
    </header>

    {tut.data.cover && (
      <img
        src={coverUrl}
        alt={tut.data.title}
        width="1280"
        height="720"
        loading="eager"
        decoding="async"
        class="w-full aspect-video object-cover mb-6"
      />
    )}

    <div class="prose prose-invert max-w-none">
      <Content />
    </div>
  </article>

  <PrevNextNav kind="tutorials" currentId={tut.id} />
  <RelatedContent kind="tutorials" tags={tut.data.tags} exclude={tut.id} />
</BaseLayout>
