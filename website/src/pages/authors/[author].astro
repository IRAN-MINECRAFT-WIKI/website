---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { mods } from '@/lib/data';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

export async function getStaticPaths() {
  const blog = await getCollection('blog', ({ data }) => !data.draft);
  const wiki = await getCollection('wiki', ({ data }) => !data.draft);
  const tutorials = await getCollection('tutorials', ({ data }) => !data.draft);

  const allAuthors = new Set<string>();

  [...blog, ...wiki, ...tutorials].forEach((entry) => {
    if (entry.data.author) allAuthors.add(entry.data.author);
  });

  // Add mod authors
  mods.forEach((m) => {
    if (m.author && m.author !== 'Unknown') allAuthors.add(m.author);
  });

  return Array.from(allAuthors).map((author) => ({
    params: { author: encodeURIComponent(author) },
    props: { author },
  }));
}

const { author } = Astro.props;
const decodedAuthor = decodeURIComponent(author);

const blog = (await getCollection('blog', ({ data }) => !data.draft && data.author === decodedAuthor)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const wiki = await getCollection('wiki', ({ data }) => !data.draft && data.author === decodedAuthor);
const tutorials = await getCollection('tutorials', ({ data }) => !data.draft && data.author === decodedAuthor);
const authorMods = mods.filter((m) => m.author === decodedAuthor);

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'سازنده‌ها', url: '/authors' },
  { name: decodedAuthor, url: `/authors/${decodedAuthor}` },
];
---

<BaseLayout
  path={`/authors/${decodedAuthor}`}
  title={`${decodedAuthor} — سازنده مود و محتوا | MineBed`}
  description={`همه‌ی محتوای ${decodedAuthor} در MineBed Farsi — مودها، مقالات و آموزش‌ها.`}
>
  <Breadcrumbs items={breadcrumb} />

  <div class="mb-6 flex items-center gap-4">
    <div class="w-16 h-16 rounded-full bg-mc-grass flex items-center justify-center text-3xl text-white font-bold border-4 border-mc-grass-3">
      {decodedAuthor.charAt(0).toUpperCase()}
    </div>
    <div>
      <h1 class="text-2xl lg:text-3xl font-extrabold mb-1">{decodedAuthor}</h1>
      <p class="text-sm text-mc-text-2">
        {blog.length + wiki.length + tutorials.length + authorMods.length} مورد منتشر شده
      </p>
    </div>
  </div>

  {authorMods.length > 0 && (
    <section class="mb-8">
      <h2 class="text-xl font-extrabold mb-4">مودها ({authorMods.length})</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {authorMods.map((mod) => (
          <a href={base(`/mods/${mod.id}`)} class="mc-panel hoverable group p-4">
            <div class="text-2xl mb-2">{mod.icon || '📦'}</div>
            <h3 class="font-bold text-sm text-mc-text group-hover:text-mc-grass-2 mb-1">{mod.nameFa || mod.name}</h3>
            <p class="text-xs text-mc-text-2 line-clamp-2">{mod.tagline}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {blog.length > 0 && (
    <section class="mb-8">
      <h2 class="text-xl font-extrabold mb-4">مقالات وبلاگ ({blog.length})</h2>
      <div class="space-y-3">
        {blog.map((post) => (
          <a href={base(`/blog/${post.id}`)} class="mc-panel hoverable group p-4 block">
            <h3 class="font-bold text-mc-text group-hover:text-mc-grass-2 mb-1">{post.data.title}</h3>
            <p class="text-xs text-mc-text-2 line-clamp-2">{post.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {wiki.length > 0 && (
    <section class="mb-8">
      <h2 class="text-xl font-extrabold mb-4">مقالات ویکی ({wiki.length})</h2>
      <div class="space-y-3">
        {wiki.map((entry) => (
          <a href={base(`/wiki/${entry.id}`)} class="mc-panel hoverable group p-4 block">
            <h3 class="font-bold text-mc-text group-hover:text-mc-grass-2 mb-1">{entry.data.title}</h3>
            <p class="text-xs text-mc-text-2 line-clamp-2">{entry.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {tutorials.length > 0 && (
    <section class="mb-8">
      <h2 class="text-xl font-extrabold mb-4">آموزش‌ها ({tutorials.length})</h2>
      <div class="space-y-3">
        {tutorials.map((tut) => (
          <a href={base(`/tutorials/${tut.id}`)} class="mc-panel hoverable group p-4 block">
            <h3 class="font-bold text-mc-text group-hover:text-mc-grass-2 mb-1">{tut.data.title}</h3>
            <p class="text-xs text-mc-text-2 line-clamp-2">{tut.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {blog.length + wiki.length + tutorials.length + authorMods.length === 0 && (
    <div class="mc-panel text-center py-12">
      <p class="text-mc-text-2">هنوز محتوایی منتشر نشده.</p>
    </div>
  )}
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
