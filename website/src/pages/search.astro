---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import SearchBox from '@components/SearchBox.astro';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'جستجو', url: '/search' },
];
---

<BaseLayout
  path="/search"
  title="جستجو در MineBed Farsi"
  description="جستجوی افزونه، سید، مقاله و آموزش ماینکرفت بدراک در MineBed Farsi"
  noindex={true}
>
  <Breadcrumbs items={breadcrumb} />

  <div class="mb-6">
    <h1 class="text-2xl lg:text-3xl font-extrabold mb-2">جستجو در سایت</h1>
    <p class="text-sm text-mc-text-2">هر چیزی از ماینکرفت بدراک که دنبالش هستی رو پیدا کن</p>
  </div>

  <div class="search-page-card">
    <p class="search-page-hint">
      روی دکمه‌ی جستجو در هدر کلیک کن (یا Ctrl+K رو بزن) تا جستجوی کامل سایت باز بشه.
      جستجو بین همه‌ی افزونه‌ها، مقالات، آموزش‌ها و سیدها رو شامل می‌شه.
    </p>
    <div class="search-page-cta">
      <button id="openSearchFromPage" class="mc-btn big">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <path d="M21 21l-4.35-4.35" />
        </svg>
        باز کردن جستجو
      </button>
      <span class="search-page-kbd">می‌تونی Ctrl + K رو هم بزنی</span>
    </div>
  </div>

  <!-- Include the unified SearchBox (provides modal + keyboard shortcut) -->
  <SearchBox />

  <!-- Auto-open the search modal on page load -->
  <script is:inline>
    document.addEventListener('astro:page-load', function () {
      // Small delay so the SearchBox script has time to bind
      setTimeout(function () {
        var btn = document.getElementById('searchOpen');
        if (btn) btn.click();
      }, 100);
    });
    // Also try on initial DOMContentLoaded
    document.addEventListener('DOMContentLoaded', function () {
      setTimeout(function () {
        var btn = document.getElementById('searchOpen');
        if (btn) btn.click();
      }, 200);
    });
  </script>
</BaseLayout>

<style>
  .search-page-card {
    background: var(--panel, #1c1c34);
    border: 2px solid var(--line, #2e2e4a);
    padding: 2rem 1.5rem;
    border-radius: 8px;
    text-align: center;
  }
  .search-page-hint {
    color: var(--text-2, #9a9ab8);
    font-size: 0.875rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 480px;
    margin-inline: auto;
  }
  .search-page-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .search-page-kbd {
    color: var(--text-3, #5c5c7a);
    font-size: 0.75rem;
  }
  .mc-btn.big {
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
  }
</style>
