      function show(name) {
        var isMap = name !== 'list';
        secMap.hidden = !isMap;
        secList.hidden = isMap;
        btns.forEach(function (b) {
          var on = b.dataset.tab === (isMap ? 'map' : 'list');
          b.classList.toggle('active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        var u = new URL(location.href);
        if (isMap) u.searchParams.delete('tab');
        else u.searchParams.set('tab', 'list');
        history.replaceState(null, '', u.toString());
        if (isMap) onMapShown();
      }

      btns.forEach(function (b) {
        b.addEventListener('click', function () { show(b.dataset.tab); });
      });

      var initial = new URL(location.href).searchParams.get('tab');
      show(initial === 'list' ? 'list' : 'map');
