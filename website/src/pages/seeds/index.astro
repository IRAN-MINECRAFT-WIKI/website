    function loadSeed(str, opts) {
      opts = opts || {};
      if (!engineReady) {
        showToast('موتور نقشه هنوز آماده نیست', true);
        return;
      }
      try {
        var big = engine.setSeed(String(str));
        state.seed = big;
        state.seedStr = String(str);
        slimeCache.clear();
        cache = null;
        genToken++;
        genInFlight = false;
        clearTimeout(overlayTimer);
        spawn = safeSpawn();
        if (opts.center) {
          state.cx = opts.center.x;
          state.cz = opts.center.z;
        } else if (spawn) {
          state.cx = spawn.x;
          state.cz = spawn.z;
        } else {
          state.cx = 0;
          state.cz = 0;
        }
        state.pin = opts.pin ? { x: opts.pin.x, z: opts.pin.z } : null;
