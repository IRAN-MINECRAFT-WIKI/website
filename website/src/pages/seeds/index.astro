    }

    function rebuildBiomeIndex() {
      biomeNameToId = new Map();
      var bn = engine && engine.biomeNames;
      if (bn && typeof bn.forEach === 'function') {
        bn.forEach(function (name, id) {
          biomeNameToId.set(String(name).toLowerCase(), id);
        });
      }
    }

    function availableStructIds() {
      if (!engine || !engine.structures) return [];
      return engine.structures.filter(function (s) {
        try { return engine.structureAvailableInVersion(s.id, state.versionLabel); }
        catch (e) { return false; }
      }).map(function (s) { return s.id; });
    }

    function applyInitialState() {
      var params = new URL(location.href).searchParams;

      // version
      var wanted = params.get('v') || '';
      var vers = (engine.versions && engine.versions.length) ? engine.versions : [];
      var chosen = null;
      for (var i = 0; i < vers.length; i++) {
        if (!wanted || String(vers[i].label).toLowerCase() === String(wanted).toLowerCase()) { chosen = vers[i]; break; }
      }
      if (!chosen) chosen = vers[0] || { label: '', fa: '' };
      state.versionLabel = String(chosen.label || '');
      try { engine.setVersion(state.versionLabel); } catch (e) { /* keep engine default */ }

      versionSelect.textContent = '';
      vers.forEach(function (v) {
        var opt = document.createElement('option');
        opt.value = v.label;
        opt.textContent = v.label + (v.fa ? ' — ' + v.fa : '');
        versionSelect.appendChild(opt);
      });
      versionSelect.value = state.versionLabel;

