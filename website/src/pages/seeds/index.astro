    /* ════════════════════ curated list tab ════════════════════ */

    function initCurated() {
      var chips = root.querySelectorAll('#seedChips .mc-chip');
      var items = root.querySelectorAll('#seedsGrid > [data-cat]');
      var verSel = $('versionFilter');
      var countEl = $('listCount');
      var emptyEl = $('listEmpty');
      if (!chips.length || !items.length) return;

      var curCat = 'all';
      var curVer = 'all';

      function apply() {
        var vis = 0;
        items.forEach(function (item) {
          var ok = (curCat === 'all' || item.dataset.cat === curCat) &&
                   (curVer === 'all' || item.dataset.ver === curVer);
          item.style.display = ok ? '' : 'none';
          if (ok) vis++;
        });
        if (countEl) countEl.textContent = faNum(vis);
        if (emptyEl) emptyEl.hidden = vis !== 0;
      }

      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          chips.forEach(function (c) { c.classList.remove('active'); });
          chip.classList.add('active');
          curCat = chip.dataset.cat;
          apply();
        });
      });
      if (verSel) {
        verSel.addEventListener('change', function () {
          curVer = verSel.value;
          apply();
        });
      }
      apply();
    }

    /* ════════════════════ engine lifecycle ════════════════════ */

    function startEngine() {
      if (engineStarted) return;
      engineStarted = true;
      engineLoading = true;
      showOverlay('loading');
      import(BASE + 'js/seedmap/engine.js').then(function (mod) {
        var Ctor = mod.SeedMapEngine || (mod.default && (mod.default.SeedMapEngine || mod.default)) || null;
        if (!Ctor || typeof Ctor.create !== 'function') throw new Error('bad engine module');
