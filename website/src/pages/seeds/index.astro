---
/**
 * /seeds — Seed Map tool page (Chunkbase-style) + curated seeds list.
 *
 * Tab 1 «نقشه سید»  — interactive canvas biome map (WASM engine from /js/seedmap/)
 * Tab 2 «سیدهای منتخب» — the original curated seeds UI (category chips + version filter + grid)
 *
 * Engine files are plain JS served from public/js/seedmap/ and loaded at runtime
 * with a dynamic import() prefixed by BASE (site is deployed under /website/).
 * All of the client logic lives in one is:inline script (no bundler processing)
 * so the runtime URLs resolve correctly under the base path.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { seeds } from '@/lib/data';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'سیدها', url: '/seeds' },
];

// ---------- Persian digits helper (frontmatter/static text only) ----------
const faDigits = '۰۱۲۳۴۵۶۷۸۹';
const faNumS = (n: number | string) => String(n).replace(/[0-9]/g, (d) => faDigits[Number(d)]);

// ---------- curated list data (unchanged behaviour, new tab) ----------
const catCounts = ['spawn', 'resources', 'structures', 'speedrun'].map((c) => ({
  id: c,
  count: seeds.filter((s) => s.category === c).length,
  name: {
    spawn: 'اسپاون',
    resources: 'منابع',
    structures: 'ساختارها',
    speedrun: 'اسپیدران',
  }[c] || c,
}));

const versions = Array.from(new Set(seeds.map((s) => s.version))).sort((a, b) => b.localeCompare(a));
const versionCounts = versions.map((v) => ({ id: v, count: seeds.filter((s) => s.version === v).length }));

// Letter badge (no emoji icons): first alphanumeric char of the seed code
const badgeLetter = (code: string) => {
  const m = String(code || '').match(/[a-z0-9]/i);
  return m ? m[0].toUpperCase() : '?';
};
---

<BaseLayout
  path="/seeds"
  title="نقشه سید ماینکرافت — ابزار جستجو و مشاهده بیوم‌ها | MineBed"
  description="نقشه سید ماینکرافت آنلاین: بیوم‌ها، دهکده‌ها، معادن و ساختارها را برای هر سیدی ببینید؛ با پیداکننده سید، بهترین سیدهای اسپاون را پیدا کنید یا از بین سیدهای منتخب و تست‌شده انتخاب کنید."
>
  <div id="seedmapRoot">
    <Breadcrumbs items={breadcrumb} />

    <!-- ── Page header ─────────────────────────────────────────────── -->
    <div class="mb-5">
      <h1 class="text-2xl lg:text-3xl font-extrabold mb-2">نقشه سید ماینکرافت</h1>
      <p class="text-sm text-mc-text-2">
        بیوم‌ها و ساختارهای هر سیدی را روی نقشه ببین، سید مناسب اسپاون پیدا کن یا از میان سیدهای منتخب انتخاب کن.
      </p>
    </div>

    <!-- ── Tabs ────────────────────────────────────────────────────── -->
    <nav class="seed-tabs" role="tablist" aria-label="بخش‌های ابزار سید">
      <button id="tabBtnMap" type="button" class="seed-tab active" data-tab="map" role="tab" aria-selected="true" aria-controls="tab-map">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-map" /></svg>
        نقشه سید
      </button>
      <button id="tabBtnList" type="button" class="seed-tab" data-tab="list" role="tab" aria-selected="false" aria-controls="tab-list">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-seed" /></svg>
        سیدهای منتخب
      </button>
    </nav>

    <!-- ══════════════════════════════════════════════════════════════
         TAB 1 — Seed Map
         ══════════════════════════════════════════════════════════════ -->
    <section id="tab-map" role="tabpanel" aria-labelledby="tabBtnMap">
      <!-- Toolbar -->
      <div class="mc-panel p-3 mb-4 flex flex-wrap items-center gap-2">
        <label for="seedInput" class="text-xs font-bold text-mc-text-3">سید:</label>
        <input
          id="seedInput"
          type="text"
          dir="ltr"
          class="sw-input flex-1 min-w-[170px] max-w-[270px] py-1.5 px-2 text-sm"
          placeholder="مثلاً 12345 یا MySeed"
          maxlength="64"
          autocomplete="off"
          spellcheck="false"
        />
        <label for="versionSelect" class="text-xs font-bold text-mc-text-3">نسخه:</label>
        <select id="versionSelect" class="sw-input py-1.5 px-2 text-xs max-w-[200px]" aria-label="نسخه تولید نقشه"></select>
        <button id="showMapBtn" type="button" class="mc-btn small">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-map" /></svg>
          نمایش نقشه
        </button>
        <button id="randomSeedBtn" type="button" class="mc-btn small ghost">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-dice" /></svg>
          سید تصادفی
        </button>
        <button id="finderOpenBtn" type="button" class="mc-btn small ghost">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-search" /></svg>
          پیدا کردن سید
        </button>
        <button id="copyLinkBtn" type="button" class="mc-btn small ghost">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-clipboard" /></svg>
          کپی لینک
        </button>
      </div>

      <!-- Map + legend -->
      <div class="map-layout">
        <!-- Main map column -->
        <div class="map-main">
          <div class="map-canvas-wrap mc-panel">
            <canvas
              id="seedCanvas"
              tabindex="0"
              role="application"
              aria-label="نقشه بیوم‌های ماینکرافت — با کشیدن جابه‌جا شو، با اسکرول یا دو انگشت زوم کن و برای اطلاعات هر نقطه کلیک کن"
            ></canvas>

            <!-- zoom buttons (bottom-left / LTR corner) -->
            <div class="zoom-btns">
              <button id="zoomIn" type="button" class="zoom-btn" aria-label="بزرگ‌نمایی نقشه" title="بزرگ‌نمایی">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
              </button>
              <button id="zoomOut" type="button" class="zoom-btn" aria-label="کوچک‌نمایی نقشه" title="کوچک‌نمایی">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /></svg>
              </button>
            </div>

            <!-- pin info card -->
            <div id="pinCard" class="pin-card" hidden>
              <div class="flex items-center justify-between gap-2 mb-1">
                <strong id="pinBiome" class="text-mc-grass-2 text-xs">بیوم</strong>
                <button id="pinClose" type="button" class="icon-btn" aria-label="بستن کارت مختصات">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><use href="#icon-close" /></svg>
                </button>
              </div>
              <div id="pinCoords" dir="ltr" class="pin-coords">X: ۰ · Z: ۰</div>
              <code id="pinTp" dir="ltr" class="pin-tp">/tp @s 0 ~ 0</code>
              <button id="pinCopy" type="button" class="mc-btn small w-full mt-2">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-command" /></svg>
                کپی مختصات
              </button>
            </div>

            <!-- async overlay: loading / progress / error -->
            <div id="mapOverlay" class="map-overlay">
              <div class="map-overlay-box">
                <div id="ovLoading">
                  <div class="ov-cube" aria-hidden="true"></div>
                  <p>در حال بارگذاری موتور نقشه…</p>
                </div>
                <div id="ovProgress" hidden>
                  <p>در حال تولید نقشه… <span id="ovPercent">۰٪</span></p>
                  <div class="map-progress-track"><div id="ovBar" class="map-progress-fill"></div></div>
                </div>
                <div id="ovError" hidden>
                  <p class="text-mc-redstone font-bold mb-1">خطا در تولید نقشه</p>
                  <p class="text-xs text-mc-text-2 mb-3">اتصال اینترنت یا مرورگر را بررسی کن.</p>
                  <button id="ovRetry" type="button" class="mc-btn small">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-refresh" /></svg>
                    تلاش مجدد
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- crosshair / scale info bar -->
          <div class="map-info-bar">
            <span class="info-item" dir="ltr" id="infoX">X: —</span>
            <span class="info-sep" aria-hidden="true">·</span>
            <span class="info-item" dir="ltr" id="infoZ">Z: —</span>
            <span class="info-sep" aria-hidden="true">·</span>
            <span class="info-item">بیوم: <span id="infoBiome">—</span></span>
            <span class="info-scale" id="infoScale">مقیاس: ۴ بلاک/پیکسل</span>
          </div>
        </div>

        <!-- Legend sidebar (right column on desktop, collapsible details on mobile) -->
        <aside class="map-legend">
          <details id="legendDetails" class="mc-panel legend-panel">
            <summary>
              <span class="inline-flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-biome" /></svg>
                راهنمای نقشه
              </span>
              <svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-chevron-left" /></svg>
            </summary>
            <div class="legend-body">
              <div>
                <div class="legend-sec-title">
                  <span>ساختارها</span>
                  <button id="structMaster" type="button" class="mc-chip chip-mini">هیچ</button>
                </div>
                <div id="legendStructs" class="chip-wrap"></div>
              </div>
              <div>
                <div class="legend-sec-title"><span>لایه‌ها</span></div>
                <div class="chip-wrap">
                  <button id="toggleTextures" type="button" class="struct-chip on" aria-pressed="true">
                    <span class="dot" style="background:#8fbf4d"></span>تکسچر بلاک‌ها
                  </button>
                  <button id="toggleSlime" type="button" class="struct-chip" aria-pressed="false">
                    <span class="dot" style="background:#6ee75a"></span>چانک‌های اسلایم
                  </button>
                  <button id="toggleGrid" type="button" class="struct-chip" aria-pressed="false">
                    <span class="dot" style="background:#9a9ab8"></span>شبکه چانک
                  </button>
                  <button id="toggleSpawn" type="button" class="struct-chip on" aria-pressed="true">
                    <span class="dot" style="background:#ffffff"></span>نشانگر اسپاون
                  </button>
                </div>
              </div>
              <div>
                <div class="legend-sec-title">
                  <span>ساختارهای اطراف</span>
                  <button id="goNearestBtn" type="button" class="mc-chip chip-mini" title="رفتن به نزدیک‌ترین ساختار فعال (حتی بیرون نقشه)">
                    برو به نزدیک‌ترین
                  </button>
                </div>
                <div id="nearbyStructs" class="nearby-list" role="list"></div>
                <span class="text-[10px] text-mc-text-3" id="nearbyHint"></span>
              </div>
              <div>
                <div class="legend-sec-title"><span>بیوم‌های پرکاربرد</span></div>
                <div id="legendBiomes" class="legend-biomes"></div>
              </div>
            </div>
          </details>
        </aside>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════
         TAB 2 — Curated seeds (original list, preserved)
         ══════════════════════════════════════════════════════════════ -->
    <section id="tab-list" role="tabpanel" aria-labelledby="tabBtnList" hidden>
      <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
        <h2 class="text-lg font-extrabold">سیدهای منتخب</h2>
        <div class="flex flex-wrap gap-2">
          <a href={base('/seeds/tested')} class="mc-btn small inline-flex items-center gap-1">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-potion" /></svg>
            سیدهای تست‌شده
          </a>
          <a href={base('/seeds/create')} class="mc-btn small ghost inline-flex items-center gap-1">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-dice" /></svg>
            ساخت سید
          </a>
          <a href={base('/seeds/my')} class="mc-btn small ghost inline-flex items-center gap-1">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-download" /></svg>
            سیدهای من
          </a>
        </div>
      </div>

      <!-- Filter toolbar -->
      <div class="mc-panel p-3 mb-5 flex flex-wrap items-center gap-3">
        <div class="flex flex-wrap gap-2" id="seedChips">
          <button type="button" class="mc-chip active" data-cat="all">همه ({faNumS(seeds.length)})</button>
          {catCounts.map((c) => (
            <button type="button" class="mc-chip" data-cat={c.id}>
              {c.name} ({faNumS(c.count)})
            </button>
          ))}
        </div>
        <div class="mr-auto flex flex-wrap items-center gap-3">
          <span class="text-xs text-mc-text-3">
            نمایش <span id="listCount" class="font-bold text-mc-grass-2">{faNumS(seeds.length)}</span> از {faNumS(seeds.length)} سید
          </span>
          <div class="flex items-center gap-2">
            <label for="versionFilter" class="text-xs text-mc-text-3 font-bold">نسخه:</label>
            <select id="versionFilter" class="sw-input text-xs py-1.5 px-2">
              <option value="all">همه نسخه‌ها</option>
              {versionCounts.map((v) => (
                <option value={v.id}>MC {v.id} ({faNumS(v.count)})</option>
              ))}
            </select>
          </div>
        </div>
      </div>

      <!-- Seeds grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="seedsGrid">
        {seeds.map((seed) => (
          <a href={base(`/seeds/${seed.id}`)} class="mc-card group flex flex-col" data-cat={seed.category} data-ver={seed.version}>
            <div class="p-5">
              <div class="flex items-start justify-between gap-2 mb-3">
                <span class={`seed-badge cat-${seed.category}`} aria-hidden="true">{badgeLetter(seed.code)}</span>
                {seed.featured && (
                  <span class="bg-mc-gold text-[#21160a] text-[10px] font-extrabold px-2 py-1 font-pixel">ویژه</span>
                )}
                {seed.isNew && !seed.featured && (
                  <span class="bg-mc-redstone text-white text-[10px] font-extrabold px-2 py-1 font-pixel">جدید</span>
                )}
              </div>
              <h3 class="text-lg font-extrabold text-mc-text group-hover:text-mc-grass-2 mb-1">{seed.nameFa}</h3>
              <p class="text-xs text-mc-text-2 mb-3 line-clamp-2">{seed.tagline}</p>
              <div class="bg-mc-bg-2 border-2 border-mc-line p-2 font-mono text-xs text-mc-diamond break-all" dir="ltr">
                {seed.code}
              </div>
              <div class="flex items-center justify-between gap-2 mt-3 pt-3 border-t border-mc-line text-xs">
                <span class="text-mc-text-3 inline-flex items-center gap-1"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-world"/></svg> {seed.biome || 'نامشخص'}</span>
                <span class="text-mc-text-3 inline-flex items-center gap-1"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><use href="#icon-star"/></svg> {seed.rating ?? '—'}</span>
                <span class="text-mc-text-3">MC {seed.version}</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div id="listEmpty" hidden class="mc-panel text-center text-sm text-mc-text-2 py-8 mt-4">
        سیدی با این فیلترها پیدا نشد — فیلترها را تغییر بده.
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════
         Finder drawer
         ══════════════════════════════════════════════════════════════ -->
    <div id="finderOverlay" class="finder-overlay" role="dialog" aria-modal="true" aria-labelledby="finderTitle">
      <div class="finder-backdrop" data-close-finder aria-hidden="true"></div>
      <div class="finder-panel mc-panel">
        <div class="flex items-start justify-between gap-3 mb-3">
          <div>
            <h2 id="finderTitle" class="text-lg font-extrabold flex items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-search" /></svg>
              پیدا کردن سید
            </h2>
            <p class="text-xs text-mc-text-2 mt-1 leading-5">
              سیدهایی پیدا کن که ساختارهای انتخابی را نزدیک اسپاون داشته باشند و بیوم اطراف اسپاون با انتخاب تو هم‌خوان باشد. جستجو از سید فعلی نقشه شروع می‌شود.
            </p>
          </div>
          <button id="finderClose" type="button" class="icon-btn" aria-label="بستن پنجره پیدا کردن سید">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><use href="#icon-close" /></svg>
          </button>
        </div>

        <div class="space-y-4">
          <div>
            <div class="finder-label">ساختارهای موردنظر</div>
            <div id="finderStructs" class="chip-wrap"></div>
          </div>
          <div>
            <div class="finder-label">بیوم اطراف اسپاون</div>
            <div id="finderBiomes" class="chip-wrap"></div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="finderRadius" class="finder-label">شعاع بیوم (بلاک)</label>
              <select id="finderRadius" class="sw-input w-full py-1.5 px-2 text-xs">
                <option value="256">۲۵۶ بلاک</option>
                <option value="512" selected>۵۱۲ بلاک</option>
                <option value="1024">۱۰۲۴ بلاک</option>
              </select>
            </div>
            <div>
              <label for="finderCount" class="finder-label">تعداد نتیجه</label>
              <select id="finderCount" class="sw-input w-full py-1.5 px-2 text-xs">
                <option value="1">۱ سید</option>
                <option value="3" selected>۳ سید</option>
                <option value="5">۵ سید</option>
                <option value="10">۱۰ سید</option>
              </select>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3 items-end">
            <div>
              <label for="finderMaxDist" class="finder-label">حداکثر فاصله ساختار (بلاک)</label>
              <input id="finderMaxDist" type="number" dir="ltr" min="0" step="50" value="800" class="sw-input w-full py-1.5 px-2 text-sm" />
            </div>
            <div>
              <div class="finder-label">نسخه موتور</div>
              <span id="finderVersion" class="finder-version" dir="ltr">—</span>
            </div>
          </div>

          <div class="flex gap-2">
            <button id="finderStart" type="button" class="mc-btn flex-1">شروع جستجو</button>
            <button id="finderStop" type="button" class="mc-btn danger flex-1 is-hidden">توقف</button>
          </div>

          <div id="finderProgress" hidden>
            <div class="flex items-center justify-between text-xs text-mc-text-2 mb-1">
              <span>بررسی‌شده: <span id="finderChecked" class="font-bold text-mc-text">۰</span> سید</span>
              <span>یافت‌شده: <span id="finderFound" class="font-bold text-mc-grass-2">۰</span></span>
            </div>
            <div class="finder-track" role="progressbar" aria-label="پیشرفت جستجوی سید">
              <div id="finderBar" class="finder-fill indeterminate"></div>
            </div>
          </div>

          <div>
            <div class="finder-label">نتایج</div>
            <div id="finderResults" class="finder-scroll" aria-live="polite">
              <p class="finder-hint">شرط‌ها را انتخاب کن و «شروع جستجو» را بزن.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- toast -->
    <div id="seedToast" class="toast-msg" role="status" aria-live="polite" hidden></div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ BASE }}>
  (function () {
    'use strict';

    /* ════════════════════ helpers ════════════════════ */

    var FA_DIGITS = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
    function toFa(s) {
      return String(s).replace(/[0-9]/g, function (d) { return FA_DIGITS[Number(d)]; });
    }
    function faNum(n) {
