---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import BackButton from "@components/BackButton.astro";
import StructuredData from '@components/StructuredData.astro';
import { articleJsonLd, breadcrumbJsonLd } from '@/lib/seo';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

export async function getStaticPaths() {
  const entries = await getCollection('wiki', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'wiki'> };
const { Content } = await render(entry);
const coverUrl = (entry.data.cover || '').startsWith('http')
  ? entry.data.cover
  : base(entry.data.cover || '');

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'ویکی', url: '/wiki' },
  { name: entry.data.title, url: base(`/wiki/${entry.id}`) },
];

const ldArticle = articleJsonLd({
  title: entry.data.title,
  description: entry.data.description,
  image: coverUrl,
  datePublished: entry.data.pubDate.toISOString(),
  dateModified: (entry.data.modDate || entry.data.pubDate).toISOString(),
  authorName: entry.data.author,
  url: base(`/wiki/${entry.id}`),
});
---

<BaseLayout
  path={`/wiki/${entry.id}`}
  title={`${entry.data.title} — ویکی ماینکرفت`}
  description={entry.data.description}
  image={coverUrl}
  type="article"
>
  <Breadcrumbs items={breadcrumb} />
  <BackButton />
  <StructuredData data={ldArticle} />

  <article class="mc-panel p-5 lg:p-8">
    <header class="mb-6 pb-6 border-b border-mc-line">
      <h1 class="text-2xl lg:text-4xl font-extrabold mb-2">{entry.data.title}</h1>
      <p class="text-sm text-mc-text-2 mb-3 leading-loose">{entry.data.description}</p>
      <div class="text-xs text-mc-text-3">
        📅 {entry.data.pubDate.toLocaleDateString('fa-IR')} • MC {entry.data.mcVersion}
      </div>
    </header>

    <div class="prose prose-invert max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
