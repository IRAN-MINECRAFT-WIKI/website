const totalItems = ITEM_CATEGORIES.reduce((sum, c) => sum + c.items.length, 0);

function textureExists(id: string): boolean {
  const p1 = path.resolve('./public/textures/items', `${id}.png`);
  const p2 = path.resolve('./public/textures/items', `${id.replace(/-/g, '_')}.png`);
  return fs.existsSync(p1) || fs.existsSync(p2);
}
---

<BaseLayout
  path="/wiki/items"
  title="لیست کامل آیتم‌های ماینکرفت — ویکی فارسی"
  description={`مرور کامل ${faNum(totalItems)}+ آیتم ماینکرفت در ${faNum(ITEM_CATEGORIES.length)} دسته: ابزارها، سلاح‌ها، غذاها، زره‌ها، پاتیل‌ها، مواد اولیه، رداستون، حمل‌ونقل، تزئینی و ویژه.`}
  type="website"
>
  <Breadcrumbs items={breadcrumb} />
  <StructuredData data={ldBread} />

  <header class="mc-panel p-5 lg:p-7 mb-5">
    <div class="flex items-center gap-3 mb-2 flex-wrap">
      <span class="text-3xl">⚔️</span>
      <h1 class="text-2xl lg:text-3xl font-extrabold">آیتم‌های ماینکرفت</h1>
      <span class="mc-chip text-xs">{faNum(totalItems)}+ آیتم</span>
    </div>
    <p class="text-sm text-mc-text-2 leading-loose">
      مرور کامل آیتم‌های ماینکرفت در <strong class="text-mc-grass-2">{faNum(ITEM_CATEGORIES.length)} دسته</strong>:
      ابزارها، سلاح‌ها، غذاها، زره‌ها، پاتیل‌ها، مواد اولیه، رداستون، حمل‌ونقل، تزئینی و ویژه.
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2 mt-4">
      {ITEM_CATEGORIES.map((cat) => (
        <a href={`#cat-${cat.id}`} class="cat-card" style={`--c:${cat.color}`}>
          <span class="cat-emoji">{cat.emoji}</span>
          <span class="cat-name">{cat.nameFa}</span>
          <span class="cat-count">{faNum(cat.items.length)} آیتم</span>
        </a>
      ))}
    </div>
  </header>

  {ITEM_CATEGORIES.map((cat) => (
    <section class="mc-panel p-5 mb-5" id={`cat-${cat.id}`}>
      <div class="flex items-center gap-3 mb-3 flex-wrap">
        <span class="text-2xl">{cat.emoji}</span>
        <h2 class="text-lg font-extrabold">{cat.nameFa}</h2>
        <span class="mc-chip text-xs">{faNum(cat.items.length)} آیتم</span>
        <span class="text-xs text-mc-text-3" style={`color: ${cat.color}`}>{cat.desc}</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2">
        {cat.items.map((item) => (
          <div class={`item-tile ${textureExists(item.id) ? '' : 'no-tex'}`}>
            {textureExists(item.id) ? (
              <img src={`${BASE}textures/items/${item.id}.png`} alt={item.nameFa} width="32" height="32" loading="lazy" class="pixel-img" onerror="this.style.display='none';" />
            ) : (
              <span class="item-emoji">📦</span>
            )}
            <div class="item-tile-name">{item.nameFa}</div>
            <div class="item-tile-en" dir="ltr">{item.id}</div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <div class="mc-panel p-4 text-center">
    <p class="text-xs text-mc-text-3 leading-loose">
      برای راهنمای کامل کاربرد هر آیتم، صفحه‌ی <a href={base('/wiki/items')} class="text-mc-grass-2 hover:underline">آیتم‌ها و کاربردها</a> رو ببین.
      برای محاسبه‌ی مواد لازم برای ساخت آیتم‌ها، از <a href={base('/calculator')} class="text-mc-grass-2 hover:underline">ماشین‌حساب کرافتینگ</a> استفاده کن.
    </p>
  </div>
</BaseLayout>

<style is:global>
  .cat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.75rem 0.5rem;
    background: rgba(13, 13, 24, 0.6);
    border: 2px solid var(--mc-line, #2e2e4a);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .cat-card:hover {
    border-color: var(--c);
    transform: translateY(-2px);
  }
  .cat-emoji { font-size: 1.5rem; }
  .cat-name { font-size: 0.75rem; font-weight: 700; color: var(--mc-text, #e6e6f2); }
  .cat-count { font-size: 0.65rem; color: var(--mc-text-3, #8585a3); }
  .item-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem;
    background: rgba(13, 13, 24, 0.5);
    border: 1px solid var(--mc-line, #2e2e4a);
    border-radius: 6px;
    transition: all 0.15s ease;
    text-align: center;
  }
  .item-tile:hover {
    border-color: var(--mc-grass-2, #7cc84a);
    background: rgba(124, 200, 74, 0.08);
  }
  .item-tile.no-tex { opacity: 0.7; }
  .item-tile img { image-rendering: pixelated; width: 32px; height: 32px; }
  .item-emoji { font-size: 1.5rem; line-height: 32px; height: 32px; }
  .item-tile-name { font-size: 0.7rem; font-weight: 600; color: var(--mc-text, #e6e6f2); line-height: 1.2; }
  .item-tile-en { font-size: 0.55rem; color: var(--mc-text-3, #8585a3); font-family: monospace; }
</style>
