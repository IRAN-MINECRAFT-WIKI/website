---
/**
 * /wiki/items — لیست کامل آیتم‌های ماینکرفت
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import StructuredData from '@components/StructuredData.astro';
import { breadcrumbJsonLd } from '@/lib/seo';
import fs from 'node:fs';
import path from 'node:path';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const breadcrumb = [
  { name: 'خانه', url: base('/') },
  { name: 'ویکی', url: base('/wiki') },
  { name: 'آیتم‌ها', url: base('/wiki/items') },
];
const ldBread = breadcrumbJsonLd(breadcrumb);

function faNum(n: number | string): string {
  const map = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
  return String(n).replace(/\d/g, (d) => map[+d]!);
}

