---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'ویکی', url: '/wiki' },
];

const entries = (await getCollection('wiki', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.title.localeCompare(b.data.title, 'fa')
);

// Group by topic
const topics: Record<string, typeof entries> = {};
entries.forEach((e) => {
  const t = e.data.topic;
  if (!topics[t]) topics[t] = [];
  topics[t].push(e);
});

const topicNames: Record<string, string> = {
  items: 'آیتم‌ها',
  blocks: 'بلوک‌ها',
  mobs: 'موجودات',
  mechanics: 'مکانیک‌ها',
  biomes: 'بیوم‌ها',
  structures: 'ساختارها',
};
---

<BaseLayout
  path="/wiki"
  title="ویکی فارسی ماینکرفت — راهنمای آیتم‌ها، بلوک‌ها و مکانیک‌ها"
  description="ویکی فارسی ماینکرفت بدراک: راهنمای کامل آیتم‌ها، بلوک‌ها، موجودات، بیوم‌ها، ساختارها و مکانیک‌های بازی."
>
  <Breadcrumbs items={breadcrumb} />

  <div class="mb-6">
    <h1 class="text-2xl lg:text-3xl font-extrabold mb-2">ویکی ماینکرفت</h1>
    <p class="text-sm text-mc-text-2">{entries.length} مقاله در {Object.keys(topics).length} دسته</p>
  </div>

  {Object.entries(topics).map(([topic, items]) => (
    <section class="mb-8">
      <h2 class="text-lg font-extrabold text-mc-gold mb-3">{topicNames[topic] || topic}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {items.map((entry) => (
          <a href={base(`/wiki/${entry.id}`)} class="mc-panel hoverable group p-4">
            <h3 class="font-bold text-mc-text group-hover:text-mc-grass-2 mb-1">{entry.data.title}</h3>
            <p class="text-xs text-mc-text-2 line-clamp-2">{entry.data.description}</p>
            <div class="text-[10px] text-mc-text-3 mt-2">MC {entry.data.mcVersion}</div>
          </a>
        ))}
      </div>
    </section>
  ))}

  {entries.length === 0 && (
    <div class="mc-panel text-center py-12">
      <div class="text-5xl mb-4">📚</div>
      <h3 class="text-xl font-bold text-mc-text-2 mb-2">هنوز مقاله‌ای نیست</h3>
      <p class="text-sm text-mc-text-3">به‌زودی مقاله‌های ویکی اضافه می‌شه!</p>
    </div>
  )}
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
