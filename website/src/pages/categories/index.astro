---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { categories, mods } from '@/lib/data';
import { breadcrumbJsonLd } from '@/lib/seo';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'دسته‌بندی‌ها', url: '/categories' },
];

const catCounts = categories.map((c) => ({
  ...c,
  count: mods.filter((m) => m.category === c.id).length,
}));

const ldBreadcrumb = breadcrumbJsonLd(breadcrumb);
---

<BaseLayout
  path="/categories"
  title="دسته‌بندی افزونه‌های ماینکرفت بدراک"
  description="دسته‌بندی کامل افزونه‌های ماینکرفت بدراک: گیم‌پلی، گرافیک، مپ، موجودات، دکوراسیون، دنیا و ابزار. همگی تست‌شده و رایگان."
>
  <script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
  <Breadcrumbs items={breadcrumb} />

  <div class="mb-6">
    <h1 class="text-2xl lg:text-3xl font-extrabold mb-2">دسته‌بندی‌ها</h1>
    <p class="text-sm text-mc-text-2">{categories.length} دسته متنوع از افزونه‌های ماینکرفت بدراک</p>
  </div>

  {/* 7 categories → use 4-col on large screens so the last row (3 items) doesn't have an orphan */}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {catCounts.map((cat) => (
      <a href={base(`/categories/${cat.id}`)} class="mc-panel hoverable group p-5 flex flex-col items-center text-center">
        <span class="text-5xl shrink-0 mb-3">{cat.icon}</span>
        <h2 class="text-lg font-extrabold text-mc-text group-hover:text-mc-grass-2 mb-1">
          {cat.name}
        </h2>
        <p class="text-xs text-mc-text-2 mb-3 line-clamp-2 leading-relaxed">{cat.description}</p>
        <span class="text-xs font-bold text-mc-grass-2 bg-mc-bg-2 border border-mc-line px-2 py-1 rounded-full">
          {cat.count} مود
        </span>
      </a>
    ))}
  </div>
</BaseLayout>
