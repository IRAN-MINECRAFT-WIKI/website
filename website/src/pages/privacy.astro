---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'حریم خصوصی', url: '/privacy' },
];
---

<BaseLayout
  path="/privacy"
  title="حریم خصوصی — MineBed Farsi"
  description="سیاست حریم خصوصی MineBed Farsi: چه اطلاعاتی از شما ذخیره می‌شود و چگونه استفاده می‌شود."
>
  <Breadcrumbs items={breadcrumb} />
  <article class="mc-panel p-6 prose prose-invert max-w-none">
    <h1>سیاست حریم خصوصی</h1>
    <p>آخرین به‌روزرسانی: آذر ۱۴۰۴</p>

    <h2>جمع‌آوری اطلاعات</h2>
    <p>
      ما به طور خودکار برخی اطلاعات فنی مانند آدرس IP، نوع مرورگر و صفحات
      مشاهده‌شده را برای تجزیه و تحلیل ترافیک جمع‌آوری می‌کنیم. این اطلاعات
      برای بهبود خدمات و رفع مشکلات سایت استفاده می‌شود.
    </p>

    <h2>کوکی‌ها</h2>
    <p>
      سایت ما از کوکی‌ها برای ذخیره‌ی ترجیحات کاربر (مانند تنظیمات زبان و
      مود پذیرفته‌شده) استفاده می‌کند. شما می‌توانید کوکی‌ها را از طریق
      تنظیمات مرورگر خود غیرفعال کنید.
    </p>

    <h2>تبلیغات</h2>
    <p>
      ما از شبکه‌های تبلیغاتی مثل Tapsell (Mediaad) و Microsoft Clarity
      استفاده می‌کنیم. این شبکه‌ها ممکن است اطلاعات کاربری را طبق سیاست
      حریم خصوصی خودشان جمع‌آوری کنند.
    </p>

    <h2>حقوق شما</h2>
    <p>
      شما حق دارید در مورد داده‌های خود سوال کنید، درخواست حذف کنید یا
      فعالیت تبلیغاتی را شخصی‌سازی کنید. برای این کار با ما از طریق
      تلگرام در ارتباط باشید.
    </p>

    <h2>تماس</h2>
    <p>
      برای هر گونه سوال درباره‌ی حریم خصوصی، از طریق <a href="https://t.me/MineBedWeb" target="_blank" rel="noopener">تلگرام</a> با ما تماس بگیرید.
    </p>
  </article>
</BaseLayout>
