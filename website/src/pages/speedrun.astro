---
/**
 * /speedrun — PaceMan.gg-style Speedrun leaderboard
 *
 * Phase 7 rebuild:
 *   - Stats bar (records / players / files / last-update) with Persian numerals
 *   - Filter bar: platform tabs + category dropdown + version dropdown +
 *     "فقط با سید" checkbox + player search + reset button
 *   - Server-side renders ALL 1,187 runs as a JSON blob; client-side
 *     filters + paginates + expands rows. No re-fetch from Speedrun.com.
 *   - Rank colors: 🏆 gold (#fcb32b), 🥈 silver (#c0c0c0), 🥉 bronze (#cd7f32)
 *   - Sticky header, hover highlight, click-row-to-expand details
 *   - Responsive: desktop = full grid table, tablet = hide seed+date,
 *     mobile (≤768px) = card layout per run
 *   - "بارگذاری بیشتر" button loads 50 more rows at a time (lazy pagination)
 *   - Empty state + loading state + result count
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import StructuredData from '@components/StructuredData.astro';
import { breadcrumbJsonLd } from '@/lib/seo';
import summary from '@/data/speedrun/summary.json';

// Import all 16 speedrun data files (Java + Bedrock)
import javaAnyGlitchless from '@/data/speedrun/java/any-glitchless.json';
import javaAny from '@/data/speedrun/java/any.json';
import javaAllAdv from '@/data/speedrun/java/all-advancements.json';
import javaSetSeed from '@/data/speedrun/java/set-seed.json';
import javaSetSeedGl from '@/data/speedrun/java/set-seed-glitchless.json';
import javaRandomSeed from '@/data/speedrun/java/random-seed.json';
import javaRandomSeedGl from '@/data/speedrun/java/random-seed-glitchless.json';
import bedrockAnyGlitchless from '@/data/speedrun/bedrock/any-glitchless.json';
import bedrockAny from '@/data/speedrun/bedrock/any.json';
import bedrockSetSeedSolo from '@/data/speedrun/bedrock/set-seed-solo.json';
import bedrockSetSeedCoop from '@/data/speedrun/bedrock/set-seed-coop.json';
import bedrockRandomSeedSolo from '@/data/speedrun/bedrock/random-seed-solo.json';
import bedrockRandomSeedCoop from '@/data/speedrun/bedrock/random-seed-coop.json';
import bedrock100 from '@/data/speedrun/bedrock/100.json';
import bedrockCoopAnyGl from '@/data/speedrun/bedrock/co-op-any-glitchless.json';
import bedrockCoopAny from '@/data/speedrun/bedrock/co-op-any.json';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

// ---------- Map of all 16 data files ----------
type RunFile = { runs: any[] };
const allFiles: Record<'java' | 'bedrock', Record<string, { meta: RunFile; label: string }>> = {
  java: {
    'any-glitchless': { meta: javaAnyGlitchless as RunFile, label: 'Any% Glitchless' },
    any: { meta: javaAny as RunFile, label: 'Any%' },
    'all-advancements': { meta: javaAllAdv as RunFile, label: 'All Advancements' },
    'set-seed': { meta: javaSetSeed as RunFile, label: 'Set Seed' },
    'set-seed-glitchless': { meta: javaSetSeedGl as RunFile, label: 'Set Seed Glitchless' },
    'random-seed': { meta: javaRandomSeed as RunFile, label: 'Random Seed' },
    'random-seed-glitchless': { meta: javaRandomSeedGl as RunFile, label: 'Random Seed Glitchless' },
  },
  bedrock: {
    'any-glitchless': { meta: bedrockAnyGlitchless as RunFile, label: 'Any% Glitchless' },
    any: { meta: bedrockAny as RunFile, label: 'Any%' },
    'set-seed-solo': { meta: bedrockSetSeedSolo as RunFile, label: 'Set Seed Solo' },
    'set-seed-coop': { meta: bedrockSetSeedCoop as RunFile, label: 'Set Seed Coop' },
    'random-seed-solo': { meta: bedrockRandomSeedSolo as RunFile, label: 'Random Seed Solo' },
    'random-seed-coop': { meta: bedrockRandomSeedCoop as RunFile, label: 'Random Seed Coop' },
    '100': { meta: bedrock100 as RunFile, label: '100%' },
    'co-op-any-glitchless': { meta: bedrockCoopAnyGl as RunFile, label: 'Co-op Any% Glitchless' },
    'co-op-any': { meta: bedrockCoopAny as RunFile, label: 'Co-op Any%' },
  },
};

// ---------- Build unified run list per platform ----------
function buildRuns(platform: 'java' | 'bedrock') {
  const files = allFiles[platform];
  const runs: any[] = [];
  for (const [catSlug, file] of Object.entries(files)) {
    const fileRuns = file.meta.runs || [];
    for (const r of fileRuns) {
      runs.push({
        id: r.id,
        player: (r.players || []).join(', '),
        players: r.players || [],
        time: r.time_primary || 0,
        timeDisplay: r.time_display || '',
        category: r.category || '',
        categorySlug: catSlug,
        categoryLabel: file.label,
        version: r.version || '',
        seed: r.seed || '',
        seedType: r.seed_type || '',
        date: r.date || '',
        weblink: r.weblink || '',
        verified: !!r.verified,
        platform,
      });
    }
  }
  // Sort by primary time ascending (fastest first)
  runs.sort((a, b) => a.time - b.time);
  return runs;
}

const javaRuns = buildRuns('java');
const bedrockRuns = buildRuns('bedrock');

// ---------- Aggregate stats ----------
const allPlayers = new Set<string>();
const allVersions = new Set<string>();
[...javaRuns, ...bedrockRuns].forEach((r) => {
  r.players.forEach((p: string) => allPlayers.add(p));
  if (r.version) allVersions.add(r.version);
});

// Sort versions newest-first by numeric components
const sortedVersions = Array.from(allVersions).sort((a, b) => {
  const av = a.split(/[.\-]/).map((n) => parseInt(n, 10) || 0);
  const bv = b.split(/[.\-]/).map((n) => parseInt(n, 10) || 0);
  for (let i = 0; i < Math.max(av.length, bv.length); i++) {
    const avv = av[i] || 0;
    const bvv = bv[i] || 0;
    if (avv !== bvv) return bvv - avv;
  }
  return a < b ? 1 : -1;
});

const totalRecords = javaRuns.length + bedrockRuns.length;
const totalPlayers = allPlayers.size;
const totalFiles = Object.keys(allFiles.java).length + Object.keys(allFiles.bedrock).length;
const lastUpdate = new Date(summary.fetched_at);

const faLastUpdate = lastUpdate.toLocaleDateString('fa-IR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const faRecords = totalRecords.toLocaleString('fa-IR');
const faPlayers = totalPlayers.toLocaleString('fa-IR');
const faFiles = totalFiles.toLocaleString('fa-IR');
const faJavaCount = javaRuns.length.toLocaleString('fa-IR');
const faBedrockCount = bedrockRuns.length.toLocaleString('fa-IR');

// Category dropdown options per platform
const javaCats = Object.entries(allFiles.java).map(([slug, f]) => ({ slug, label: f.label, count: (f.meta.runs || []).length }));
const bedrockCats = Object.entries(allFiles.bedrock).map(([slug, f]) => ({ slug, label: f.label, count: (f.meta.runs || []).length }));

// ---------- Embed JSON for client-side rendering ----------
// Escape </script>, <, >, &, U+2028/2029 so the JSON is safe inside a <script> tag.
function safeJson(json: string): string {
  return json
    .replace(/\\/g, '\\\\')
    .replace(/<\//g, '<\\/')
    .replace(/<!--/g, '<\\!--')
    .replace(/\u2028/g, '\\u2028')
    .replace(/\u2029/g, '\\u2029');
}

const javaRunsJSON = safeJson(JSON.stringify(javaRuns));
const bedrockRunsJSON = safeJson(JSON.stringify(bedrockRuns));
const catsJSON = safeJson(JSON.stringify({ java: javaCats, bedrock: bedrockCats }));
const versionsJSON = safeJson(JSON.stringify(sortedVersions));

// ---------- SEO / Breadcrumbs ----------
const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'سرعت‌رانی', url: '/speedrun' },
];
const ldBreadcrumb = breadcrumbJsonLd(breadcrumb);
---

<BaseLayout
  path="/speedrun"
  title="رکوردهای سرعت‌رانی ماینکرفت — Speedrun Leaderboard"
  description="۱٬۱۸۷ رکورد کامل سرعت‌رانی ماینکرفت Java و Bedrock از Speedrun.com — فیلتر بر اساس دسته، نسخه، پلتفرم و بازیکن، رتبه‌بندی زنده، جستجوی بازیکن."
>
  <StructuredData data={ldBreadcrumb} />
  <Breadcrumbs items={breadcrumb} />

  <!-- ===== Title ===== -->
  <div class="mb-6">
    <h1 class="text-2xl lg:text-3xl font-extrabold mb-2 flex items-center gap-3">
      <span class="text-3xl">🏆</span>
      <span>رکوردهای سرعت‌رانی ماینکرفت</span>
    </h1>
    <p class="text-sm text-mc-text-2">
      کامل‌ترین لیست رکوردهای Speedrun.com برای Java و Bedrock — هر شب ساعت ۳ بامداد ایران به‌روزرسانی می‌شه.
    </p>
  </div>

  <!-- ===== Stats bar (PaceMan.gg-style) ===== -->
  <div class="sr-stats mc-panel mb-6">
    <div class="sr-stats-grid">
      <div class="sr-stat">
        <div class="sr-stat-num text-mc-grass-2">{faRecords}</div>
        <div class="sr-stat-lbl">رکورد</div>
      </div>
      <div class="sr-stat">
        <div class="sr-stat-num text-mc-diamond">{faPlayers}</div>
        <div class="sr-stat-lbl">بازیکن</div>
      </div>
      <div class="sr-stat">
        <div class="sr-stat-num text-mc-gold">{faFiles}</div>
        <div class="sr-stat-lbl">فایل داده</div>
      </div>
      <div class="sr-stat">
        <div class="sr-stat-num text-mc-emerald">{sortedVersions.length.toLocaleString('fa-IR')}</div>
        <div class="sr-stat-lbl">نسخه</div>
      </div>
    </div>
    <div class="sr-stats-date">
      <span class="sr-stats-date-lbl">آخرین به‌روزرسانی:</span>
      <span class="sr-stats-date-val">{faLastUpdate}</span>
    </div>
  </div>

  <!-- ===== Platform tabs ===== -->
  <div class="sr-tabs" id="srTabs" role="tablist" aria-label="پلتفرم">
    <button class="mc-btn sr-tab active" data-platform="java" role="tab" aria-selected="true">
      <span class="sr-tab-icon">☕</span>
      <span class="sr-tab-label">Java Edition</span>
      <span class="sr-tab-cnt">{faJavaCount}</span>
    </button>
    <button class="mc-btn ghost sr-tab" data-platform="bedrock" role="tab" aria-selected="false">
      <span class="sr-tab-icon">📱</span>
      <span class="sr-tab-label">Bedrock Edition</span>
      <span class="sr-tab-cnt">{faBedrockCount}</span>
    </button>
  </div>

  <!-- ===== Filter bar ===== -->
  <div class="mc-panel sr-filters mb-4">
    <div class="sr-filters-row">
      <div class="sr-search-wrap">
        <input
          type="search"
          id="srSearch"
          placeholder="جستجو بر اساس نام بازیکن…"
          class="sr-search"
          autocomplete="off"
          aria-label="جستجوی بازیکن"
        />
        <span class="sr-search-icon" aria-hidden="true">
          <svg width="16" height="16"><use href="#icon-search" /></svg>
        </span>
      </div>
      <select id="srCategory" class="sr-select" aria-label="دسته‌بندی">
        <option value="all">همه دسته‌ها</option>
      </select>
      <select id="srVersion" class="sr-select" aria-label="نسخه بازی">
        <option value="all">همه نسخه‌ها</option>
      </select>
      <label class="sr-checkbox">
        <input type="checkbox" id="srSeedOnly" />
        <span class="sr-checkbox-box"></span>
        <span class="sr-checkbox-lbl">فقط با سید</span>
      </label>
      <button id="srReset" class="mc-btn ghost small sr-reset" title="پاک کردن فیلترها" aria-label="پاک کردن فیلترها">
        <span aria-hidden="true">↺</span>
        <span class="sr-reset-lbl">بازنشانی</span>
      </button>
    </div>
  </div>

  <!-- ===== Loading state (shown until JS init) ===== -->
  <div id="srLoading" class="sr-loading mc-panel">
    <div class="sr-spinner" aria-hidden="true"></div>
    <p class="sr-loading-text">در حال بارگذاری رکوردها…</p>
  </div>

  <!-- ===== Results board ===== -->
  <div id="srResults" class="sr-results hidden">
    <!-- Result count line -->
    <div class="sr-result-count" id="srResultCount" aria-live="polite"></div>

    <!-- Sticky header (desktop ≥769px) -->
    <div class="sr-board mc-panel" id="srBoard">
      <div class="sr-grid sr-grid-header" role="row" aria-hidden="true">
        <div class="sr-c-rank">رتبه</div>
        <div class="sr-c-player">بازیکن</div>
        <div class="sr-c-time">زمان</div>
        <div class="sr-c-cat">دسته</div>
        <div class="sr-c-ver">نسخه</div>
        <div class="sr-c-seed">سید</div>
        <div class="sr-c-date">تاریخ</div>
        <div class="sr-c-link">لینک</div>
      </div>
      <!-- Runs list — rendered by JS -->
      <div id="srList" class="sr-list" role="rowgroup"></div>
    </div>

    <!-- Load more button -->
    <div class="sr-loadmore-wrap" id="srLoadMoreWrap">
      <button class="mc-btn sr-loadmore" id="srLoadMore">
        <span aria-hidden="true">▼</span>
        <span>بارگذاری بیشتر</span>
        <span class="sr-loadmore-cnt" id="srLoadMoreCnt"></span>
      </button>
    </div>
  </div>

  <!-- ===== Empty state ===== -->
  <div id="srEmpty" class="sr-empty mc-panel hidden">
    <div class="text-5xl mb-4 text-mc-text-3">🔍</div>
    <h3 class="text-xl font-bold text-mc-text-2 mb-2">هیچ رکوردی پیدا نشد</h3>
    <p class="text-sm text-mc-text-3">فیلتر یا جستجوی دیگری امتحان کن یا فیلترها رو پاک کن.</p>
    <button class="mc-btn small mt-4" id="srEmptyReset">پاک کردن فیلترها</button>
  </div>

  <!-- ===== Hidden JSON data ===== -->
  <script type="application/json" id="sr-data-java" set:html={javaRunsJSON} />
  <script type="application/json" id="sr-data-bedrock" set:html={bedrockRunsJSON} />
  <script type="application/json" id="sr-data-cats" set:html={catsJSON} />
  <script type="application/json" id="sr-data-versions" set:html={versionsJSON} />
</BaseLayout>

<script is:inline>
  (function () {
    'use strict';

    // ---------- Helpers ----------
    var FA_DIGITS = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
    function faNum(n) {
      return String(n).replace(/[0-9]/g, function (d) {
        return FA_DIGITS[+d];
      });
    }
    function faNumGrouped(n) {
      return n.toLocaleString('fa-IR');
    }
    function escapeHtml(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // ---------- State ----------
    var PAGE_SIZE = 50;
    var state = {
      platform: 'java',
      runs: [],
      filtered: [],
      visible: PAGE_SIZE,
      expanded: new Set(),
      search: '',
      category: 'all',
      version: 'all',
      seedOnly: false,
    };

    // ---------- DOM refs ----------
    var el = {};
    function cacheDom() {
      el.tabs = document.querySelectorAll('.sr-tab');
      el.tabsWrap = document.getElementById('srTabs');
      el.search = document.getElementById('srSearch');
      el.category = document.getElementById('srCategory');
      el.version = document.getElementById('srVersion');
      el.seedOnly = document.getElementById('srSeedOnly');
      el.reset = document.getElementById('srReset');
      el.emptyReset = document.getElementById('srEmptyReset');
      el.loading = document.getElementById('srLoading');
      el.results = document.getElementById('srResults');
      el.list = document.getElementById('srList');
      el.empty = document.getElementById('srEmpty');
      el.loadMore = document.getElementById('srLoadMore');
      el.loadMoreWrap = document.getElementById('srLoadMoreWrap');
      el.loadMoreCnt = document.getElementById('srLoadMoreCnt');
      el.resultCount = document.getElementById('srResultCount');
    }

    // ---------- Data load ----------
    function loadData() {
      var javaData = JSON.parse(document.getElementById('sr-data-java').textContent);
      var bedrockData = JSON.parse(document.getElementById('sr-data-bedrock').textContent);
      var cats = JSON.parse(document.getElementById('sr-data-cats').textContent);
      var versions = JSON.parse(document.getElementById('sr-data-versions').textContent);
      return { java: javaData, bedrock: bedrockData, cats: cats, versions: versions };
    }

    // ---------- Populate dropdowns ----------
    function populateCats(platform) {
      if (!el.category) return;
      var cats = data.cats[platform] || [];
      var html = '<option value="all">همه دسته‌ها (' + faNumGrouped(state.runs.length) + ')</option>';
      for (var i = 0; i < cats.length; i++) {
        var c = cats[i];
        if (c.count === 0) continue;
        html +=
          '<option value="' +
          escapeHtml(c.slug) +
          '">' +
          escapeHtml(c.label) +
          ' (' +
          faNumGrouped(c.count) +
          ')</option>';
      }
      el.category.innerHTML = html;
      el.category.value = 'all';
      state.category = 'all';
    }
    function populateVersions() {
      if (!el.version) return;
      var html = '<option value="all">همه نسخه‌ها (' + faNumGrouped(data.versions.length) + ')</option>';
      for (var i = 0; i < data.versions.length; i++) {
        var v = data.versions[i];
        html += '<option value="' + escapeHtml(v) + '">' + escapeHtml(v) + '</option>';
      }
      el.version.innerHTML = html;
      el.version.value = 'all';
      state.version = 'all';
    }

    // ---------- Filtering ----------
    function applyFilters() {
      var q = state.search.trim().toLowerCase();
      var cat = state.category;
      var ver = state.version;
      var seed = state.seedOnly;
      state.filtered = state.runs.filter(function (r) {
        if (q && r.player.toLowerCase().indexOf(q) === -1) return false;
        if (cat !== 'all' && r.categorySlug !== cat) return false;
        if (ver !== 'all' && r.version !== ver) return false;
        if (seed && !r.seed) return false;
        return true;
      });
      state.visible = PAGE_SIZE;
      state.expanded.clear();
      render();
    }

    // ---------- Render ----------
    function rankBadge(rank) {
      if (rank === 1) return '<span class="sr-rank-medal sr-rank-gold">🏆</span>';
      if (rank === 2) return '<span class="sr-rank-medal sr-rank-silver">🥈</span>';
      if (rank === 3) return '<span class="sr-rank-medal sr-rank-bronze">🥉</span>';
      return '';
    }
    function rankClass(rank) {
      if (rank === 1) return 'sr-rank-1';
      if (rank === 2) return 'sr-rank-2';
      if (rank === 3) return 'sr-rank-3';
      return '';
    }

    function rowHtml(r, rank, idx) {
      var medal = rankBadge(rank);
      var rcls = rankClass(rank);
      var seedCell = r.seed
        ? '<span class="sr-seed-val" dir="ltr" title="' + escapeHtml(r.seed) + '">' + escapeHtml(r.seed) + '</span>'
        : '<span class="sr-seed-empty">—</span>';
      var linkCell = r.weblink
        ? '<a href="' + escapeHtml(r.weblink) + '" target="_blank" rel="noopener" class="sr-ext-link" aria-label="مشاهده در Speedrun.com" onclick="event.stopPropagation();">↗</a>'
        : '<span class="sr-seed-empty">—</span>';
      var expanded = state.expanded.has(idx);
      var expandIcon = expanded ? '▲' : '▼';
      var players = escapeHtml(r.player);
      var catBadge = '<span class="sr-cat-badge">' + escapeHtml(r.categoryLabel) + '</span>';
      var verBadge = r.version
        ? '<span class="sr-ver-badge" dir="ltr">' + escapeHtml(r.version) + '</span>'
        : '<span class="sr-seed-empty">—</span>';
      var dateCell = r.date
        ? '<span class="sr-date-val" dir="ltr">' + escapeHtml(r.date) + '</span>'
        : '<span class="sr-seed-empty">—</span>';

      var html =
        '<div class="sr-row-wrap' + (expanded ? ' sr-row-expanded' : '') + '" data-idx="' + idx + '" role="row">';
      html +=
        '<button class="sr-grid sr-row ' +
        rcls +
        '" data-idx="' +
        idx +
        '" type="button" aria-expanded="' +
        expanded +
        '">';
      html += '<div class="sr-c-rank">' + medal + '<span class="sr-rank-num">' + faNum(rank) + '</span></div>';
      html += '<div class="sr-c-player">' + players + '</div>';
      html += '<div class="sr-c-time" dir="ltr">' + escapeHtml(r.timeDisplay) + '</div>';
      html += '<div class="sr-c-cat">' + catBadge + '</div>';
      html += '<div class="sr-c-ver">' + verBadge + '</div>';
      html += '<div class="sr-c-seed">' + seedCell + '</div>';
      html += '<div class="sr-c-date">' + dateCell + '</div>';
      html += '<div class="sr-c-link">' + linkCell + '</div>';
      html += '<div class="sr-c-expand" aria-hidden="true">' + expandIcon + '</div>';
      html += '</button>';

      // Detail panel (shown when expanded)
      html += '<div class="sr-detail' + (expanded ? '' : ' hidden') + '" data-detail-for="' + idx + '">';
      html += '<div class="sr-detail-grid">';
      html +=
        '<div class="sr-detail-item"><span class="sr-detail-lbl">بازیکن</span><span class="sr-detail-val">' +
        players +
        '</span></div>';
      html +=
        '<div class="sr-detail-item"><span class="sr-detail-lbl">دسته</span><span class="sr-detail-val">' +
        escapeHtml(r.categoryLabel) +
        '</span></div>';
      html +=
        '<div class="sr-detail-item"><span class="sr-detail-lbl">نسخه</span><span class="sr-detail-val" dir="ltr">' +
        escapeHtml(r.version || '—') +
        '</span></div>';
      html +=
        '<div class="sr-detail-item"><span class="sr-detail-lbl">سید</span><span class="sr-detail-val sr-detail-seed" dir="ltr">' +
        (r.seed ? escapeHtml(r.seed) : '—') +
        '</span></div>';
      html +=
        '<div class="sr-detail-item"><span class="sr-detail-lbl">نوع سید</span><span class="sr-detail-val">' +
        escapeHtml(r.seedType || '—') +
        '</span></div>';
      html +=
        '<div class="sr-detail-item"><span class="sr-detail-lbl">تاریخ</span><span class="sr-detail-val" dir="ltr">' +
        escapeHtml(r.date || '—') +
        '</span></div>';
      html +=
        '<div class="sr-detail-item"><span class="sr-detail-lbl">زمان</span><span class="sr-detail-val sr-detail-time" dir="ltr">' +
        escapeHtml(r.timeDisplay) +
        '</span></div>';
      html +=
        '<div class="sr-detail-item"><span class="sr-detail-lbl">وضعیت</span><span class="sr-detail-val">' +
        (r.verified ? '✅ تأیید شده' : '⏳ در انتظار') +
        '</span></div>';
      html += '</div>';
      if (r.weblink) {
        html +=
          '<a href="' +
          escapeHtml(r.weblink) +
          '" target="_blank" rel="noopener" class="mc-btn small gold sr-detail-link">↗ مشاهده در Speedrun.com</a>';
      }
      html += '</div>';

      html += '</div>';
      return html;
    }

    function render() {
      // Build HTML for visible slice
      var total = state.filtered.length;
      var showCount = Math.min(state.visible, total);
      var html = '';
      for (var i = 0; i < showCount; i++) {
        var r = state.filtered[i];
        html += rowHtml(r, i + 1, i);
      }
      el.list.innerHTML = html;

      // Update result count
      var countText =
        'نمایش ' +
        faNumGrouped(showCount) +
        ' از ' +
        faNumGrouped(total) +
        ' رکورد' +
        (total !== state.runs.length ? ' (از ' + faNumGrouped(state.runs.length) + ' کل)' : '');
      el.resultCount.textContent = countText;

      // Load more button visibility + count
      if (showCount < total) {
        el.loadMoreWrap.classList.remove('hidden');
        var remaining = total - showCount;
        var next = Math.min(PAGE_SIZE, remaining);
        el.loadMoreCnt.textContent = '(' + faNumGrouped(next) + ' رکورد بعدی — ' + faNumGrouped(remaining) + ' باقی‌مانده)';
      } else {
        el.loadMoreWrap.classList.add('hidden');
      }

      // Empty state
      if (total === 0) {
        el.results.classList.add('hidden');
        el.empty.classList.remove('hidden');
      } else {
        el.results.classList.remove('hidden');
        el.empty.classList.add('hidden');
      }
    }

    // ---------- Event handlers ----------
    function switchTab(platform) {
      state.platform = platform;
      state.runs = data[platform] || [];
      el.tabs.forEach(function (t) {
        var isActive = t.dataset.platform === platform;
        t.classList.toggle('active', isActive);
        t.classList.toggle('ghost', !isActive);
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      // Reset filters
      if (el.search) el.search.value = '';
      if (el.seedOnly) el.seedOnly.checked = false;
      state.search = '';
      state.seedOnly = false;
      populateCats(platform);
      // Version dropdown is shared across both platforms
      // (already populated once at init)
      el.version.value = 'all';
      state.version = 'all';
      applyFilters();
    }

    function toggleExpand(idx) {
      if (state.expanded.has(idx)) {
        state.expanded.delete(idx);
      } else {
        state.expanded.add(idx);
      }
      // Re-render only the affected row to avoid full innerHTML rebuild
      var wrap = el.list.querySelector('.sr-row-wrap[data-idx="' + idx + '"]');
      if (wrap) {
        var r = state.filtered[idx];
        var rank = +idx + 1;
        var newHtml = rowHtml(r, rank, idx);
        wrap.outerHTML = newHtml;
      }
    }

    function loadMore() {
      state.visible += PAGE_SIZE;
      render();
      // Scroll into view of new content (subtle)
      var last = el.list.lastElementChild;
      if (last && last.scrollIntoView) {
        var rect = last.getBoundingClientRect();
        if (rect.bottom > window.innerHeight) {
          last.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }
    }

    function resetFilters() {
      if (el.search) el.search.value = '';
      if (el.seedOnly) el.seedOnly.checked = false;
      if (el.category) el.category.value = 'all';
      if (el.version) el.version.value = 'all';
      state.search = '';
      state.seedOnly = false;
      state.category = 'all';
      state.version = 'all';
      applyFilters();
    }

    // ---------- Debounce ----------
    var searchDebounce = null;
    function onSearchInput() {
      state.search = el.search.value;
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(applyFilters, 150);
    }

    // ---------- Init ----------
    var data = null;
    function init() {
      cacheDom();
      if (!el.tabs.length || !el.list) return;
      try {
        data = loadData();
      } catch (e) {
        console.error('Speedrun data load failed:', e);
        if (el.loading) {
          el.loading.innerHTML =
            '<div class="text-center text-mc-redstone">خطا در بارگذاری داده‌ها. صفحه را تازه‌سازی کنید.</div>';
        }
        return;
      }
      populateVersions();
      // Wire events
      el.tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          switchTab(tab.dataset.platform);
        });
      });
      el.search.addEventListener('input', onSearchInput);
      el.category.addEventListener('change', function () {
        state.category = el.category.value;
        applyFilters();
      });
      el.version.addEventListener('change', function () {
        state.version = el.version.value;
        applyFilters();
      });
      el.seedOnly.addEventListener('change', function () {
        state.seedOnly = el.seedOnly.checked;
        applyFilters();
      });
      el.reset.addEventListener('click', resetFilters);
      el.emptyReset.addEventListener('click', resetFilters);
      el.loadMore.addEventListener('click', loadMore);
      // Event delegation for row clicks
      el.list.addEventListener('click', function (e) {
        var target = e.target;
        // Don't toggle when clicking external link inside row
        if (target.closest('.sr-ext-link') || target.closest('.sr-detail-link')) return;
        var row = target.closest('.sr-row');
        if (row) {
          var idx = +row.dataset.idx;
          if (!isNaN(idx)) toggleExpand(idx);
        }
      });
      // Hide loading, show results
      el.loading.classList.add('hidden');
      el.results.classList.remove('hidden');
      // Initial platform = java
      switchTab('java');
    }

    // ---------- Boot ----------
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('astro:page-load', init);
  })();
</script>

