---
import BaseLayout from '@layouts/BaseLayout.astro';
import CraftingHelper from '@components/CraftingHelper.astro';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

// This page is full-screen (no main padding) — the scene fills the viewport
---

<BaseLayout
  path="/crafting"
  title="کرافت ماینکرفت — تعاملی و سه‌بعدی"
  description="یک تجربه‌ی کرافت کامل و سه‌بعدی — استیو، میز کار، هات‌بار، پنل بلاک‌ها. تایپ کن تا استیو برات بسازه!"
>
  <!-- Full-screen crafting scene — overrides the default BaseLayout main padding -->
  <div class="crafting-page">
    <CraftingHelper />
  </div>
</BaseLayout>

<style is:global>
  /* Override BaseLayout's main padding for this page only */
  .crafting-page {
    margin: -1.5rem -1rem 0;
  }
  
  /* On larger screens, also kill the max-width + horizontal padding */
  @media (min-width: 640px) {
    .crafting-page {
      margin: -1.5rem -1.5rem 0;
    }
  }
  @media (min-width: 1024px) {
    .crafting-page {
      margin: -1.5rem -2rem 0;
    }
  }
  
  /* Hide the breadcrumbs + h1 on this page (the scene is the hero) */
  .crafting-page + * {
    display: none;
  }
</style>
