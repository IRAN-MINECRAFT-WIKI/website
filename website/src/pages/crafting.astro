<script is:inline define:vars={{ recipesData, allItemsData, itemIconsJson, pngItemsJson, itemsRenderJson, blocksRenderJson, cdnMapJson, BASE }}>
  (function () {
    // ── Modern Tab Switching (Phase 7) ─────────────────────────
    // The first tab ("رسپی‌ها") shows the search + recipe list + grid.
    // The second tab ("اسکین ۳D") shows the Steve skin viewer + customizer.
    // The third/fourth tabs are <a> links to other pages (no JS).
    function setupTabs() {
      const tabs = document.querySelectorAll('.craft-tab[data-tab]');
      const recipesSection = document.querySelector('.craft-search-section');
      const gridSection = document.querySelector('.craft-main-section, .craft-grid-section, section.mcui-recipe');
      const steveSection = document.querySelector('.craft-steve-section');
      // Collect all top-level sections that should toggle visibility
      const recipeParts = document.querySelectorAll('.craft-search-section, section:not(.craft-tabs):not(.craft-steve-section):not(.craft-search-section)');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.dataset.tab;
          tabs.forEach((t) => {
            t.classList.toggle('active', t === tab);
            t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
          });
          if (target === 'recipes') {
            if (recipesSection) recipesSection.style.display = '';
            // show all other sections except steve section
            document.querySelectorAll('main section').forEach((s) => {
              if (s.classList.contains('craft-steve-section')) {
                s.style.display = 'none';
              } else {
                s.style.display = '';
              }
            });
          } else if (target === 'steve') {
            if (recipesSection) recipesSection.style.display = 'none';
            document.querySelectorAll('main section').forEach((s) => {
              if (s.classList.contains('craft-steve-section')) {
                s.style.display = '';
              } else if (s.classList.contains('craft-tabs') || s.classList.contains('craft-header')) {
                // keep header visible
                s.style.display = '';
              } else {
                s.style.display = 'none';
              }
            });
            // scroll the Steve section into view
            setTimeout(() => {
              if (steveSection) steveSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
          }
        });
      });
      // Initial state: show steve section is hidden (only because we want to default to recipes tab)
      // Actually the Steve section IS rendered visible by default, let's hide it until user clicks
      // Actually let's just leave it visible — both sections visible simultaneously is fine for UX
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupTabs);
    } else {
      setupTabs();
    }
    // ── State ─────────────────────────────────────────────
    let recipes = [];
    try { recipes = JSON.parse(recipesData); }
    catch (e) { console.error('crafting: failed to parse recipes', e); return; }

    // ── Item-icon emoji fallback map (Task 23) ─────────────────
    // Used when an item's PNG is missing (most of the 285 recipes have no PNG).
    let itemIcons = {};
    try { itemIcons = JSON.parse(itemIconsJson) || {}; }
    catch (e) { itemIcons = {}; }

    // ── Set of item names that DO have any image asset (Task SA-ITEMS) ──
    // Built at build-time by scanning /public/textures/{items,blocks} (flat PNGs)
    // plus /public/textures/{items-render,blocks-render} (3D .webp renders).
    // Lets the client skip img loads for items that would 404 anyway.
    let pngSet = new Set();
    try {
      const arr = JSON.parse(pngItemsJson) || [];
      pngSet = new Set(arr);
    } catch (e) { pngSet = new Set(); }
    function hasPng(name) { return !!name && pngSet.has(name); }

    // ── CDN URL map (name → ccvaults.com URL) ──
    // Build-time lookup from @klashdevelopment/mcicons. Preferred over all
    // local paths so GitHub Pages doesn't serve the (git-ignored) renders.
    let cdnMap = {};
    try { cdnMap = JSON.parse(cdnMapJson) || {}; }
    catch (e) { cdnMap = {}; }

    // ── Sets of item names that have a 3D render (.webp) ──
    // itemsRenderSet: 3D item renders (from mcicons `items` category).
    // blocksRenderSet: 3D block renders (from mcicons `blocks` category).
    // Preference order in texPath(): item render > block render > flat PNG.
    let itemsRenderSet = new Set();
    try {
      itemsRenderSet = new Set(JSON.parse(itemsRenderJson) || []);
    } catch (e) { itemsRenderSet = new Set(); }
    let blocksRenderSet = new Set();
    try {
      blocksRenderSet = new Set(JSON.parse(blocksRenderJson) || []);
    } catch (e) { blocksRenderSet = new Set(); }
    function hasRender(name) {
      return !!name && (itemsRenderSet.has(name) || blocksRenderSet.has(name));
    }

    // Folder picker for items that have block PNGs (everything else → items/).
    // NOTE: server-side isBlockPng() checks the actual block folder; we mirror
    // it here via a Set of "block item names" derived from pngItemsJson's
    // intersection with the blocks directory. For simplicity, when an item has
    // a PNG, we try items/ first then blocks/ on 404 — both are 1 round-trip
    // but rare since most items we ship live in items/.
    const BLOCK_NAMES_CLIENT = new Set([
      // Curated block list (kept for compatibility with the existing 33 recipes
      // whose output items ARE block PNGs). New block items just rely on emoji
      // fallback if their PNG isn't in either folder.
      'oak-planks', 'cobblestone', 'crafting-table-top', 'crafting-table-side',
      'chest', 'furnace-side', 'furnace-front', 'furnace-top', 'tnt',
      'ladder', 'bookshelf', 'red-bed', 'glass', 'sand', 'wool',
      'oak-log', 'oak-log-top', 'oak-leaves', 'stone', 'dirt', 'grass-block',
      'planks', 'sand-side',
    ]);

    // ── Texture cache (localStorage) for faster subsequent loads ──
    // Caches the resolved texture URL for each item name so we don't re-check
    // multiple paths on every render. Also caches failed lookups (null) so we
    // don't retry paths that 404'd before.
    const TEX_CACHE_KEY = 'mb_tex_cache_v2';
    let texCache = {};
    try { texCache = JSON.parse(localStorage.getItem(TEX_CACHE_KEY) || '{}'); }
    catch (e) { texCache = {}; }
    function saveTexCache() {
      try { localStorage.setItem(TEX_CACHE_KEY, JSON.stringify(texCache)); }
      catch (e) { /* quota or private mode */ }
    }

    function texPath(name) {
      if (!name) return null;
      // Check cache first
      if (texCache[name] !== undefined) return texCache[name];
      // PREFER LOCAL files over CDN — the HuggingFace CDN returns HTML (not PNG)
      // for items that don't exist there, causing broken images.
      // Local files are reliable (376/377 items have local PNGs).
      if (BLOCK_NAMES_CLIENT.has(name)) {
        var u = BASE + 'textures/blocks/' + name + '.png';
        texCache[name] = u; return u;
      }
      // Default: items folder (most item textures live here)
      var u = BASE + 'textures/items/' + name + '.png';
      texCache[name] = u; return u;
    }

    // ── Render a single grid-slot or result-slot item ────────
    // If the item has any image asset (3D render preferred, else flat PNG),
    // render an <img alt="ماینکرفت بدراک | ماین بد (MineBed)"> (with onerror → emoji swap). Otherwise, render the
    // emoji directly as text — no failed HTTP req.
    function renderItemIcon(parentEl, itemName, fallbackEmoji, large) {
      parentEl.innerHTML = '';
      const emoji = fallbackEmoji || itemIcons[itemName] || '📦';
      // Always try to load an image — even if hasPng() returns false, the
      // file might exist under a different name or folder. Let the browser
      // handle 404 via onerror → emoji fallback.
      const src = texPath(itemName);
      if (src) {
        const img = document.createElement('img');
        img.src = src;
        img.alt = itemName;
        img.loading = 'eager';
        img.decoding = 'async';
        img.style.cssText = 'width: ' + (large ? '70%' : '70%') +
          '; height: ' + (large ? '70%' : '70%') +
          '; image-rendering: pixelated; object-fit: contain;';
        img.onerror = function () {
          // Mark this path as failed in cache so we don't retry
          texCache[itemName] = null;
          saveTexCache();
          this.style.display = 'none';
          const span = document.createElement('span');
          span.className = 'emoji-icon';
          span.style.cssText = 'font-size: ' + (large ? '1.5rem' : '1rem') +
            '; line-height: 1; display: inline-block;';
          span.textContent = emoji;
          parentEl.appendChild(span);
        };
        parentEl.appendChild(img);
      } else {
        // No texture path — emoji fallback directly
        const span = document.createElement('span');
        span.className = 'emoji-icon';
        span.style.cssText = 'font-size: ' + (large ? '1.5rem' : '1rem') +
          '; line-height: 1; display: inline-block;';
        span.textContent = emoji;
        parentEl.appendChild(span);
      }
    }

    // ── DOM refs ──────────────────────────────────────────
    const searchInput = document.getElementById('craftingSearch');
    const searchClear = document.getElementById('craftingSearchClear');
    const chips = document.querySelectorAll('.craft-chip');
    const recipeInfo = document.getElementById('recipeInfo');
    const recipeTitle = document.getElementById('recipeTitle');
    const recipeDesc = document.getElementById('recipeDesc');
    const recipeCount = document.getElementById('recipeCount');
    const wikiLink = document.getElementById('wikiLink');
    const clearGridBtn = document.getElementById('clearGridBtn');
    const emptyHint = document.getElementById('emptyHint');
    const recipeList = document.getElementById('recipeList');
    const recipeListCount = document.getElementById('recipeListCount');
    const recipeListEmpty = document.getElementById('recipeListEmpty');
    const recipeItems = document.querySelectorAll('.item-icon-btn');

    if (!searchInput || recipes.length === 0) return;

    // (BLOCK_NAMES_CLIENT + texPath + renderItemIcon defined above, near top of IIFE.)

    // ── findRecipe (TYPED search): exact → alias → substring ──
    // NOTE: This is the FUZZY path used only when the user TYPES.
    // Chip clicks and recipe-list clicks use the EXACT `findById` path.
    function findRecipe(query) {
      const q = (query || '').trim().toLowerCase();
      if (!q) return null;

      // 1) Exact id
      let r = recipes.find((r) => r.id === q);
      if (r) return r;

      // 2) Exact nameFa (Persian, lowercased — Persian has no case but this is harmless)
      r = recipes.find((r) => (r.nameFa || '').toLowerCase() === q);
      if (r) return r;

      // 3) Exact English name
      r = recipes.find((r) => (r.nameEn || '').toLowerCase() === q);
      if (r) return r;

      // 4) Exact alias
      r = recipes.find((r) => (r.aliases || []).some((a) => a.toLowerCase() === q));
      if (r) return r;

      // 5) Substring on nameFa / nameEn / aliases (simple includes())
      r = recipes.find((r) =>
        (r.nameFa || '').toLowerCase().includes(q) ||
        (r.nameEn || '').toLowerCase().includes(q) ||
        (r.aliases || []).some((a) => a.toLowerCase().includes(q))
      );
      return r || null;
    }

    // ── EXACT id lookup — used by chips + list clicks (no fuzzy) ──
    function findById(recipeId) {
      if (!recipeId) return null;
      return recipes.find((r) => r.id === recipeId) || null;
    }

    // ── Render recipe into 3D scene ───────────────────────
    function renderRecipe(recipe) {
      // Clear 3D scene items FIRST (fixes bug where old items pile up)
      if (window.__craft3D) {
        window.__craft3D.clearItems();
      }

      if (!recipe) return;

      // Mark the matching list item active
      recipeItems.forEach((el) => el.classList.remove('active'));
      const matchItem = document.querySelector('.item-icon-btn[data-recipe-id="' + recipe.id + '"]');
      if (matchItem) {
        matchItem.classList.add('active');
        try { matchItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); } catch (e) {}
      }

      // Drop items onto the 3D crafting table one by one
      const flatGrid = [];
      for (let r = 0; r < 3; r++) {
        for (let c = 0; c < 3; c++) {
          const v = recipe.grid && recipe.grid[r] ? recipe.grid[r][c] : null;
          flatGrid.push(v);
        }
      }
      flatGrid.forEach((itemName, idx) => {
        if (!itemName) return;
        setTimeout(() => {
          if (window.__craft3D) {
            window.__craft3D.dropItem(itemName, idx);
          }
        }, idx * 100);
      });

      // After all items dropped, move camera up to show recipe from above
      const filledCount = flatGrid.filter(Boolean).length;
      setTimeout(() => {
        if (emptyHint) emptyHint.hidden = true;

        // Camera moves up to show the recipe from above
        if (window.__craft3D) {
          window.__craft3D.showRecipe();
        }

        // Recipe info
        recipeTitle.textContent = recipe.nameFa;
        recipeDesc.textContent = recipe.description || '';
        if (recipe.output.count && recipe.output.count > 1) {
          recipeCount.textContent = '×' + recipe.output.count;
          recipeCount.hidden = false;
        } else {
          recipeCount.hidden = true;
        }
        wikiLink.href = BASE + 'wiki/' + (recipe.wikiSlug || 'crafting-recipes');
        recipeInfo.hidden = false;
      }, flatGrid.filter(Boolean).length * 60 + 120);
    }

    // ── Filter the item list by name (all items, not just recipes) ──
    function filterList(query) {
      const q = (query || '').trim().toLowerCase();
      let visibleCount = 0;
      recipeItems.forEach((el) => {
        const name = el.getAttribute('data-item-name') || '';
        const recipeId = el.getAttribute('data-recipe-id');
        if (!q) {
          el.style.display = '';
          visibleCount++;
          return;
        }
        // Match against item name, recipe nameFa, recipe nameEn, aliases
        let matches = name.toLowerCase().includes(q);
        if (!matches && recipeId) {
          const r = findById(recipeId);
          if (r) {
            matches = (r.nameFa || '').toLowerCase().includes(q) ||
              (r.nameEn || '').toLowerCase().includes(q) ||
              (r.aliases || []).some((a) => a.toLowerCase().includes(q));
          }
        }
        el.style.display = matches ? '' : 'none';
        if (matches) visibleCount++;
      });
      if (recipeListCount) recipeListCount.textContent = String(visibleCount);
      if (recipeListEmpty) recipeListEmpty.hidden = visibleCount > 0;
    }

    // ── Clear grid + info ──────────────────────────────────
    function clearGrid() {
      if (window.__craft3D) {
        window.__craft3D.clearItems();
        window.__craft3D.resetCamera();
      }
      recipeInfo.hidden = true;
      if (emptyHint) emptyHint.hidden = false;
      recipeItems.forEach((el) => el.classList.remove('active'));
    }

    // ── Event handlers ─────────────────────────────────────
    // Search input (typed)
    let searchTimer = null;
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const q = e.target.value;
        if (searchClear) searchClear.hidden = q.length === 0;

        // Always filter the list live
        filterList(q);

        // Only auto-render the grid when query is non-empty AND a recipe is found
        clearTimeout(searchTimer);
        if (!q || q.trim().length < 2) {
          // Don't clear grid on every short query — keep current state
          return;
        }
        searchTimer = setTimeout(() => {
          const recipe = findRecipe(q);
          // Only re-render if the found recipe differs from the active one
          const activeItem = document.querySelector('.recipe-item.active');
          const activeId = activeItem ? activeItem.getAttribute('data-recipe-id') : null;
          if (recipe && recipe.id !== activeId) {
            renderRecipe(recipe);
          } else if (!recipe && activeId) {
            // No match — leave current grid alone (less jarring)
          }
        }, 250);
      });

      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          clearTimeout(searchTimer);
          const q = searchInput.value.trim();
          if (q.length < 2) return;
          const recipe = findRecipe(q);
          if (recipe) {
            renderRecipe(recipe);
          } else {
            // Brief shake to indicate no match
            if (searchInput.parentElement) {
              searchInput.parentElement.style.animation = 'none';
              void searchInput.parentElement.offsetWidth;
              searchInput.parentElement.style.animation = 'searchShake 0.4s ease-in-out';
            }
          }
        } else if (e.key === 'Escape') {
          searchInput.value = '';
          if (searchClear) searchClear.hidden = true;
          filterList('');
          searchInput.focus();
        }
      });
    }

    // Clear-search button
    if (searchClear) {
      searchClear.addEventListener('click', () => {
        searchInput.value = '';
        searchClear.hidden = true;
        filterList('');
        searchInput.focus();
      });
    }

    // Chips — EXACT id lookup, NO fuzzy
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const id = chip.getAttribute('data-recipe-id');
        const recipe = findById(id);
        if (!recipe) return;
        // Set the search box to the EXACT nameFa so the user sees what they clicked
        searchInput.value = recipe.nameFa;
        if (searchClear) searchClear.hidden = false;
        filterList(recipe.nameFa);
        renderRecipe(recipe);
      });
    });

    // Item grid: single click = load recipe (if has one), double-click = always try
    recipeItems.forEach((el) => {
      // Single click — load recipe if the item has one
      el.addEventListener('click', () => {
        const hasRecipe = el.getAttribute('data-has-recipe') === 'true';
        const recipeId = el.getAttribute('data-recipe-id');
        const itemName = el.getAttribute('data-item-name') || '';
        if (hasRecipe && recipeId) {
          const recipe = findById(recipeId);
          if (recipe) {
            searchInput.value = recipe.nameFa;
            if (searchClear) searchClear.hidden = false;
            filterList(recipe.nameFa);
            renderRecipe(recipe);
          }
        } else {
          // No recipe — show info message
          showNoRecipeMessage(itemName);
        }
      });
      // Double-click — force recipe view even for no-recipe items (shows message)
      el.addEventListener('dblclick', () => {
        const hasRecipe = el.getAttribute('data-has-recipe') === 'true';
        const recipeId = el.getAttribute('data-recipe-id');
        const itemName = el.getAttribute('data-item-name') || '';
        if (hasRecipe && recipeId) {
          const recipe = findById(recipeId);
          if (recipe) renderRecipe(recipe);
        } else {
          showNoRecipeMessage(itemName);
        }
      });
    });

    // Show "no recipe" → trigger 3D mob/chest animation
    function showNoRecipeMessage(itemName) {
      if (window.__craft3D) {
        window.__craft3D.clearItems();
        window.__craft3D.showMobScene(itemName);
      }
      if (emptyHint) emptyHint.hidden = true;
      recipeInfo.hidden = true;
      // Show the scene control buttons
      var sceneBtns = document.getElementById('sceneBtns');
      if (sceneBtns) sceneBtns.hidden = false;
    }

    // Clear-grid button
    if (clearGridBtn) {
      clearGridBtn.addEventListener('click', () => {
        clearGrid();
        searchInput.value = '';
        if (searchClear) searchClear.hidden = true;
        filterList('');
        searchInput.focus();
      });
    }

    // Scene control buttons (mob/chest animation)
    var sceneNextBtn = document.getElementById('sceneNextBtn');
    var sceneReturnBtn = document.getElementById('sceneReturnBtn');
    if (sceneNextBtn) {
      sceneNextBtn.addEventListener('click', () => {
        if (window.__craft3D) window.__craft3D.nextScene();
      });
    }
    if (sceneReturnBtn) {
      sceneReturnBtn.addEventListener('click', () => {
        if (window.__craft3D) {
          window.__craft3D.clearItems();
          window.__craft3D.resetCamera();
        }
        var sb = document.getElementById('sceneBtns');
        if (sb) sb.hidden = true;
        if (emptyHint) {
          emptyHint.hidden = false;
          emptyHint.innerHTML = '<p>روی یکی از آیکون‌های سمت راست کلیک کن.</p>';
        }
      });
    }

    // ── Drag & Drop (phase 102) ──────────────────────────────────
    // Drag recipe items from the list → drop into craft-slots to build a grid.
    // Also: click a filled slot to clear it; drag a slot to another slot to move.

    // 1. Make recipe-items draggable (set dataTransfer with recipe id + name)
    function setupDragSource() {
      document.querySelectorAll('.item-icon-btn[draggable="true"]').forEach((el) => {
        el.addEventListener('dragstart', (e) => {
          const id = el.getAttribute('data-recipe-id');
          const name = el.getAttribute('data-recipe-name') || '';
          if (e.dataTransfer) {
            e.dataTransfer.setData('text/plain', id + '|' + name);
            e.dataTransfer.effectAllowed = 'copy';
          }
          el.classList.add('dragging');
        });
        el.addEventListener('dragend', () => {
          el.classList.remove('dragging');
        });
      });
    }
    setupDragSource();

    // 2. Re-bind drag source when the list re-renders (after search filter)
    const recipeListEl = document.getElementById('recipeList');
    if (recipeListEl) {
      const observer = new MutationObserver(() => setupDragSource());
      observer.observe(recipeListEl, { childList: true, subtree: true });
    }

    // 3. Make the 3D canvas droppable — drag item from list → drop on table
    const craft3DWrap = document.getElementById('craft3DWrap');
    if (craft3DWrap) {
      craft3DWrap.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'copy';
        craft3DWrap.style.borderColor = 'var(--grass-2, #7cc84a)';
      });
      craft3DWrap.addEventListener('dragleave', () => {
        craft3DWrap.style.borderColor = '';
      });
      craft3DWrap.addEventListener('drop', (e) => {
        e.preventDefault();
        craft3DWrap.style.borderColor = '';
        const raw = e.dataTransfer ? e.dataTransfer.getData('text/plain') : '';
        if (!raw) return;
        const id = raw.split('|')[0];
        const recipe = findById(id);
        if (recipe) {
          renderRecipe(recipe);
          searchInput.value = recipe.nameFa;
          if (searchClear) searchClear.hidden = false;
          filterList(recipe.nameFa);
        }
      });
    }

    // 4. Touch support for mobile — tap item then tap the 3D canvas
    let pendingItem = null;
    document.querySelectorAll('.item-icon-btn[draggable="true"]').forEach((el) => {
      el.addEventListener('touchstart', () => {
        pendingItem = {
          id: el.getAttribute('data-recipe-id'),
          name: el.getAttribute('data-recipe-name') || '',
        };
      });
    });
    if (craft3DWrap) {
      craft3DWrap.addEventListener('touchend', () => {
        if (!pendingItem) return;
        const recipe = findById(pendingItem.id);
        if (recipe) {
          renderRecipe(recipe);
          searchInput.value = recipe.nameFa;
          if (searchClear) searchClear.hidden = false;
          filterList(recipe.nameFa);
        }
        pendingItem = null;
      });
    }
  })();
</script>

<!-- ═══ 3D Crafting Table Scene (Three.js) ═══ -->
<script is:inline type="module" data-base={BASE}>
  import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.186.1/build/three.module.js';

  const canvas = document.getElementById('craft3DCanvas');
  const hint = document.getElementById('craft3DHint');
  if (!canvas) throw new Error('no craft3DCanvas');

  const BASE = '/website/';

  // Scene setup
  const scene = new THREE.Scene();
  scene.background = null;

  const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100);
  // Fixed angle — 75° from horizontal (15° tilt from straight down)
  camera.position.set(0, 6.5, 3.5);
  camera.lookAt(0, 0.3, 0);

  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  // Lighting
  const ambient = new THREE.AmbientLight(0xffffff, 0.6);
  scene.add(ambient);
  const dirLight = new THREE.DirectionalLight(0xfff5e0, 0.7);
  dirLight.position.set(3, 6, 4);
  scene.add(dirLight);

  // Crafting table block — NO rotation, locked in place
  const loader = new THREE.TextureLoader();
  loader.crossOrigin = 'anonymous';
  const topTex = loader.load(BASE + 'textures/blocks/crafting-table-top.png', () => {
    if (hint) hint.hidden = true;
  });
  const sideTex = loader.load(BASE + 'textures/blocks/crafting-table-side.png');
  // CRITICAL: disable mipmaps + use NearestFilter for BOTH mag AND min
  // to keep the 16x16 pixel-art texture crisp at any scale (no blurriness)
  [topTex, sideTex].forEach(tex => {
    tex.magFilter = THREE.NearestFilter;
    tex.minFilter = THREE.NearestFilter;
    tex.generateMipmaps = false;
    tex.colorSpace = THREE.SRGBColorSpace;
  });

  const blockGeo = new THREE.BoxGeometry(2, 2, 2);
  const materials = [
    new THREE.MeshLambertMaterial({ map: sideTex }),
    new THREE.MeshLambertMaterial({ map: sideTex }),
    new THREE.MeshLambertMaterial({ map: topTex }),
    new THREE.MeshLambertMaterial({ color: 0x8B5A2B }),
    new THREE.MeshLambertMaterial({ map: sideTex }),
    new THREE.MeshLambertMaterial({ map: sideTex }),
  ];
  const tableBlock = new THREE.Mesh(blockGeo, materials);
  scene.add(tableBlock);

  // Items sit on a GROUP that is locked to the table (no rotation)
  const itemGroup = new THREE.Group();
  scene.add(itemGroup);

  // Camera animation: smooth transition between idle and recipe-view
  let camTargetX = 0, camTargetY = 6.5, camTargetZ = 3.5;
  let camLookX = 0, camLookY = 0.3, camLookZ = 0;
  let camAnimating = false;
  // helper to set camera target + lookAt in one go
  function camTo(x, y, z, lx, ly, lz) {
    camTargetX = x; camTargetY = y; camTargetZ = z;
    camLookX = lx; camLookY = ly; camLookZ = lz;
    camAnimating = true;
  }

  function clearItems() {
    // Remove all old item meshes + dispose geometry/materials
    while (itemGroup.children.length > 0) {
      const child = itemGroup.children[0];
      if (child.geometry) child.geometry.dispose();
      if (child.material) {
        if (child.material.map) child.material.map.dispose();
        child.material.dispose();
      }
      itemGroup.remove(child);
    }
  }

  window.__craft3D = {
    clearItems: clearItems,
    dropItem: function(itemName, slotIdx) {
      const url = BASE + 'textures/items/' + itemName + '.png';
      loader.load(url, (tex) => {
        tex.magFilter = THREE.NearestFilter;
        tex.minFilter = THREE.NearestFilter;
        tex.generateMipmaps = false;
        tex.colorSpace = THREE.SRGBColorSpace;
        createItemPlane(tex, slotIdx);
      }, undefined, () => {
        loader.load(BASE + 'textures/blocks/' + itemName + '.png', (tex) => {
          tex.magFilter = THREE.NearestFilter;
          tex.minFilter = THREE.NearestFilter;
          tex.generateMipmaps = false;
          tex.colorSpace = THREE.SRGBColorSpace;
          createItemPlane(tex, slotIdx);
        });
      });
    },
    showRecipe: function() {
      camTargetY = 7.5;
      camTargetZ = 1.5;
      camAnimating = true;
    },
    resetCamera: function() {
      clearItems();
      clearScene();
      camTargetY = 6.5;
      camTargetZ = 3.5;
      camAnimating = true;
    },
    showMobScene: function(itemName) {
      // Dispatch to the right discovery scene based on where the item is found
      var d = getDiscovery(itemName);
      if (d.type === 'mine_tree') startMineTreeScene(itemName, d.tree);
      else if (d.type === 'chest_loot') startChestLootScene(itemName);
      else startMobScene(itemName); // mob_drop (default, incl. totem/evoker)
    },
    nextScene: function() {
      advanceScene();
    }
  };

  // ═══ MOB / CHEST DISCOVERY ANIMATION ═══
  // Scenes: 0=mob_approach, 1=mob_attack+drop, 2=zoom_item, 3=chest_fall, 4=chest_open+prize
  let sceneState = -1;
  let sceneItemMesh = null;
  let sceneMob = null;
  let sceneSteve = null;
  let sceneChest = null;
  let sceneChestLid = null;
  let sceneGroup = null;

  function clearScene() {
    if (sceneGroup) {
      scene.remove(sceneGroup);
      sceneGroup.traverse(obj => {
        if (obj.geometry) obj.geometry.dispose();
        if (obj.material) { if (obj.material.map) obj.material.map.dispose(); obj.material.dispose(); }
      });
      sceneGroup = null;
    }
    sceneState = -1;
    sceneItemMesh = null;
    sceneMob = null;
    sceneSteve = null;
    sceneTree = null;
    sceneChest = null;
    sceneChestLid = null;
    var sb = document.getElementById('sceneBtns');
    if (sb) sb.hidden = true;
    var sn = document.getElementById('sceneNextBtn');
    if (sn) sn.hidden = false;
  }

  // Helper: set UV for a BoxGeometry face (CORRECT Three.js vertex order)
  // faceIdx: 0=right(+X), 1=left(-X), 2=top(+Y), 3=bottom(-Y), 4=front(+Z), 5=back(-Z)
  // x0,y0 = top-left pixel; x1,y1 = bottom-right pixel; s = texture size
  function setFaceUV(geo, faceIdx, x0, y0, x1, y1, s) {
    var base = faceIdx * 4;
    var uv = geo.attributes.uv;
    var u0 = x0 / s, u1 = x1 / s;
    var vTop = 1 - y0 / s, vBot = 1 - y1 / s;
    // Three.js BoxGeometry UV order: v0=TL, v1=TR, v2=BL, v3=BR
    uv.setXY(base,     u0, vTop);
    uv.setXY(base + 1, u1, vTop);
    uv.setXY(base + 2, u0, vBot);
    uv.setXY(base + 3, u1, vBot);
  }

  // Flip the U (horizontal) coordinate on the +X(right) and -X(left) faces.
  // Minecraft skin wrapping requires these side faces to be mirrored vs the
  // default BoxGeometry UV order, otherwise the head sides appear reversed.
  function flipSideUVs(geo) {
    var uv = geo.attributes.uv;
    [0, 1].forEach(function (faceIdx) {
      var base = faceIdx * 4;
      var ua = uv.getX(base), ub = uv.getX(base + 1);
      uv.setXY(base,     ub, uv.getY(base));
      uv.setXY(base + 1, ua, uv.getY(base + 1));
      uv.setXY(base + 2, ub, uv.getY(base + 2));
      uv.setXY(base + 3, ua, uv.getY(base + 3));
    });
    geo.attributes.uv.needsUpdate = true;
  }

  // ═══════════════════════════════════════════════════════════════
  //  REAL MINECRAFT PLAYER MODEL (UV-mapped skin + limb pivots)
  //  Limbs are pivot Groups at shoulder/hip so they can swing.
  //  userData.parts = { head, body, armR, armL, legR, legL }
  //  userData.lambertMats = materials that support emissive (for death flash)
  // ═══════════════════════════════════════════════════════════════
  function buildPlayerFromTexture(skinTex, scale) {
    skinTex.magFilter = THREE.NearestFilter;
    skinTex.minFilter = THREE.NearestFilter;
    skinTex.generateMipmaps = false;
    skinTex.colorSpace = THREE.SRGBColorSpace;

    var s = 64;
    var texH = (skinTex.image && skinTex.image.height) ? skinTex.image.height : 64;
    var isOld = texH < 64; // 64×32 old format → left limbs mirror right
    var mkMat = function () {
      return new THREE.MeshLambertMaterial({ map: skinTex, transparent: true, opacity: 1, side: THREE.DoubleSide });
    };

    var root = new THREE.Group();
    var P = {};
    var mats = [];

    // ── HEAD (8×8×8) ──
    var hs = 0.5 * scale;
    var headGeo = new THREE.BoxGeometry(hs, hs, hs);
    setFaceUV(headGeo, 4, 8, 8, 16, 16, s);    // front (face)
    setFaceUV(headGeo, 5, 24, 8, 32, 16, s);   // back
    setFaceUV(headGeo, 0, 0, 8, 8, 16, s);     // right
    setFaceUV(headGeo, 1, 16, 8, 24, 16, s);   // left
    setFaceUV(headGeo, 2, 8, 0, 16, 8, s);     // top
    setFaceUV(headGeo, 3, 16, 0, 24, 8, s);    // bottom
    flipSideUVs(headGeo); // mirror side faces so head sides aren't reversed
    var head = new THREE.Mesh(headGeo, mkMat());
    head.position.y = 1.5 * scale;
    root.add(head); P.head = head; mats.push(head.material);

    // ── BODY (8×12×4) ──
    var bw = 0.5 * scale, bh = 0.75 * scale, bd = 0.25 * scale;
    var bodyGeo = new THREE.BoxGeometry(bw, bh, bd);
    setFaceUV(bodyGeo, 4, 20, 20, 28, 32, s);
    setFaceUV(bodyGeo, 5, 32, 20, 40, 32, s);
    setFaceUV(bodyGeo, 0, 28, 20, 32, 32, s);
    setFaceUV(bodyGeo, 1, 16, 20, 20, 32, s);
    setFaceUV(bodyGeo, 2, 20, 16, 28, 20, s);
    setFaceUV(bodyGeo, 3, 28, 16, 36, 20, s);
    flipSideUVs(bodyGeo);
    var body = new THREE.Mesh(bodyGeo, mkMat());
    body.position.y = 0.85 * scale;
    root.add(body); P.body = body; mats.push(body.material);

    // ── LIMB builder: pivot Group at the joint, mesh hangs below ──
    var aw = 0.25 * scale, ah = 0.75 * scale, ad = 0.25 * scale;
    function buildLimb(uvs, px, py) {
      var geo = new THREE.BoxGeometry(aw, ah, ad);
      setFaceUV(geo, 4, uvs.f[0], uvs.f[1], uvs.f[2], uvs.f[3], s);
      setFaceUV(geo, 5, uvs.b[0], uvs.b[1], uvs.b[2], uvs.b[3], s);
      setFaceUV(geo, 0, uvs.r[0], uvs.r[1], uvs.r[2], uvs.r[3], s);
      setFaceUV(geo, 1, uvs.l[0], uvs.l[1], uvs.l[2], uvs.l[3], s);
      setFaceUV(geo, 2, uvs.t[0], uvs.t[1], uvs.t[2], uvs.t[3], s);
      setFaceUV(geo, 3, uvs.bt[0], uvs.bt[1], uvs.bt[2], uvs.bt[3], s);
      flipSideUVs(geo);
      var mesh = new THREE.Mesh(geo, mkMat());
      mesh.position.y = -ah / 2; // hang below the pivot (joint)
      var pivot = new THREE.Group();
      pivot.add(mesh);
      pivot.position.set(px, py, 0);
      mats.push(mesh.material);
      return pivot;
    }

    var armUVR = { f: [44, 20, 48, 32], b: [52, 20, 56, 32], r: [48, 20, 52, 32], l: [40, 20, 44, 32], t: [44, 16, 48, 20], bt: [48, 16, 52, 20] };
    var armUVL = isOld ? armUVR : { f: [36, 52, 40, 64], b: [44, 52, 48, 64], r: [40, 52, 44, 64], l: [32, 52, 36, 64], t: [36, 48, 40, 52], bt: [40, 48, 44, 52] };
    var legUVR = { f: [4, 20, 8, 32], b: [12, 20, 16, 32], r: [8, 20, 12, 32], l: [0, 20, 4, 32], t: [4, 16, 8, 20], bt: [8, 16, 12, 20] };
    var legUVL = isOld ? legUVR : { f: [20, 52, 24, 64], b: [28, 52, 32, 64], r: [24, 52, 28, 64], l: [16, 52, 20, 64], t: [20, 48, 24, 52], bt: [24, 48, 28, 52] };

    var shoulderY = 1.225 * scale, hipY = 0.525 * scale;
    P.armR = buildLimb(armUVR, 0.375 * scale, shoulderY); root.add(P.armR);
    P.armL = buildLimb(armUVL, -0.375 * scale, shoulderY); root.add(P.armL);
    P.legR = buildLimb(legUVR, 0.125 * scale, hipY); root.add(P.legR);
    P.legL = buildLimb(legUVL, -0.125 * scale, hipY); root.add(P.legL);

    root.userData.parts = P;
    root.userData.lambertMats = mats;
    return root;
  }

  // Async wrapper: load skin URL → build model
  async function createPlayerModel(skinUrl, scale) {
    var skinTex = await new Promise(function (resolve, reject) {
      loader.load(skinUrl, resolve, undefined, reject);
    });
    return buildPlayerFromTexture(skinTex, scale);
  }

  // ── Evoker: REAL Minecraft entity texture (illager) ──
  // The illager head uses the standard player-head UV (face at 8,8-16,16),
  // so buildPlayerFromTexture renders the real evoker face correctly. The
  // body/arms map onto the illager robe (real dark robe + gold trim colors).
  function makeEvokerSkinTexture() {
    var c = document.createElement('canvas');
    c.width = 64; c.height = 64;
    var ctx = c.getContext('2d');
    ctx.clearRect(0, 0, 64, 64);
    var skin = '#B0B0BA', skinD = '#9696A0';
    var robe = '#1E1E2C', robeD = '#14141F';
    var gold = '#F0C840', dark = '#101018', beard = '#D0D0CC';
    // HEAD
    ctx.fillStyle = skin;  ctx.fillRect(8, 8, 8, 8);   // front
    ctx.fillStyle = skinD; ctx.fillRect(24, 8, 8, 8);  // back
    ctx.fillStyle = skin;  ctx.fillRect(0, 8, 8, 8);   // right
    ctx.fillStyle = skin;  ctx.fillRect(16, 8, 8, 8);  // left
    ctx.fillStyle = skinD; ctx.fillRect(8, 0, 8, 8);   // top
    ctx.fillStyle = skinD; ctx.fillRect(16, 0, 8, 8);  // bottom
    // face: angry eyebrows, eyes, beard
    ctx.fillStyle = dark;
    ctx.fillRect(9, 10, 2, 1); ctx.fillRect(13, 10, 4, 1);          // eyebrows
    ctx.fillRect(10, 11, 2, 2); ctx.fillRect(14, 11, 2, 2);         // eyes
    ctx.fillStyle = beard; ctx.fillRect(9, 13, 6, 2);               // beard
    // BODY (robe)
    ctx.fillStyle = robe;  ctx.fillRect(20, 20, 8, 12);  // front
    ctx.fillStyle = robeD; ctx.fillRect(32, 20, 8, 12);  // back
    ctx.fillStyle = robeD; ctx.fillRect(28, 20, 4, 12);  // right
    ctx.fillStyle = robeD; ctx.fillRect(16, 20, 4, 12);  // left
    ctx.fillStyle = robeD; ctx.fillRect(20, 16, 8, 4);   // top
    ctx.fillStyle = robe;  ctx.fillRect(28, 16, 8, 4);   // bottom
    ctx.fillStyle = gold;  ctx.fillRect(21, 20, 6, 1); ctx.fillRect(23, 20, 2, 2); // gold collar
    // RIGHT ARM
    ctx.fillStyle = robe;  ctx.fillRect(44, 20, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(52, 20, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(48, 20, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(40, 20, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(44, 16, 4, 4);
    ctx.fillStyle = robe;  ctx.fillRect(48, 16, 4, 4);
    // LEFT ARM (64×64 lower layer)
    ctx.fillStyle = robe;  ctx.fillRect(36, 52, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(44, 52, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(40, 52, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(32, 52, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(36, 48, 4, 4);
    ctx.fillStyle = robe;  ctx.fillRect(40, 48, 4, 4);
    // RIGHT LEG
    ctx.fillStyle = robeD; ctx.fillRect(4, 20, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(12, 20, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(8, 20, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(0, 20, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(4, 16, 4, 4);
    ctx.fillStyle = robeD; ctx.fillRect(8, 16, 4, 4);
    // LEFT LEG (64×64 lower layer)
    ctx.fillStyle = robeD; ctx.fillRect(20, 52, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(28, 52, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(24, 52, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(16, 52, 4, 12);
    ctx.fillStyle = robeD; ctx.fillRect(20, 48, 4, 4);
    ctx.fillStyle = robeD; ctx.fillRect(24, 48, 4, 4);

    var tex = new THREE.CanvasTexture(c);
    tex.magFilter = THREE.NearestFilter;
    tex.minFilter = THREE.NearestFilter;
    tex.generateMipmaps = false;
    tex.colorSpace = THREE.SRGBColorSpace;
    return tex;
  }

  // Build the Evoker model using the REAL Minecraft entity texture (illager).
  // Falls back to the canvas-generated skin if the real texture fails to load.
  function createEvokerModel(scale) {
    return new Promise(function (resolve) {
      loader.load(BASE + 'textures/entity/illager/evoker.png', function (tex) {
        resolve(buildPlayerFromTexture(tex, scale));
      }, undefined, function () {
        resolve(buildPlayerFromTexture(makeEvokerSkinTexture(), scale));
      });
    });
  }

  // ── Diamond sword: textured plane held in the hand, extends below the fist ──
  function createSword(scale) {
    var g = new THREE.Group();
    var swTex = loader.load(BASE + 'textures/items/diamond-sword.png');
    swTex.magFilter = THREE.NearestFilter; swTex.minFilter = THREE.NearestFilter;
    swTex.generateMipmaps = false; swTex.colorSpace = THREE.SRGBColorSpace;
    var mat = new THREE.MeshBasicMaterial({ map: swTex, transparent: true, alphaTest: 0.5, side: THREE.DoubleSide });
    var swW = 0.28 * scale, swH = 0.92 * scale;
    var blade = new THREE.Mesh(new THREE.PlaneGeometry(swW, swH), mat);
    // arm mesh is 0.75 tall hanging below the shoulder pivot; the hand (fist) is
    // at the bottom = y -0.75. Place the sword so its top sits at the hand and it
    // extends downward, pushed slightly in front of the arm box (+Z = arm front).
    blade.position.set(0, -0.75 * scale - swH / 2 + 0.06 * scale, 0.14 * scale);
    g.add(blade);
    g.userData.swordTex = swTex;
    return g;
  }

  // ═══ ANIMATIONS ═══
  // Idle: gentle breathing bob + head sway (persistent)
  function setIdleAnim(model) {
    var t0 = performance.now();
    var P = model.userData.parts;
    model.userData.animate = function (now) {
      var t = (now - t0) / 1000;
      model.position.y = Math.sin(t * 1.8) * 0.025;
      if (P.head) P.head.rotation.z = Math.sin(t * 1.8 + 0.5) * 0.03;
      if (P.armR) P.armR.rotation.x = -0.05 + Math.sin(t * 1.8) * 0.04;
      if (P.armL) P.armL.rotation.x = -0.05 - Math.sin(t * 1.8) * 0.04;
    };
  }

  // Walk: legs & arms swing oppositely. Returns {stop} that resets limbs.
  function startWalkAnim(model, speed) {
    speed = speed || 9;
    var t0 = performance.now();
    var P = model.userData.parts;
    function reset() {
      P.legR.rotation.x = 0; P.legL.rotation.x = 0;
      P.armR.rotation.x = -0.05; P.armL.rotation.x = -0.05;
    }
    model.userData.animate = function (now) {
      var t = (now - t0) / 1000;
      var sw = Math.sin(t * speed) * 0.85;
      P.legR.rotation.x = sw;
      P.legL.rotation.x = -sw;
      P.armR.rotation.x = -0.05 - sw * 0.6;
      P.armL.rotation.x = -0.05 + sw * 0.6;
    };
    return { stop: function () { reset(); model.userData.animate = null; } };
  }

  // Attack sequence: approach → wind-up (raise sword) → slash → recover.
  // onImpact called at the hit moment. onDone called when fully recovered.
  function playAttackSequence(steve, startX, endX, onImpact, onDone) {
    var P = steve.userData.parts;
    var t0 = performance.now();
    var phase = 'approach';
    steve.userData.animate = function (now) {
      var t = (now - t0) / 1000;
      if (phase === 'approach') {
        var p = Math.min(t / 0.75, 1);
        var e = 1 - Math.pow(1 - p, 2);
        steve.position.x = startX + (endX - startX) * e;
        var sw = Math.sin(t * 11) * 0.9;
        P.legR.rotation.x = sw; P.legL.rotation.x = -sw;
        P.armR.rotation.x = -0.05 - sw * 0.5; P.armL.rotation.x = -0.05 + sw * 0.5;
        if (p >= 1) { phase = 'windup'; t0 = now; }
      } else if (phase === 'windup') {
        var pw = Math.min(t / 0.42, 1);
        // raise sword arm forward & up (rotation.x negative = forward/up)
        P.armR.rotation.x = -0.05 - pw * 2.5;
        P.legR.rotation.x = -0.22; P.legL.rotation.x = 0.28; // small stance
        if (pw >= 1) { phase = 'slash'; t0 = now; if (onImpact) onImpact(); }
      } else if (phase === 'slash') {
        var ps = Math.min(t / 0.22, 1);
        // swing hard from raised (-2.55) down past vertical to +0.35
        P.armR.rotation.x = -2.55 + ps * 2.9;
        if (ps >= 1) { phase = 'recover'; t0 = now; }
      } else if (phase === 'recover') {
        var pr = Math.min(t / 0.4, 1);
        P.armR.rotation.x = 0.3 * (1 - pr) - 0.05 * pr;
        P.legR.rotation.x *= (1 - pr); P.legL.rotation.x *= (1 - pr);
        if (pr >= 1) {
          P.armR.rotation.x = -0.05; P.armL.rotation.x = -0.05;
          P.legR.rotation.x = 0; P.legL.rotation.x = 0;
          steve.userData.animate = null;
          if (onDone) onDone();
        }
      }
    };
  }

  // Death sequence: red flash → fall backward → shrink+fade + particle poof
  function playDeathSequence(mob, group, onDone) {
    var P = mob.userData.parts;
    var mats = mob.userData.lambertMats || [];
    var red = new THREE.Color(0xCC0000);
    mats.forEach(function (m) { m.emissive = red.clone(); m.emissiveIntensity = 0; });
    var t0 = performance.now();
    var phase = 'flash';
    mob.userData.animate = function (now) {
      var t = (now - t0) / 1000;
      if (phase === 'flash') {
        // flash red 4 times over 0.6s
        var fp = t / 0.6;
        var on = Math.floor(fp * 8) % 2 === 0;
        mats.forEach(function (m) { m.emissiveIntensity = on ? 0.85 : 0; });
        if (fp >= 1) {
          mats.forEach(function (m) { m.emissiveIntensity = 0; });
          phase = 'fall'; t0 = now;
        }
      } else if (phase === 'fall') {
        var pf = Math.min(t / 0.45, 1);
        var e = 1 - Math.pow(1 - pf, 2);
        // fall backward (tilt so head goes behind, away from attacker)
        mob.rotation.x = -e * (Math.PI / 2 - 0.08);
        if (pf >= 1) {
          phase = 'poof'; t0 = now;
          spawnDeathParticles(mob, group);
        }
      } else if (phase === 'poof') {
        var pp = Math.min(t / 0.4, 1);
        mob.scale.setScalar(1 - pp * 0.6);
        mats.forEach(function (m) { m.opacity = 1 - pp; });
        if (pp >= 1) {
          mob.visible = false;
          mob.userData.animate = null;
          if (onDone) onDone();
        }
      }
    };
  }

  // Mojang-style death particle burst: small textured cubes fly outward + fade
  function spawnDeathParticles(mob, group) {
    var N = 28;
    var baseY = mob.position.y;
    for (var i = 0; i < N; i++) {
      var sz = 0.06 + Math.random() * 0.08;
      var geo = new THREE.BoxGeometry(sz, sz, sz);
      var col = Math.random() < 0.5 ? 0x9696A0 : 0x1E1E2C;
      var mat = new THREE.MeshBasicMaterial({ color: col, transparent: true, opacity: 1 });
      var m = new THREE.Mesh(geo, mat);
      m.position.set(
        mob.position.x + (Math.random() - 0.5) * 0.5,
        baseY + 0.4 + Math.random() * 1.3,
        (mob.position.z || 0) + (Math.random() - 0.5) * 0.5
      );
      var ang = Math.random() * Math.PI * 2;
      var spd = 1.2 + Math.random() * 2.2;
      var vel = new THREE.Vector3(Math.cos(ang) * spd, 1.8 + Math.random() * 2.6, Math.sin(ang) * spd);
      var life = { t: 0, max: 0.8 + Math.random() * 0.4 };
      (function (m, vel, life) {
        m.userData.animate = function () {
          var dt = 0.016;
          life.t += dt;
          m.position.x += vel.x * dt;
          m.position.y += vel.y * dt;
          m.position.z += vel.z * dt;
          vel.y -= 9.8 * dt; // gravity
          m.rotation.x += dt * 7; m.rotation.z += dt * 5;
          m.material.opacity = Math.max(0, 1 - life.t / life.max);
          if (life.t >= life.max) {
            group.remove(m); m.geometry.dispose(); m.material.dispose();
            m.userData.animate = null;
          }
        };
      })(m, vel, life);
      group.add(m);
    }
  }

  // Small golden "critical hit" sparkle burst at an impact point
  function spawnHitSparkles(point, group) {
    var N = 10;
    for (var i = 0; i < N; i++) {
      var sz = 0.05 + Math.random() * 0.05;
      var geo = new THREE.BoxGeometry(sz, sz, sz);
      var mat = new THREE.MeshBasicMaterial({ color: 0xFFE660, transparent: true, opacity: 1 });
      var m = new THREE.Mesh(geo, mat);
      m.position.copy(point);
      var ang = Math.random() * Math.PI * 2;
      var spd = 1.0 + Math.random() * 1.5;
      var vel = new THREE.Vector3(Math.cos(ang) * spd, 1.2 + Math.random() * 1.6, Math.sin(ang) * spd);
      var life = { t: 0, max: 0.45 };
      (function (m, vel, life) {
        m.userData.animate = function () {
          var dt = 0.016;
          life.t += dt;
          m.position.addScaledVector(vel, dt);
          vel.y -= 7 * dt;
          m.material.opacity = Math.max(0, 1 - life.t / life.max);
          if (life.t >= life.max) {
            group.remove(m); m.geometry.dispose(); m.material.dispose();
            m.userData.animate = null;
          }
        };
      })(m, vel, life);
      group.add(m);
    }
  }

  // Fallback: simple box character (used if skin fails to load)
  function makeBoxCharacter(colors, scale) {
    var g = new THREE.Group();
    var mkMat = (c) => new THREE.MeshLambertMaterial({ color: c, transparent: true, opacity: 1 });
    var head = new THREE.Mesh(new THREE.BoxGeometry(0.5*scale, 0.5*scale, 0.5*scale), mkMat(colors.head));
    head.position.y = 1.5*scale; g.add(head);
    var body = new THREE.Mesh(new THREE.BoxGeometry(0.5*scale, 0.75*scale, 0.25*scale), mkMat(colors.body));
    body.position.y = 0.85*scale; g.add(body);
    var armGeo = new THREE.BoxGeometry(0.2*scale, 0.75*scale, 0.2*scale);
    var armL = new THREE.Mesh(armGeo, mkMat(colors.arms)); armL.position.set(-0.35*scale, 0.85*scale, 0); g.add(armL);
    var armR = new THREE.Mesh(armGeo, mkMat(colors.arms)); armR.position.set(0.35*scale, 0.85*scale, 0); g.add(armR);
    var legGeo = new THREE.BoxGeometry(0.2*scale, 0.75*scale, 0.2*scale);
    var legL = new THREE.Mesh(legGeo, mkMat(colors.legs)); legL.position.set(-0.15*scale, 0.15*scale, 0); g.add(legL);
    var legR = new THREE.Mesh(legGeo, mkMat(colors.legs)); legR.position.set(0.15*scale, 0.15*scale, 0); g.add(legR);
    return g;
  }

  // Create a REAL textured Minecraft chest (normal.png, 64×64) with opening lid.
  // UV regions per the vanilla chest texture layout. Lid is hinged at the
  // back-top edge and rotates open around X.
  function makeChestTextured() {
    var g = new THREE.Group();
    var chestTex = loader.load(BASE + 'textures/entity/chest/normal.png');
    chestTex.magFilter = THREE.NearestFilter;
    chestTex.minFilter = THREE.NearestFilter;
    chestTex.generateMipmaps = false;
    chestTex.colorSpace = THREE.SRGBColorSpace;

    var mat = new THREE.MeshLambertMaterial({ map: chestTex, transparent: true });
    var s = 64;

    // BODY: 14×10×14 px → 1.4 × 1.0 × 1.4 units (texture offset 0,19 per ModelChest)
    var bodyGeo = new THREE.BoxGeometry(1.4, 1.0, 1.4);
    setFaceUV(bodyGeo, 4, 14, 33, 28, 43, s);  // front (lock face)
    setFaceUV(bodyGeo, 5, 42, 33, 56, 43, s);  // back
    setFaceUV(bodyGeo, 0, 0, 33, 14, 43, s);   // right
    setFaceUV(bodyGeo, 1, 28, 33, 42, 43, s);  // left
    setFaceUV(bodyGeo, 2, 14, 19, 28, 33, s);  // top (interior, shared w/ lid bottom)
    setFaceUV(bodyGeo, 3, 14, 33, 28, 43, s);  // bottom (reuse front)
    flipSideUVs(bodyGeo);
    var body = new THREE.Mesh(bodyGeo, mat.clone());
    body.position.y = 0.5;
    g.add(body);

    // LID: 14×5×14 px → 1.4 × 0.5 × 1.4 units (texture offset 0,0 per ModelChest)
    var lidGeo = new THREE.BoxGeometry(1.4, 0.5, 1.4);
    setFaceUV(lidGeo, 4, 14, 14, 28, 19, s);   // front (latch)
    setFaceUV(lidGeo, 5, 42, 14, 56, 19, s);   // back
    setFaceUV(lidGeo, 0, 0, 14, 14, 19, s);    // right
    setFaceUV(lidGeo, 1, 28, 14, 42, 19, s);   // left
    setFaceUV(lidGeo, 2, 14, 0, 28, 14, s);    // top (14×14)
    setFaceUV(lidGeo, 3, 14, 19, 28, 33, s);   // bottom (interior, shared)
    flipSideUVs(lidGeo);
    var lid = new THREE.Mesh(lidGeo, mat.clone());
    // offset lid so its back-bottom edge sits at the pivot origin (the hinge)
    lid.position.set(0, 0.25, 0.7);
    var lidPivot = new THREE.Group();
    lidPivot.add(lid);
    // hinge at back-top edge of the body (body top = y1.0, back = z-0.7)
    lidPivot.position.set(0, 1.0, -0.7);
    g.add(lidPivot);
    g.userData.lid = lidPivot;

    return g;
  }

  function makeChest() {
    var g = new THREE.Group();
    // chest body
    var body = new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.8, 0.8),
      new THREE.MeshLambertMaterial({ color: 0x8B4513 }));
    body.position.y = 0.4;
    g.add(body);
    // chest lid (will rotate to open)
    var lid = new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.35, 0.8),
      new THREE.MeshLambertMaterial({ color: 0x6B3410 }));
    lid.position.set(0, 0.975, -0.35); // hinge at back
    g.add(lid);
    g.userData.lid = lid;
    // gold lock
    var lock = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.15, 0.1),
      new THREE.MeshLambertMaterial({ color: 0xFFD700 }));
    lock.position.set(0, 0.8, 0.41);
    g.add(lock);
    return g;
  }

  // ═══════════════════════════════════════════════════════════════
  //  DISCOVERY FRAMEWORK — each non-craftable item maps to a discovery
  //  type based on where it's actually found in Minecraft:
  //    mob_drop  → Steve kills a mob, item drops (totem/evoker, bone/skeleton…)
  //    mine_tree → Steve chops a tree, log drops (oak-log, birch-log…)
  //    mine_ore  → Steve mines ore, item drops (diamond, iron-ore…)
  //    chest_loot→ chest appears, Steve opens it, item is the prize (default)
  // ═══════════════════════════════════════════════════════════════
  let sceneTree = null;
  let sceneType = 'mob_drop'; // current discovery scene type

  function getDiscovery(itemName) {
    var n = (itemName || '').toLowerCase();
    var mobDrops = {
      'totem-of-undying': 'evoker', 'bone': 'skeleton', 'bone-meal': 'skeleton',
      'gunpowder': 'creeper', 'rotten-flesh': 'zombie', 'ender-pearl': 'enderman',
      'skeleton-skull': 'skeleton', 'creeper-head': 'creeper', 'zombie-head': 'zombie'
    };
    if (mobDrops[n]) return { type: 'mob_drop', mob: mobDrops[n] };
    // logs / wood
    var logM = n.match(/(oak|birch|spruce|jungle|acacia|dark-oak|mangrove|cherry|crimson|warped)/);
    if (/(^|[-_])log($|-)/.test(n) || /-wood$/.test(n) || /-log$/.test(n)) {
      return { type: 'mine_tree', tree: logM ? logM[1] : 'oak' };
    }
    // ores / minerals
    var oreMap = { 'diamond': 'diamond', 'iron-ore': 'iron', 'raw-iron': 'iron',
      'coal': 'coal', 'coal-ore': 'coal', 'gold-ore': 'gold', 'raw-gold': 'gold',
      'lapis-lazuli': 'lapis', 'redstone': 'redstone', 'redstone-dust': 'redstone',
      'emerald': 'emerald', 'nether-quartz': 'quartz', 'amethyst-shard': 'amethyst' };
    if (oreMap[n]) return { type: 'mine_ore', ore: oreMap[n] };
    return { type: 'chest_loot' };
  }

  // ── Tree model: stacked log trunk + leaf canopy ──
  function createTree(treeType, scale) {
    var g = new THREE.Group();
    var logName = (treeType || 'oak') + '-log';
    var logTex = loader.load(BASE + 'textures/blocks/' + logName + '.png', undefined, undefined, function () {
      // fallback to oak log
    });
    logTex.magFilter = THREE.NearestFilter; logTex.minFilter = THREE.NearestFilter;
    logTex.generateMipmaps = false; logTex.colorSpace = THREE.SRGBColorSpace;
    var logMat = new THREE.MeshLambertMaterial({ map: logTex });
    var leavesTex = loader.load(BASE + 'textures/blocks/leaves.png');
    leavesTex.magFilter = THREE.NearestFilter; leavesTex.minFilter = THREE.NearestFilter;
    leavesTex.generateMipmaps = false; leavesTex.colorSpace = THREE.SRGBColorSpace;
    var leavesMat = new THREE.MeshLambertMaterial({ map: leavesTex });
    var trunkBlocks = [];
    for (var i = 0; i < 3; i++) {
      var blk = new THREE.Mesh(new THREE.BoxGeometry(0.8 * scale, 0.8 * scale, 0.8 * scale), logMat.clone());
      blk.position.set(0, 0.4 * scale + i * 0.8 * scale, 0);
      g.add(blk); trunkBlocks.push(blk);
    }
    var leafTop = 0.4 * scale + 3 * 0.8 * scale;
    var lp = [[0,leafTop+0.3*scale,0],[-0.7*scale,leafTop+0.3*scale,0],[0.7*scale,leafTop+0.3*scale,0],
      [0,leafTop+0.3*scale,-0.7*scale],[0,leafTop+0.3*scale,0.7*scale],
      [-0.7*scale,leafTop+0.3*scale,-0.7*scale],[0.7*scale,leafTop+0.3*scale,0.7*scale],
      [-0.7*scale,leafTop+0.3*scale,0.7*scale],[0.7*scale,leafTop+0.3*scale,-0.7*scale],
      [0,leafTop+0.9*scale,0]];
    lp.forEach(function (p) {
      var l = new THREE.Mesh(new THREE.BoxGeometry(0.85 * scale, 0.85 * scale, 0.85 * scale), leavesMat.clone());
      l.position.set(p[0], p[1], p[2]);
      g.add(l);
    });
    g.userData.trunkBlocks = trunkBlocks;
    return g;
  }

  // ── Axe: textured plane held in the hand (for chopping) ──
  function createAxe(scale) {
    var g = new THREE.Group();
    var axTex = loader.load(BASE + 'textures/items/diamond-axe.png');
    axTex.magFilter = THREE.NearestFilter; axTex.minFilter = THREE.NearestFilter;
    axTex.generateMipmaps = false; axTex.colorSpace = THREE.SRGBColorSpace;
    var mat = new THREE.MeshBasicMaterial({ map: axTex, transparent: true, alphaTest: 0.5, side: THREE.DoubleSide });
    var blade = new THREE.Mesh(new THREE.PlaneGeometry(0.32 * scale, 0.88 * scale), mat);
    blade.position.set(0, -0.75 * scale - 0.44 * scale + 0.06 * scale, 0.14 * scale);
    g.add(blade);
    return g;
  }

  // ── Block-break particle burst (Mojang-style: small cubes fly + fade) ──
  function spawnBreakParticles(point, color, group, n) {
    n = n || 14;
    for (var i = 0; i < n; i++) {
      var sz = 0.08 + Math.random() * 0.1;
      var geo = new THREE.BoxGeometry(sz, sz, sz);
      var mat = new THREE.MeshBasicMaterial({ color: color, transparent: true, opacity: 1 });
      var m = new THREE.Mesh(geo, mat);
      m.position.copy(point);
      var ang = Math.random() * Math.PI * 2;
      var spd = 0.8 + Math.random() * 1.6;
      var vel = new THREE.Vector3(Math.cos(ang) * spd, 1.2 + Math.random() * 2.0, Math.sin(ang) * spd);
      var life = { t: 0, max: 0.6 + Math.random() * 0.3 };
      (function (m, vel, life) {
        m.userData.animate = function () {
          var dt = 0.016; life.t += dt;
          m.position.x += vel.x * dt; m.position.y += vel.y * dt; m.position.z += vel.z * dt;
          vel.y -= 9 * dt;
          m.rotation.x += dt * 6; m.rotation.z += dt * 4;
          m.material.opacity = Math.max(0, 1 - life.t / life.max);
          if (life.t >= life.max) { group.remove(m); m.geometry.dispose(); m.material.dispose(); m.userData.animate = null; }
        };
      })(m, vel, life);
      group.add(m);
    }
  }

  // ── Scene slide transition: slide current group out left, build new ──
  function slideTransition(onMidSwap) {
    if (!sceneGroup) { onMidSwap(); return; }
    var t0 = performance.now();
    var oldGroup = sceneGroup;
    sceneGroup = null; // detached; render loop still traverses oldGroup via a temp
    // slide out left + fade
    oldGroup.userData._slide = { t0: t0, dir: -1 };
    oldGroup.userData.animate = function (now) {
      var t = Math.min((now - t0) / 450, 1);
      oldGroup.position.x = -t * 8;
      oldGroup.traverse(function (o) {
        if (o.material) { if (o.material.opacity === undefined) {} o.material.transparent = true; o.material.opacity = 1 - t; }
      });
      if (t >= 1) {
        scene.remove(oldGroup);
        oldGroup.traverse(function (o) { if (o.geometry) o.geometry.dispose(); if (o.material) { if (o.material.map) o.material.map.dispose(); o.material.dispose(); } });
        oldGroup.userData.animate = null;
      }
    };
    scene.add(oldGroup); // keep rendering during slide-out
    // at mid-point, build the new scene
    setTimeout(function () {
      onMidSwap();
      if (sceneGroup) {
        sceneGroup.position.x = 8;
        var nt0 = performance.now();
        var baseOp = [];
        sceneGroup.traverse(function (o) { if (o.material) { o.material.transparent = true; baseOp.push([o, o.material.opacity]); } });
        sceneGroup.userData.animate = function (now) {
          var t = Math.min((now - nt0) / 450, 1);
          sceneGroup.position.x = 8 - t * 8;
          sceneGroup.traverse(function (o) { if (o.material) o.material.opacity = t; });
          if (t >= 1) { sceneGroup.position.x = 0; sceneGroup.userData.animate = null; }
        };
      }
    }, 300);
  }

  // ── MINE TREE discovery scene (oak/birch/spruce logs + wood) ──
  // Scene 0: tree + Steve(axe). Scene 1: chop trunk bottom-up, log drops.
  // Scene 2: slide → chest. Scene 3: open chest, log is the prize.
  function startMineTreeScene(itemName, treeType) {
    clearScene(); clearItems();
    sceneType = 'mine_tree';
    sceneGroup = new THREE.Group();
    scene.add(sceneGroup);
    sceneTree = createTree(treeType, 1);
    sceneTree.position.set(1.3, 0, 0);
    sceneGroup.add(sceneTree);
    // grass ground
    var ground = new THREE.Mesh(new THREE.CircleGeometry(4.5, 48),
      new THREE.MeshBasicMaterial({ color: 0x2d5a1f, transparent: true, opacity: 0.5 }));
    ground.rotation.x = -Math.PI / 2; ground.position.y = -0.02;
    sceneGroup.add(ground);
    // Steve with axe
    createPlayerModel(BASE + 'textures/steve.png', 1).then(function (model) {
      sceneSteve = model;
      sceneSteve.position.set(-1.3, 0, 0.4);
      sceneSteve.rotation.y = Math.PI / 2 - 0.5;
      sceneGroup.add(sceneSteve);
      sceneSteve.userData.parts.armR.add(createAxe(1));
      setIdleAnim(sceneSteve);
    });
    // item texture (the log)
    var makeItemMesh = function (tex) {
      tex.magFilter = THREE.NearestFilter; tex.minFilter = THREE.NearestFilter;
      tex.generateMipmaps = false; tex.colorSpace = THREE.SRGBColorSpace;
      sceneItemMesh = new THREE.Mesh(new THREE.PlaneGeometry(0.5, 0.5),
        new THREE.MeshBasicMaterial({ map: tex, transparent: true, alphaTest: 0.5, side: THREE.DoubleSide, visible: false }));
      sceneGroup.add(sceneItemMesh);
    };
    loader.load(BASE + 'textures/items/' + itemName + '.png', makeItemMesh, undefined, function () {
      loader.load(BASE + 'textures/blocks/' + itemName + '.png', makeItemMesh);
    });
    tableBlock.visible = false;
    sceneState = 0;
    camTo(0, 3.2, 6.0, 0, 1.4, 0);
    var btn = document.getElementById('sceneNextBtn');
    if (btn) { btn.textContent = '🪓 برش درخت ←'; btn.hidden = false; }
    var sb = document.getElementById('sceneBtns'); if (sb) sb.hidden = false;
  }

  // The chop sequence: Steve walks to tree, swings axe, trunk breaks bottom-up.
  function playChopSequence(onDone) {
    if (!sceneSteve || !sceneTree) { setTimeout(function () { playChopSequence(onDone); }, 120); return; }
    sceneSteve.userData.animate = null;
    var P = sceneSteve.userData.parts;
    var startX = sceneSteve.position.x;
    var treeX = sceneTree.position.x;
    var t0 = performance.now();
    var phase = 'approach';
    var chops = 0;
    var MAX_CHOPS = 3;
    sceneSteve.userData.animate = function (now) {
      var t = (now - t0) / 1000;
      if (phase === 'approach') {
        var p = Math.min(t / 0.6, 1);
        sceneSteve.position.x = startX + (treeX - 1.0 - startX) * (1 - Math.pow(1 - p, 2));
        var sw = Math.sin(t * 11) * 0.8;
        P.legR.rotation.x = sw; P.legL.rotation.x = -sw;
        P.armR.rotation.x = -0.05 - sw * 0.4; P.armL.rotation.x = -0.05 + sw * 0.4;
        if (p >= 1) { phase = 'chop'; t0 = now; }
      } else if (phase === 'chop') {
        // swing axe: wind up then strike, repeat for MAX_CHOPS
        var cycle = 0.7;
        var ct = t % cycle;
        var ci = Math.floor(t / cycle);
        if (ci > chops) {
          chops = ci;
          // break the next trunk block from the bottom + particles
          var blocks = sceneTree.userData.trunkBlocks;
          var idx = chops - 1;
          if (idx < blocks.length) {
            var blk = blocks[idx];
            var wp = new THREE.Vector3(); blk.getWorldPosition(wp);
            spawnBreakParticles(wp, 0x6b4a1f, sceneGroup, 12);
            sceneTree.remove(blk);
          }
          if (chops >= MAX_CHOPS) { phase = 'done'; t0 = now; }
        }
        // axe swing animation within each cycle
        var cp = ct / cycle;
        P.armR.rotation.x = -0.05 - (Math.sin(cp * Math.PI * 2) * 0.5 + 0.5) * 2.0;
        P.legR.rotation.x = -0.15; P.legL.rotation.x = 0.15;
        if (phase === 'done') {
          // drop the log item from the tree base
          if (sceneItemMesh) {
            sceneItemMesh.material.visible = true;
            sceneItemMesh.position.set(treeX - 0.2, 2.0, 0);
            sceneItemMesh.rotation.set(-Math.PI / 2, 0, 0);
            sceneItemMesh.scale.set(1, 1, 1);
            if (window.__craft3D) window.__craft3D._totemX = treeX - 0.2;
            var dropStart = performance.now();
            sceneItemMesh.userData.animate = function (now2) {
              var dt2 = Math.min((now2 - dropStart) / 800, 1);
              var e2 = 1 - Math.pow(1 - dt2, 3);
              sceneItemMesh.position.y = 2.0 + (0.32 - 2.0) * e2;
              sceneItemMesh.rotation.z = (1 - dt2) * Math.PI * 2;
              if (dt2 >= 1) {
                var bob = performance.now();
                sceneItemMesh.userData.animate = function (n3) {
                  var tt = (n3 - bob) / 1000;
                  sceneItemMesh.position.y = 0.32 + Math.sin(tt * 2.5) * 0.05;
                  sceneItemMesh.rotation.z = Math.sin(tt * 2.5) * 0.15;
                };
              }
            };
          }
        }
      } else if (phase === 'done') {
        if (t > 0.9) {
          sceneSteve.userData.animate = null;
          setIdleAnim(sceneSteve);
          if (onDone) onDone();
        }
      }
    };
  }

  // ── Default CHEST LOOT scene: just a chest that falls + opens ──
  function startChestLootScene(itemName) {
    clearScene(); clearItems();
    sceneType = 'chest_loot';
    sceneGroup = new THREE.Group();
    scene.add(sceneGroup);
    var ground = new THREE.Mesh(new THREE.CircleGeometry(4.5, 48),
      new THREE.MeshBasicMaterial({ color: 0x16161E, transparent: true, opacity: 0.55 }));
    ground.rotation.x = -Math.PI / 2; ground.position.y = -0.02;
    sceneGroup.add(ground);
    var makeItemMesh = function (tex) {
      tex.magFilter = THREE.NearestFilter; tex.minFilter = THREE.NearestFilter;
      tex.generateMipmaps = false; tex.colorSpace = THREE.SRGBColorSpace;
      sceneItemMesh = new THREE.Mesh(new THREE.PlaneGeometry(0.55, 0.55),
        new THREE.MeshBasicMaterial({ map: tex, transparent: true, alphaTest: 0.5, side: THREE.DoubleSide, visible: false }));
      sceneGroup.add(sceneItemMesh);
    };
    loader.load(BASE + 'textures/items/' + itemName + '.png', makeItemMesh, undefined, function () {
      loader.load(BASE + 'textures/blocks/' + itemName + '.png', makeItemMesh);
    });
