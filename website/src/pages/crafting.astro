    sceneChest.position.set(0, 0, 0);
    sceneGroup.add(sceneChest);
    sceneChestLid = sceneChest.userData.lid;
    if (window.__craft3D) window.__craft3D._totemX = 0;
    var btn = document.getElementById('sceneNextBtn');
    if (btn) { btn.textContent = '📦 باز کردن چست ←'; btn.hidden = false; }
    var sb = document.getElementById('sceneBtns'); if (sb) sb.hidden = false;
  }

  // ═══ MOB DROP DISCOVERY ANIMATION (Mojang-style) ═══
  // Scene 0: Steve (sword) vs Evoker face off, idle breathing, camera intro
  // Scene 1: Steve walks in → sword swing → Evoker flashes red, falls, poofs into particles; totem drops glowing
  // Scene 2: zoom on totem
  // Scene 3: chest falls from sky + bounce
  // Scene 4: chest opens, golden glow, totem rises as prize
  function startMobScene(itemName) {
    clearScene();
    clearItems();
    sceneType = 'mob_drop';
    sceneGroup = new THREE.Group();
    scene.add(sceneGroup);

    // subtle ground disc so the fall feels grounded
    var groundGeo = new THREE.CircleGeometry(4.5, 48);
    var groundMat = new THREE.MeshBasicMaterial({ color: 0x16161E, transparent: true, opacity: 0.55 });
    var ground = new THREE.Mesh(groundGeo, groundMat);
    ground.rotation.x = -Math.PI / 2;
    ground.position.y = -0.02;
    sceneGroup.add(ground);

    // ── STEVE (real skin model + sword in right hand) ──
    createPlayerModel(BASE + 'textures/steve.png', 1).then(function (model) {
      sceneSteve = model;
      sceneSteve.position.set(-1.7, 0, 0);
      // face +X (toward Evoker), angled ~22° toward camera so the face is visible
      sceneSteve.rotation.y = Math.PI / 2 - 0.42;
      sceneGroup.add(sceneSteve);
      // attach diamond sword to right hand
      var sword = createSword(1);
      sceneSteve.userData.parts.armR.add(sword);
      sceneSteve.userData.sword = sword;
      setIdleAnim(sceneSteve);
    }).catch(function (err) {
      console.error('[craft3D] Steve model failed:', err);
      sceneSteve = makeBoxCharacter({ head: 0xF0C8A0, body: 0x00AAAA, arms: 0x4488CC, legs: 0x4444AA }, 1);
      sceneSteve.position.set(-1.7, 0, 0);
      sceneSteve.rotation.y = Math.PI / 2 - 0.42;
      sceneGroup.add(sceneSteve);
      setIdleAnim(sceneSteve);
    });

    // ── EVOKER (REAL illager entity texture) ──
    createEvokerModel(1).then(function (model) {
      sceneMob = model;
      sceneMob.position.set(1.7, 0, 0);
      sceneMob.rotation.y = -Math.PI / 2 + 0.42; // face -X (toward Steve), angled toward camera
      sceneGroup.add(sceneMob);
      setIdleAnim(sceneMob);
    });

    // ── load the totem/item texture for the drop ──
    var itemUrl = BASE + 'textures/items/' + itemName + '.png';
    var makeItemMesh = function (tex) {
      tex.magFilter = THREE.NearestFilter; tex.minFilter = THREE.NearestFilter;
      tex.generateMipmaps = false; tex.colorSpace = THREE.SRGBColorSpace;
      sceneItemMesh = new THREE.Mesh(
        new THREE.PlaneGeometry(0.55, 0.55),
        new THREE.MeshBasicMaterial({ map: tex, transparent: true, alphaTest: 0.5, side: THREE.DoubleSide, visible: false })
      );
      sceneGroup.add(sceneItemMesh);
    };
    loader.load(itemUrl, makeItemMesh, undefined, function () {
      loader.load(BASE + 'textures/blocks/' + itemName + '.png', makeItemMesh);
    });

    // hide crafting table
    tableBlock.visible = false;

    // Scene 0: camera intro — front elevated view of both fighters
    sceneState = 0;
    camera.position.set(0, 3.0, 6.5);
    camTargetY = 3.0; camTargetZ = 6.5;
    camera.position.x = 0;
    camAnimating = true;

    var btn = document.getElementById('sceneNextBtn');
    if (btn) { btn.textContent = '⚔ حمله استیو ←'; btn.hidden = false; }
    var sb = document.getElementById('sceneBtns');
    if (sb) sb.hidden = false;
  }

  function advanceScene() {
    sceneState++;
    // ── dispatch by discovery type ──
    if (sceneType === 'chest_loot') {
      // Scene 1: open the chest, item rises as prize
      if (sceneState === 1) {
        var btn = document.getElementById('sceneNextBtn');
        if (btn) { btn.textContent = '✓ تمام'; btn.hidden = true; }
        openChest();
      } else if (sceneState >= 2) {
        returnToCraftingTable();
      }
      return;
    }
    if (sceneType === 'mine_tree') {
      if (sceneState === 1) {
        // chop the tree → log drops
        var btn = document.getElementById('sceneNextBtn');
        if (btn) btn.hidden = true;
        playChopSequence(function () {
          if (sceneState === 1) {
            var b2 = document.getElementById('sceneNextBtn');
            if (b2) { b2.textContent = 'کشف در چست ←'; b2.hidden = false; }
          }
        });
      } else if (sceneState === 2) {
        // slide transition → chest scene
        var btn = document.getElementById('sceneNextBtn');
        if (btn) btn.hidden = true;
        slideTransition(function () {
          // build the chest scene (reuse spawnChest's chest setup, no fall)
          sceneTree = null; sceneSteve = null;
          sceneChest = makeChestTextured();
          sceneChest.position.set(0, 0, 0);
          sceneGroup.add(sceneChest);
          sceneChestLid = sceneChest.userData.lid;
          if (window.__craft3D) window.__craft3D._totemX = 0;
          camTo(0, 2.9, 3.4, 0, 1.0, 0);
          var b2 = document.getElementById('sceneNextBtn');
          if (b2) { b2.textContent = 'باز شدن چست ←'; b2.hidden = false; }
        });
      } else if (sceneState === 3) {
        var btn = document.getElementById('sceneNextBtn');
        if (btn) { btn.textContent = '✓ تمام'; btn.hidden = true; }
        openChest();
      } else if (sceneState >= 4) {
        returnToCraftingTable();
      }
      return;
    }
    // ── default: mob_drop ──
    if (sceneState === 1) {
      // Auto-play the attack + death + totem drop
      var btn = document.getElementById('sceneNextBtn');
      if (btn) btn.hidden = true; // hide during auto-play
      playAttackScene();
    } else if (sceneState === 2) {
      // Zoom on the dropped totem — move camera to the totem and look at it
      var btn = document.getElementById('sceneNextBtn');
      if (btn) { btn.textContent = 'افتادن چست ←'; btn.hidden = false; }
      var tx = (window.__craft3D && window.__craft3D._totemX) || 1.6;
      camTo(tx + 0.35, 0.85, 1.15, tx, 0.32, 0);
    } else if (sceneState === 3) {
      var btn = document.getElementById('sceneNextBtn');
      if (btn) btn.textContent = 'باز شدن چست ←';
      spawnChest();
    } else if (sceneState === 4) {
      var btn = document.getElementById('sceneNextBtn');
      if (btn) { btn.textContent = '✓ تمام'; btn.hidden = true; }
      openChest();
    } else if (sceneState >= 5) {
      returnToCraftingTable();
    }
  }

  // The full attack → death → totem-drop sequence (auto-plays on scene 1)
  function playAttackScene() {
    if (!sceneSteve || !sceneMob) {
      // models not ready yet (Steve still loading) — retry shortly
      setTimeout(playAttackScene, 120);
      return;
    }
    // stop idle anims
    sceneSteve.userData.animate = null;
    sceneMob.userData.animate = null;

    var steveStartX = sceneSteve.position.x;
    var steveFaceX = sceneSteve.rotation.y; // keep facing
    // Steve walks from -1.7 toward the Evoker but stops ~0.35 (sword reach),
    // leaving the Evoker clearly visible to the camera (no overlap).
    var approachEnd = 0.35;

    playAttackSequence(sceneSteve, steveStartX, approachEnd, function onImpact() {
      // impact moment: hit sparkles at the Evoker's torso + trigger death
      var p = new THREE.Vector3(sceneMob.position.x - 0.4, 1.1, 0);
      spawnHitSparkles(p, sceneGroup);
      playDeathSequence(sceneMob, sceneGroup, function onDead() {
        // totem drops from where the Evoker was, glowing green
        var totemX = sceneMob.position.x - 0.1;
        if (window.__craft3D) window.__craft3D._totemX = totemX;
        if (sceneItemMesh) {
          sceneItemMesh.material.visible = true;
          sceneItemMesh.position.set(totemX, 1.4, 0);
          sceneItemMesh.rotation.set(-Math.PI / 2, 0, 0);
          sceneItemMesh.scale.set(1, 1, 1);
          // green glow light (totem of undying)
          var glow = new THREE.PointLight(0x35FF66, 1.6, 4);
          glow.position.set(sceneMob.position.x - 0.1, 0.7, 0);
          sceneGroup.add(glow);
          var dropStart = performance.now();
          sceneItemMesh.userData.animate = function (now) {
            var t = Math.min((now - dropStart) / 900, 1);
            var eased = 1 - Math.pow(1 - t, 3);
            sceneItemMesh.position.y = 1.4 + (0.32 - 1.4) * eased;
            sceneItemMesh.rotation.z = (1 - t) * Math.PI * 3; // spin while falling
            // gentle bob after landing
            if (t >= 1) {
              var bobStart = performance.now();
              sceneItemMesh.userData.animate = function (now2) {
                var tt = (now2 - bobStart) / 1000;
                sceneItemMesh.position.y = 0.32 + Math.sin(tt * 2.5) * 0.05;
                sceneItemMesh.rotation.z = Math.sin(tt * 2.5) * 0.15;
              };
            }
          };
        }
        // after the drop settles, reveal the "zoom" button
        setTimeout(function () {
          if (sceneState === 1) {
            var btn = document.getElementById('sceneNextBtn');
            if (btn) { btn.textContent = 'زوم روی آیتم ←'; btn.hidden = false; }
          }
        }, 1100);
      });
    }, function onAttackDone() {
      // Steve holds his pose after the strike
      setIdleAnim(sceneSteve);
    });
  }

  function spawnChest() {
    // Remove mob + Steve (mob already poofed, Steve leaves the scene)
    if (sceneMob) { sceneGroup.remove(sceneMob); sceneMob = null; }
    if (sceneSteve) { sceneGroup.remove(sceneSteve); sceneSteve = null; }
    // hide the dropped totem while the chest falls (it'll reappear as the prize)
    if (sceneItemMesh) {
      sceneItemMesh.userData.animate = null;
      sceneItemMesh.material.visible = false;
    }

    // Create real textured chest
    sceneChest = makeChestTextured();
    sceneChest.position.set(0, 5, 0); // start above
    sceneGroup.add(sceneChest);
    sceneChestLid = sceneChest.userData.lid;

    // Camera moves to watch chest fall (reset to center on the chest at origin)
    camTo(0, 2.6, 4.2, 0, 0.6, 0);

    // Animate chest falling
    var startTime = performance.now();
    sceneChest.userData.animate = function(now) {
      var t = Math.min((now - startTime) / 1000, 1);
      var eased = t * t; // accelerate (gravity feel)
      sceneChest.position.y = 5 + (0 - 5) * eased;
      if (t >= 1) {
        // Bounce
        var bounceStart = performance.now();
        sceneChest.userData.animate = function(now2) {
          var t2 = Math.min((now2 - bounceStart) / 300, 1);
          sceneChest.position.y = Math.sin(t2 * Math.PI) * 0.3 * (1 - t2);
          if (t2 >= 1) {
            sceneChest.position.y = 0;
            sceneChest.userData.animate = null;
          }
        };
      }
    };
  }

  function openChest() {
    if (!sceneChest || !sceneChestLid) return;

    // Animate lid opening
    var startTime = performance.now();
    sceneChestLid.userData.animate = function(now) {
      var t = Math.min((now - startTime) / 500, 1);
      // Rotate lid back (hinge at back-bottom)
      sceneChestLid.rotation.x = -t * Math.PI * 0.4; // open ~72°
      if (t >= 1) {
        sceneChestLid.userData.animate = null;
        // Item pops out as prize — if the item texture failed to load, use a
        // glowing golden gift cube as a fallback so the scene is never empty.
        if (!sceneItemMesh) {
          sceneItemMesh = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.5, 0.5),
            new THREE.MeshBasicMaterial({ color: 0xFFD633, transparent: true, opacity: 0.95 }));
          sceneGroup.add(sceneItemMesh);
        }
        if (sceneItemMesh) {
          var popStart = performance.now();
          sceneItemMesh.position.set(0, 0.8, 0);
          sceneItemMesh.rotation.set(0, 0, 0); // upright, facing the camera
          sceneItemMesh.material.visible = true;
          // glow halo behind the prize so it's clearly visible
          var halo = new THREE.Mesh(new THREE.PlaneGeometry(1.6, 1.6),
            new THREE.MeshBasicMaterial({ color: 0xFFE680, transparent: true, opacity: 0.35, depthWrite: false }));
          halo.position.set(0, 0.8, -0.3);
          sceneChest.add(halo);
          var popDur = 700;
          sceneItemMesh.userData.animate = function(now2) {
            var t2 = Math.min((now2 - popStart) / popDur, 1);
            var e = 1 - Math.pow(1 - t2, 2);
            sceneItemMesh.position.y = 0.8 + e * 1.7; // rise up
            sceneItemMesh.rotation.y = t2 * Math.PI * 2; // spin (Y, since upright)
            var scale = 0.9 + e * 0.7;
            sceneItemMesh.scale.set(scale, scale, scale);
            halo.position.y = 0.8 + e * 1.7;
            if (t2 >= 1) {
              // gentle float + spin as the prize
              var floatStart = performance.now();
              sceneItemMesh.userData.animate = function(now3) {
                var tt = (now3 - floatStart) / 1000;
                sceneItemMesh.position.y = 2.5 + Math.sin(tt * 2) * 0.12;
                sceneItemMesh.rotation.y = tt * 1.5;
                halo.position.y = 2.5 + Math.sin(tt * 2) * 0.12;
              };
            }
          };
          // Camera frames chest + rising totem prize
          camTo(0, 2.9, 3.4, 0, 1.5, 0);
        }
      }
    };

    // Golden glow effect (subtle, so it doesn't blow out the close camera)
    var glow = new THREE.PointLight(0xFFD700, 1.0, 4);
    glow.position.set(0, 1.2, 0);
    sceneChest.add(glow);
  }

  function returnToCraftingTable() {
    clearScene();
    tableBlock.visible = true;
    camTargetY = 6.5;
    camTargetZ = 3.5;
    camAnimating = true;
    var sb = document.getElementById('sceneBtns');
    if (sb) sb.hidden = true;
  }

  function createItemPlane(texture, slotIdx) {
    const mat = new THREE.MeshBasicMaterial({ map: texture, transparent: true, alphaTest: 0.5 });
    const geo = new THREE.PlaneGeometry(0.58, 0.58);
    const mesh = new THREE.Mesh(geo, mat);
    // Grid layout EXACTLY aligned with the crafting table's 3x3 pattern
    // The crafting table texture has grid lines at 5/16 and 10/16
    // Each cell is ~5.33/16 of the block width = 5.33/16 * 2 = 0.667 units
    // Center the grid: offset by -0.667 so the grid is centered on the block
    const col = slotIdx % 3;
    const row = Math.floor(slotIdx / 3);
    const cellSize = 0.62;  // matches the grid cell size on the texture
    const offset = -cellSize; // center the 3x3 grid
    mesh.position.set(
      offset + col * cellSize,
      3, // start above, will animate down
      offset + row * cellSize
    );
    mesh.rotation.x = -Math.PI / 2;
    itemGroup.add(mesh);

    // Animate falling onto table
    const startY = 3;
    const endY = 1.06;
    const duration = 600;
    const startTime = performance.now();
    mesh.userData.animate = function(now) {
      const t = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      mesh.position.y = startY + (endY - startY) * eased;
      if (t >= 1) mesh.userData.animate = null;
    };
  }

  // Render loop — NO table rotation, items locked to table
  function render(now) {
    requestAnimationFrame(render);
    // Camera animation only (no block rotation)
    if (camAnimating) {
      camera.position.x += (camTargetX - camera.position.x) * 0.08;
      camera.position.y += (camTargetY - camera.position.y) * 0.08;
      camera.position.z += (camTargetZ - camera.position.z) * 0.08;
      // smoothly interpolate the lookAt target too
      var clx = camera._lookX || 0, cly = camera._lookY || 0.3, clz = camera._lookZ || 0;
      clx += (camLookX - clx) * 0.08;
      cly += (camLookY - cly) * 0.08;
      clz += (camLookZ - clz) * 0.08;
      camera._lookX = clx; camera._lookY = cly; camera._lookZ = clz;
      camera.lookAt(clx, cly, clz);
      if (Math.abs(camera.position.y - camTargetY) < 0.01 &&
          Math.abs(camera.position.x - camTargetX) < 0.01 &&
          Math.abs(camera.position.z - camTargetZ) < 0.01) camAnimating = false;
    }
    // Animate falling items (recipe drops)
    itemGroup.children.forEach(mesh => {
      if (mesh.userData.animate) mesh.userData.animate(now);
    });
    // Animate scene objects (mob/chest/prize)
    if (sceneGroup) {
      sceneGroup.traverse(obj => {
        if (obj.userData && obj.userData.animate) obj.userData.animate(now);
      });
    }
    renderer.render(scene, camera);
  }
  render(0);

  // Resize handler
  function onResize() {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    if (w === 0 || h === 0) return;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h, false);
  }
  window.addEventListener('resize', onResize);
  setTimeout(onResize, 100);
</script>

