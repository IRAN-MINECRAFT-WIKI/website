<script is:inline define:vars={{ recipesData, allItemsData, itemIconsJson, pngItemsJson, itemsRenderJson, blocksRenderJson, cdnMapJson, BASE }}>
  (function () {
    // ── Modern Tab Switching (Phase 7) ─────────────────────────
    // The first tab ("رسپی‌ها") shows the search + recipe list + grid.
    // The second tab ("اسکین ۳D") shows the Steve skin viewer + customizer.
    // The third/fourth tabs are <a> links to other pages (no JS).
    function setupTabs() {
      const tabs = document.querySelectorAll('.craft-tab[data-tab]');
      const recipesSection = document.querySelector('.craft-search-section');
      const gridSection = document.querySelector('.craft-main-section, .craft-grid-section, section.mcui-recipe');
      const steveSection = document.querySelector('.craft-steve-section');
      // Collect all top-level sections that should toggle visibility
      const recipeParts = document.querySelectorAll('.craft-search-section, section:not(.craft-tabs):not(.craft-steve-section):not(.craft-search-section)');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.dataset.tab;
          tabs.forEach((t) => {
            t.classList.toggle('active', t === tab);
            t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
          });
          if (target === 'recipes') {
            if (recipesSection) recipesSection.style.display = '';
            // show all other sections except steve section
            document.querySelectorAll('main section').forEach((s) => {
              if (s.classList.contains('craft-steve-section')) {
                s.style.display = 'none';
              } else {
                s.style.display = '';
              }
            });
          } else if (target === 'steve') {
            if (recipesSection) recipesSection.style.display = 'none';
            document.querySelectorAll('main section').forEach((s) => {
              if (s.classList.contains('craft-steve-section')) {
                s.style.display = '';
              } else if (s.classList.contains('craft-tabs') || s.classList.contains('craft-header')) {
                // keep header visible
                s.style.display = '';
              } else {
                s.style.display = 'none';
              }
            });
            // scroll the Steve section into view
            setTimeout(() => {
              if (steveSection) steveSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
          }
        });
      });
      // Initial state: show steve section is hidden (only because we want to default to recipes tab)
      // Actually the Steve section IS rendered visible by default, let's hide it until user clicks
      // Actually let's just leave it visible — both sections visible simultaneously is fine for UX
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupTabs);
    } else {
      setupTabs();
    }
    // ── State ─────────────────────────────────────────────
    let recipes = [];
    try { recipes = JSON.parse(recipesData); }
    catch (e) { console.error('crafting: failed to parse recipes', e); return; }

    // ── Item-icon emoji fallback map (Task 23) ─────────────────
    // Used when an item's PNG is missing (most of the 285 recipes have no PNG).
    let itemIcons = {};
    try { itemIcons = JSON.parse(itemIconsJson) || {}; }
    catch (e) { itemIcons = {}; }

    // ── Set of item names that DO have any image asset (Task SA-ITEMS) ──
    // Built at build-time by scanning /public/textures/{items,blocks} (flat PNGs)
    // plus /public/textures/{items-render,blocks-render} (3D .webp renders).
    // Lets the client skip img loads for items that would 404 anyway.
    let pngSet = new Set();
    try {
      const arr = JSON.parse(pngItemsJson) || [];
      pngSet = new Set(arr);
    } catch (e) { pngSet = new Set(); }
    function hasPng(name) { return !!name && pngSet.has(name); }

    // ── CDN URL map (name → ccvaults.com URL) ──
    // Build-time lookup from @klashdevelopment/mcicons. Preferred over all
    // local paths so GitHub Pages doesn't serve the (git-ignored) renders.
    let cdnMap = {};
    try { cdnMap = JSON.parse(cdnMapJson) || {}; }
    catch (e) { cdnMap = {}; }

    // ── Sets of item names that have a 3D render (.webp) ──
    // itemsRenderSet: 3D item renders (from mcicons `items` category).
    // blocksRenderSet: 3D block renders (from mcicons `blocks` category).
    // Preference order in texPath(): item render > block render > flat PNG.
    let itemsRenderSet = new Set();
    try {
      itemsRenderSet = new Set(JSON.parse(itemsRenderJson) || []);
    } catch (e) { itemsRenderSet = new Set(); }
    let blocksRenderSet = new Set();
    try {
      blocksRenderSet = new Set(JSON.parse(blocksRenderJson) || []);
    } catch (e) { blocksRenderSet = new Set(); }
    function hasRender(name) {
      return !!name && (itemsRenderSet.has(name) || blocksRenderSet.has(name));
    }

    // Folder picker for items that have block PNGs (everything else → items/).
    // NOTE: server-side isBlockPng() checks the actual block folder; we mirror
    // it here via a Set of "block item names" derived from pngItemsJson's
    // intersection with the blocks directory. For simplicity, when an item has
    // a PNG, we try items/ first then blocks/ on 404 — both are 1 round-trip
    // but rare since most items we ship live in items/.
    const BLOCK_NAMES_CLIENT = new Set([
      // Curated block list (kept for compatibility with the existing 33 recipes
      // whose output items ARE block PNGs). New block items just rely on emoji
      // fallback if their PNG isn't in either folder.
      'oak-planks', 'cobblestone', 'crafting-table-top', 'crafting-table-side',
      'chest', 'furnace-side', 'furnace-front', 'furnace-top', 'tnt',
      'ladder', 'bookshelf', 'red-bed', 'glass', 'sand', 'wool',
      'oak-log', 'oak-log-top', 'oak-leaves', 'stone', 'dirt', 'grass-block',
      'planks', 'sand-side',
    ]);

    // ── Texture cache (localStorage) for faster subsequent loads ──
    // Caches the resolved texture URL for each item name so we don't re-check
    // multiple paths on every render. Also caches failed lookups (null) so we
    // don't retry paths that 404'd before.
    const TEX_CACHE_KEY = 'mb_tex_cache_v2';
    let texCache = {};
    try { texCache = JSON.parse(localStorage.getItem(TEX_CACHE_KEY) || '{}'); }
    catch (e) { texCache = {}; }
    function saveTexCache() {
      try { localStorage.setItem(TEX_CACHE_KEY, JSON.stringify(texCache)); }
      catch (e) { /* quota or private mode */ }
    }

    function texPath(name) {
      if (!name) return null;
      // Check cache first
      if (texCache[name] !== undefined) return texCache[name];
      // PREFER LOCAL files over CDN — the HuggingFace CDN returns HTML (not PNG)
      // for items that don't exist there, causing broken images.
      // Local files are reliable (376/377 items have local PNGs).
      if (BLOCK_NAMES_CLIENT.has(name)) {
        var u = BASE + 'textures/blocks/' + name + '.png';
        texCache[name] = u; return u;
      }
      // Default: items folder (most item textures live here)
      var u = BASE + 'textures/items/' + name + '.png';
      texCache[name] = u; return u;
    }

    // ── Render a single grid-slot or result-slot item ────────
    // If the item has any image asset (3D render preferred, else flat PNG),
    // render an <img alt="ماینکرفت بدراک | ماین بد (MineBed)"> (with onerror → emoji swap). Otherwise, render the
    // emoji directly as text — no failed HTTP req.
    function renderItemIcon(parentEl, itemName, fallbackEmoji, large) {
      parentEl.innerHTML = '';
      const emoji = fallbackEmoji || itemIcons[itemName] || '📦';
      // Always try to load an image — even if hasPng() returns false, the
      // file might exist under a different name or folder. Let the browser
      // handle 404 via onerror → emoji fallback.
      const src = texPath(itemName);
      if (src) {
        const img = document.createElement('img');
        img.src = src;
        img.alt = itemName;
        img.loading = 'eager';
        img.decoding = 'async';
        img.style.cssText = 'width: ' + (large ? '70%' : '70%') +
          '; height: ' + (large ? '70%' : '70%') +
          '; image-rendering: pixelated; object-fit: contain;';
        img.onerror = function () {
          // Mark this path as failed in cache so we don't retry
          texCache[itemName] = null;
          saveTexCache();
          this.style.display = 'none';
          const span = document.createElement('span');
          span.className = 'emoji-icon';
          span.style.cssText = 'font-size: ' + (large ? '1.5rem' : '1rem') +
            '; line-height: 1; display: inline-block;';
          span.textContent = emoji;
          parentEl.appendChild(span);
        };
        parentEl.appendChild(img);
      } else {
        // No texture path — emoji fallback directly
        const span = document.createElement('span');
        span.className = 'emoji-icon';
        span.style.cssText = 'font-size: ' + (large ? '1.5rem' : '1rem') +
          '; line-height: 1; display: inline-block;';
        span.textContent = emoji;
        parentEl.appendChild(span);
      }
    }

    // ── DOM refs ──────────────────────────────────────────
    const searchInput = document.getElementById('craftingSearch');
    const searchClear = document.getElementById('craftingSearchClear');
    const chips = document.querySelectorAll('.craft-chip');
    const recipeInfo = document.getElementById('recipeInfo');
    const recipeTitle = document.getElementById('recipeTitle');
    const recipeDesc = document.getElementById('recipeDesc');
    const recipeCount = document.getElementById('recipeCount');
    const wikiLink = document.getElementById('wikiLink');
    const clearGridBtn = document.getElementById('clearGridBtn');
    const emptyHint = document.getElementById('emptyHint');
    const recipeList = document.getElementById('recipeList');
    const recipeListCount = document.getElementById('recipeListCount');
    const recipeListEmpty = document.getElementById('recipeListEmpty');
    const recipeItems = document.querySelectorAll('.item-icon-btn');

    if (!searchInput || recipes.length === 0) return;

    // (BLOCK_NAMES_CLIENT + texPath + renderItemIcon defined above, near top of IIFE.)

    // ── findRecipe (TYPED search): exact → alias → substring ──
    // NOTE: This is the FUZZY path used only when the user TYPES.
    // Chip clicks and recipe-list clicks use the EXACT `findById` path.
    function findRecipe(query) {
      const q = (query || '').trim().toLowerCase();
      if (!q) return null;

      // 1) Exact id
      let r = recipes.find((r) => r.id === q);
      if (r) return r;

      // 2) Exact nameFa (Persian, lowercased — Persian has no case but this is harmless)
      r = recipes.find((r) => (r.nameFa || '').toLowerCase() === q);
      if (r) return r;

      // 3) Exact English name
      r = recipes.find((r) => (r.nameEn || '').toLowerCase() === q);
      if (r) return r;

      // 4) Exact alias
      r = recipes.find((r) => (r.aliases || []).some((a) => a.toLowerCase() === q));
      if (r) return r;

      // 5) Substring on nameFa / nameEn / aliases (simple includes())
      r = recipes.find((r) =>
        (r.nameFa || '').toLowerCase().includes(q) ||
        (r.nameEn || '').toLowerCase().includes(q) ||
        (r.aliases || []).some((a) => a.toLowerCase().includes(q))
      );
      return r || null;
    }

    // ── EXACT id lookup — used by chips + list clicks (no fuzzy) ──
    function findById(recipeId) {
      if (!recipeId) return null;
      return recipes.find((r) => r.id === recipeId) || null;
    }

    // ── Render recipe into 3D scene ───────────────────────
    function renderRecipe(recipe) {
      // Clear 3D scene items FIRST (fixes bug where old items pile up)
      if (window.__craft3D) {
        window.__craft3D.clearItems();
      }

      if (!recipe) return;

      // Mark the matching list item active
      recipeItems.forEach((el) => el.classList.remove('active'));
      const matchItem = document.querySelector('.item-icon-btn[data-recipe-id="' + recipe.id + '"]');
      if (matchItem) {
        matchItem.classList.add('active');
        try { matchItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); } catch (e) {}
      }

      // Drop items onto the 3D crafting table one by one
      const flatGrid = [];
      for (let r = 0; r < 3; r++) {
        for (let c = 0; c < 3; c++) {
          const v = recipe.grid && recipe.grid[r] ? recipe.grid[r][c] : null;
          flatGrid.push(v);
        }
      }
      flatGrid.forEach((itemName, idx) => {
        if (!itemName) return;
        setTimeout(() => {
          if (window.__craft3D) {
            window.__craft3D.dropItem(itemName, idx);
          }
        }, idx * 100);
      });

      // After all items dropped, move camera up to show recipe from above
      const filledCount = flatGrid.filter(Boolean).length;
      setTimeout(() => {
        if (emptyHint) emptyHint.hidden = true;

        // Camera moves up to show the recipe from above
        if (window.__craft3D) {
          window.__craft3D.showRecipe();
        }

        // Recipe info
        recipeTitle.textContent = recipe.nameFa;
        recipeDesc.textContent = recipe.description || '';
        if (recipe.output.count && recipe.output.count > 1) {
          recipeCount.textContent = '×' + recipe.output.count;
          recipeCount.hidden = false;
        } else {
          recipeCount.hidden = true;
        }
        wikiLink.href = BASE + 'wiki/' + (recipe.wikiSlug || 'crafting-recipes');
        recipeInfo.hidden = false;
      }, flatGrid.filter(Boolean).length * 60 + 120);
    }

    // ── Filter the item list by name (all items, not just recipes) ──
    function filterList(query) {
      const q = (query || '').trim().toLowerCase();
      let visibleCount = 0;
      recipeItems.forEach((el) => {
        const name = el.getAttribute('data-item-name') || '';
        const recipeId = el.getAttribute('data-recipe-id');
        if (!q) {
          el.style.display = '';
          visibleCount++;
          return;
        }
        // Match against item name, recipe nameFa, recipe nameEn, aliases
        let matches = name.toLowerCase().includes(q);
        if (!matches && recipeId) {
          const r = findById(recipeId);
          if (r) {
            matches = (r.nameFa || '').toLowerCase().includes(q) ||
              (r.nameEn || '').toLowerCase().includes(q) ||
              (r.aliases || []).some((a) => a.toLowerCase().includes(q));
          }
        }
        el.style.display = matches ? '' : 'none';
        if (matches) visibleCount++;
      });
      if (recipeListCount) recipeListCount.textContent = String(visibleCount);
      if (recipeListEmpty) recipeListEmpty.hidden = visibleCount > 0;
    }

    // ── Clear grid + info ──────────────────────────────────
    function clearGrid() {
      if (window.__craft3D) {
        window.__craft3D.clearItems();
        window.__craft3D.resetCamera();
      }
      recipeInfo.hidden = true;
      if (emptyHint) emptyHint.hidden = false;
      recipeItems.forEach((el) => el.classList.remove('active'));
    }

    // ── Event handlers ─────────────────────────────────────
    // Search input (typed)
    let searchTimer = null;
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const q = e.target.value;
        if (searchClear) searchClear.hidden = q.length === 0;

        // Always filter the list live
        filterList(q);

        // Only auto-render the grid when query is non-empty AND a recipe is found
        clearTimeout(searchTimer);
        if (!q || q.trim().length < 2) {
          // Don't clear grid on every short query — keep current state
          return;
        }
        searchTimer = setTimeout(() => {
          const recipe = findRecipe(q);
          // Only re-render if the found recipe differs from the active one
          const activeItem = document.querySelector('.recipe-item.active');
          const activeId = activeItem ? activeItem.getAttribute('data-recipe-id') : null;
          if (recipe && recipe.id !== activeId) {
            renderRecipe(recipe);
          } else if (!recipe && activeId) {
            // No match — leave current grid alone (less jarring)
          }
        }, 250);
      });

      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          clearTimeout(searchTimer);
          const q = searchInput.value.trim();
          if (q.length < 2) return;
          const recipe = findRecipe(q);
          if (recipe) {
            renderRecipe(recipe);
          } else {
            // Brief shake to indicate no match
            if (searchInput.parentElement) {
              searchInput.parentElement.style.animation = 'none';
              void searchInput.parentElement.offsetWidth;
              searchInput.parentElement.style.animation = 'searchShake 0.4s ease-in-out';
            }
          }
        } else if (e.key === 'Escape') {
          searchInput.value = '';
          if (searchClear) searchClear.hidden = true;
          filterList('');
          searchInput.focus();
        }
      });
    }

    // Clear-search button
    if (searchClear) {
      searchClear.addEventListener('click', () => {
        searchInput.value = '';
        searchClear.hidden = true;
        filterList('');
        searchInput.focus();
      });
    }

    // Chips — EXACT id lookup, NO fuzzy
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const id = chip.getAttribute('data-recipe-id');
        const recipe = findById(id);
        if (!recipe) return;
        // Set the search box to the EXACT nameFa so the user sees what they clicked
        searchInput.value = recipe.nameFa;
        if (searchClear) searchClear.hidden = false;
        filterList(recipe.nameFa);
        renderRecipe(recipe);
      });
    });

    // Item grid: single click = load recipe (if has one), double-click = always try
    recipeItems.forEach((el) => {
      // Single click — load recipe if the item has one
      el.addEventListener('click', () => {
        const hasRecipe = el.getAttribute('data-has-recipe') === 'true';
        const recipeId = el.getAttribute('data-recipe-id');
        const itemName = el.getAttribute('data-item-name') || '';
        if (hasRecipe && recipeId) {
          const recipe = findById(recipeId);
          if (recipe) {
            searchInput.value = recipe.nameFa;
            if (searchClear) searchClear.hidden = false;
            filterList(recipe.nameFa);
            renderRecipe(recipe);
          }
        } else {
          // No recipe — show info message
          showNoRecipeMessage(itemName);
        }
      });
      // Double-click — force recipe view even for no-recipe items (shows message)
      el.addEventListener('dblclick', () => {
        const hasRecipe = el.getAttribute('data-has-recipe') === 'true';
        const recipeId = el.getAttribute('data-recipe-id');
        const itemName = el.getAttribute('data-item-name') || '';
        if (hasRecipe && recipeId) {
          const recipe = findById(recipeId);
          if (recipe) renderRecipe(recipe);
        } else {
          showNoRecipeMessage(itemName);
        }
      });
    });

    // Show "no recipe" message for items that can't be crafted
    function showNoRecipeMessage(itemName) {
      if (window.__craft3D) {
        window.__craft3D.clearItems();
        window.__craft3D.resetCamera();
      }
      if (emptyHint) {
        emptyHint.hidden = false;
        emptyHint.innerHTML = '<div style="text-align:center;padding:1rem">' +
          '<p style="font-size:1.1rem;font-weight:700;color:var(--gold,#e8c84a);margin-bottom:0.5rem">' +
          itemName + '</p>' +
          '<p style="color:var(--text-2,#b8b8d0)">این آیتم کرافت ندارد.</p>' +
          '<p style="color:var(--text-3,#8a8aa8);font-size:0.8rem;margin-top:0.5rem">' +
          'در چست‌ها، روی زمین، یا از کشتن ماب‌ها پیدا می‌شه.</p>' +
          '</div>';
      }
      recipeInfo.hidden = true;
    }

    // Clear-grid button
    if (clearGridBtn) {
      clearGridBtn.addEventListener('click', () => {
        clearGrid();
        searchInput.value = '';
        if (searchClear) searchClear.hidden = true;
        filterList('');
        searchInput.focus();
      });
    }

    // ── Drag & Drop (phase 102) ──────────────────────────────────
    // Drag recipe items from the list → drop into craft-slots to build a grid.
    // Also: click a filled slot to clear it; drag a slot to another slot to move.

    // 1. Make recipe-items draggable (set dataTransfer with recipe id + name)
    function setupDragSource() {
      document.querySelectorAll('.item-icon-btn[draggable="true"]').forEach((el) => {
        el.addEventListener('dragstart', (e) => {
          const id = el.getAttribute('data-recipe-id');
          const name = el.getAttribute('data-recipe-name') || '';
          if (e.dataTransfer) {
            e.dataTransfer.setData('text/plain', id + '|' + name);
            e.dataTransfer.effectAllowed = 'copy';
          }
          el.classList.add('dragging');
        });
        el.addEventListener('dragend', () => {
          el.classList.remove('dragging');
        });
      });
    }
    setupDragSource();

    // 2. Re-bind drag source when the list re-renders (after search filter)
    const recipeListEl = document.getElementById('recipeList');
    if (recipeListEl) {
      const observer = new MutationObserver(() => setupDragSource());
      observer.observe(recipeListEl, { childList: true, subtree: true });
    }

    // 3. Make the 3D canvas droppable — drag item from list → drop on table
    const craft3DWrap = document.getElementById('craft3DWrap');
    if (craft3DWrap) {
      craft3DWrap.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'copy';
        craft3DWrap.style.borderColor = 'var(--grass-2, #7cc84a)';
      });
      craft3DWrap.addEventListener('dragleave', () => {
        craft3DWrap.style.borderColor = '';
      });
      craft3DWrap.addEventListener('drop', (e) => {
        e.preventDefault();
        craft3DWrap.style.borderColor = '';
        const raw = e.dataTransfer ? e.dataTransfer.getData('text/plain') : '';
        if (!raw) return;
        const id = raw.split('|')[0];
        const recipe = findById(id);
        if (recipe) {
          renderRecipe(recipe);
          searchInput.value = recipe.nameFa;
          if (searchClear) searchClear.hidden = false;
          filterList(recipe.nameFa);
        }
      });
    }

    // 4. Touch support for mobile — tap item then tap the 3D canvas
    let pendingItem = null;
    document.querySelectorAll('.item-icon-btn[draggable="true"]').forEach((el) => {
      el.addEventListener('touchstart', () => {
        pendingItem = {
          id: el.getAttribute('data-recipe-id'),
          name: el.getAttribute('data-recipe-name') || '',
        };
      });
    });
    if (craft3DWrap) {
      craft3DWrap.addEventListener('touchend', () => {
        if (!pendingItem) return;
        const recipe = findById(pendingItem.id);
        if (recipe) {
          renderRecipe(recipe);
          searchInput.value = recipe.nameFa;
          if (searchClear) searchClear.hidden = false;
          filterList(recipe.nameFa);
        }
        pendingItem = null;
      });
    }
  })();
</script>

<!-- ═══ 3D Crafting Table Scene (Three.js) ═══ -->
<script is:inline type="module" data-base={BASE}>
  import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.186.1/build/three.module.js';

  const canvas = document.getElementById('craft3DCanvas');
  const hint = document.getElementById('craft3DHint');
  if (!canvas) throw new Error('no craft3DCanvas');

  const BASE = '/website/';

  // Scene setup
  const scene = new THREE.Scene();
  scene.background = null;

  const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100);
  // Fixed angle — 75° from horizontal (15° tilt from straight down)
  camera.position.set(0, 6.5, 3.5);
  camera.lookAt(0, 0.3, 0);

  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  // Lighting
  const ambient = new THREE.AmbientLight(0xffffff, 0.6);
  scene.add(ambient);
  const dirLight = new THREE.DirectionalLight(0xfff5e0, 0.7);
  dirLight.position.set(3, 6, 4);
  scene.add(dirLight);

  // Crafting table block — NO rotation, locked in place
  const loader = new THREE.TextureLoader();
  loader.crossOrigin = 'anonymous';
  const topTex = loader.load(BASE + 'textures/blocks/crafting-table-top.png', () => {
    if (hint) hint.hidden = true;
  });
  const sideTex = loader.load(BASE + 'textures/blocks/crafting-table-side.png');
  topTex.magFilter = THREE.NearestFilter;
  sideTex.magFilter = THREE.NearestFilter;

  const blockGeo = new THREE.BoxGeometry(2, 2, 2);
  const materials = [
    new THREE.MeshLambertMaterial({ map: sideTex }),
    new THREE.MeshLambertMaterial({ map: sideTex }),
    new THREE.MeshLambertMaterial({ map: topTex }),
    new THREE.MeshLambertMaterial({ color: 0x8B5A2B }),
    new THREE.MeshLambertMaterial({ map: sideTex }),
    new THREE.MeshLambertMaterial({ map: sideTex }),
  ];
  const tableBlock = new THREE.Mesh(blockGeo, materials);
  scene.add(tableBlock);

  // Items sit on a GROUP that is locked to the table (no rotation)
  const itemGroup = new THREE.Group();
  scene.add(itemGroup);

  // Camera animation: smooth transition between idle and recipe-view
  let camTargetY = 6.5, camTargetZ = 3.5;
  let camAnimating = false;

  function clearItems() {
    // Remove all old item meshes + dispose geometry/materials
    while (itemGroup.children.length > 0) {
      const child = itemGroup.children[0];
      if (child.geometry) child.geometry.dispose();
      if (child.material) {
        if (child.material.map) child.material.map.dispose();
        child.material.dispose();
      }
      itemGroup.remove(child);
    }
  }

  window.__craft3D = {
    clearItems: clearItems,
    dropItem: function(itemName, slotIdx) {
      const url = BASE + 'textures/items/' + itemName + '.png';
      loader.load(url, (tex) => {
        tex.magFilter = THREE.NearestFilter;
        createItemPlane(tex, slotIdx);
      }, undefined, () => {
        // fallback to blocks folder
        loader.load(BASE + 'textures/blocks/' + itemName + '.png', (tex) => {
          tex.magFilter = THREE.NearestFilter;
          createItemPlane(tex, slotIdx);
        });
      });
    },
    showRecipe: function() {
      camTargetY = 7.5;
      camTargetZ = 1.5;
      camAnimating = true;
    },
    resetCamera: function() {
      clearItems();
      camTargetY = 6.5;
      camTargetZ = 3.5;
      camAnimating = true;
    }
  };

  function createItemPlane(texture, slotIdx) {
    const mat = new THREE.MeshBasicMaterial({ map: texture, transparent: true, alphaTest: 0.5 });
    const geo = new THREE.PlaneGeometry(0.58, 0.58);
    const mesh = new THREE.Mesh(geo, mat);
    // Grid layout EXACTLY aligned with the crafting table's 3x3 pattern
    // The crafting table texture has grid lines at 5/16 and 10/16
    // Each cell is ~5.33/16 of the block width = 5.33/16 * 2 = 0.667 units
    // Center the grid: offset by -0.667 so the grid is centered on the block
    const col = slotIdx % 3;
    const row = Math.floor(slotIdx / 3);
    const cellSize = 0.62;  // matches the grid cell size on the texture
    const offset = -cellSize; // center the 3x3 grid
    mesh.position.set(
      offset + col * cellSize,
      3, // start above, will animate down
      offset + row * cellSize
    );
    mesh.rotation.x = -Math.PI / 2;
    itemGroup.add(mesh);

    // Animate falling onto table
    const startY = 3;
    const endY = 1.06;
    const duration = 600;
    const startTime = performance.now();
    mesh.userData.animate = function(now) {
      const t = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      mesh.position.y = startY + (endY - startY) * eased;
      if (t >= 1) mesh.userData.animate = null;
    };
  }

  // Render loop — NO table rotation, items locked to table
  function render(now) {
    requestAnimationFrame(render);
    // Camera animation only (no block rotation)
    if (camAnimating) {
      camera.position.y += (camTargetY - camera.position.y) * 0.06;
      camera.position.z += (camTargetZ - camera.position.z) * 0.06;
      camera.lookAt(0, 0.3, 0);
      if (Math.abs(camera.position.y - camTargetY) < 0.01) camAnimating = false;
    }
    // Animate falling items
    itemGroup.children.forEach(mesh => {
      if (mesh.userData.animate) mesh.userData.animate(now);
    });
    renderer.render(scene, camera);
  }
  render(0);

  // Resize handler
  function onResize() {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    if (w === 0 || h === 0) return;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h, false);
  }
  window.addEventListener('resize', onResize);
  setTimeout(onResize, 100);
</script>

