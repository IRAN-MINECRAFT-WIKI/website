---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'قوانین', url: '/terms' },
];
---

<BaseLayout
  path="/terms"
  title="قوانین استفاده — MineBed Farsi"
  description="قوانین استفاده از خدمات MineBed Farsi: دانلود، استفاده و توزیع محتوا."
>
  <Breadcrumbs items={breadcrumb} />
  <article class="mc-panel p-6 prose prose-invert max-w-none">
    <h1>قوانین استفاده</h1>
    <p>آخرین به‌روزرسانی: آذر ۱۴۰۴</p>

    <h2>پذیرش قوانین</h2>
    <p>
      با استفاده از این سایت، شما تمام قوانین زیر را می‌پذیرید. اگر با هر یک
      از این قوانین مخالف هستید، لطفاً از استفاده‌ی سایت خودداری کنید.
    </p>

    <h2>محتوای افزونه‌ها</h2>
    <p>
      تمام افزونه‌های موجود در MineBed Farsi از منابع عمومی (MCPEDL و...)
      جمع‌آوری و ترجمه شده‌اند. اعتبار اصلی ساخت هر افزونه متعلق به سازنده‌ی
      آن است. ما هیچ ادعایی برای مالکیت این فایل‌ها نداریم.
    </p>

    <h2>استفاده‌ی شخصی</h2>
    <p>
      محتوای دانلود شده از این سایت فقط برای استفاده‌ی شخصی است. شما
      نمی‌توانید فایل‌ها را مجدداً بفروشید یا توزیع کنید. برای تجاری
      کردن هر فایل، باید با سازنده‌ی اصلی آن تماس بگیرید.
    </p>

    <h2>سلب مسئولیت</h2>
    <p>
      ما تضمین نمی‌کنیم که هر افزونه به طور کامل روی دستگاه شما کار کند.
      همچنین مسئولیت هرگونه آسیب احتمالی به دستگاه شما بر عهده‌ی شماست.
    </p>

    <h2>کپی‌رایت</h2>
    <p>
      تمام محتوای متنی و گرافیکی MineBed Farsi (به جز افزونه‌ها) متعلق به این
      پروژه است. ماینکرفت و لوگوهای آن متعلق به Mojang Studios و Microsoft
      است.
    </p>

    <h2>تغییرات</h2>
    <p>
      ما ممکن است این قوانین را در هر زمان تغییر دهیم. ادامه‌ی استفاده از
      سایت پس از تغییر، به منزله‌ی پذیرش قوانین جدید است.
    </p>
  </article>
</BaseLayout>
