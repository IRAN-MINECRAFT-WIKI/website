---
// src/pages/admin-minebed-control.astro
// Hidden admin panel for MineBed.
//
// URL: /admin-minebed-control
//   This URL is intentionally NOT in the sitemap, NOT in robots.txt
//   (in fact, robots.txt has `Disallow: /admin-minebed-control`), and
//   NOT linked from anywhere on the public site. The only way to
//   discover it is by being told — i.e. this is "security by
//   obscurity" rather than real security. Real security is the
//   PocketBase admin token required to actually mutate any data;
//   the password form here just gates the UI.
//
// What it does:
//   1. Login form — user pastes the PocketBase admin JWT into a
//      password field. We store it in sessionStorage (NOT localStorage)
//      as `adminToken`. sessionStorage is per-tab and dies on tab
//      close, so a forgotten login doesn't outlive the day.
//   2. Dashboard tab — shows the headline numbers (online users,
//      pending seeds, total visits).
//   3. Queue tab — table of pending seeds with filter + pagination
//      + Test/Approve/Reject buttons.
//   4. Stats tab — same numbers as dashboard + a 24h visits chart.
//
// Graceful degradation:
//   Every API call is wrapped in a try/catch. If PocketBase is
//   unreachable (no backend deployed yet, dev machine, server down),
//   the panel shows a friendly "Backend not available — showing
//   simulated data" banner and populates the tables with simulated
//   rows so the admin can still poke around the UI before deploying
//   the backend.
import BaseLayout from '@layouts/BaseLayout.astro';

// ⚙️ PB_URL — change this to your production PocketBase URL before
// deploying. Default to the local dev server so the panel works
// out-of-the-box with `bun run dev` + `./pocketbase serve`.
const PB_URL = 'http://127.0.0.1:8090';

// PerPage for the queue table.
const PER_PAGE = 20;
---

<BaseLayout
  path="/admin-minebed-control"
  title="پنل مدیریت MineBed"
  description="پنل مدیریت"
  noindex={true}
>
  <!-- Outer container -->
  <div class="adm-wrap">
    <!-- Login screen -->
    <section id="loginScreen" class="adm-card adm-login">
      <header class="adm-login-head">
        <div class="adm-lock-icon" aria-hidden="true">🔐</div>
        <h1 class="adm-login-title">پنل مدیریت MineBed</h1>
        <p class="adm-login-sub">
          برای ورود، توکن ادمین PocketBase را در کادر زیر وارد کنید.
          این صفحه در نقشه‌ی سایت یا فهرست عمومی نیست.
        </p>
      </header>

      <form id="loginForm" class="adm-login-form" autocomplete="off">
        <label class="adm-field">
          <span class="adm-field-label">توکن ادمین</span>
          <input
            id="adminTokenInput"
            type="password"
            class="adm-input"
            placeholder="eyJhbGciOiJIUzI1NiIs…"
            autocomplete="off"
            spellcheck={false}
            required
          />
        </label>
        <div class="adm-login-actions">
          <button type="submit" class="adm-btn primary big">
            <span aria-hidden="true">▶</span> ورود
          </button>
          <button type="button" id="devLoginBtn" class="adm-btn ghost">
            <span aria-hidden="true">🧪</span> ورود با داده‌ی شبیه‌سازی
          </button>
        </div>
        <p class="adm-login-hint">
          توکن در <code>sessionStorage</code> ذخیره می‌شود و با بستن tab پاک می‌شود.
        </p>
      </form>
    </section>

    <!-- Main admin (hidden until login) -->
    <section id="adminMain" class="adm-main hidden">
      <!-- Top bar -->
      <header class="adm-topbar">
        <div class="adm-topbar-left">
          <span class="adm-logo" aria-hidden="true">🛠️</span>
          <div>
            <h1 class="adm-title">پنل مدیریت MineBed</h1>
            <p class="adm-subtitle">
              <span id="backendStatus" class="adm-status-pill">
                <span class="adm-status-dot" aria-hidden="true"></span>
                <span id="backendStatusText">در حال بررسی…</span>
              </span>
            </p>
          </div>
        </div>
        <div class="adm-topbar-right">
          <button id="refreshBtn" class="adm-btn ghost small">
            <span aria-hidden="true">🔄</span> به‌روزرسانی
          </button>
          <button id="logoutBtn" class="adm-btn danger small">
            <span aria-hidden="true">🚪</span> خروج
          </button>
        </div>
      </header>

      <!-- Backend-unavailable banner (hidden unless needed) -->
      <div id="backendBanner" class="adm-banner hidden" role="status" aria-live="polite">
        <span aria-hidden="true">⚠️</span>
        <span id="backendBannerText">
          سرور PocketBase در دسترس نیست — نمایش داده‌ی شبیه‌سازی.
          بعد از راه‌اندازی backend، صفحه را به‌روزرسانی کنید.
        </span>
      </div>

      <!-- Tabs -->
      <nav class="adm-tabs" role="tablist">
        <button class="adm-tab active" data-tab="dashboard" role="tab" aria-selected="true">
          <span aria-hidden="true">📊</span> داشبورد
        </button>
        <button class="adm-tab" data-tab="queue" role="tab" aria-selected="false">
          <span aria-hidden="true">📥</span> صف سیدها
          <span class="adm-tab-badge" id="pendingBadge" aria-hidden="true">—</span>
        </button>
        <button class="adm-tab" data-tab="stats" role="tab" aria-selected="false">
          <span aria-hidden="true">📈</span> آمار
        </button>
      </nav>

      <!-- ============================================================ -->
      <!-- Dashboard tab                                                 -->
      <!-- ============================================================ -->
      <div class="adm-tab-panel active" data-panel="dashboard" role="tabpanel">
        <div class="adm-kpi-grid">
          <div class="adm-kpi-card">
            <div class="adm-kpi-head">
              <span class="adm-kpi-dot green" aria-hidden="true"></span>
              <span class="adm-kpi-label">کاربر آنلاین</span>
            </div>
            <div class="adm-kpi-value" id="kpiOnline">—</div>
            <div class="adm-kpi-sub">به‌روزرسانی هر ۳۰ ثانیه</div>
          </div>
          <div class="adm-kpi-card">
            <div class="adm-kpi-head">
              <span aria-hidden="true">📥</span>
              <span class="adm-kpi-label">سید در انتظار</span>
            </div>
            <div class="adm-kpi-value" id="kpiPending">—</div>
            <div class="adm-kpi-sub">نیازمند بررسی</div>
          </div>
          <div class="adm-kpi-card">
            <div class="adm-kpi-head">
              <span aria-hidden="true">📦</span>
              <span class="adm-kpi-label">سید منتشرشده</span>
            </div>
            <div class="adm-kpi-value" id="kpiPublished">—</div>
            <div class="adm-kpi-sub">همه‌ی زمان‌ها</div>
          </div>
          <div class="adm-kpi-card">
            <div class="adm-kpi-head">
              <span aria-hidden="true">👁️</span>
              <span class="adm-kpi-label">کل بازدیدها</span>
            </div>
            <div class="adm-kpi-value" id="kpiVisits">—</div>
            <div class="adm-kpi-sub">از راه‌اندازی backend</div>
          </div>
        </div>

        <div class="adm-row">
          <div class="adm-card adm-half">
            <h2 class="adm-card-title">
              <span aria-hidden="true">⚡</span> اقدام‌های سریع
            </h2>
            <div class="adm-quick-actions">
              <button class="adm-btn primary" data-quick="approve-all-tested">
                <span aria-hidden="true">✅</span> تأیید همه‌ی سیدهای تست‌شده
              </button>
              <button class="adm-btn ghost" data-quick="refresh-now">
                <span aria-hidden="true">🔄</span> به‌روزرسانی داده‌ها
              </button>
              <a class="adm-btn ghost" href="#queue-tab" data-quick="goto-queue">
                <span aria-hidden="true">📋</span> رفتن به صف
              </a>
              <a class="adm-btn ghost" href="/seeds" target="_blank" rel="noopener">
                <span aria-hidden="true">🌍</span> مشاهده‌ی سیدهای عمومی
              </a>
            </div>
          </div>

          <div class="adm-card adm-half">
            <h2 class="adm-card-title">
              <span aria-hidden="true">📜</span> فعالیت اخیر
            </h2>
            <ul id="recentList" class="adm-recent-list">
              <li class="adm-recent-empty">— در حال بارگذاری…</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- Queue tab                                                     -->
      <!-- ============================================================ -->
      <div class="adm-tab-panel hidden" data-panel="queue" role="tabpanel">
        <div class="adm-card">
          <!-- Filters -->
          <div class="adm-filters">
            <div class="adm-filter-group">
              <label class="adm-field">
                <span class="adm-field-label">وضعیت</span>
                <select id="filterStatus" class="adm-input">
                  <option value="pending">⏳ در انتظار</option>
                  <option value="all">همه</option>
                  <option value="approved">✅ تأییدشده</option>
                  <option value="rejected">❌ ردشده</option>
                </select>
              </label>
              <label class="adm-field">
                <span class="adm-field-label">نسخه</span>
                <select id="filterVersion" class="adm-input">
                  <option value="all">همه</option>
                  <option value="1.21">1.21</option>
                  <option value="1.20">1.20</option>
                  <option value="1.19">1.19</option>
                  <option value="1.18">1.18</option>
                  <option value="1.17">1.17</option>
                  <option value="1.16">1.16</option>
                </select>
              </label>
              <label class="adm-field">
                <span class="adm-field-label">پلتفرم</span>
                <select id="filterPlatform" class="adm-input">
                  <option value="all">همه</option>
                  <option value="Bedrock">📱 بدراک</option>
                  <option value="Java">☕ جاوا</option>
                </select>
              </label>
            </div>
            <div class="adm-filter-actions">
              <button id="applyFiltersBtn" class="adm-btn primary small">
                <span aria-hidden="true">🔍</span> اعمال فیلتر
              </button>
              <button id="resetFiltersBtn" class="adm-btn ghost small">
                <span aria-hidden="true">✕</span> پاک‌سازی
              </button>
            </div>
          </div>

          <!-- Table -->
          <div class="adm-table-wrap">
            <table class="adm-table">
              <thead>
                <tr>
                  <th>سید</th>
                  <th>نسخه</th>
                  <th>پلتفرم</th>
                  <th>ویژگی‌ها</th>
                  <th>UUID کاربر</th>
                  <th>IP</th>
                  <th>تاریخ</th>
                  <th>وضعیت</th>
                  <th>اقدامات</th>
                </tr>
              </thead>
              <tbody id="queueBody">
                <!-- rows injected by JS -->
              </tbody>
            </table>
            <div id="queueEmpty" class="adm-empty hidden">
              <div class="adm-empty-icon" aria-hidden="true">🌱</div>
              <p>هیچ سیدی در این فیلتر نیست.</p>
            </div>
            <div id="queueLoading" class="adm-empty">
              <div class="adm-spinner" aria-hidden="true"></div>
              <p>در حال بارگذاری…</p>
            </div>
          </div>

          <!-- Pagination -->
          <div class="adm-pagination">
            <button id="prevPageBtn" class="adm-btn ghost small" disabled>
              <span aria-hidden="true">◀</span> قبلی
            </button>
            <span class="adm-page-info">
              صفحه‌ی <span id="curPage">۱</span> از <span id="totalPages">۱</span>
              · <span id="totalRows">۰</span> رکورد
            </span>
            <button id="nextPageBtn" class="adm-btn ghost small" disabled>
              بعدی <span aria-hidden="true">▶</span>
            </button>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- Stats tab                                                     -->
      <!-- ============================================================ -->
      <div class="adm-tab-panel hidden" data-panel="stats" role="tabpanel">
        <div class="adm-kpi-grid">
          <div class="adm-kpi-card">
            <div class="adm-kpi-head">
              <span class="adm-kpi-dot green" aria-hidden="true"></span>
              <span class="adm-kpi-label">آنلاین الان</span>
            </div>
            <div class="adm-kpi-value" id="statsOnline">—</div>
          </div>
          <div class="adm-kpi-card">
            <div class="adm-kpi-head">
              <span aria-hidden="true">👁️</span>
              <span class="adm-kpi-label">بازدید امروز</span>
            </div>
            <div class="adm-kpi-value" id="statsToday">—</div>
          </div>
          <div class="adm-kpi-card">
            <div class="adm-kpi-head">
              <span aria-hidden="true">📈</span>
              <span class="adm-kpi-label">بازدید این هفته</span>
            </div>
            <div class="adm-kpi-value" id="statsWeek">—</div>
          </div>
          <div class="adm-kpi-card">
            <div class="adm-kpi-head">
              <span aria-hidden="true">🌍</span>
              <span class="adm-kpi-label">IPهای یکتای امروز</span>
            </div>
            <div class="adm-kpi-value" id="statsUniqueIps">—</div>
          </div>
        </div>

        <div class="adm-card">
          <h2 class="adm-card-title">
            <span aria-hidden="true">📊</span> بازدید ۲۴ ساعته
          </h2>
          <div id="statsChart" class="adm-chart-wrap">
            <svg viewBox="0 0 480 200" class="adm-chart" id="visitsSvg" aria-label="نمودار بازدید ۲۴ ساعته">
              <!-- bars injected by JS -->
            </svg>
          </div>
          <p class="adm-chart-cap">محور افقی: ساعت ۰ تا ۲۳ · محور عمودی: تعداد بازدید</p>
        </div>

        <div class="adm-card">
          <h2 class="adm-card-title">
            <span aria-hidden="true">📋</span> صفحات پر‌بازدید
          </h2>
          <ol id="topPagesList" class="adm-top-list">
            <li class="adm-recent-empty">— در حال بارگذاری…</li>
          </ol>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style is:global>
  /* ============================================================
     Admin panel scoped styles — use the same CSS variables as the
     rest of the site so the panel matches the visual language.
     ============================================================ */
  .adm-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  .adm-card {
    background: rgba(13, 13, 24, 0.7);
    border: 1px solid var(--line, #2a2a3e);
    border-radius: 10px;
    padding: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .adm-card-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.05rem;
    font-weight: 800;
    margin: 0 0 1rem 0;
    color: var(--text, #f0f0fa);
  }

  /* Login screen */
  .adm-login {
    max-width: 480px;
    margin: 3rem auto 0;
    text-align: center;
    background: linear-gradient(135deg, rgba(28, 28, 52, 0.85), rgba(13, 13, 24, 0.95));
    border: 2px solid var(--line, #2a2a3e);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
  }
  .adm-login-head {
    margin-bottom: 1.5rem;
  }
  .adm-lock-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }
  .adm-login-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
    color: var(--text, #f0f0fa);
  }
  .adm-login-sub {
    font-size: 0.8rem;
    color: var(--text-2, #b8b8d0);
    margin: 0;
    line-height: 1.5;
  }

  .adm-login-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: right;
  }
  .adm-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .adm-field-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-3, #8585a3);
  }
  .adm-input {
    background: rgba(0, 0, 0, 0.4);
    border: 2px solid var(--line, #2a2a3e);
    color: var(--text, #f0f0fa);
    padding: 0.6rem 0.85rem;
    font-size: 0.875rem;
    font-family: 'Vazirmatn', 'Rooyin', monospace;
    border-radius: 6px;
    transition: border-color 0.15s, background 0.15s;
    width: 100%;
    box-sizing: border-box;
  }
  .adm-input:focus {
    outline: none;
    border-color: var(--grass-2, #7cc84a);
    background: rgba(0, 0, 0, 0.6);
  }
  .adm-login-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }
  .adm-login-hint {
    font-size: 0.7rem;
    color: var(--text-3, #8585a3);
    margin-top: 0.5rem;
  }
  .adm-login-hint code {
    background: rgba(0, 0, 0, 0.5);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-family: monospace;
    color: var(--diamond, #4aedd9);
  }

  /* Buttons */
  .adm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text, #f0f0fa);
    background: linear-gradient(180deg, rgba(40, 40, 60, 0.9), rgba(20, 20, 36, 0.95));
    border: 2px solid var(--line, #2a2a3e);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    min-height: 38px;
    line-height: 1;
  }
  .adm-btn:hover {
    border-color: rgba(124, 200, 74, 0.5);
    background: linear-gradient(180deg, rgba(50, 50, 76, 0.95), rgba(28, 28, 52, 1));
    transform: translateY(-1px);
  }
  .adm-btn:active {
    transform: translateY(0);
  }
  .adm-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }
  .adm-btn.primary {
    background: linear-gradient(180deg, var(--grass-2, #7cc84a), var(--grass-3, #5fa838));
    color: #0d0d18;
    border-color: var(--grass-2, #7cc84a);
  }
  .adm-btn.primary:hover {
    background: linear-gradient(180deg, #8de35a, #6fb846);
  }
  .adm-btn.ghost {
    background: rgba(28, 28, 52, 0.5);
    color: var(--text-2, #b8b8d0);
  }
  .adm-btn.danger {
    background: linear-gradient(180deg, #d94646, #a32d2d);
    color: #fff;
    border-color: #d94646;
  }
  .adm-btn.small {
    padding: 0.35rem 0.65rem;
    font-size: 0.75rem;
    min-height: 32px;
  }
  .adm-btn.big {
    padding: 0.7rem 1.25rem;
    font-size: 0.95rem;
    min-height: 44px;
  }

  /* Top bar */
  .adm-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.5rem 0 1rem;
    border-bottom: 1px solid var(--line, #2a2a3e);
    margin-bottom: 1.25rem;
  }
  .adm-topbar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .adm-topbar-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .adm-logo {
    font-size: 1.75rem;
    line-height: 1;
  }
  .adm-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    color: var(--text, #f0f0fa);
  }
  .adm-subtitle {
    font-size: 0.75rem;
    margin: 0.15rem 0 0;
    color: var(--text-3, #8585a3);
  }
  .adm-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--line, #2a2a3e);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-2, #b8b8d0);
  }
  .adm-status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-3, #8585a3);
  }
  .adm-status-pill.ok .adm-status-dot {
    background: var(--grass-2, #7cc84a);
    box-shadow: 0 0 6px var(--grass-2, #7cc84a);
    animation: adm-pulse 2s ease-in-out infinite;
  }
  .adm-status-pill.warn .adm-status-dot {
    background: var(--gold, #fcb32b);
  }
  .adm-status-pill.err .adm-status-dot {
    background: var(--redstone, #d94646);
  }
  @keyframes adm-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* Backend banner */
  .adm-banner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    background: rgba(252, 179, 43, 0.12);
    border: 1px solid rgba(252, 179, 43, 0.4);
    border-radius: 8px;
    color: var(--gold, #fcb32b);
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* Tabs */
  .adm-tabs {
    display: flex;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--line, #2a2a3e);
    flex-wrap: wrap;
  }
  .adm-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.95rem;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    color: var(--text-2, #b8b8d0);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 700;
    transition: all 0.15s;
    margin-bottom: -1px;
    font-family: inherit;
  }
  .adm-tab:hover {
    color: var(--text, #f0f0fa);
  }
  .adm-tab.active {
