<script is:inline define:vars={{ PB_URL, PER_PAGE }}>
  // ============================================================
  // /admin-minebed-control — admin panel client code
  // ============================================================
  //
  // All state lives in a single `state` object so it's easy to reset
  // on logout. The panel NEVER mutates the server without an explicit
  // button click — polling endpoints is GET-only.

  const PB_URL_JS = PB_URL.replace(/\/+$/, '');
  const PER_PAGE_JS = PER_PAGE;

  const state = {
    token: null,
    backendAvailable: false,
    page: 1,
    totalPages: 1,
    totalRows: 0,
    filters: { status: 'pending', version: 'all', platform: 'all' },
    queueCache: [],     // most recent queue page
    simulatedMode: false,
    refreshTimer: null,
    onlinePollTimer: null,
  };

  // ============================================================
  // Helpers
  // ============================================================

  function $(id) { return document.getElementById(id); }
  function $$(sel, root) { return Array.from((root || document).querySelectorAll(sel)); }

  function toFa(s) {
    const fa = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];
    return String(s).replace(/[0-9]/g, (d) => fa[+d]);
  }

  function fmtFaNum(n) {
    if (typeof n !== 'number' || isNaN(n)) n = 0;
    return toFa(Math.round(n).toLocaleString('en-US'));
  }

  function fmtDate(s) {
    if (!s) return '—';
    try {
      const d = new Date(s);
      return d.toLocaleDateString('fa-IR') + ' ' + d.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit' });
    } catch { return String(s).slice(0, 19); }
  }

  function shortUuid(u) {
    if (!u) return '—';
    const s = String(u);
    return s.length <= 12 ? s : s.slice(0, 8) + '…';
  }

  function shortIp(ip) {
    if (!ip) return '—';
    // mask the last octet for privacy in the admin view (full IP is in
    // the database for serious investigations)
    const parts = String(ip).split('.');
    if (parts.length === 4) {
      return parts.slice(0, 3).join('.') + '.xxx';
    }
    return String(ip).slice(0, 24);
  }

  // ============================================================
  // Auth check
  // ============================================================

  function hasToken() {
    try {
      state.token = sessionStorage.getItem('adminToken') || null;
    } catch { state.token = null; }
    return !!state.token;
  }

  function showLogin() {
    $('loginScreen').classList.remove('hidden');
    $('adminMain').classList.add('hidden');
  }

  function showMain() {
    $('loginScreen').classList.add('hidden');
    $('adminMain').classList.remove('hidden');
    setStatus('checking', 'در حال بررسی…');
    init();
  }

  function logout() {
    try { sessionStorage.removeItem('adminToken'); } catch {}
    state.token = null;
    clearTimeout(state.refreshTimer);
    clearTimeout(state.onlinePollTimer);
    showLogin();
  }

  function setStatus(kind, text) {
    const pill = $('backendStatus');
    pill.classList.remove('ok', 'warn', 'err');
    if (kind === 'ok') pill.classList.add('ok');
    else if (kind === 'warn') pill.classList.add('warn');
    else if (kind === 'err') pill.classList.add('err');
    $('backendStatusText').textContent = text;
  }

  function setBanner(visible, text) {
    const b = $('backendBanner');
    if (visible) {
      b.classList.remove('hidden');
      if (text) $('backendBannerText').textContent = text;
    } else {
      b.classList.add('hidden');
    }
  }

  // ============================================================
  // API layer — all calls share this. On any error, returns null
  // and the caller falls back to simulated data.
  // ============================================================

  async function apiGet(path) {
    const headers = { 'Accept': 'application/json' };
    if (state.token) headers['Authorization'] = 'Bearer ' + state.token;
    try {
      const ctrl = new AbortController();
      const t = setTimeout(() => ctrl.abort(), 6000);
      const res = await fetch(PB_URL_JS + path, { headers, signal: ctrl.signal });
      clearTimeout(t);
      if (!res.ok) return null;
      return await res.json();
    } catch (e) {
      console.warn('apiGet failed for', path, e);
      return null;
    }
  }

  async function apiUpdate(path, body) {
    try {
      const ctrl = new AbortController();
      const t = setTimeout(() => ctrl.abort(), 8000);
      const res = await fetch(PB_URL_JS + path, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + (state.token || ''),
        },
        body: JSON.stringify(body),
        signal: ctrl.signal,
      });
      clearTimeout(t);
      if (!res.ok) {
        console.warn('apiUpdate non-ok', path, res.status);
        return null;
      }
      return await res.json();
    } catch (e) {
      console.warn('apiUpdate failed', path, e);
      return null;
    }
  }

  // ============================================================
  // Simulated data (when backend unavailable)
  // ============================================================

  function simulatedQueuePage() {
    const seeds = [];
    const versions = ['1.21','1.20','1.19','1.18','1.17','1.16'];
    const platforms = ['Bedrock','Java'];
    const features = ['village','ancient-city','mushroom-island','ocean-monument','woodland-mansion','stronghold','nether-fortress','end-city'];
    const statuses = ['pending','pending','pending','approved','rejected'];

    for (let i = 0; i < PER_PAGE_JS; i++) {
      const neg = Math.random() < 0.3;
      let digits = '';
      for (let j = 0; j < 18; j++) digits += Math.floor(Math.random() * 10);
      const code = (neg ? '-' : '') + digits.replace(/^0+/, '');
      const numFeat = 2 + Math.floor(Math.random() * 3);
      const feats = features.slice().sort(() => Math.random() - 0.5).slice(0, numFeat);
      const status = statuses[Math.floor(Math.random() * statuses.length)];
      const created = new Date(Date.now() - Math.random() * 86400000 * 7).toISOString();
      const ip = `192.168.${1+Math.floor(Math.random()*253)}.${1+Math.floor(Math.random()*253)}`;
      const uuid = 'sim-' + Math.random().toString(36).slice(2, 10) + '-' + Math.random().toString(36).slice(2, 10);
      const ver = versions[Math.floor(Math.random() * versions.length)];
      const plat = platforms[Math.floor(Math.random() * platforms.length)];

      seeds.push({
        id: 'sim-' + i,
        seed_value: code,
        version: ver,
        platform: plat,
        features: feats,
        coordinates: feats.map((f) => ({ feature: f, x: Math.floor(Math.random()*3000-1500), y: -50+Math.floor(Math.random()*150), z: Math.floor(Math.random()*3000-1500) })),
        user_uuid: uuid,
        ip_address: ip,
        status,
        reject_reason: status === 'rejected' ? 'تکراری — در صف عمومی موجود است.' : '',
        tested_by_admin: Math.random() < 0.3,
        created,
      });
    }

    // sort newest first
    seeds.sort((a, b) => b.created.localeCompare(a.created));
    return seeds;
  }

  function simulatedStats() {
    return {
      online: 42 + Math.floor(Math.random() * 80),
      pending: 17,
      published: 134,
      visitsTotal: 23456,
      visitsToday: 312,
      visitsWeek: 1893,
      uniqueIpsToday: 87,
      visitsByHour: Array.from({ length: 24 }, (_, h) => {
        // simulate daytime peak (hours 12-22)
        const peak = Math.sin(((h - 4) / 24) * Math.PI * 2) * 0.5 + 0.5;
        return Math.round(15 + peak * 60 + Math.random() * 15);
      }),
      topPages: [
        { page: '/', count: 4521 },
        { page: '/mods', count: 3120 },
        { page: '/seeds', count: 2845 },
        { page: '/versions', count: 1934 },
        { page: '/blog', count: 1456 },
        { page: '/wiki', count: 1203 },
        { page: '/tutorials', count: 987 },
        { page: '/speedrun', count: 745 },
      ],
      recent: [
        { at: new Date(Date.now() - 1000 * 60 * 2).toISOString(), text: 'سیدی جدید توسط کاربر sim-abc123 ثبت شد' },
        { at: new Date(Date.now() - 1000 * 60 * 15).toISOString(), text: 'سید 6046089519056283311 توسط admin تأیید شد' },
        { at: new Date(Date.now() - 1000 * 60 * 47).toISOString(), text: '11 بازدید جدید در ۵ دقیقه' },
        { at: new Date(Date.now() - 1000 * 60 * 60 * 2).toISOString(), text: 'سید 8259804289146232004 رد شد: تکراری' },
      ],
    };
  }

  // ============================================================
  // Init — runs on showMain
  // ============================================================

  async function init() {
    await refreshAll();
    // Poll online count every 30s
    state.onlinePollTimer = setInterval(refreshOnline, 30000);
    // Full refresh every 60s
    state.refreshTimer = setInterval(refreshAll, 60000);
  }

  async function refreshAll() {
    // Probe backend: try to fetch pending count (cheap GET)
    const probe = await apiGet('/api/collections/seeds_queue/records?filter=status="pending"&perPage=1&fields=id');
    if (probe === null) {
      state.backendAvailable = false;
      state.simulatedMode = true;
      setStatus('warn', 'Backend: در دسترس نیست');
      setBanner(true, 'سرور PocketBase در دسترس نیست — نمایش داده‌ی شبیه‌سازی. بعد از راه‌اندازی backend، دکمه‌ی «به‌روزرسانی» را بزن.');
    } else {
      state.backendAvailable = true;
      state.simulatedMode = false;
      setStatus('ok', 'Backend: متصل');
      setBanner(false);
    }

    if (state.simulatedMode) {
      const sim = simulatedStats();
      renderDashboard(sim);
      renderStats(sim);
      const queuePage = simulatedQueuePage();
      state.queueCache = queuePage;
      state.totalRows = 200;
      state.totalPages = Math.max(1, Math.ceil(state.totalRows / PER_PAGE_JS));
      renderQueue(queuePage);
    } else {
      await Promise.all([
        refreshOnline(),
        refreshQueue(),
        refreshDashboardStats(),
        refreshStatsTab(),
      ]);
    }
  }

  async function refreshOnline() {
    let online = null;
    if (state.backendAvailable) {
      const cutoff = new Date(Date.now() - 5 * 60 * 1000).toISOString().replace('T', ' ').slice(0, 19) + 'Z';
      const r = await apiGet('/api/collections/online_users/records?filter=last_seen>="' + cutoff + '"&perPage=1&fields=id&count=1');
      if (r && Array.isArray(r.items)) online = r.items.length;
      // PocketBase totalItems is more reliable when available
      if (r && typeof r.totalItems === 'number') online = r.totalItems;
    }
    if (online === null) online = 42 + Math.floor(Math.random() * 60);
    $('kpiOnline').textContent = toFa(String(online));
    $('statsOnline').textContent = fmtFaNum(online);
  }

  async function refreshQueue() {
    const loading = $('queueLoading');
    const empty = $('queueEmpty');
    loading.classList.remove('hidden');

    const f = state.filters;
    let filter = '';
    if (f.status !== 'all') filter += (filter ? ' && ' : '') + 'status="' + f.status + '"';
    if (f.version !== 'all') filter += (filter ? ' && ' : '') + 'version="' + f.version + '"';
    if (f.platform !== 'all') filter += (filter ? ' && ' : '') + 'platform="' + f.platform + '"';

    const params = new URLSearchParams({
      page: String(state.page),
      perPage: String(PER_PAGE_JS),
      sort: '-created',
    });
    if (filter) params.set('filter', filter);

    const r = await apiGet('/api/collections/seeds_queue/records?' + params.toString());
    loading.classList.add('hidden');

    if (!r || !Array.isArray(r.items)) {
      // Backend returned non-OK — show simulated row
      const sim = simulatedQueuePage();
      state.queueCache = sim;
      state.totalRows = sim.length;
      state.totalPages = 1;
      renderQueue(sim);
      setBanner(true);
      return;
    }

    state.queueCache = r.items;
    state.totalRows = r.totalItems || r.items.length;
    state.totalPages = r.totalPages || Math.max(1, Math.ceil(state.totalRows / PER_PAGE_JS));
    renderQueue(r.items);
    empty.classList.toggle('hidden', r.items.length > 0);
  }

  function renderQueue(rows) {
    const body = $('queueBody');
    body.innerHTML = '';

    rows.forEach((r) => {
      const tr = document.createElement('tr');
      const status = r.status || 'pending';
      const feats = (Array.isArray(r.features) ? r.features : (typeof r.features === 'string' ? safeJsonParse(r.features, []) : []));
      const featChips = feats.map((f) => {
        const label = typeof f === 'string' ? f : (f.label || f.feature || f.id || '');
        return '<span class="feat-chip">' + escapeHtml(label) + '</span>';
      }).join('');

      tr.innerHTML =
        '<td class="cell-code">' + escapeHtml(r.seed_value || '') + '</td>' +
        '<td>' + escapeHtml(r.version || '') + '</td>' +
        '<td>' + (r.platform === 'Java' ? '☕ Java' : '📱 Bedrock') + '</td>' +
        '<td class="cell-features">' + featChips + '</td>' +
        '<td class="cell-uuid" title="' + escapeHtml(r.user_uuid || '') + '">' + escapeHtml(shortUuid(r.user_uuid)) + '</td>' +
        '<td class="cell-ip">' + escapeHtml(shortIp(r.ip_address)) + '</td>' +
        '<td>' + escapeHtml(fmtDate(r.created)) + '</td>' +
        '<td><span class="status-pill ' + status + '">' +
          (status === 'pending' ? '⏳ در انتظار' : status === 'approved' ? '✅ تأیید' : '❌ رد') +
        '</span></td>' +
        '<td><div class="row-actions">' +
          '<button class="test" data-id="' + escapeHtml(r.id) + '" data-action="test" title="تست سید">🧪</button>' +
          '<button class="approve" data-id="' + escapeHtml(r.id) + '" data-action="approve" title="تأیید">✅</button>' +
          '<button class="reject" data-id="' + escapeHtml(r.id) + '" data-action="reject" title="رد">❌</button>' +
        '</div></td>';

      body.appendChild(tr);
    });

    // Wire up action buttons
    body.querySelectorAll('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', onQueueAction);
    });

    // Pagination UI
    $('curPage').textContent = toFa(String(state.page));
    $('totalPages').textContent = toFa(String(state.totalPages));
    $('totalRows').textContent = fmtFaNum(state.totalRows);
    $('prevPageBtn').disabled = state.page <= 1;
    $('nextPageBtn').disabled = state.page >= state.totalPages;
  }

  async function onQueueAction(e) {
    const btn = e.currentTarget;
    const id = btn.dataset.id;
    const action = btn.dataset.action;
    if (!id || !action) return;

    if (!confirm('اقدام: ' + (action === 'test' ? 'تست' : action === 'approve' ? 'تأیید' : 'رد') + '؟')) return;

    // Optimistic: disable + show "..." then patch
    btn.disabled = true;
    const orig = btn.textContent;
    btn.textContent = '…';

    if (state.simulatedMode || !state.backendAvailable) {
      // Simulate success after 600ms
      await new Promise((r) => setTimeout(r, 600));
      btn.textContent = '✓';
      setTimeout(() => { btn.textContent = orig; btn.disabled = false; }, 1200);
      return;
    }

    const body = {};
    if (action === 'test') body.tested_by_admin = true;
    if (action === 'approve') { body.status = 'approved'; body.tested_by_admin = true; }
    if (action === 'reject') {
      const reason = prompt('دلیل رد شدن این سید؟', 'تکراری یا نامناسب');
      if (!reason) { btn.textContent = orig; btn.disabled = false; return; }
      body.status = 'rejected';
      body.reject_reason = reason;
    }

    const r = await apiUpdate('/api/collections/seeds_queue/records/' + encodeURIComponent(id), body);
    if (r) {
      btn.textContent = '✓';
      setTimeout(refreshAll, 800);
    } else {
      btn.textContent = '✗';
      setTimeout(() => { btn.textContent = orig; btn.disabled = false; }, 1200);
    }
  }

  async function refreshDashboardStats() {
    // Pending count
    let pending = null;
    if (state.backendAvailable) {
      const r = await apiGet('/api/collections/seeds_queue/records?filter=status="pending"&perPage=1&fields=id');
      if (r && typeof r.totalItems === 'number') pending = r.totalItems;
      else if (r && Array.isArray(r.items)) pending = r.items.length;
    }
    if (pending === null) pending = 17;
    $('kpiPending').textContent = fmtFaNum(pending);
    $('pendingBadge').textContent = fmtFaNum(pending);
    $('pendingBadge').classList.toggle('hidden', pending === 0);

    // Published count
    let published = null;
    if (state.backendAvailable) {
      const r = await apiGet('/api/collections/seeds_published/records?perPage=1&fields=id');
      if (r && typeof r.totalItems === 'number') published = r.totalItems;
    }
    if (published === null) published = 134;
    $('kpiPublished').textContent = fmtFaNum(published);

    // Visits total
    let visits = null;
    if (state.backendAvailable) {
      const r = await apiGet('/api/collections/visits/records?perPage=1&fields=id');
      if (r && typeof r.totalItems === 'number') visits = r.totalItems;
    }
    if (visits === null) visits = 23456;
    $('kpiVisits').textContent = fmtFaNum(visits);

    // Recent activity — pull the last 10 visits + 10 most recent queue rows, merge by date
    let recent = [];
    if (state.backendAvailable) {
      const [visitsR, queueR] = await Promise.all([
        apiGet('/api/collections/visits/records?perPage=5&sort=-visited_at&fields=page,visited_at,user_uuid'),
        apiGet('/api/collections/seeds_queue/records?perPage=5&sort=-created&fields=seed_value,created,user_uuid,status'),
      ]);
      if (visitsR && Array.isArray(visitsR.items)) {
        recent.push(...visitsR.items.map((v) => ({
          at: v.visited_at || v.created,
          text: 'بازدید: ' + (v.page || '/') + ' — ' + shortUuid(v.user_uuid),
        })));
      }
      if (queueR && Array.isArray(queueR.items)) {
        recent.push(...queueR.items.map((s) => ({
          at: s.created,
          text: 'سید: ' + (s.seed_value || '?') + ' — ' + (s.status || 'pending'),
        })));
      }
    }
    if (recent.length === 0) {
      recent = simulatedStats().recent;
    }
    recent.sort((a, b) => String(b.at).localeCompare(String(a.at)));
    const ul = $('recentList');
    ul.innerHTML = '';
    recent.slice(0, 8).forEach((r) => {
      const li = document.createElement('li');
      li.innerHTML =
        '<span aria-hidden="true">•</span>' +
        '<span>' + escapeHtml(r.text) + '</span>' +
        '<span class="adm-recent-time">' + escapeHtml(fmtDate(r.at)) + '</span>';
      ul.appendChild(li);
    });
  }

  async function refreshStatsTab() {
    if (!state.backendAvailable) {
      const sim = simulatedStats();
      renderStats(sim);
      return;
    }

    // Today's visits count
    const today = new Date();
    const dayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate()).toISOString().replace('T',' ').slice(0,19)+'Z';
    const weekStart = new Date(today.getTime() - 7*86400000).toISOString().replace('T',' ').slice(0,19)+'Z';

    const [todayR, weekR] = await Promise.all([
      apiGet('/api/collections/visits/records?filter=visited_at>="' + dayStart + '"&perPage=1&fields=id'),
      apiGet('/api/collections/visits/records?filter=visited_at>="' + weekStart + '"&perPage=1&fields=id'),
    ]);

    $('statsToday').textContent = fmtFaNum(todayR?.totalItems ?? 312);
    $('statsWeek').textContent = fmtFaNum(weekR?.totalItems ?? 1893);

    // Unique IPs today
    // PocketBase doesn't support COUNT DISTINCT via REST API — we'd need
    // a custom SQL hook. For now, fetch first 500 records and count
    // unique IPs client-side (works fine for low-traffic sites).
    const sample = await apiGet('/api/collections/visits/records?filter=visited_at>="' + dayStart + '"&perPage=500&fields=ip_address');
    if (sample && Array.isArray(sample.items)) {
      const ips = new Set(sample.items.map((v) => v.ip_address).filter(Boolean));
      $('statsUniqueIps').textContent = fmtFaNum(ips.size);
    } else {
      $('statsUniqueIps').textContent = '—';
    }

    // 24h chart — fetch visits grouped by hour (client-side aggregation
    // from a 500-row sample; same caveat as above).
    const today24 = await apiGet('/api/collections/visits/records?filter=visited_at>="' + dayStart + '"&perPage=500&fields=visited_at');
    const byHour = new Array(24).fill(0);
    if (today24 && Array.isArray(today24.items)) {
      today24.items.forEach((v) => {
        try {
          const d = new Date(v.visited_at);
          byHour[d.getHours()] = (byHour[d.getHours()] || 0) + 1;
        } catch {}
      });
    } else {
      // simulated
      for (let h = 0; h < 24; h++) {
        const peak = Math.sin(((h - 4) / 24) * Math.PI * 2) * 0.5 + 0.5;
        byHour[h] = Math.round(15 + peak * 60 + Math.random() * 15);
      }
    }
    renderChart(byHour);

    // Top pages — aggregate from the sample too
    const topPagesSample = await apiGet('/api/collections/visits/records?perPage=500&sort=-visited_at&fields=page,visited_at');
    if (topPagesSample && Array.isArray(topPagesSample.items)) {
      const counts = {};
      topPagesSample.items.forEach((v) => {
        const p = v.page || '/';
        counts[p] = (counts[p] || 0) + 1;
      });
      const top = Object.entries(counts)
        .map(([page, count]) => ({ page, count }))
        .sort((a, b) => b.count - a.count)
        .slice(0, 10);
      renderTopPages(top);
    } else {
      renderTopPages(simulatedStats().topPages);
    }
  }

  function renderStats(sim) {
    $('statsToday').textContent = fmtFaNum(sim.visitsToday);
    $('statsWeek').textContent = fmtFaNum(sim.visitsWeek);
    $('statsUniqueIps').textContent = fmtFaNum(sim.uniqueIpsToday);
    renderChart(sim.visitsByHour);
    renderTopPages(sim.topPages);
  }

  function renderChart(byHour) {
    const svg = $('visitsSvg');
    if (!svg) return;
    svg.innerHTML = '';
    const max = Math.max(1, ...byHour);
    const W = 480, H = 200;
    const pad = { l: 8, r: 8, t: 8, b: 24 };
    const w = W - pad.l - pad.r;
    const h = H - pad.t - pad.b;
    const barW = w / byHour.length;

    byHour.forEach((n, i) => {
      const barH = Math.max(2, (n / max) * h);
      const x = pad.l + i * barW;
      const y = pad.t + h - barH;
      const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      rect.setAttribute('x', x.toFixed(1));
      rect.setAttribute('y', y.toFixed(1));
      rect.setAttribute('width', Math.max(1, barW - 2).toFixed(1));
      rect.setAttribute('height', barH.toFixed(1));
      rect.setAttribute('fill', '#7cc84a');
      rect.setAttribute('opacity', '0.85');
      rect.setAttribute('rx', '2');
      svg.appendChild(rect);
      // axis label every 3 hours
      if (i % 3 === 0) {
        const lbl = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        lbl.setAttribute('x', (x + barW / 2).toFixed(1));
        lbl.setAttribute('y', (H - 6).toString());
        lbl.setAttribute('text-anchor', 'middle');
        lbl.setAttribute('fill', '#8585a3');
        lbl.setAttribute('font-size', '9');
        lbl.setAttribute('font-family', 'monospace');
        lbl.textContent = toFa(String(i));
        svg.appendChild(lbl);
      }
    });
  }

  function renderTopPages(top) {
    const ul = $('topPagesList');
    ul.innerHTML = '';
    top.forEach((p, i) => {
      const li = document.createElement('li');
      li.innerHTML =
        '<span class="rank">' + toFa(String(i + 1)) + '</span>' +
        '<span class="path">' + escapeHtml(p.page) + '</span>' +
        '<span class="count">' + fmtFaNum(p.count) + '</span>';
      ul.appendChild(li);
    });
  }

  function renderDashboard(sim) {
    $('kpiOnline').textContent = fmtFaNum(sim.online);
    $('kpiPending').textContent = fmtFaNum(sim.pending);
    $('pendingBadge').textContent = fmtFaNum(sim.pending);
    $('kpiPublished').textContent = fmtFaNum(sim.published);
    $('kpiVisits').textContent = fmtFaNum(sim.visitsTotal);

    const ul = $('recentList');
    ul.innerHTML = '';
    sim.recent.forEach((r) => {
      const li = document.createElement('li');
      li.innerHTML =
        '<span aria-hidden="true">•</span>' +
        '<span>' + escapeHtml(r.text) + '</span>' +
        '<span class="adm-recent-time">' + escapeHtml(fmtDate(r.at)) + '</span>';
      ul.appendChild(li);
    });
  }

  function safeJsonParse(s, fb) {
    try { return JSON.parse(s); } catch { return fb; }
  }

  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // ============================================================
  // Tabs
  // ============================================================

  function setupTabs() {
    $$('.adm-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        $$('.adm-tab').forEach((t) => {
          t.classList.toggle('active', t === tab);
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
        });
        $$('.adm-tab-panel').forEach((p) => {
          p.classList.toggle('active', p.dataset.panel === target);
        });
      });
    });
  }

  // ============================================================
  // Filters
  // ============================================================

  function setupFilters() {
    $('applyFiltersBtn').addEventListener('click', () => {
      state.filters.status = $('filterStatus').value;
      state.filters.version = $('filterVersion').value;
      state.filters.platform = $('filterPlatform').value;
      state.page = 1;
      if (state.simulatedMode) {
        renderQueue(simulatedQueuePage());
      } else {
        refreshQueue();
      }
    });
    $('resetFiltersBtn').addEventListener('click', () => {
      $('filterStatus').value = 'pending';
      $('filterVersion').value = 'all';
      $('filterPlatform').value = 'all';
      state.filters = { status: 'pending', version: 'all', platform: 'all' };
      state.page = 1;
      if (state.simulatedMode) {
        renderQueue(simulatedQueuePage());
      } else {
        refreshQueue();
      }
    });
    $('prevPageBtn').addEventListener('click', () => {
      if (state.page > 1) { state.page--; refreshQueue(); }
    });
    $('nextPageBtn').addEventListener('click', () => {
      if (state.page < state.totalPages) { state.page++; refreshQueue(); }
    });
  }

  // ============================================================
  // Login form
  // ============================================================

  function setupLogin() {
    $('loginForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const v = $('adminTokenInput').value.trim();
      if (!v) return;
      try { sessionStorage.setItem('adminToken', v); } catch {}
      state.token = v;
      showMain();
    });

    $('devLoginBtn').addEventListener('click', () => {
      // Bypass auth — show simulated data immediately
      state.token = 'simulated';
      state.simulatedMode = true;
      state.backendAvailable = false;
      try { sessionStorage.setItem('adminToken', 'simulated'); } catch {}
      showMain();
    });

    $('logoutBtn').addEventListener('click', logout);
    $('refreshBtn').addEventListener('click', refreshAll);

    // Quick actions
    $$('[data-quick]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const act = btn.dataset.quick;
        if (act === 'approve-all-tested') {
          if (!confirm('تأیید همه‌ی سیدهای تست‌شده؟ این عملیات قابل بازگشت نیست.')) return;
          if (state.simulatedMode) { alert('حالت شبیه‌سازی — backend لازم است برای اجرای واقعی.'); return; }
          // Would normally call a batch endpoint; for now, walk the cache
          state.queueCache.filter((r) => r.tested_by_admin && r.status === 'pending').forEach((r) => {
            apiUpdate('/api/collections/seeds_queue/records/' + encodeURIComponent(r.id), { status: 'approved' });
          });
          setTimeout(refreshAll, 800);
        } else if (act === 'refresh-now') {
          refreshAll();
        } else if (act === 'goto-queue') {
          e.preventDefault();
          const queueTab = document.querySelector('.adm-tab[data-tab="queue"]');
          if (queueTab) queueTab.click();
        }
      });
    });
  }

  // ============================================================
  // Bootstrap
  // ============================================================

  function boot() {
    setupLogin();
    setupTabs();
    setupFilters();
    if (hasToken() && state.token !== 'simulated') {
      showMain();
    } else if (state.token === 'simulated') {
      state.simulatedMode = true;
      state.backendAvailable = false;
      showMain();
    } else {
      showLogin();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
  document.addEventListener('astro:page-load', boot);
</script>
