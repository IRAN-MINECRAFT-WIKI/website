    /* ═══════════════════════════════════════════════════════════
       WALK ANIMATION
       Body bobs 3px; legs alternate ±22° at hip; arms swing ±15° at
       shoulder. Total period 1.2s. Body bob uses translate3d so the
       whole steve group bobs while individual parts rotate.
       ═══════════════════════════════════════════════════════════ */
    .td-steve.td-mode-walk {
      animation: td-steve-walk-bob 1.2s ease-in-out infinite;
    }
    .td-steve.td-mode-walk .td-steve-leg-r {
      animation: td-leg-swing-r 1.2s ease-in-out infinite;
      transform: translate3d(-8px, -24px, 0);
    }
    .td-steve.td-mode-walk .td-steve-leg-l {
      animation: td-leg-swing-l 1.2s ease-in-out infinite;
      transform: translate3d(8px, -24px, 0);
    }
    .td-steve.td-mode-walk .td-steve-arm-r {
      animation: td-arm-swing-r 1.2s ease-in-out infinite;
      transform: translate3d(-16px, -72px, 0);
    }
    .td-steve.td-mode-walk .td-steve-arm-l {
      animation: td-arm-swing-l 1.2s ease-in-out infinite;
      transform: translate3d(16px, -72px, 0);
    }

    @keyframes td-steve-walk-bob {
      0%, 100% { transform: translate3d(0, 0, 0); }
      25%      { transform: translate3d(0, -2px, 0); }
      50%      { transform: translate3d(0, 0, 0); }
      75%      { transform: translate3d(0, -2px, 0); }
    }

    /* For rotateX, positive angles tilt the leg forward (knee up = forward
       swing), negative = backward. The transform-origin is at the hip,
       so the leg swings around its top. */
    @keyframes td-leg-swing-r {
      0%, 100% { transform: translate3d(-8px, -24px, 0) rotateX(22deg); }
      50%      { transform: translate3d(-8px, -24px, 0) rotateX(-22deg); }
    }
    @keyframes td-leg-swing-l {
      0%, 100% { transform: translate3d(8px, -24px, 0) rotateX(-22deg); }
      50%      { transform: translate3d(8px, -24px, 0) rotateX(22deg); }
    }
    @keyframes td-arm-swing-r {
      0%, 100% { transform: translate3d(-16px, -72px, 0) rotateX(-15deg); }
      50%      { transform: translate3d(-16px, -72px, 0) rotateX(15deg); }
    }
    @keyframes td-arm-swing-l {
      0%, 100% { transform: translate3d(16px, -72px, 0) rotateX(15deg); }
      50%      { transform: translate3d(16px, -72px, 0) rotateX(-15deg); }
    }

    /* ═══════════════════════════════════════════════════════════
       RUN ANIMATION
       Same keyframes shape but faster (0.55s loop) and bigger angles
       (±45° legs, ±35° arms, 5px body bob). Use distinct animation
       names so the walk→run transition is instant (otherwise the
       existing walk keyframe would interpolate awkwardly).
       ═══════════════════════════════════════════════════════════ */
    .td-steve.td-mode-run {
      animation: td-steve-run-bob 0.55s ease-in-out infinite;
    }
    .td-steve.td-mode-run .td-steve-leg-r {
      animation: td-run-leg-r 0.55s ease-in-out infinite;
    }
    .td-steve.td-mode-run .td-steve-leg-l {
      animation: td-run-leg-l 0.55s ease-in-out infinite;
    }
    .td-steve.td-mode-run .td-steve-arm-r {
      animation: td-run-arm-r 0.55s ease-in-out infinite;
    }
    .td-steve.td-mode-run .td-steve-arm-l {
      animation: td-run-arm-l 0.55s ease-in-out infinite;
    }

    @keyframes td-steve-run-bob {
      0%, 100% { transform: translate3d(0, 0, 0); }
      25%      { transform: translate3d(0, -5px, 0); }
      50%      { transform: translate3d(0, 0, 0); }
      75%      { transform: translate3d(0, -5px, 0); }
    }
    @keyframes td-run-leg-r {
      0%, 100% { transform: translate3d(-8px, -24px, 0) rotateX(45deg); }
      50%      { transform: translate3d(-8px, -24px, 0) rotateX(-45deg); }
    }
    @keyframes td-run-leg-l {
      0%, 100% { transform: translate3d(8px, -24px, 0) rotateX(-45deg); }
      50%      { transform: translate3d(8px, -24px, 0) rotateX(45deg); }
    }
    @keyframes td-run-arm-r {
      0%, 100% { transform: translate3d(-16px, -72px, 0) rotateX(-35deg); }
      50%      { transform: translate3d(-16px, -72px, 0) rotateX(35deg); }
    }
    @keyframes td-run-arm-l {
      0%, 100% { transform: translate3d(16px, -72px, 0) rotateX(35deg); }
      50%      { transform: translate3d(16px, -72px, 0) rotateX(-35deg); }
    }

