      }, { passive: true });
      stage.addEventListener('touchmove', function (e) {
        if (e.touches.length === 2) {
          e.preventDefault();
          var d = pinchDist(e);
          if (pinchStart > 0) {
            zoom = pinchInitZoom * (d / pinchStart);
            if (zoom < 0.4) zoom = 0.4;
            if (zoom > 2.2) zoom = 2.2;
            applyTransform();
          }
        }
      }, { passive: false });
      function pinchDist(e) {
        var a = e.touches[0], b = e.touches[1];
        var dx = a.clientX - b.clientX, dy = a.clientY - b.clientY;
        return Math.sqrt(dx * dx + dy * dy);
      }

      // ── Animation mode buttons ───────────────────────────────
      function setMode(mode) {
        // Clear all mode classes on steve
        steve.classList.remove('td-mode-idle', 'td-mode-walk', 'td-mode-run');
        // idle = no extra class (default .td-steve animation is idle-bob);
        // walk/run add their own keyframes (overriding idle).
        if (mode === 'walk') steve.classList.add('td-mode-walk');
        else if (mode === 'run') steve.classList.add('td-mode-run');
        // else idle — base animation is the idle bob via .td-steve

        // Toggle button active state
        [btnIdle, btnWalk, btnRun].forEach(function (b) {
          if (!b) return;
          b.classList.toggle('active', b.dataset.mode === mode);
        });
      }
      if (btnIdle) btnIdle.addEventListener('click', function () { setMode('idle'); });
      if (btnWalk) btnWalk.addEventListener('click', function () { setMode('walk'); });
      if (btnRun)  btnRun.addEventListener('click',  function () { setMode('run'); });

      // ── Auto-rotate toggle ────────────────────────────────────
      function setAutoRotate(on) {
        autoRotate = on;
        if (btnAuto) {
          btnAuto.setAttribute('aria-pressed', on ? 'true' : 'false');
          btnAuto.classList.toggle('active', on);
        }
        if (REDUCED) {
          world.classList.remove('td-auto'); // never auto-spin in reduced mode
          return;
        }
        if (on) world.classList.add('td-auto');
        else world.classList.remove('td-auto');
      }
      if (btnAuto) btnAuto.addEventListener('click', function () {
        setAutoRotate(!autoRotate);
      });

      // ── Reset view ────────────────────────────────────────────
      if (btnReset) btnReset.addEventListener('click', function () {
        rotX = -15; rotY = -25; zoom = 1;
        applyTransform();
      });

      // ── Init ──────────────────────────────────────────────────
      setMode('idle');
      // Default to auto-rotate ON (unless reduced motion)
      if (!REDUCED) setAutoRotate(true);

      // Re-apply after Astro view-transition navigation
      document.addEventListener('astro:page-load', function () {
        // Re-query in case DOM was swapped
        stage = document.getElementById('tdStage');
        world = document.getElementById('tdWorld');
        steve = document.getElementById('tdSteve');
        btnIdle = document.getElementById('tdBtnIdle');
        btnWalk = document.getElementById('tdBtnWalk');
        btnRun = document.getElementById('tdBtnRun');
        btnAuto = document.getElementById('tdBtnAuto');
        btnReset = document.getElementById('tdBtnReset');
        if (!stage || !world || !steve) return;
        applyTransform();
        setMode('idle');
        if (!REDUCED) setAutoRotate(true);
      });
    })();
  </script>
</BaseLayout>
