---
/**
 * /3d — Interactive 3D Minecraft Steve world (Phase 6)
 *
 * Approach: PURE CSS 3D transforms (no Three.js / no skin3d / no
 * external 3D library) so the page stays dependency-free, tiny,
 * and works behind any proxy / CDN. The whole scene is just:
 *
 *   .scene-3d            (perspective wrapper, GPU layer)
 *     .world-3d          (preserve-3d, mouse-drag rotation)
 *       .ground          (3x3 grid of grass-block cubes)
 *       .steve           (preserve-3d group with body parts)
 *         .steve-leg-l/r (4x12x4 box, blue pants)
 *         .steve-body    (4x12x4 box, blue shirt)
 *         .steve-arm-l/r (4x12x4 box, skin color)
 *         .steve-head    (8x8x8 cube with Minecraft-style face)
 *
 * Animation keyframes (all use transform + opacity only):
 *   - idle  : subtle 2px vertical bob
 *   - walk  : legs + arms alternate ±20°, body bobs 3px, 1.2s loop
 *   - run   : same skeleton, 0.55s loop, ±40°, body bobs 5px
 *   - auto-rotate: world rotateY 0→360 over 18s
 *
 * Controls (vanilla JS, no deps):
 *   - Mouse / touch drag  → rotate world (rotateX, rotateY)
 *   - Wheel / pinch      → zoom (perspective + scale)
 *   - Buttons            : idle / walk / run / چرخش خودکار (auto-rotate)
 *
 * Responsive:
 *   - Desktop  : 600×400 viewport, full mouse wheel zoom
 *   - Mobile   : full-width × 300px, touch drag + pinch-zoom
 *
 * Performance / Accessibility:
 *   - will-change: transform on every animated part
 *   - prefers-reduced-motion → disables auto-rotate + walk/run (idle only)
 *   - GPU layers via transform3d, never animates left/top/width/height
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import StructuredData from '@components/StructuredData.astro';
import { breadcrumbJsonLd } from '@/lib/seo';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'دنیای سه‌بعدی', url: '/3d' },
];
const ldBreadcrumb = breadcrumbJsonLd(breadcrumb);

// 3×3 grass platform — every cube is one Minecraft block (16 voxels × 4px = 64px).
// Centered on world origin (x=0, z=0), top of platform at y=0 (so cubes sit
// below origin, top face flush with origin plane).
const PLATFORM = 64;            // cube edge in CSS px
const HALF_P = PLATFORM / 2;
const grid3 = [-PLATFORM, 0, PLATFORM];
const cubes = grid3.flatMap((z) => grid3.map((x) => ({ x, z })));
---

<BaseLayout
  path="/3d"
  title="دنیای سه‌بعدی استیو — Minecraft 3D"
  description="یه دنیای سه‌بعدی تعاملی با استیو در ماینکرفت! با موس بچرخ، زوم کن، و انیمیشن‌های Idle / Walk / Run رو ببین. ساخته‌شده با CSS 3D — بدون هیچ کتابخانه‌ی خارجی."
>
  <StructuredData data={ldBreadcrumb} />
  <Breadcrumbs items={breadcrumb} />

  <!-- ═══════════════════════════════════════════════════════════
       PAGE HEADER
       ═══════════════════════════════════════════════════════════ -->
  <section class="td-header">
    <div class="td-header-icon" aria-hidden="true">
      <svg viewBox="0 0 32 32" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2L4 7v10l8 5 8-5V7l-8-5z" fill="rgba(124,200,74,0.18)" stroke="#7cc84a"/>
        <path d="M4 7l8 5 8-5M12 12v10" stroke="#5fa838"/>
      </svg>
    </div>
    <div class="td-header-text">
      <h1>دنیای سه‌بعدیِ استیو</h1>
      <p>با موس یا انگشت بکش و دنیا رو بچرخون. دکمه‌ها رو امتحان کن تا استیو راه بره یا بدوه!</p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       3D SCENE — main viewport
       ═══════════════════════════════════════════════════════════ -->
  <section class="td-stage-wrap" aria-label="صحنه سه‌بعدی استیو">
    <div class="td-stage" id="tdStage" role="img" aria-label="استیو روی سکوی بلوک چمن ایستاده">

      <!-- Sky gradient background + CSS clouds -->
      <div class="td-sky" aria-hidden="true">
        <span class="td-cloud td-cloud-1"></span>
        <span class="td-cloud td-cloud-2"></span>
        <span class="td-cloud td-cloud-3"></span>
      </div>

      <!-- Sun glow -->
      <div class="td-sun" aria-hidden="true"></div>

      <!-- The 3D world — gets drag-rotation applied here -->
      <div class="td-world" id="tdWorld">
        <!-- Ground platform (3×3 grass cubes) -->
        <div class="td-ground" aria-hidden="true">
          {cubes.map((c, i) => (
            <div
              class="td-cube td-grass-cube"
              style={`transform: translate3d(${c.x}px, ${HALF_P}px, ${c.z}px); --i:${i};`}
            >
              <div class="td-face td-face-top"></div>
              <div class="td-face td-face-bottom"></div>
              <div class="td-face td-face-front td-grass-side"></div>
              <div class="td-face td-face-back td-grass-side"></div>
              <div class="td-face td-face-left td-grass-side"></div>
              <div class="td-face td-face-right td-grass-side"></div>
            </div>
          ))}
        </div>

        <!-- ════════════════════════════════════════════════════
             STEVE FIGURE
             All measurements are real Minecraft voxel counts × 4 (so
             head=8×4=32px, body=4×12×4 → 16×48×16px, etc.) Total height
             = 32+48+48 = 128px. Steve stands on top of the platform (y=0
             at platform top, legs extend upward as negative y values).

             Body part group origins (their OWN local 0,0,0) sit at
             the TOP of each part so that rotateX() at the shoulders
             swings the arms naturally (pivot at shoulder, not at the
             arm's geometric center).

             Layout (negative-y = up):
               legs:    y =   0 → -48   (height 48, pivot at top=-48)
               body:    y = -48 → -96   (height 48)
               arms:    y = -48 → -96   (height 48, pivot at top=-48)
               head:    y = -96 → -128  (height 32)
            ════════════════════════════════════════════════════ -->
        <div class="td-steve" id="tdSteve" aria-hidden="true">

          <!-- Right leg (pivot at hip = top of leg) -->
          <div
            class="td-cube td-steve-leg td-steve-leg-r"
            style="--w:16; --h:48; --d:16;"
          >
            <div class="td-face td-face-front td-leg-side"></div>
            <div class="td-face td-face-back td-leg-side"></div>
            <div class="td-face td-face-left td-leg-side"></div>
            <div class="td-face td-face-right td-leg-side"></div>
            <div class="td-face td-face-top td-leg-top"></div>
            <div class="td-face td-face-bottom td-leg-bottom"></div>
          </div>

          <!-- Left leg -->
          <div
            class="td-cube td-steve-leg td-steve-leg-l"
            style="--w:16; --h:48; --d:16;"
          >
            <div class="td-face td-face-front td-leg-side"></div>
            <div class="td-face td-face-back td-leg-side"></div>
            <div class="td-face td-face-left td-leg-side"></div>
            <div class="td-face td-face-right td-leg-side"></div>
            <div class="td-face td-face-top td-leg-top"></div>
            <div class="td-face td-face-bottom td-leg-bottom"></div>
          </div>

          <!-- Body (blue shirt) -->
          <div
            class="td-cube td-steve-body"
            style="--w:16; --h:48; --d:8;"
          >
            <div class="td-face td-face-front td-body-front"></div>
            <div class="td-face td-face-back td-body-back"></div>
            <div class="td-face td-face-left td-body-side"></div>
            <div class="td-face td-face-right td-body-side"></div>
            <div class="td-face td-face-top td-body-top"></div>
            <div class="td-face td-face-bottom td-body-bottom"></div>
          </div>

          <!-- Right arm (skin color, pivot at shoulder) -->
          <div
            class="td-cube td-steve-arm td-steve-arm-r"
            style="--w:16; --h:48; --d:16;"
          >
            <div class="td-face td-face-front td-arm-side"></div>
            <div class="td-face td-face-back td-arm-side"></div>
            <div class="td-face td-face-left td-arm-side"></div>
            <div class="td-face td-face-right td-arm-side"></div>
            <div class="td-face td-face-top td-arm-top"></div>
            <div class="td-face td-face-bottom td-arm-bottom"></div>
          </div>

          <!-- Left arm -->
          <div
            class="td-cube td-steve-arm td-steve-arm-l"
            style="--w:16; --h:48; --d:16;"
          >
            <div class="td-face td-face-front td-arm-side"></div>
            <div class="td-face td-face-back td-arm-side"></div>
            <div class="td-face td-face-left td-arm-side"></div>
            <div class="td-face td-face-right td-arm-side"></div>
            <div class="td-face td-face-top td-arm-top"></div>
            <div class="td-face td-face-bottom td-arm-bottom"></div>
          </div>

          <!-- Head (8×8×8 → 32×32×32 cube with Minecraft-style face) -->
          <div
            class="td-cube td-steve-head"
            style="--w:32; --h:32; --d:32;"
          >
            <div class="td-face td-face-top td-head-top"></div>
            <div class="td-face td-face-bottom td-head-bottom"></div>
            <div class="td-face td-face-back td-head-back"></div>
            <div class="td-face td-face-left td-head-side"></div>
            <div class="td-face td-face-right td-head-side"></div>
            <!-- FRONT face = Steve's face: pixel-art via layered divs -->
            <div class="td-face td-face-front td-head-front">
              <!-- Hair strip (top 8px of the 32px face) -->
              <span class="td-hair"></span>
              <!-- Eyes row (row 3 from top, 8px tall, 8px from top) -->
              <span class="td-eye td-eye-l">
                <span class="td-pupil"></span>
              </span>
              <span class="td-eye td-eye-r">
                <span class="td-pupil"></span>
              </span>
              <!-- Nose (subtle) -->
              <span class="td-nose"></span>
              <!-- Mouth / beard area -->
              <span class="td-mouth"></span>
              <span class="td-beard"></span>
            </div>
          </div>
        </div>
        <!-- /td-steve -->

      </div>
      <!-- /td-world -->

      <!-- Floating hint chip -->
      <div class="td-hint" id="tdHint" aria-hidden="true">
        <span class="td-hint-icon">🖱️</span>
        <span>برای چرخش بکش · برای زوم اسکرول کن</span>
      </div>
    </div>
    <!-- /td-stage -->
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       CONTROL PANEL
       ═══════════════════════════════════════════════════════════ -->
  <section class="td-controls" aria-label="کنترل‌های صحنه">
    <div class="td-control-group" role="group" aria-label="حالت انیمیشن">
      <button class="td-btn active" id="tdBtnIdle" type="button" data-mode="idle">
        <span class="td-btn-icon">🧍</span>
        <span>ایستاده</span>
      </button>
      <button class="td-btn" id="tdBtnWalk" type="button" data-mode="walk">
        <span class="td-btn-icon">🚶</span>
        <span>راه می‌ره</span>
      </button>
      <button class="td-btn" id="tdBtnRun" type="button" data-mode="run">
        <span class="td-btn-icon">🏃</span>
        <span>می‌دوه</span>
      </button>
    </div>

    <div class="td-control-group" role="group" aria-label="کنترل چرخش">
      <button class="td-btn td-btn-toggle" id="tdBtnAuto" type="button" aria-pressed="false">
        <span class="td-btn-icon">🔄</span>
        <span>چرخش خودکار</span>
      </button>
      <button class="td-btn" id="tdBtnReset" type="button" aria-label="بازنشانی دید">
        <span class="td-btn-icon">🎯</span>
        <span>بازنشانی</span>
      </button>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       INFO / HELP
       ═══════════════════════════════════════════════════════════ -->
  <section class="td-info mc-panel">
    <h2>درباره‌ی این دنیای سه‌بعدی</h2>
    <p class="td-info-text">
      این صحنه <strong>کاملاً با CSS 3D ساخته شده</strong> — هیچ کتابخانه‌ی
      جاوااسکریپت خارجی مثل Three.js یا skin3d استفاده نشده. یعنی صفحه
      خیلی سریع لود می‌شه و روی هر مرورگری (حتی قدیمی‌ها) کار می‌کنه.
    </p>
    <ul class="td-info-list">
      <li><strong>سکو:</strong> ۹ بلوک چمن (آرایه‌ی ۳×۳)</li>
      <li><strong>استیو:</strong> سر ۸×۸×۸ · بدن ۴×۱۲×۴ · دست‌ها ۴×۱۲×۴ · پاها ۴×۱۲×۴</li>
      <li><strong>انیمیشن‌ها:</strong> idle / walk / run — همه با <code>@keyframes</code></li>
      <li><strong>کنترل:</strong> موس/لمس برای چرخش، اسکرول/پینچ برای زوم</li>
      <li><strong>عملکرد:</strong> فقط <code>transform</code> و <code>opacity</code> (GPU شتاب‌دهی)</li>
      <li><strong>دسترسی‌پذیری:</strong> احترام به <code>prefers-reduced-motion</code></li>
    </ul>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       STYLES
       ═══════════════════════════════════════════════════════════ -->
  <style is:global>
    /* ─────────────────────────────────────────────────────────────
       3D STEVE WORLD — pure CSS 3D, no external deps
       ───────────────────────────────────────────────────────────── */

    /* Shared CSS custom props for the 3D scene */
    .td-stage-wrap {
      --steve-skin:   #c8a07a;
      --steve-skin-2: #b88a64;
      --steve-shirt:  #3aa0d6;
      --steve-shirt-2:#2a85b8;
      --steve-pants:  #3a4b80;
      --steve-pants-2:#2c3a66;
      --steve-hair:   #2a1f15;
      --steve-eye-w:  #ffffff;
      --steve-eye-p:  #6b4edb;
      --grass-top:   #6db73f;
      --grass-top-2: #5fa838;
      --grass-side-top: #5fa838;
      --grass-side-bottom: #79553a;
      --dirt-bottom: #5b3f29;

      display: block;
      width: 100%;
      max-width: 960px;
      margin: 0 auto 1rem;
    }

    /* ── Stage: perspective wrapper ── */
    .td-stage {
      position: relative;
      width: 100%;
      height: 400px;
      perspective: 900px;
      perspective-origin: 50% 38%;
      border-radius: 12px;
      overflow: hidden;
      cursor: grab;
      touch-action: none;          /* let JS handle drag on touch */
      user-select: none;
      background: linear-gradient(180deg,
        #87ceeb 0%,
        #a8dbef 45%,
        #c8e8f5 100%);
      box-shadow: inset 0 -40px 60px rgba(0,0,0,0.18),
                  0 8px 32px rgba(0,0,0,0.4);
      border: 1px solid #2e2e4a;
    }

    .td-stage:active { cursor: grabbing; }

    /* ── Sky background + clouds ── */
    .td-sky {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .td-cloud {
      position: absolute;
      width: 90px;
      height: 28px;
      background: #fff;
      border-radius: 50px;
      filter: blur(2px);
      opacity: 0.85;
      box-shadow:
        30px 8px 0 -2px #fff,
        -28px 10px 0 -4px #fff,
        55px 4px 0 -6px #fff;
      animation: td-cloud-drift 60s linear infinite;
    }
    .td-cloud-1 { top: 18%;  left: -120px; animation-duration: 65s; }
    .td-cloud-2 { top: 8%;   left: -160px; animation-duration: 85s; animation-delay: -20s; transform: scale(0.7); opacity: 0.7; }
    .td-cloud-3 { top: 32%;  left: -100px; animation-duration: 95s; animation-delay: -45s; transform: scale(1.2); opacity: 0.6; }

    @keyframes td-cloud-drift {
      from { transform: translateX(0) scale(var(--s, 1)); }
      to   { transform: translateX(calc(100vw + 200px)) scale(var(--s, 1)); }
    }
    .td-cloud-2 { --s: 0.7; }
    .td-cloud-3 { --s: 1.2; }

    /* ── Sun glow ── */
    .td-sun {
      position: absolute;
      top: 6%;
      right: 8%;
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background: radial-gradient(circle,
        #fff9c4 0%,
        #fff59d 40%,
        rgba(255, 235, 130, 0) 75%);
      box-shadow: 0 0 60px 20px rgba(255, 235, 130, 0.5);
      pointer-events: none;
    }

    /* ── World: holds ground + Steve; rotates via JS ── */
    .td-world {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      transform-style: preserve-3d;
      transform: rotateX(-15deg) rotateY(-25deg);
      will-change: transform;
      transition: transform 0.05s linear;
    }

    .td-world.td-auto {
      animation: td-world-spin 18s linear infinite;
    }

    @keyframes td-world-spin {
      from { transform: rotateX(-15deg) rotateY(0deg); }
      to   { transform: rotateX(-15deg) rotateY(360deg); }
    }

    /* ── Generic 3D cube ── */
    .td-cube {
      position: absolute;
      width: 0;
      height: 0;
      transform-style: preserve-3d;
      will-change: transform;
    }

    .td-face {
      position: absolute;
      display: block;
      backface-visibility: hidden;
      image-rendering: pixelated;
    }

    /* Faces position themselves based on cube width/height/depth (--w/--h/--d).
       Each face is centered at cube origin then pushed outward by half its
       dimension along the appropriate axis. */
    .td-face.td-face-front  { width: calc(var(--w) * 1px); height: calc(var(--h) * 1px);
      top: calc(var(--h) * -0.5px); left: calc(var(--w) * -0.5px);
      transform: translateZ(calc(var(--d) * 0.5px)); }
    .td-face.td-face-back   { width: calc(var(--w) * 1px); height: calc(var(--h) * 1px);
      top: calc(var(--h) * -0.5px); left: calc(var(--w) * -0.5px);
      transform: rotateY(180deg) translateZ(calc(var(--d) * 0.5px)); }
    .td-face.td-face-right  { width: calc(var(--d) * 1px); height: calc(var(--h) * 1px);
      top: calc(var(--h) * -0.5px); left: calc(var(--d) * -0.5px);
      transform: rotateY(90deg) translateZ(calc(var(--w) * 0.5px)); }
    .td-face.td-face-left   { width: calc(var(--d) * 1px); height: calc(var(--h) * 1px);
      top: calc(var(--h) * -0.5px); left: calc(var(--d) * -0.5px);
      transform: rotateY(-90deg) translateZ(calc(var(--w) * 0.5px)); }
    .td-face.td-face-top    { width: calc(var(--w) * 1px); height: calc(var(--d) * 1px);
      top: calc(var(--d) * -0.5px); left: calc(var(--w) * -0.5px);
      transform: rotateX(90deg) translateZ(calc(var(--h) * 0.5px)); }
    .td-face.td-face-bottom { width: calc(var(--w) * 1px); height: calc(var(--d) * 1px);
      top: calc(var(--d) * -0.5px); left: calc(var(--w) * -0.5px);
      transform: rotateX(-90deg) translateZ(calc(var(--h) * 0.5px)); }

    /* ── Ground: 3×3 grass-block grid ── */
    .td-ground {
      position: absolute;
      transform-style: preserve-3d;
    }

    .td-grass-cube {
      /* Each cube is PLATFORM px (64) — set --w/--h/--d accordingly */
      --w: 64; --h: 64; --d: 64;
      /* Per-cube transform was inlined via `style` attribute — translate3d to
         its grid position; the y offset (HALF_P = 32) places top face at y=0 */
    }

    .td-grass-cube .td-face {
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.15);
    }

    .td-grass-cube .td-face-top {
      background:
        /* tiny noise speckles for pixel-art feel */
        repeating-linear-gradient(90deg,
          rgba(0,0,0,0.06) 0 4px,
          rgba(255,255,255,0.04) 4px 8px),
        repeating-linear-gradient(0deg,
          rgba(0,0,0,0.04) 0 4px,
          rgba(255,255,255,0.03) 4px 8px),
        linear-gradient(180deg, var(--grass-top) 0%, var(--grass-top-2) 100%);
    }
    .td-grass-cube .td-face-bottom {
      background: linear-gradient(180deg, var(--dirt-bottom), #3a2a1a);
    }
    .td-grass-cube .td-grass-side {
      background:
        /* top 12px green strip */
        linear-gradient(180deg,
          var(--grass-side-top) 0,
          var(--grass-side-top) 12px,
          var(--grass-side-bottom) 12px,
          #5b3f29 100%);
    }

    /* ── Steve figure ── */
    .td-steve {
      position: absolute;
      transform-style: preserve-3d;
      will-change: transform;
      /* Idle bob applied via animation when body has class td-mode-idle */
      animation: td-steve-idle 2s ease-in-out infinite;
    }

    @keyframes td-steve-idle {
      0%, 100% { transform: translate3d(0, 0, 0); }
      50%      { transform: translate3d(0, -2px, 0); }
    }

    /* Steve parts — each cube positioned with translate3d in 3D space.
       Origin: Steve's vertical center is at world y=0 (top of platform).
       Negative Y = up (Steve extends upward). Positive X = Steve's left
       (mirror because of how the world rotates). Z = forward (where
       Steve faces — front of head looks down -Z axis after rotations). */

    /* Legs (16w × 48h × 16d), feet at y=0, top at y=-48.
       Left leg at x=-8 (Steve's left, our +X is world-left when facing
       default direction — but to keep it readable we just split them
       symmetrically around x=0).
       Right leg X = -8, Left leg X = +8. */
    .td-steve-leg {
      --w:16; --h:48; --d:16;
      transform-style: preserve-3d;
      transform-origin: 0 calc(var(--h) * -0.5px);  /* pivot at HIP */
      will-change: transform;
    }
    .td-steve-leg-r {
      transform: translate3d(-8px, -24px, 0px);
    }
    .td-steve-leg-l {
      transform: translate3d(8px, -24px, 0px);
    }

    .td-leg-side {
      background: linear-gradient(180deg, var(--steve-pants) 0%, var(--steve-pants-2) 100%);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.18);
    }
    .td-leg-top    { background: var(--steve-pants); }
    .td-leg-bottom { background: #1f2750; box-shadow: inset 0 0 0 2px #141833; }

    /* Body (16w × 48h × 8d), top at y=-48, bottom at y=-96. Center y=-72 */
    .td-steve-body {
      --w:16; --h:48; --d:8;
      transform: translate3d(0, -72px, 0);
      transform-style: preserve-3d;
      will-change: transform;
      transform-origin: 0 0;  /* body just bobs with the .steve parent */
    }
    .td-body-front {
      background:
        /* subtle vertical stripe to suggest jacket seams */
        linear-gradient(90deg,
          transparent 0 7px,
          rgba(0,0,0,0.18) 7px 9px,
          transparent 9px 100%),
        linear-gradient(180deg, var(--steve-shirt) 0%, var(--steve-shirt-2) 100%);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.18);
    }
    .td-body-back  {
      background: linear-gradient(180deg, var(--steve-shirt-2) 0%, var(--steve-shirt) 100%);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.18);
    }
    .td-body-side, .td-body-top, .td-body-bottom {
      background: linear-gradient(180deg, var(--steve-shirt) 0%, var(--steve-shirt-2) 100%);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.18);
    }

    /* Arms (16w × 48h × 16d), shoulder at y=-48, hand at y=0.
       Pivot at shoulder (top). Right arm at x=-16 (Steve's right),
       Left arm at x=+16 (Steve's left). */
    .td-steve-arm {
      --w:16; --h:48; --d:16;
      transform-style: preserve-3d;
      transform-origin: 0 calc(var(--h) * -0.5px);  /* pivot at shoulder */
      will-change: transform;
    }
    .td-steve-arm-r {
      transform: translate3d(-16px, -72px, 0);
    }
    .td-steve-arm-l {
      transform: translate3d(16px, -72px, 0);
    }
    .td-arm-side, .td-arm-top {
      background: linear-gradient(180deg, var(--steve-skin) 0%, var(--steve-skin-2) 100%);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.15);
    }
    .td-arm-bottom { background: var(--steve-skin-2); }

    /* Head (32w × 32h × 32d). Top at y=-96, bottom at y=-128. Center y=-112 */
    .td-steve-head {
      --w:32; --h:32; --d:32;
      transform: translate3d(0, -112px, 0);
      transform-style: preserve-3d;
      will-change: transform;
    }
    .td-head-top    { background: linear-gradient(180deg, #3a2a1a, #2a1f15); box-shadow: inset 0 0 0 1px rgba(0,0,0,0.2); }
    .td-head-back   { background: linear-gradient(180deg, var(--steve-skin), var(--steve-skin-2)); box-shadow: inset 0 0 0 1px rgba(0,0,0,0.2); }
    .td-head-side   { background: linear-gradient(180deg, #3a2a1a 0 8px, var(--steve-skin) 8px 100%); box-shadow: inset 0 0 0 1px rgba(0,0,0,0.2); }
    .td-head-bottom { background: var(--steve-skin-2); }

    /* ── Steve's face (front of head cube) ── */
    .td-head-front {
      background: linear-gradient(180deg, var(--steve-skin) 0%, var(--steve-skin-2) 100%);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.18);
      overflow: hidden;
      position: absolute;
    }
    /* Hair: top 8px of the 32px face = 25% height. */
    .td-head-front .td-hair {
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 10px;
      background: linear-gradient(180deg, #2a1f15 0%, #3a2a1a 100%);
      /* Slight wave at bottom of hairline */
      clip-path: polygon(
        0 0, 100% 0, 100% 100%,
        88% 60%, 75% 90%, 62% 60%, 50% 100%, 38% 60%, 25% 90%, 12% 60%, 0 100%
      );
    }
    /* Eyes: row 3 (rows of 4px each in 32px face → eyes at top ~12-16px).
       Each eye is 8px wide × 4px tall; left eye at x=4-12, right at x=20-28. */
    .td-head-front .td-eye {
      position: absolute;
      top: 12px;
      width: 8px;
      height: 8px;
      background: var(--steve-eye-w);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.4);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .td-head-front .td-eye-l { left: 6px; }
    .td-head-front .td-eye-r { left: 18px; }

    .td-head-front .td-pupil {
      width: 4px;
      height: 4px;
      background: var(--steve-eye-p);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.4);
    }
    /* Nose — subtle darker pixel under the eye line */
    .td-head-front .td-nose {
      position: absolute;
      top: 22px;
      left: 14px;
      width: 4px;
      height: 4px;
      background: rgba(0,0,0,0.18);
    }
    /* Mouth — small horizontal line of 2 darker pixels at row 6 */
    .td-head-front .td-mouth {
      position: absolute;
      top: 24px;
      left: 12px;
      width: 8px;
      height: 4px;
      background: linear-gradient(180deg, #6a4a30 0%, #4a3018 100%);
    }
    /* Beard area — soft brown tint at bottom (like Steve's stubble) */
    .td-head-front .td-beard {
      position: absolute;
      bottom: 0; left: 0;
      width: 100%;
      height: 6px;
      background: linear-gradient(180deg, transparent 0%, rgba(58,42,26,0.4) 100%);
      pointer-events: none;
