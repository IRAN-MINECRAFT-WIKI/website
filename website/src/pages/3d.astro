  <!-- ═══════════════════════════════════════════════════════════
       JAVASCRIPT — drag rotate, wheel zoom, button handlers
       Pure vanilla, no deps, is:inline so it ships in the HTML.
       ═══════════════════════════════════════════════════════════ -->
  <script is:inline>
    (function () {
      var stage = document.getElementById('tdStage');
      var world = document.getElementById('tdWorld');
      var steve = document.getElementById('tdSteve');
      var btnIdle = document.getElementById('tdBtnIdle');
      var btnWalk = document.getElementById('tdBtnWalk');
      var btnRun = document.getElementById('tdBtnRun');
      var btnAuto = document.getElementById('tdBtnAuto');
      var btnReset = document.getElementById('tdBtnReset');
      if (!stage || !world || !steve) return;

      var REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ── State ──────────────────────────────────────────────────
      var rotX = -15, rotY = -25;   // initial world rotation (deg)
      var zoom = 1;                  // scale multiplier
      var isDragging = false;
      var lastX = 0, lastY = 0;
      var autoRotate = false;

      // Initial transform — also reused by reset
      function applyTransform() {
        var ts = 'translateZ(0) scale(' + zoom.toFixed(3) + ')';
        world.style.transform =
          'translate3d(0,0,0) ' + ts + ' rotateX(' + rotX + 'deg) rotateY(' + rotY + 'deg)';
      }
      applyTransform();

      // ── Drag handlers (mouse + touch) ─────────────────────────
      function onDown(e) {
        // Don't hijack clicks on buttons
        if (e.target.closest('.td-btn')) return;
        isDragging = true;
        var p = pointer(e);
        lastX = p.x; lastY = p.y;
        stage.style.cursor = 'grabbing';
        // Stop auto-rotate while dragging (feels more natural)
        if (autoRotate) world.classList.remove('td-auto');
        e.preventDefault();
      }
      function onMove(e) {
        if (!isDragging) return;
        var p = pointer(e);
        var dx = p.x - lastX;
        var dy = p.y - lastY;
        lastX = p.x; lastY = p.y;
        rotY += dx * 0.4;
        rotX -= dy * 0.4;
        // Clamp rotX so we don't flip upside-down
        if (rotX > 60) rotX = 60;
        if (rotX < -60) rotX = -60;
        applyTransform();
        e.preventDefault();
      }
      function onUp() {
        if (!isDragging) return;
        isDragging = false;
        stage.style.cursor = 'grab';
        // Resume auto-rotate if it was on
        if (autoRotate && !REDUCED) world.classList.add('td-auto');
      }
      function pointer(e) {
        if (e.touches && e.touches[0]) return { x: e.touches[0].clientX, y: e.touches[0].clientY };
        return { x: e.clientX, y: e.clientY };
      }

      stage.addEventListener('mousedown', onDown);
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
      stage.addEventListener('touchstart', onDown, { passive: false });
      document.addEventListener('touchmove', onMove, { passive: false });
      document.addEventListener('touchend', onUp);

      // ── Wheel / pinch zoom ────────────────────────────────────
      function onWheel(e) {
        e.preventDefault();
        // deltaY > 0 = scroll down = zoom out
        var delta = e.deltaY > 0 ? 0.92 : 1.08;
        zoom *= delta;
        if (zoom < 0.4) zoom = 0.4;
        if (zoom > 2.2) zoom = 2.2;
        applyTransform();
