---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { mods } from '@/lib/data';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

export async function getStaticPaths() {
  const blog = await getCollection('blog', ({ data }) => !data.draft);
  const wiki = await getCollection('wiki', ({ data }) => !data.draft);
  const tutorials = await getCollection('tutorials', ({ data }) => !data.draft);

  // Collect unique tags from all collections + mod keywords
  const allTags = new Set<string>();

  [...blog, ...wiki, ...tutorials].forEach((entry) => {
    entry.data.tags?.forEach((t: string) => allTags.add(t));
  });

  // Add mod keywords as tags
  mods.forEach((m) => {
    if (m.keywords) {
      m.keywords.split(/\s+/).forEach((kw) => {
        if (kw.length > 2) allTags.add(kw);
      });
    }
  });

  return Array.from(allTags).map((tag) => ({
    // Do NOT encodeURIComponent — Astro handles URL encoding when generating
    // the static file path. Double-encoding caused the Persian folder name
    // to be generated as %25D8%25AA... which never matches browser requests.
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
// tag is already the decoded Persian string — no decodeURIComponent needed
const decodedTag = tag;

const blog = (await getCollection('blog', ({ data }) => !data.draft && data.tags.includes(decodedTag))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const wiki = await getCollection('wiki', ({ data }) => !data.draft && data.tags.includes(decodedTag));
const tutorials = await getCollection('tutorials', ({ data }) => !data.draft && data.tags.includes(decodedTag));
const tagMods = mods.filter((m) => (m.keywords || '').toLowerCase().includes(decodedTag.toLowerCase()));

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'تگ‌ها', url: '/tags' },
  { name: `#${decodedTag}`, url: `/tags/${decodedTag}` },
];
---

<BaseLayout
  path={`/tags/${decodedTag}`}
  title={`#${decodedTag} — MineBed Farsi`}
  description={`همه‌ی محتوای MineBed با تگ ${decodedTag} — مودها، مقالات، آموزش‌ها و...`}
>
  <Breadcrumbs items={breadcrumb} />

  <div class="mb-6">
    <h1 class="text-2xl lg:text-3xl font-extrabold mb-2">
      تگ <span class="text-mc-grass-2">#{decodedTag}</span>
    </h1>
    <p class="text-sm text-mc-text-2">
      {blog.length + wiki.length + tutorials.length + tagMods.length} مورد با این تگ
    </p>
  </div>

  {tagMods.length > 0 && (
    <section class="mb-8">
      <h2 class="text-xl font-extrabold mb-4">مودها ({tagMods.length})</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {tagMods.map((mod) => (
          <a href={base(`/mods/${mod.id}`)} class="mc-panel hoverable group p-4">
            <div class="text-2xl mb-2">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round">
                <use href="#icon-mod" />
              </svg>
            </div>
            <h3 class="font-bold text-sm text-mc-text group-hover:text-mc-grass-2 mb-1">{mod.nameFa || mod.name}</h3>
            <p class="text-xs text-mc-text-2 line-clamp-2">{mod.tagline}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {blog.length > 0 && (
    <section class="mb-8">
      <h2 class="text-xl font-extrabold mb-4">مقالات وبلاگ ({blog.length})</h2>
      <div class="space-y-3">
        {blog.map((post) => (
          <a href={base(`/blog/${post.id}`)} class="mc-panel hoverable group p-4 block">
            <h3 class="font-bold text-mc-text group-hover:text-mc-grass-2 mb-1">{post.data.title}</h3>
            <p class="text-xs text-mc-text-2 line-clamp-2">{post.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {wiki.length > 0 && (
    <section class="mb-8">
      <h2 class="text-xl font-extrabold mb-4">مقالات ویکی ({wiki.length})</h2>
      <div class="space-y-3">
        {wiki.map((entry) => (
          <a href={base(`/wiki/${entry.id}`)} class="mc-panel hoverable group p-4 block">
            <h3 class="font-bold text-mc-text group-hover:text-mc-grass-2 mb-1">{entry.data.title}</h3>
            <p class="text-xs text-mc-text-2 line-clamp-2">{entry.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {tutorials.length > 0 && (
    <section class="mb-8">
      <h2 class="text-xl font-extrabold mb-4">آموزش‌ها ({tutorials.length})</h2>
      <div class="space-y-3">
        {tutorials.map((tut) => (
          <a href={base(`/tutorials/${tut.id}`)} class="mc-panel hoverable group p-4 block">
            <h3 class="font-bold text-mc-text group-hover:text-mc-grass-2 mb-1">{tut.data.title}</h3>
            <p class="text-xs text-mc-text-2 line-clamp-2">{tut.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {blog.length + wiki.length + tutorials.length + tagMods.length === 0 && (
    <div class="mc-panel text-center py-12">
      <p class="text-mc-text-2">هیچ موردی با این تگ پیدا نشد.</p>
    </div>
  )}
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
