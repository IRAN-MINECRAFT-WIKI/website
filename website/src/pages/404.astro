---
import BaseLayout from '@layouts/BaseLayout.astro';
import '@components/icons.astro';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);
---

<BaseLayout
  path="/404"
  title="۴۰۴ — صفحه پیدا نشد"
  description="صفحه‌ای که دنبالش بودی پیدا نشد."
  noindex={true}
>
  <div class="error-page">
    <div class="creeper-block" role="img" aria-label="کریپر ماینکرفت">
      <svg width="120" height="120" viewBox="0 0 24 24" class="creeper-svg">
        <use href="#icon-creeper" />
      </svg>
    </div>

    <div class="error-content">
      <div class="error-code">404</div>
      <h1 class="error-title">این صفحه منفجر شد!</h1>
      <p class="error-desc">
        صفحه‌ای که دنبالش بودی پیدا نشد. شاید آدرس عوض شده یا اشتباه وارد کردی.
        <br>
        می‌تونی برگردی به خانه یا بگردی بین افزونه‌ها.
      </p>
      <div class="error-actions">
        <a href={base('/')} class="mc-btn" data-route>
          <svg width="14" height="14"><use href="#icon-home" /></svg>
          بازگشت به خانه
        </a>
        <a href={base('/mods')} class="mc-btn ghost" data-route>
          <svg width="14" height="14"><use href="#icon-cube" /></svg>
          دیدن افزونه‌ها
        </a>
        <a href={base('/search')} class="mc-btn gold small" data-route>
          <svg width="14" height="14"><use href="#icon-search" /></svg>
          جستجو در سایت
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    text-align: center;
    padding: 2rem 1rem;
  }

  /* ─── Creeper SVG block ─── */
  .creeper-block {
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #5cc44c;
    background: rgba(46, 80, 24, 0.15);
    border: 3px solid #2d5018;
    box-shadow:
      inset -6px -6px 0 rgba(0, 0, 0, 0.25),
      0 8px 24px rgba(0, 0, 0, 0.5);
    image-rendering: pixelated;
    animation: creeperBreath 3s ease-in-out infinite;
    transform-origin: bottom center;
  }

  .creeper-svg {
    width: 70%;
    height: 70%;
    fill: currentColor;
  }

  @keyframes creeperBreath {
    0%, 100% { transform: scaleY(1) scaleX(1); }
    50%      { transform: scaleY(1.03) scaleX(0.98); }
  }

  @media (prefers-reduced-motion: reduce) {
    .creeper-block { animation: none; }
  }

  /* ─── Error content ─── */
  .error-code {
    font-family: 'Press Start 2P', monospace;
    font-size: 4rem;
    color: #5cc44c;
    text-shadow:
      4px 4px 0 #1a3010,
      0 0 24px rgba(92, 196, 76, 0.45);
    letter-spacing: 4px;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 480px) {
    .error-code { font-size: 2.75rem; letter-spacing: 2px; }
    .creeper-block { width: 90px; height: 90px; border-width: 2px; }
  }

  .error-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.5rem;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);
  }

  .error-desc {
    font-size: 0.875rem;
    color: var(--text-2);
    line-height: 1.85;
    max-width: 460px;
    margin: 0 auto 1.25rem;
  }

  .error-actions {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
