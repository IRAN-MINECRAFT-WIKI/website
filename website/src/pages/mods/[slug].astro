---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import BackButton from "@components/BackButton.astro";
import ModCard from '@components/ModCard.astro';
import AdSlot from '@components/AdSlot.astro';
import StructuredData from '@components/StructuredData.astro';
import { mods, getModBySlug, getRelatedMods, getCategoryById, siteConfig } from '@/lib/data';
import { modJsonLd, faqJsonLd } from '@/lib/seo';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

export async function getStaticPaths() {
  return mods.map((mod) => ({
    params: { slug: mod.id },
    props: { mod },
  }));
}

const { mod } = Astro.props;
const cat = getCategoryById(mod.category);
const related = getRelatedMods(mod, 4);

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'افزونه‌ها', url: '/mods' },
  { name: mod.catName || cat?.name || '', url: `/categories/${mod.category}` },
  { name: mod.nameFa || mod.name, url: `/mods/${mod.id}` },
];

const ldMod = modJsonLd({
  name: mod.name,
  nameFa: mod.nameFa,
  tagline: mod.tagline,
  desc: mod.desc,
  downloadUrl: mod.downloadUrl,
  cover: mod.cover,
  author: mod.author,
  version: mod.version,
  size: mod.size,
  category: mod.catName,
  updated: mod.updated,
});

const faqs = [
  { q: 'این افزونه رایگان است؟', a: 'بله، تمام افزونه‌های MineBed کاملاً رایگان هستند و بدون نیاز به ثبت‌نام قابل دانلود هستند.' },
  { q: 'این افزونه روی چه نسخه‌ای کار می‌کند؟', a: `این افزونه با نسخه ${mod.version} ماینکرفت بدراک تست شده است و روی نسخه‌های نزدیک هم کار می‌کند.` },
  { q: 'چطور افزونه را نصب کنم؟', a: 'فایل .mcpack یا .mcaddon را دانلود کنید و روی آن کلیک کنید تا Minecraft به طور خودکار آن را نصب کند. برای راهنمای کامل به بخش آموزش مراجعه کنید.' },
  { q: 'آیا این افزونه امن است؟', a: 'بله، همه‌ی افزونه‌ها قبل از انتشار روی دنیای آزمایشی تست می‌شوند و هیچ فایل ناشناسی روی سایت قرار نمی‌گیرد.' },
];

const ldFaq = faqJsonLd(faqs);

const gallery = mod.gallery || [];
---

<BaseLayout
  path={`/mods/${mod.id}`}
  title={`${mod.nameFa || mod.name} — دانلود افزونه ماینکرفت بدراک ${mod.version}`}
  description={mod.tagline || mod.desc.slice(0, 160)}
  image={mod.cover}
  type="article"
>
  <Breadcrumbs items={breadcrumb} />
  <BackButton />
  <StructuredData data={ldMod} />
  <StructuredData data={ldFaq} />

  <div class="grid lg:grid-cols-[1fr_360px] gap-6">
    <!-- Main content -->
    <article>
      <!-- Header -->
      <header class="mc-panel mb-6">
        <div class="aspect-video overflow-hidden bg-mc-panel-2">
          <img
            src={mod.cover}
            alt={mod.nameFa || mod.name}
            width="640"
            height="360"
            loading="eager"
            decoding="async"
            class="w-full h-full object-cover"
            onerror={`this.src='${BASE}images/placeholder-mod.svg'`}
          />
        </div>
        <div class="p-5">
          <div class="flex items-start gap-4">
            <div class="text-5xl shrink-0 text-mc-grass-2">
              <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
                <use href="#icon-mod" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h1 class="text-2xl lg:text-3xl font-extrabold text-mc-text mb-1">
                {mod.nameFa || mod.name}
              </h1>
              <p class="text-sm text-mc-text-2 mb-3">{mod.tagline}</p>
              <div class="flex flex-wrap gap-3 text-xs">
                {mod.author && (
                  <span class="text-mc-text-3">👤 سازنده: <b class="text-mc-text-2">{mod.author}</b></span>
                )}
                {mod.version && (
                  <span class="text-mc-text-3">🏷️ نسخه: <b class="text-mc-text-2">{mod.version}</b></span>
                )}
                {mod.size && (
                  <span class="text-mc-text-3">💾 حجم: <b class="text-mc-text-2">{mod.size}</b></span>
                )}
                {mod.updated && (
                  <span class="text-mc-text-3">📅 آپدیت: <b class="text-mc-text-2">{mod.updated}</b></span>
                )}
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- Gallery -->
      {gallery.length > 0 && (
        <section class="mc-panel mb-6 p-5">
          <h2 class="text-lg font-extrabold mb-3">گالری</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            {gallery.map((g) => (
              <a href={g} target="_blank" class="block aspect-video overflow-hidden bg-mc-panel-2">
                <img src={g} alt="اسکرین‌شات" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition-transform" />
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Description — use textContent + CSS white-space: pre-wrap to render
           newlines without XSS risk (set:html would allow injection if mod.desc
           ever contained HTML). -->
      <section class="mc-panel mb-6 p-5 prose prose-invert max-w-none">
        <h2 class="text-xl font-extrabold mb-3">درباره‌ی این افزونه</h2>
        <div class="mod-desc-text">{mod.desc}</div>
      </section>

      <!-- FAQ -->
      <section class="mc-panel mb-6 p-5">
        <h2 class="text-xl font-extrabold mb-4">سوالات متداول</h2>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="bg-mc-bg-2 border-2 border-mc-line p-3 group">
              <summary class="cursor-pointer font-bold text-mc-text flex items-center justify-between">
                {faq.q}
                <span class="text-mc-grass-2 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-sm text-mc-text-2 mt-2 leading-loose">{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Related -->
      {related.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-extrabold mb-4">افزونه‌های مرتبط</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
            {related.map((m) => <ModCard mod={m} />)}
          </div>
        </section>
      )}
    </article>

    <!-- Sidebar -->
    <aside class="space-y-4">
      <!-- Download box -->
      <div class="mc-panel p-5 sticky top-20">
        <h3 class="font-extrabold text-mc-text mb-3">دانلود</h3>
        <a href={mod.downloadUrl} target="_blank" rel="noopener" class="mc-btn w-full mb-3">دانلود مستقیم</a>
        <p class="text-xs text-mc-text-3 mb-4">
          حجم: {mod.size} • نسخه: {mod.version}
        </p>
        <a href={base('/guide')} class="mc-btn ghost w-full small">راهنمای نصب</a>

        <div class="border-t border-mc-line mt-4 pt-4">
          <p class="text-xs text-mc-text-3 mb-2">دسته:</p>
          <a href={base(`/categories/${mod.category}`)} class="mc-chip">
            <span>{cat?.icon}</span>
            <span>{cat?.name}</span>
          </a>
        </div>
      </div>

      <!-- Ad -->
      <AdSlot slotId="mediaad-modside" format="banner" />
    </aside>
  </div>

  <!-- ============ COMMENTS SECTION ============ -->
  <section class="mc-block-panel grass mt-8 p-6" id="comments">
    <h2 class="text-xl font-extrabold mb-4 flex items-center gap-2">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
      نظرات کاربران
    </h2>

    <div class="mc-block-panel p-4 mb-4">
      <label for="commentName" class="block text-sm text-mc-text-2 mb-2">نام شما</label>
      <input
        type="text"
        id="commentName"
        class="w-full bg-mc-bg-2 border-2 border-mc-line px-3 py-2 text-mc-text mb-3"
        placeholder="مثلاً: علی ماینکرفت‌باز"
        maxlength="30"
      />
      <label for="commentText" class="block text-sm text-mc-text-2 mb-2">نظر شما</label>
      <textarea
        id="commentText"
        class="w-full bg-mc-bg-2 border-2 border-mc-line px-3 py-2 text-mc-text mb-3"
        rows="3"
        placeholder="نظرت رو درباره‌ی این ماد بنویس..."
        maxlength="500"
      ></textarea>
      <button id="commentSubmit" class="mc-btn pixel small">
        ارسال نظر
      </button>
      <p id="commentStatus" class="text-xs mt-2 text-mc-text-3"></p>
    </div>

    <div id="commentList" class="space-y-3"></div>
    <div id="commentEmpty" class="text-center py-8 text-mc-text-3 text-sm">
      هنوز نظری برای این ماد ثبت نشده. اولین نفر باش!
    </div>
  </section>
</BaseLayout>

<style>
  .mod-desc-text {
    white-space: pre-wrap;
    line-height: 1.85;
    color: var(--text);
    font-size: 0.9375rem;
  }
</style>

<script is:inline define:vars={{ modId: mod.id }}>
  (function () {
    function setupComments() {
      const nameInput = document.getElementById('commentName');
      const textInput = document.getElementById('commentText');
      const submitBtn = document.getElementById('commentSubmit');
      const listEl = document.getElementById('commentList');
      const emptyEl = document.getElementById('commentEmpty');
      const statusEl = document.getElementById('commentStatus');
      if (!nameInput || !textInput || !submitBtn || !listEl || !emptyEl) return;

      const STORAGE_KEY = 'mc_comments_' + modId;

      // XSS sanitizer: strip all HTML tags, escape <, >, &
      function escape(s) {
        return String(s || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function toPersian(n) {
        return String(n).replace(/[0-9]/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
      }

      function loadComments() {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        } catch (e) { return []; }
      }

      function saveComments(comments) {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(comments));
          return true;
        } catch (e) {
          return false;
        }
      }

      function renderComments() {
        const comments = loadComments();
        listEl.innerHTML = '';
        if (comments.length === 0) {
          emptyEl.style.display = '';
          return;
        }
        emptyEl.style.display = 'none';
        // Show newest first
        comments.slice().reverse().forEach(c => {
          const div = document.createElement('div');
          div.className = 'mc-block-panel p-3';

          const header = document.createElement('div');
          header.className = 'flex items-center gap-2 mb-2';

          const avatar = document.createElement('span');
          avatar.className = 'w-7 h-7 rounded-full bg-mc-grass flex items-center justify-center text-white text-xs font-bold';
          avatar.textContent = escape(c.name.charAt(0).toUpperCase());

          const nameSpan = document.createElement('span');
          nameSpan.className = 'font-bold text-mc-text text-sm';
          nameSpan.textContent = c.name;  // textContent = XSS-safe

          const date = document.createElement('span');
          date.className = 'text-xs text-mc-text-3';
          date.textContent = new Date(c.ts).toLocaleDateString('fa-IR');

          header.appendChild(avatar);
          header.appendChild(nameSpan);
          header.appendChild(date);

          const body = document.createElement('p');
          body.className = 'text-sm text-mc-text-2 line-height-relaxed';
          body.textContent = c.text;  // textContent = XSS-safe
          body.style.lineHeight = '1.7';

          div.appendChild(header);
          div.appendChild(body);
          listEl.appendChild(div);
        });
      }

      function setStatus(msg, isError) {
        statusEl.textContent = msg;
        statusEl.style.color = isError ? '#ec7063' : '#7cc84a';
        setTimeout(() => { statusEl.textContent = ''; }, 3000);
      }

      submitBtn.addEventListener('click', () => {
        const name = nameInput.value.trim();
        const text = textInput.value.trim();
        if (!name) { setStatus('نام خود را وارد کنید', true); return; }
        if (!text) { setStatus('متن نظر را وارد کنید', true); return; }
        if (text.length < 5) { setStatus('نظر خیلی کوتاه است', true); return; }
        if (text.length > 500) { setStatus('نظر خیلی طولانی است', true); return; }

        const comments = loadComments();
        comments.push({
          name: name.slice(0, 30),
          text: text.slice(0, 500),
          ts: Date.now(),
        });
        if (saveComments(comments)) {
          nameInput.value = '';
          textInput.value = '';
          renderComments();
          setStatus('نظر شما با موفقیت ثبت شد ✓', false);
        } else {
          setStatus('خطا در ذخیره‌سازی. مرورگر شما localStorage را بسته.', true);
        }
      });

      renderComments();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupComments);
    } else {
      setupComments();
    }
    document.addEventListener('astro:page-load', setupComments);
  })();
</script>
