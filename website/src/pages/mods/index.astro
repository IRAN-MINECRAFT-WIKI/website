---
import BaseLayout from '@layouts/BaseLayout.astro';
import ModCard from '@components/ModCard.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import AdSlot from '@components/AdSlot.astro';
import StructuredData from '@components/StructuredData.astro';
import { mods, categories, siteConfig } from '@/lib/data';
import { breadcrumbJsonLd, itemListJsonLd } from '@/lib/seo';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'افزونه‌ها', url: '/mods' },
];

const catIconMap: Record<string, string> = {
  gameplay: 'icon-sword',
  graphics: 'icon-diamond',
  maps: 'icon-map',
  mobs: 'icon-mob',
  decoration: 'icon-decoration',
  world: 'icon-world',
  utility: 'icon-tool',
};

// Structured data: BreadcrumbList + ItemList (top 30 mods)
const ldBreadcrumb = breadcrumbJsonLd(breadcrumb);
const ldItemList = itemListJsonLd(
  mods.slice(0, 30).map((m) => ({
    name: m.nameFa || m.name,
    url: `/mods/${m.id}`,
  }))
);
---

<BaseLayout
  path="/mods"
  title="دانلود افزونه ماینکرفت بدراک — لیست کامل"
  description="لیست کامل افزونه‌های ماینکرفت بدراک به فارسی — شامل گیم‌پلی، گرافیک، مپ، موجودات، دکوراسیون و دنیا. همه تست‌شده و رایگان."
  type="website"
>
  <StructuredData data={ldBreadcrumb} />
  <StructuredData data={ldItemList} />
  <Breadcrumbs items={breadcrumb} />

  <div class="mb-6">
    <h1 class="text-2xl lg:text-3xl font-extrabold mb-2">همه‌ی افزونه‌ها</h1>
    <p class="text-sm text-mc-text-2">
      جستجو بین <span class="text-mc-grass-2 font-bold">{mods.length}</span>+ افزونه‌ی تست‌شده ماینکرفت بدراک
    </p>
  </div>

  <div class="mc-panel mb-6 p-4">
    <div class="flex flex-col md:flex-row gap-3 items-stretch md:items-center">
      <div class="flex-1 relative">
        <input
          type="text"
          id="modsSearchInput"
          placeholder="جستجوی افزونه (مثلاً: لکی بلاک، شیدر، تفنگ)..."
          class="w-full bg-mc-bg-2 border border-mc-line px-4 py-2.5 pr-10 text-sm text-mc-text focus:border-mc-grass-2 outline-none"
        />
        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-mc-text-3">
          <svg width="16" height="16"><use href="#icon-search" /></svg>
        </span>
      </div>
      <select id="sortSelect" class="bg-mc-bg-2 border border-mc-line px-3 py-2.5 text-sm text-mc-text">
        <option value="new">جدیدترین</option>
        <option value="featured">ویژه‌ها</option>
        <option value="name">نام (الفبا)</option>
      </select>
    </div>
    <div class="flex flex-wrap gap-2 mt-3 pt-3 border-t border-mc-line" id="chipRow">
      <button class="mc-chip active" data-cat="all">همه ({mods.length})</button>
      {categories.map((cat) => {
        const count = mods.filter(m => m.category === cat.id).length;
        return (
          <button class="mc-chip" data-cat={cat.id}>
            <svg width="12" height="12"><use href={`#${catIconMap[cat.id] || 'icon-cube'}`} /></svg>
            <span>{cat.name}</span>
            <span class="opacity-50">({count})</span>
          </button>
        );
      })}
    </div>
  </div>

  <div id="modsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
    {mods.map((mod) => <ModCard mod={mod} />)}
  </div>

  <div id="emptyState" class="mc-panel text-center py-12 hidden">
    <div class="text-5xl mb-4 text-mc-text-3">
      <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; margin: 0 auto;">
        <circle cx="11" cy="11" r="8" />
        <path d="M21 21l-4.35-4.35" />
      </svg>
    </div>
    <h3 class="text-xl font-bold text-mc-text-2 mb-2">هیچ افزونه‌ای پیدا نشد</h3>
    <p class="text-sm text-mc-text-3">عبارت دیگری را امتحان کن</p>
  </div>

  <div class="my-8">
    <AdSlot slotId="mediaad-modslist" format="banner" />
  </div>
</BaseLayout>

<script is:inline>
  // Use is:inline so Astro ALWAYS re-executes this script on every page load.
  // Use oninput/onclick (not addEventListener) to REPLACE handlers — no duplicates.
  // This fixes the bug where search only worked once or not at all after navigation.
  (function () {
    function setupModsSearch() {
      // P1-2 fix: use a unique ID instead of "searchInput" (which also
      // exists in the global SearchBox modal — getElementById was
      // grabbing the wrong input, so typing in the mods filter did
      // nothing).
      var input = document.getElementById("modsSearchInput");
      var grid = document.getElementById("modsGrid");
      var empty = document.getElementById("emptyState");
      var sort = document.getElementById("sortSelect");
      var chips = document.querySelectorAll("#chipRow .mc-chip");
      if (!input || !grid) return;

      var currentCat = "all";
      var currentQuery = "";
      var currentSort = "new";

      function getCards() {
        return Array.from(grid.children).map(function (card) {
          var cat = card.getAttribute("data-cat") || "";
          var keywords = (card.getAttribute("data-keywords") || "").toLowerCase();
          var titleEl = card.querySelector(".mod-title-link") || card.querySelector("a");
          var taglineEl = card.querySelector(".mod-tagline");
          var sizeEl = card.querySelector(".mod-size");
          var versionEl = card.querySelector(".mod-version");
          var name = titleEl ? titleEl.textContent.trim().toLowerCase() : "";
          var tagline = taglineEl ? taglineEl.textContent.trim().toLowerCase() : "";
          var size = sizeEl ? sizeEl.textContent.trim().toLowerCase() : "";
          var version = versionEl ? versionEl.textContent.trim().toLowerCase() : "";
          return {
            el: card,
            name: name,
            haystack: name + " " + tagline + " " + keywords + " " + size + " " + version + " " + cat,
            cat: cat,
            isNew: !!card.querySelector(".mod-badge.new"),
            isFeatured: !!card.querySelector(".mod-badge.featured")
          };
        });
      }

      var allCards = getCards();

      function applyFilters() {
        var visible = 0;
        var i;
        for (i = 0; i < allCards.length; i++) {
          var item = allCards[i];
          var show = true;
          if (currentCat !== "all" && item.cat !== currentCat) show = false;
          if (currentQuery && show) {
            if (item.haystack.indexOf(currentQuery.toLowerCase()) === -1) show = false;
          }
          item.el.style.display = show ? "" : "none";
          if (show) visible++;
        }
        if (empty) {
          if (visible === 0) empty.classList.remove("hidden");
          else empty.classList.add("hidden");
        }
        if (currentSort === "featured") {
          allCards.sort(function(a, b) { return (b.isFeatured?1:0) - (a.isFeatured?1:0); });
        } else if (currentSort === "name") {
          allCards.sort(function(a, b) { return a.name.localeCompare(b.name, "fa"); });
        } else {
          allCards.sort(function(a, b) { return (b.isNew?1:0) - (a.isNew?1:0); });
        }
        var frag = document.createDocumentFragment();
        for (i = 0; i < allCards.length; i++) {
          frag.appendChild(allCards[i].el);
        }
        grid.appendChild(frag);
      }

      // Use oninput/onclick — REPLACES handlers, no duplicates
      input.oninput = function(e) {
        currentQuery = e.target.value.trim();
        applyFilters();
      };

      if (sort) {
        sort.onchange = function(e) {
          currentSort = e.target.value;
          applyFilters();
        };
      }

      chips.forEach(function(chip) {
        chip.onclick = function() {
          chips.forEach(function(c) { c.classList.remove("active"); });
          chip.classList.add("active");
          currentCat = chip.dataset.cat || "all";
          applyFilters();
        };
      });

      // Initial filter
      applyFilters();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupModsSearch);
    } else {
      setupModsSearch();
    }
    document.addEventListener("astro:page-load", setupModsSearch);
  })();
</script>
