---
// src/pages/stats.astro
// REAL centralized analytics — fetches {online, today, total} from the
// Cloudflare Worker (D1-backed, dedupes by user_uuid so refresh-spam
// can't inflate). 30-day trend chart samples the Worker's daily `today`
// number once per day per browser; over time every data point is a real
// Worker number. No localStorage counting of uniques — all counting happens
// on the Worker.
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import BackButton from '@components/BackButton.astro';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'آمار', url: '/stats' },
];
---

<BaseLayout
  path="/stats"
  title="آمار سایت MineBed — بازدید امروز و کل"
  description="آمار بازدید سایت MineBed به‌صورت زنده از Cloudflare Worker: کاربران آنلاین، بازدید امروز و کل. هر بازدیدکننده‌ی یکتا فقط یک بار شمرده می‌شود — رفرش‌کردن آمار را بالا نمی‌برد."
>
  <Breadcrumbs items={breadcrumb} />
  <BackButton />

  <div class="mb-6 flex items-start justify-between gap-3 flex-wrap">
    <div>
      <h1 class="text-2xl lg:text-3xl font-extrabold mb-2">📊 آمار سایت</h1>
      <p class="text-sm text-mc-text-2">
        آمار واقعی از سرور متمرکز — هر بازدیدکننده‌ی یکتا فقط ۱ بار در روز شمرده می‌شود.
        <a href="https://github.com/IRAN-MINECRAFT-WIKI/website" target="_blank" rel="noopener" class="text-mc-grass-2 underline">منبع باز</a>.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <button id="refreshBtn" class="mc-btn ghost small">
        <span aria-hidden="true">🔄</span> به‌روزرسانی
      </button>
    </div>
  </div>

  <!-- Anti-inflation banner -->
  <div class="mb-6 p-3 rounded-lg border border-mc-grass-2/30 bg-mc-grass-2/5 text-xs text-mc-grass-2 flex items-center gap-2 flex-wrap">
    <span aria-hidden="true">🛡️</span>
    <span><b>آمار واقعی:</b> هر بازدیدکننده‌ی یکتا فقط <b>۱ بار</b> در روز شمرده می‌شود. رفرش‌کردن نمی‌تواند آمار را بالا ببرد — داده‌ها از <b>سرور متمرکز Cloudflare Worker</b> می‌آیند.</span>
  </div>

  <!-- KPI cards -->
  <section class="grid grid-cols-2 lg:grid-cols-3 gap-3 mb-6" id="kpiGrid">
    <div class="mc-card p-4">
      <div class="flex items-center gap-2 text-xs text-mc-text-3 font-bold mb-1">
        <span class="kpi-dot" aria-hidden="true"></span>
        <span>آنلاین (زنده)</span>
      </div>
      <div class="text-3xl font-extrabold text-mc-grass-2" id="kpiOnline">⏳</div>
      <div class="text-[10px] text-mc-text-3 mt-1" id="kpiOnlineSub">در حال بارگذاری از سرور…</div>
    </div>
    <div class="mc-card p-4">
      <div class="flex items-center gap-2 text-xs text-mc-text-3 font-bold mb-1">
        <span aria-hidden="true">📈</span>
        <span>بازدید امروز</span>
      </div>
      <div class="text-3xl font-extrabold text-mc-diamond" id="kpiToday">⏳</div>
      <div class="text-[10px] text-mc-text-3 mt-1" id="kpiTodaySub">از ساعت ۰۰:۰۰ (UTC)</div>
    </div>
    <div class="mc-card p-4 col-span-2 lg:col-span-1">
      <div class="flex items-center gap-2 text-xs text-mc-text-3 font-bold mb-1">
        <span aria-hidden="true">🔢</span>
        <span>بازدید کل</span>
      </div>
      <div class="text-3xl font-extrabold text-mc-gold" id="kpiTotal">⏳</div>
      <div class="text-[10px] text-mc-text-3 mt-1" id="kpiTotalSub">از ابتدای راه‌اندازی سرور</div>
    </div>
  </section>

  <!-- 30-day trend chart -->
  <section class="mc-panel p-5 mb-6">
    <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
      <h2 class="text-lg font-extrabold flex items-center gap-2">
        <span aria-hidden="true">📈</span> روند ۳۰ روزه
      </h2>
      <span class="text-xs text-mc-text-3" id="chart30Meta">—</span>
    </div>
    <div id="chart30" class="w-full overflow-x-auto"></div>
    <p class="text-[10px] text-mc-text-3 mt-2">هر ستون = بازدید روزانه‌ی واقعی از سرور. ستون‌های علامت‌دار با ⭐ نمونه‌ی واقعی امروز هستند؛ بقیه با گذشت زمان جایگزین می‌شوند.</p>
  </section>

  <!-- Top pages (local browser — honestly labeled) -->
  <section class="mc-panel p-5 mb-6">
    <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
      <h2 class="text-lg font-extrabold flex items-center gap-2">
        <span aria-hidden="true">📄</span> صفحات دیده‌شده توسط شما
      </h2>
      <span class="text-xs text-mc-text-3" id="topMeta">—</span>
    </div>
    <div id="topPagesList" class="space-y-2"></div>
    <p class="text-[10px] text-mc-text-3 mt-3">این بخش فقط صفحات دیده‌شده توسط همین مرورگر را نشان می‌دهد (داده‌ی محلی). آمار سایت‌گسترده‌ی صفحات نیازمند ارتقای سرور است.</p>
  </section>

  <!-- Privacy / how it works -->
  <section class="mc-panel p-5 text-sm">
    <h2 class="text-base font-extrabold mb-2 flex items-center gap-2">
      <span aria-hidden="true">🔒</span> حریم خصوصی و نحوه‌ی کار
    </h2>
    <ul class="text-xs text-mc-text-2 space-y-1.5 list-disc pr-4">
      <li><b>آمار واقعی:</b> اعداد آنلاین/امروز/کل از <a href="https://minebed-api.www-habib6269.workers.dev/api/stats" target="_blank" rel="noopener" class="text-mc-grass-2 underline">Cloudflare Worker</a> می‌آیند — متمرکز برای همه‌ی بازدیدکنندگان.</li>
      <li><b>ضد تقلب:</b> هر مرورگر یک شناسه‌ی یکتا (UUID) دارد. سرور هر UUID را فقط یک بار در روز شمرده می‌شود — رفرش‌کردن آمار را بالا نمی‌برد.</li>
      <li><b>بدون سرور ماینکرفت:</b> این آمار بازدید وب‌سایت است، نه سرور بازی.</li>
      <li><b>حریم خصوصی:</b> شناسه‌ی مرورگر یک UUID تصادفی است — هیچ داده‌ی شخصی در آن نیست.</li>
      <li><b>نمودار ۳۰ روزه:</b> هر بار که این صفحه را باز می‌کنید، عدد «امروز» از سرور نمونه‌برداری می‌شود و در روند ۳۰ روزه ثبت می‌گردد.</li>
    </ul>
  </section>
</BaseLayout>

<style>
  .kpi-dot {
    width: 8px;
    height: 8px;
    background: #7cc84a;
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(124, 200, 74, 0.8);
    animation: kpiPulse 1.8s ease-in-out infinite;
  }
  @keyframes kpiPulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.4; }
  }

  .chart-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .chart-bar {
    fill: rgba(124, 200, 74, 0.5);
    stroke: #7cc84a;
    stroke-width: 1;
    transition: fill 0.15s;
  }
  .chart-bar:hover {
    fill: rgba(124, 200, 74, 0.85);
  }
  .chart-bar.real {
    fill: rgba(74, 237, 217, 0.7);
    stroke: #4aedd9;
  }
  .chart-bar.today {
    fill: rgba(252, 179, 43, 0.7);
    stroke: #fcb32b;
  }
  .chart-axis-text {
    fill: #8585a3;
    font-size: 10px;
    font-family: 'Rooyin', sans-serif;
  }
  .chart-grid {
    stroke: rgba(255, 255, 255, 0.05);
    stroke-width: 1;
  }

  .top-row {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 60px 80px;
    gap: 0.5rem;
    align-items: center;
    padding: 0.45rem 0.55rem;
    background: rgba(13, 13, 24, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
  }
  .top-rank {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.7rem;
    color: #fcb32b;
    text-align: center;
  }
  .top-label {
    min-width: 0;
    font-size: 0.8rem;
    color: #e8e8f4;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    direction: ltr;
    text-align: left;
  }
  .top-count {
    font-family: monospace;
    font-size: 0.75rem;
    color: #4aedd9;
    text-align: center;
  }
  .top-bar-wrap {
    min-width: 0;
    display: flex;
    align-items: center;
  }
  .top-bar {
    height: 8px;
    background: linear-gradient(90deg, #7cc84a, #4aedd9);
    border-radius: 4px;
    transition: width 0.3s ease-out;
    max-width: 100%;
  }

  @media (max-width: 600px) {
    .top-row {
      grid-template-columns: 28px minmax(0, 1fr) 60px;
    }
    .top-row .top-bar-wrap {
      display: none;
    }
  }
</style>

<script>
  // ============================================================
  // /stats — render KPIs + 30-day trend chart from REAL Worker data
  // ============================================================
  import {
    getStats,
    getDailyHistory,
    getPageHits,
    trackVisit,
    heartbeat,
    fmtFa,
    shamsiLabel,
  } from '@/lib/analytics.js';

  const PAGE_NAMES = {
    '/': 'خانه',
    '/wiki/blocks': 'ویکی — بلاک‌ها',
    '/wiki/mobs': 'ویکی — ماب‌ها',
    '/mods': 'دانلود ماد‌ها',
    '/speedrun': 'سرعت‌رانی',
    '/tutorials': 'آموزش‌ها',
    '/seeds/create': 'ساخت سید',
    '/crafting': 'کرافت',
    '/blog': 'وبلاگ',
    '/stats': 'آمار سایت',
    '/wiki': 'ویکی',
    '/versions': 'نسخه‌ها',
    '/categories': 'دسته‌بندی‌ها',
  };

  const PAGE_COLORS = {
    '/': '#7cc84a',
    '/wiki/blocks': '#7e7e7e',
    '/wiki/mobs': '#3d7521',
    '/mods': '#a855f7',
    '/speedrun': '#fcb32b',
    '/tutorials': '#06b6d4',
    '/seeds/create': '#84cc16',
    '/crafting': '#ec4899',
    '/blog': '#8b5cf6',
  };

  function setupStatsPage() {
    trackVisit();
    render();
    if (!window.__statsHB) {
      window.__statsHB = setInterval(render, 30_000);
    }
  }

  async function render() {
    const remote = await getStats();
    const history = getDailyHistory();
    const hits = getPageHits();

    const s = {
      online: remote.online || 0,
      today: remote.today || 0,
      total: remote.total || 0,
      source: remote.source || 'offline',
      isReal: remote.isReal !== false,
      history,
      hits,
    };

    paintKpis(s);
    paintChart30(s);
    paintTopPages(s);
  }

  function paintKpis(s) {
    const el = (id) => document.getElementById(id);
    const online = el('kpiOnline');
    const today = el('kpiToday');
    const total = el('kpiTotal');
    if (online) online.textContent = fmtFa(s.online);
    if (today) today.textContent = fmtFa(s.today);
    if (total) total.textContent = fmtFa(s.total);

    const onlineSub = el('kpiOnlineSub');
    const todaySub = el('kpiTodaySub');
    const totalSub = el('kpiTotalSub');
    if (onlineSub) onlineSub.textContent = s.isReal ? 'از سرور متمرکز — ۶۰ ثانیه‌ی اخیر' : 'سرور در دسترس نیست';
    if (todaySub) todaySub.textContent = s.isReal ? 'از ساعت ۰۰:۰۰ (UTC) — واقعی' : '—';
    if (totalSub) totalSub.textContent = s.isReal ? 'از ابتدای راه‌اندازی سرور' : '—';
  }

  function paintChart30(s) {
    const wrap = document.getElementById('chart30');
    const meta = document.getElementById('chart30Meta');
    if (!wrap) return;

    const data = s.history || [];
    if (data.length === 0) {
      wrap.innerHTML = '<p class="text-xs text-mc-text-3 text-center py-8">داده‌ای موجود نیست.</p>';
      if (meta) meta.textContent = '—';
      return;
    }

    const W = 760;
    const H = 200;
    const padL = 36;
    const padR = 12;
    const padT = 14;
    const padB = 28;
    const chartW = W - padL - padR;
    const chartH = H - padT - padB;

    const maxVal = Math.max(...data.map((d) => d.today), 1);
    const yMax = Math.ceil(maxVal * 1.15);
    const barW = chartW / data.length * 0.7;
    const gap = chartW / data.length * 0.3;

    const todayStr = new Date().toISOString().split('T')[0];

    let bars = '';
    let gridLines = '';
    let yLabels = '';

    // Y-axis grid + labels (5 lines)
    for (let i = 0; i <= 4; i++) {
      const y = padT + (chartH / 4) * i;
      const val = Math.round(yMax * (1 - i / 4));
      gridLines += `<line class="chart-grid" x1="${padL}" y1="${y}" x2="${W - padR}" y2="${y}" />`;
      yLabels += `<text class="chart-axis-text" x="${padL - 6}" y="${y + 3}" text-anchor="end">${fmtFa(val)}</text>`;
    }

    // Bars
    data.forEach((d, i) => {
      const x = padL + (chartW / data.length) * i + gap / 2;
      const h = Math.max(2, (d.today / yMax) * chartH);
      const y = padT + chartH - h;
      const isToday = d.date === todayStr;
      const isReal = !d.seed;
      const cls = isToday ? 'chart-bar today' : isReal ? 'chart-bar real' : 'chart-bar';
      const star = isToday ? '⭐' : isReal ? '✓' : '';
      bars += `<rect class="${cls}" x="${x}" y="${y}" width="${barW}" height="${h}" rx="2">
        <title>${shamsiLabel(d.date)} — ${fmtFa(d.today)} بازدید ${isReal ? '(واقعی)' : '(تخمینی)'}</title>
      </rect>`;
      // X-axis label every ~5 days
      if (i % 5 === 0 || isToday) {
        bars += `<text class="chart-axis-text" x="${x + barW / 2}" y="${H - padB + 14}" text-anchor="middle">${shamsiLabel(d.date)}</text>`;
      }
      if (star) {
        bars += `<text x="${x + barW / 2}" y="${y - 4}" text-anchor="middle" font-size="9">${star}</text>`;
      }
    });

    const svg = `<svg class="chart-svg" viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="نمودار ۳۰ روزه">
      <defs>
        <linearGradient id="barGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#7cc84a" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#4aedd9" stop-opacity="0.4" />
        </linearGradient>
      </defs>
      ${gridLines}
      ${yLabels}
      ${bars}
    </svg>`;

    wrap.innerHTML = svg;

    const realCount = data.filter((d) => !d.seed).length;
    if (meta) {
      meta.textContent = `${fmtFa(data.length)} روز · ${fmtFa(realCount)} نمونه‌ی واقعی · اوج: ${fmtFa(Math.max(...data.map((d) => d.today)))}`;
    }
  }

  function paintTopPages(s) {
    const wrap = document.getElementById('topPagesList');
    const meta = document.getElementById('topMeta');
    if (!wrap) return;

    const hits = s.hits || {};
    const entries = Object.entries(hits).sort((a, b) => b[1] - a[1]);
    if (entries.length === 0) {
      wrap.innerHTML = '<p class="text-xs text-mc-text-3 text-center py-6">هنوز صفحه‌ای در این مرورگر دیده نشده.</p>';
      if (meta) meta.textContent = '—';
      return;
    }

    const maxHits = entries[0][1];
    wrap.innerHTML = entries
      .map(([path, count], i) => {
        const name = PAGE_NAMES[path] || path;
        const color = PAGE_COLORS[path] || '#7cc84a';
        const pct = (count / maxHits) * 100;
        const rank = i + 1;
        return `<div class="top-row">
          <div class="top-rank">${fmtFa(rank)}</div>
          <div>
            <div class="top-label">${name}</div>
            <div class="top-path">${path}</div>
          </div>
          <div class="top-count">${fmtFa(count)}</div>
          <div class="top-bar-wrap">
            <div class="top-bar" style="width:${pct}%; background: linear-gradient(90deg, ${color}, #4aedd9);"></div>
          </div>
        </div>`;
      })
      .join('');

    if (meta) meta.textContent = `${fmtFa(entries.length)} صفحه — محلی`;
  }

  // Refresh button
  document.getElementById('refreshBtn')?.addEventListener('click', () => {
    const btn = document.getElementById('refreshBtn');
    if (btn) {
      const orig = btn.innerHTML;
      btn.innerHTML = '<span aria-hidden="true">⏳</span> در حال بارگذاری…';
      btn.disabled = true;
      heartbeat().then(() => {
        setTimeout(() => {
          render();
          if (btn) {
            btn.innerHTML = orig;
            btn.disabled = false;
          }
        }, 500);
      });
    }
  });

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupStatsPage);
  } else {
    setupStatsPage();
  }
</script>
