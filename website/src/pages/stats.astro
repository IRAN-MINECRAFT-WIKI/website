---
// src/pages/stats.astro
// Client-side analytics dashboard — no backend, no third-party tracker.
// All numbers come from src/lib/analytics.js (locally-tracked in
// localStorage). Charts are pure SVG, no Chart.js needed.
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import BackButton from '@components/BackButton.astro';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'آمار', url: '/stats' },
];
---

<BaseLayout
  path="/stats"
  title="آمار سایت MineBed — بازدید امروز و کل"
  description="آمار بازدید سایت MineBed به‌صورت زنده: کاربران آنلاین، بازدید امروز، بازدید کل، نمودار ۳۰ روزه و ۲۴ ساعته. همه‌ی داده‌ها روی همین مرورگر شما نگه‌داری می‌شوند."
>
  <Breadcrumbs items={breadcrumb} />
  <BackButton />

  <div class="mb-6 flex items-start justify-between gap-3 flex-wrap">
    <div>
      <h1 class="text-2xl lg:text-3xl font-extrabold mb-2">📊 آمار سایت</h1>
      <p class="text-sm text-mc-text-2">
        آمار زنده از Cloudflare Worker — تعداد آنلاین‌ها، بازدید امروز و کل به‌صورت لحظه‌ای.
        <a href="https://github.com/IRAN-MINECRAFT-WIKI/website" target="_blank" rel="noopener" class="text-mc-grass-2 underline">منبع باز</a>.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <button id="refreshBtn" class="mc-btn ghost small">
        <span aria-hidden="true">🔄</span> به‌روزرسانی
      </button>
      <button id="resetBtn" class="mc-btn small danger">
        <span aria-hidden="true">🗑️</span> پاک‌سازی داده‌ها
      </button>
    </div>
  </div>

  <!-- KPI cards -->
  <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6" id="kpiGrid">
    <div class="mc-card p-4">
      <div class="flex items-center gap-2 text-xs text-mc-text-3 font-bold mb-1">
        <span class="kpi-dot" aria-hidden="true"></span>
        <span>آنلاین (زنده)</span>
      </div>
      <div class="text-2xl font-extrabold text-mc-grass-2" id="kpiOnline">⏳</div>
      <div class="text-[10px] text-mc-text-3 mt-1" id="kpiOnlineSub">در حال بارگذاری…</div>
    </div>
    <div class="mc-card p-4">
      <div class="flex items-center gap-2 text-xs text-mc-text-3 font-bold mb-1">
        <span aria-hidden="true">📈</span>
        <span>بازدید امروز</span>
      </div>
      <div class="text-2xl font-extrabold text-mc-diamond" id="kpiToday">⏳</div>
      <div class="text-[10px] text-mc-text-3 mt-1" id="kpiTodaySub">از ساعت ۰۰:۰۰</div>
    </div>
    <div class="mc-card p-4">
      <div class="flex items-center gap-2 text-xs text-mc-text-3 font-bold mb-1">
        <span aria-hidden="true">🔥</span>
        <span>بازدید کل (این مرورگر)</span>
      </div>
      <div class="text-2xl font-extrabold text-mc-gold" id="kpiTotal">⏳</div>
      <div class="text-[10px] text-mc-text-3 mt-1" id="kpiTotalSub">از اولین بازدید</div>
    </div>
    <div class="mc-card p-4">
      <div class="flex items-center gap-2 text-xs text-mc-text-3 font-bold mb-1">
        <span aria-hidden="true">🆔</span>
        <span>شناسه‌ی مرورگر</span>
      </div>
      <div class="text-xs font-mono text-mc-text break-all" id="kpiUuid">⏳</div>
      <div class="text-[10px] text-mc-text-3 mt-1">پایدار تا پاک‌سازی</div>
    </div>
  </section>

  <!-- 30-day chart -->
  <section class="mc-panel p-5 mb-6">
    <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
      <h2 class="text-lg font-extrabold flex items-center gap-2">
        <span aria-hidden="true">📅</span> بازدید ۳۰ روز اخیر
      </h2>
      <span class="text-xs text-mc-text-3" id="chart30Meta">—</span>
    </div>
    <div id="chart30" class="w-full overflow-x-auto"></div>
    <p class="text-[10px] text-mc-text-3 mt-2">محور افقی: ۳۰ روز گذشته · محور عمودی: تعداد بازدید در روز</p>
  </section>

  <!-- 24-hour chart -->
  <section class="mc-panel p-5 mb-6">
    <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
      <h2 class="text-lg font-extrabold flex items-center gap-2">
        <span aria-hidden="true">⏰</span> بازدید ۲۴ ساعته‌ی امروز
      </h2>
      <span class="text-xs text-mc-text-3" id="chart24Meta">—</span>
    </div>
    <div id="chart24" class="w-full overflow-x-auto"></div>
    <p class="text-[10px] text-mc-text-3 mt-2">محور افقی: ساعت ۰۰ تا ۲۳ · محور عمودی: تعداد بازدید در ساعت</p>
  </section>

  <!-- Top pages -->
  <section class="mc-panel p-5 mb-6">
    <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
      <h2 class="text-lg font-extrabold flex items-center gap-2">
        <span aria-hidden="true">🏆</span> صفحه‌های پربازدید
      </h2>
      <span class="text-xs text-mc-text-3" id="topMeta">—</span>
    </div>
    <div id="topPagesList" class="space-y-2"></div>
    <p class="text-[10px] text-mc-text-3 mt-3">از ۱۰ صفحه‌ی اصلی + هر صفحه‌ی دیگه که دیده‌ای. صفحات بدون بازدید نمایش داده نمی‌شن.</p>
  </section>

  <!-- Info footer -->
  <section class="mc-panel p-5 text-sm">
    <h2 class="text-base font-extrabold mb-2 flex items-center gap-2">
      <span aria-hidden="true">🔒</span> حریم خصوصی
    </h2>
    <ul class="text-xs text-mc-text-2 space-y-1.5 list-disc pr-4">
      <li>هیچ داده‌ای به سرور ارسال نمی‌شود — همه‌ی آمار روی همین مرورگر نگه‌داری می‌شود.</li>
      <li>«آنلاین» یک عدد شبیه‌سازی‌شده است (بین ۵۰ تا ۲۰۰) — وابسته به روز و ساعت، مستقل از تعداد واقعی بازدیدکنندگان.</li>
      <li>شناسه‌ی مرورگر یک UUID تصادفی است که در localStorage ذخیره می‌شود — هیچ داده‌ی شخصی در آن نیست.</li>
      <li>دکمه‌ی «پاک‌سازی داده‌ها» همه‌ی آمار و شناسه را در همین مرورگر پاک می‌کند.</li>
      <li>برای آمار واقعیِ آنلاین/کلی به یک سرور نیاز است که در نسخه‌ی بعدی اضافه می‌شود.</li>
    </ul>
  </section>
</BaseLayout>

<style>
  .kpi-dot {
    width: 8px;
    height: 8px;
    background: #7cc84a;
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(124, 200, 74, 0.8);
    animation: kpiPulse 1.8s ease-in-out infinite;
  }
  @keyframes kpiPulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.4; }
  }

  .chart-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .chart-bar {
    fill: rgba(124, 200, 74, 0.5);
    stroke: #7cc84a;
    stroke-width: 1;
    transition: fill 0.15s;
  }
  .chart-bar:hover {
    fill: rgba(124, 200, 74, 0.85);
  }
  .chart-bar.today {
    fill: rgba(74, 237, 217, 0.6);
    stroke: #4aedd9;
  }
  .chart-bar.now {
    fill: rgba(252, 179, 43, 0.7);
    stroke: #fcb32b;
  }
  .chart-line {
    fill: none;
    stroke: #4aedd9;
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .chart-area {
    fill: url(#chartAreaGradient);
    opacity: 0.6;
  }
  .chart-axis-text {
    fill: #8585a3;
    font-size: 10px;
    font-family: 'Rooyin', sans-serif;
  }
  .chart-grid {
    stroke: rgba(255, 255, 255, 0.05);
    stroke-width: 1;
  }
  .chart-point {
    fill: #4aedd9;
    stroke: #0d0d18;
    stroke-width: 1.5;
  }
  .chart-point.now {
    fill: #fcb32b;
    r: 5;
  }

  .top-row {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 60px 80px;
    gap: 0.5rem;
    align-items: center;
    padding: 0.45rem 0.55rem;
    background: rgba(13, 13, 24, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
  }
  .top-rank {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.7rem;
    color: #fcb32b;
    text-align: center;
  }
  .top-label {
    /* min-width: 0 is critical for grid items — without it, the implicit
       `min-width: auto` lets long text overflow the assigned 1fr track
       and push the bar+count columns out of alignment. */
    min-width: 0;
    font-size: 0.8rem;
    color: #e8e8f4;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    direction: ltr;
    text-align: left;
  }
  .top-path {
    font-family: monospace;
    font-size: 0.65rem;
    color: #8585a3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    direction: ltr;
    text-align: left;
    min-width: 0;
  }
  .top-bar-wrap {
    min-width: 0;
    display: flex;
    align-items: center;
  }
  .top-bar {
    height: 8px;
    background: linear-gradient(90deg, #7cc84a, #4aedd9);
    border-radius: 4px;
    transition: width 0.3s ease-out;
    max-width: 100%;
  }

  @media (max-width: 600px) {
    .top-row {
      grid-template-columns: 28px minmax(0, 1fr) 60px;
    }
    .top-row .top-bar-wrap {
      display: none;
    }
  }
</style>

<script>
  // ============================================================
  // /stats — render all KPIs + SVG charts
  // ============================================================
  import {
    getStats,
    getLocalStats,
    resetAnalytics,
    trackVisit,
    heartbeat,
    fmtFa,
  } from '@/lib/analytics.js';
  import { resetUUID, getOrCreateUUID } from '@/lib/uuid.js';

  function setupStatsPage() {
    trackVisit('/stats');
    render();
    // Refresh online number every 30s
    if (!window.__statsHB) {
      window.__statsHB = setInterval(render, 30_000);
    }
  }

  async function render() {
    // Fetch real stats from Cloudflare Worker (async)
    const remote = await getStats();
    // Get local chart data from localStorage (sync)
    const local = getLocalStats();

    // Merge: remote (online/today/total) + local (charts)
    const s = {
      online: remote.online || 0,
      today: remote.today || 0,
      total: remote.total || 0,
      source: remote.source || 'local',
      uuid: getOrCreateUUID(),
      lastSeen: Date.now(),
      // Transform byDay object → last30 array of {date, count}
      last30: Object.entries(local.byDay || {}).map(([date, count]) => ({ date, count })),
      byHour: local.byHour || {},
      hits: local.hits || {},
    };

    paintKpis(s);
    paintChart30(s);
    paintChart24(s);
    paintTopPages(s);
  }

  function paintKpis(s) {
    const elOnline = document.getElementById('kpiOnline');
    const elToday = document.getElementById('kpiToday');
    const elTotal = document.getElementById('kpiTotal');
    const elUuid = document.getElementById('kpiUuid');
    if (elOnline) elOnline.textContent = fmtFa(s.online);
    if (elToday) elToday.textContent = fmtFa(s.today);
    if (elTotal) elTotal.textContent = fmtFa(s.total, { short: true });
    if (elUuid) elUuid.textContent = s.uuid || '—';

    // Sub labels
    const subOnline = document.getElementById('kpiOnlineSub');
    const subTotal = document.getElementById('kpiTotalSub');
    if (subOnline) {
      const d = new Date();
      subOnline.textContent = 'ساعت ' + d.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit' });
    }
    if (subTotal) {
      const days = Math.max(1, Math.ceil((Date.now() - (s.lastSeen || Date.now())) / 86_400_000));
      subTotal.textContent = fmtFa(s.total) + ' بازدید';
    }
  }

  function paintChart30(s) {
    const el = document.getElementById('chart30');
    const meta = document.getElementById('chart30Meta');
    if (!el) return;
    if (!s.last30 || s.last30.length === 0) {
      el.innerHTML = '<div class="text-center text-mc-text-3 text-xs py-6">داده‌ای موجود نیست — چند صفحه باز کن تا نمودار پر شود.</div>';
      if (meta) meta.textContent = '—';
      return;
    }
    const data = s.last30;
    const max = Math.max(1, ...data.map((d) => d.count));
    const today = data[data.length - 1];

    // SVG dims — responsive via viewBox
    const w = 760, h = 180;
    const padL = 32, padR = 12, padT = 12, padB = 28;
    const plotW = w - padL - padR;
    const plotH = h - padT - padB;
    const barW = plotW / data.length;
    const barGap = barW * 0.18;

    let svg = '<svg class="chart-svg" viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="xMidYMid meet" role="img" aria-label="نمودار ۳۰ روزه">';

    // Gridlines (4 horizontal)
    for (let g = 0; g <= 4; g++) {
      const y = padT + (plotH * g) / 4;
      const val = Math.round(max - (max * g) / 4);
      svg += '<line class="chart-grid" x1="' + padL + '" y1="' + y + '" x2="' + (w - padR) + '" y2="' + y + '"/>';
      svg += '<text class="chart-axis-text" x="' + (padL - 6) + '" y="' + (y + 3) + '" text-anchor="end">' + toFa(String(val)) + '</text>';
    }

    // Bars
    data.forEach((d, i) => {
      const x = padL + i * barW + barGap / 2;
      const barHeight = (d.count / max) * plotH;
      const y = padT + plotH - barHeight;
      const cls = i === data.length - 1 ? 'chart-bar today' : 'chart-bar';
      const titleText = d.date + ': ' + toFa(String(d.count)) + ' بازدید';
      svg += '<rect class="' + cls + '" x="' + x.toFixed(2) + '" y="' + y.toFixed(2) +
        '" width="' + (barW - barGap).toFixed(2) + '" height="' + barHeight.toFixed(2) + '" rx="2">' +
        '<title>' + escapeHtml(titleText) + '</title></rect>';
    });

    // X-axis labels (every 5 days)
    data.forEach((d, i) => {
      if (i % 5 === 0 || i === data.length - 1) {
        const x = padL + i * barW + barW / 2;
        const y = h - padB + 14;
        svg += '<text class="chart-axis-text" x="' + x.toFixed(2) + '" y="' + y + '" text-anchor="middle">' + escapeHtml(d.label) + '</text>';
      }
    });

    svg += '</svg>';
    el.innerHTML = svg;
    if (meta) {
      const total30 = data.reduce((a, b) => a + b.count, 0);
      meta.textContent = 'مجموع ۳۰ روز: ' + fmtFa(total30) + ' بازدید · امروز: ' + fmtFa(today.count);
    }
  }

  function paintChart24(s) {
    const el = document.getElementById('chart24');
    const meta = document.getElementById('chart24Meta');
    if (!el) return;
    if (!s.last24 || s.last24.length === 0) {
      el.innerHTML = '<div class="text-center text-mc-text-3 text-xs py-6">داده‌ای موجود نیست.</div>';
      if (meta) meta.textContent = '—';
      return;
    }
    const data = s.last24;
    const max = Math.max(1, ...data.map((d) => d.count));
    const nowH = new Date().getHours();
    const now = data[nowH];

    const w = 760, h = 180;
    const padL = 32, padR = 12, padT = 12, padB = 28;
    const plotW = w - padL - padR;
    const plotH = h - padT - padB;
    const stepX = plotW / (data.length - 1);

    let svg = '<svg class="chart-svg" viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="xMidYMid meet" role="img" aria-label="نمودار ۲۴ ساعته">';

    // Gradient def for area fill
    svg += '<defs><linearGradient id="chartAreaGradient" x1="0" y1="0" x2="0" y2="1">';
    svg += '<stop offset="0%" stop-color="#4aedd9" stop-opacity="0.5"/>';
    svg += '<stop offset="100%" stop-color="#4aedd9" stop-opacity="0"/>';
    svg += '</linearGradient></defs>';

    // Gridlines
    for (let g = 0; g <= 4; g++) {
      const y = padT + (plotH * g) / 4;
      const val = Math.round(max - (max * g) / 4);
      svg += '<line class="chart-grid" x1="' + padL + '" y1="' + y + '" x2="' + (w - padR) + '" y2="' + y + '"/>';
      svg += '<text class="chart-axis-text" x="' + (padL - 6) + '" y="' + (y + 3) + '" text-anchor="end">' + toFa(String(val)) + '</text>';
    }

    // Build line path + area path
    let line = '';
    let area = 'M ' + padL + ' ' + (padT + plotH) + ' ';
    data.forEach((d, i) => {
      const x = padL + i * stepX;
      const y = padT + plotH - (d.count / max) * plotH;
      line += (i === 0 ? 'M ' : 'L ') + x.toFixed(2) + ' ' + y.toFixed(2) + ' ';
      area += 'L ' + x.toFixed(2) + ' ' + y.toFixed(2) + ' ';
    });
    const lastX = padL + (data.length - 1) * stepX;
    area += 'L ' + lastX.toFixed(2) + ' ' + (padT + plotH) + ' Z';

    svg += '<path class="chart-area" d="' + area + '"/>';
    svg += '<path class="chart-line" d="' + line + '"/>';

    // Points (every 3 hours + now)
    data.forEach((d, i) => {
      if (i % 3 === 0 || i === nowH) {
        const x = padL + i * stepX;
        const y = padT + plotH - (d.count / max) * plotH;
        const cls = i === nowH ? 'chart-point now' : 'chart-point';
        svg += '<circle class="' + cls + '" cx="' + x.toFixed(2) + '" cy="' + y.toFixed(2) + '" r="3">' +
          '<title>' + escapeHtml(d.label + ': ' + toFa(String(d.count)) + ' بازدید') + '</title></circle>';
      }
    });

    // X-axis labels (every 6 hours)
    data.forEach((d, i) => {
      if (i % 6 === 0 || i === data.length - 1) {
        const x = padL + i * stepX;
        const y = h - padB + 14;
        svg += '<text class="chart-axis-text" x="' + x.toFixed(2) + '" y="' + y + '" text-anchor="middle">' + escapeHtml(String(d.hour).padStart(2, '0')) + '</text>';
      }
    });

    svg += '</svg>';
    el.innerHTML = svg;
    if (meta) {
      const total24 = data.reduce((a, b) => a + b.count, 0);
      meta.textContent = 'مجموع امروز: ' + fmtFa(total24) + ' بازدید · ساعت ' + String(nowH).padStart(2, '0') + ':۰۰ = ' + fmtFa(now.count);
    }
  }

  function paintTopPages(s) {
    const el = document.getElementById('topPagesList');
    const meta = document.getElementById('topMeta');
    if (!el) return;
    if (!s.topPages || s.topPages.length === 0) {
      el.innerHTML = '<div class="text-center text-mc-text-3 text-xs py-6">هنوز صفحه‌ای پربازدید نیست.</div>';
      if (meta) meta.textContent = '—';
      return;
    }
    const list = s.topPages.filter((p) => p.hits > 0).slice(0, 10);
    if (list.length === 0) {
      el.innerHTML = '<div class="text-center text-mc-text-3 text-xs py-6">هنوز هیچ صفحه‌ای در این مرورگر بازدید نشده. چند صفحه باز کن تا این نمودار پر شود.</div>';
      if (meta) meta.textContent = '۰ صفحه';
      return;
    }
    const max = Math.max(...list.map((p) => p.hits));
    el.innerHTML = '';
    list.forEach((p, idx) => {
      const row = document.createElement('div');
      row.className = 'top-row';
      const pct = (p.hits / max) * 100;
      const rankFa = toFa(String(idx + 1));
      const label = escapeHtml(p.label || p.path);
      const path = escapeHtml(p.path);
      row.innerHTML =
        '<span class="top-rank">' + rankFa + '</span>' +
        '<span class="top-label" title="' + path + '">' + label + '</span>' +
        '<span class="font-mono text-xs text-mc-diamond text-right" dir="ltr">' + fmtFa(p.hits) + '</span>' +
        '<div class="top-bar-wrap"><div class="top-bar" style="width:' + pct.toFixed(0) + '%"></div></div>';
      el.appendChild(row);
    });
    if (meta) meta.textContent = toFa(String(list.length)) + ' صفحه';
  }

  // ============================================================
  // Wire up buttons
  // ============================================================
  function wireButtons() {
    const refBtn = document.getElementById('refreshBtn');
    const resetBtn = document.getElementById('resetBtn');
    if (refBtn && !refBtn.dataset.wired) {
      refBtn.dataset.wired = '1';
      refBtn.addEventListener('click', () => {
        refBtn.disabled = true;
        render();
        setTimeout(() => { refBtn.disabled = false; }, 500);
      });
    }
    if (resetBtn && !resetBtn.dataset.wired) {
      resetBtn.dataset.wired = '1';
      resetBtn.addEventListener('click', () => {
        if (!confirm('همه‌ی آمار و شناسه‌ی مرورگر پاک بشه؟ این عمل قابل بازگشت نیست.')) return;
        resetAnalytics();
        resetUUID();
        // Force-create a new UUID so the KPI shows something
        getOrCreateUUID();
        render();
      });
    }
  }

  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function toFa(s) {
    const fa = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
    return String(s).replace(/[0-9]/g, (d) => fa[+d]).replace(/-/g, '−');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupStatsPage();
      wireButtons();
    });
  } else {
    setupStatsPage();
    wireButtons();
  }
  document.addEventListener('astro:page-load', () => {
    setupStatsPage();
    wireButtons();
  });
</script>
