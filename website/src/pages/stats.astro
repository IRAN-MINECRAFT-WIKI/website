---
// src/pages/stats.astro
// REAL centralized analytics — Minecraft pixel theme using the site's
// existing mc-card/mc-btn/pixel-font styles. Fetches {online, today, total}
// from the Cloudflare Worker (D1-backed, dedupes by user_uuid). Chart.js
// for beautiful charts with Minecraft colors.
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import BackButton from '@components/BackButton.astro';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'آمار', url: '/stats' },
];
---

<BaseLayout
  path="/stats"
  title="آمار سایت MineBed — بازدید امروز و کل"
  description="آمار بازدید سایت MineBed به‌صورت زنده از Cloudflare Worker: کاربران آنلاین، بازدید امروز و کل. هر بازدیدکننده‌ی یکتا فقط یک بار شمرده می‌شود."
>
  <Breadcrumbs items={breadcrumb} />
  <BackButton />

  <div class="mb-6 flex items-start justify-between gap-3 flex-wrap">
    <div>
      <h1 class="text-2xl lg:text-3xl font-extrabold mb-2 font-pixel text-mc-grass-2 inline-flex items-center gap-2" style="font-size: 1.3rem; line-height: 1.6;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-stats"/></svg> آمار سایت</h1>
      <p class="text-sm text-mc-text-2">
        آمار واقعی از سرور متمرکز — هر بازدیدکننده‌ی یکتا فقط ۱ بار در روز شمرده می‌شود.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <button id="refreshBtn" class="mc-btn ghost small">
        <span aria-hidden="true" class="inline-flex"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-refresh"/></svg></span> به‌روزرسانی
      </button>
    </div>
  </div>

  <!-- Anti-inflation banner -->
  <div class="mb-6 p-3 rounded-lg border border-mc-grass-2/30 bg-mc-grass-2/5 text-xs text-mc-grass-2 flex items-center gap-2 flex-wrap">
    <span aria-hidden="true" class="shrink-0"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-lock"/></svg></span>
    <span><b>آمار واقعی:</b> هر بازدیدکننده‌ی یکتا فقط <b>۱ بار</b> در روز شمرده می‌شود. رفرش‌کردن نمی‌تواند آمار را بالا ببرد — داده‌ها از <b>سرور Cloudflare Worker</b> می‌آیند.</span>
  </div>

  <!-- KPI cards -->
  <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6" id="kpiGrid">
    <div class="mc-card p-4">
      <div class="flex items-center gap-2 text-xs text-mc-text-3 font-bold mb-1">
        <span class="kpi-dot" aria-hidden="true"></span>
        <span>آنلاین (زنده)</span>
      </div>
      <div class="text-3xl font-extrabold text-mc-grass-2" id="kpiOnline"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-hourglass"/></svg></div>
      <div class="text-[10px] text-mc-text-3 mt-1" id="kpiOnlineSub">در حال بارگذاری…</div>
    </div>
    <div class="mc-card p-4">
      <div class="flex items-center gap-2 text-xs text-mc-text-3 font-bold mb-1">
        <span aria-hidden="true" class="inline-flex"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-stats"/></svg></span>
        <span>بازدید امروز</span>
      </div>
      <div class="text-3xl font-extrabold text-mc-diamond" id="kpiToday"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-hourglass"/></svg></div>
      <div class="text-[10px] text-mc-text-3 mt-1" id="kpiTodaySub">از ساعت ۰۰:۰۰ (UTC)</div>
    </div>
    <div class="mc-card p-4 col-span-2 lg:col-span-1">
      <div class="flex items-center gap-2 text-xs text-mc-text-3 font-bold mb-1">
        <span aria-hidden="true" class="inline-flex"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-hashtag"/></svg></span>
        <span>بازدیدکننده‌ی کل (یکته)</span>
      </div>
      <div class="text-3xl font-extrabold text-mc-gold" id="kpiTotal"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-hourglass"/></svg></div>
      <div class="text-[10px] text-mc-text-3 mt-1" id="kpiTotalSub">از ابتدای راه‌اندازی KV</div>
    </div>
  </section>

  <!-- Charts row -->
  <section class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
    <div class="mc-panel p-5">
      <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
        <h2 class="text-lg font-extrabold flex items-center gap-2 font-pixel" style="font-size: 0.85rem;">
          <span aria-hidden="true" class="inline-flex"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-stats"/></svg></span> روند ۳۰ روزه
        </h2>
        <span class="text-xs text-mc-text-3 font-mono px-2 py-1 rounded bg-mc-grass-2/10 text-mc-grass-2 border border-mc-grass-2/20">۳۰ روز</span>
      </div>
      <div class="chart-canvas-wrap" style="height: 240px; position: relative;">
        <canvas id="chart30d"></canvas>
      </div>
      <p class="text-[10px] text-mc-text-3 mt-2" id="chart30Meta">—</p>
    </div>

    <div class="mc-panel p-5">
      <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
        <h2 class="text-lg font-extrabold flex items-center gap-2 font-pixel" style="font-size: 0.85rem;">
          <span aria-hidden="true" class="inline-flex"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-clock"/></svg></span> فعالیت ۲۴ ساعت
        </h2>
        <span class="text-xs text-mc-text-3 font-mono px-2 py-1 rounded bg-mc-diamond/10 text-mc-diamond border border-mc-diamond/20">محلی</span>
      </div>
      <div class="chart-canvas-wrap" style="height: 240px; position: relative;">
        <canvas id="chart24h"></canvas>
      </div>
      <p class="text-[10px] text-mc-text-3 mt-2" id="chart24Meta">—</p>
      <p class="text-[10px] text-mc-amber mt-1 inline-flex items-center gap-1"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-warning"/></svg> این فقط فعالیت همین مرورگره، نه کل سایت.</p>
    </div>
  </section>

  <!-- Top pages -->
  <section class="mc-panel p-5 mb-6">
    <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
      <h2 class="text-lg font-extrabold flex items-center gap-2 font-pixel" style="font-size: 0.85rem;">
        <span aria-hidden="true" class="inline-flex"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-document"/></svg></span> صفحات دیده‌شده توسط شما
      </h2>
      <span class="text-xs text-mc-text-3 font-mono px-2 py-1 rounded bg-mc-amber/10 text-mc-amber border border-mc-amber/20" id="topBadge">محلی</span>
    </div>
    <div id="topPagesList" class="space-y-2"></div>
    <p class="text-[10px] text-mc-amber mt-3 inline-flex items-start gap-1" id="topWarn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-top:2px;"><use href="#icon-warning"/></svg> <span>این فقط صفحات دیده‌شده توسط همین مرورگره (داده‌ی محلی) — نه کل سایت. برای آمار سایت‌گسترده، Worker v2 رو آپدیت کن (با /api/pages).</span></p>
  </section>

  <!-- Privacy -->
  <section class="mc-panel p-5 text-sm">
    <h2 class="text-base font-extrabold mb-2 flex items-center gap-2 font-pixel" style="font-size: 0.85rem;">
      <span aria-hidden="true" class="inline-flex"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-lock"/></svg></span> حریم خصوصی و نحوه‌ی کار
    </h2>
    <ul class="text-xs text-mc-text-2 space-y-1.5 list-disc pr-4">
      <li><b>آمار واقعی:</b> اعداد آنلاین/امروز/کل از <a href="https://minebed-api.www-habib6269.workers.dev/api/stats" target="_blank" rel="noopener" class="text-mc-grass-2 underline">Cloudflare Worker</a> می‌آیند — متمرکز برای همه‌ی بازدیدکنندگان.</li>
      <li><b>ضد تقلب:</b> هر مرورگر یک شناسه‌ی یکتا (UUID) دارد. سرور هر UUID را فقط یک بار در روز شمرده می‌شود.</li>
      <li><b>بدون سرور ماینکرفت:</b> این آمار بازدید وب‌سایت است.</li>
      <li><b>نمودار ۳۰ روزه:</b> هر بار که این صفحه را باز می‌کنید، عدد «امروز» از سرور نمونه‌برداری می‌شود.</li>
    </ul>
  </section>
</BaseLayout>

<style>
  .kpi-dot {
    width: 8px;
    height: 8px;
    background: #7cc84a;
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(124, 200, 74, 0.8);
    animation: kpiPulse 1.8s ease-in-out infinite;
  }
  @keyframes kpiPulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.4; }
  }

  .top-row {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 50px 100px;
    gap: 0.5rem;
    align-items: center;
    padding: 0.5rem 0.6rem;
    background: rgba(13, 13, 24, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
  }
  .top-rank { font-family: 'Press Start 2P', monospace; font-size: 0.65rem; color: #fcb32b; text-align: center; }
  .top-label { min-width: 0; font-size: 0.8rem; color: #e8e8f4; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; direction: ltr; text-align: left; }
  .top-count { font-family: monospace; font-size: 0.72rem; color: #4aedd9; text-align: center; }
  .top-bar-wrap { min-width: 0; display: flex; align-items: center; }
  .top-bar { height: 8px; border-radius: 4px; transition: width 0.3s; max-width: 100%; }
  @media (max-width: 600px) {
    .top-row { grid-template-columns: 28px 1fr 50px; }
    .top-row .top-bar-wrap { display: none; }
  }
</style>

<script>
  import Chart from 'chart.js/auto';
  import {
    getStats,
    getDailyHistory,
    getHourly24,
    fetchTopPages,
    getPageHits,
    trackVisit,
    heartbeat,
    fmtFa,
    shamsiLabel,
  } from '@/lib/analytics.js';

  let chart30 = null;
  let chart24 = null;

  const PAGE_NAMES = {
    '/': 'خانه',
    '/wiki/blocks': 'ویکی — بلاک‌ها',
    '/wiki/mobs': 'ویکی — ماب‌ها',
    '/mods': 'دانلود ماد‌ها',
    '/speedrun': 'سرعت‌رانی',
    '/tutorials': 'آموزش‌ها',
    '/seeds/create': 'ساخت سید',
    '/crafting': 'کرافت',
    '/blog': 'وبلاگ',
    '/stats': 'آمار سایت',
    '/wiki': 'ویکی',
    '/versions': 'نسخه‌ها',
    '/categories': 'دسته‌بندی‌ها',
  };

  const PAGE_COLORS = {
    '/': '#7cc84a',
    '/wiki/blocks': '#7e7e7e',
    '/wiki/mobs': '#3d7521',
    '/mods': '#a855f7',
    '/speedrun': '#fcb32b',
    '/tutorials': '#06b6d4',
    '/seeds/create': '#84cc16',
    '/crafting': '#ec4899',
    '/blog': '#8b5cf6',
  };

  function setup() {
    trackVisit();
    render();
    if (!window.__statsHB) {
      window.__statsHB = setInterval(render, 300_000); // 5 min — KV list() limit protection
    }
  }

  async function render() {
    const remote = await getStats();
    const history = getDailyHistory();
    const hourly = getHourly24();
    const topPages = await fetchTopPages();
    const localHits = getPageHits();

    paintKpis(remote, history);
    paintChart30(history);
    paintChart24(hourly);
    paintTopPages(topPages, localHits);
    paintSourceBadge(remote);
  }

  function paintSourceBadge(remote) {
    // Update the live badge with real online count + source
    const badge = document.getElementById('onlineBadgeText');
    if (badge) badge.textContent = fmtFa(remote.online || 0);
  }

  function paintKpis(remote, history) {
    const $ = (id) => document.getElementById(id);
    const online = $('kpiOnline');
    const today = $('kpiToday');
    const total = $('kpiTotal');
    if (online) online.textContent = fmtFa(remote.online || 0);
    if (today) today.textContent = fmtFa(remote.today || 0);
    if (total) total.textContent = fmtFa(remote.total || 0);

    const cachedNote = remote.isCached ? ' (ذخیره‌شده)' : '';
    if ($('kpiOnlineSub')) $('kpiOnlineSub').textContent = `از KV متمرکز — ۶۰s اخیر${cachedNote}`;
    if ($('kpiTodaySub')) $('kpiTodaySub').textContent = `بازدیدکننده‌ی یکتای امروز${cachedNote}`;
    if ($('kpiTotalSub')) $('kpiTotalSub').textContent = `همه‌ی بازدیدکننده‌ها${cachedNote}`;
  }

  // Minecraft green gradient for 30-day bars.
  function grassGradient(ctx) {
    const chart = ctx.chart;
    const { ctx: c, chartArea } = chart;
    if (!chartArea) return 'rgba(124, 200, 74, 0.6)';
    const g = c.createLinearGradient(0, chartArea.bottom, 0, chartArea.top);
    g.addColorStop(0, 'rgba(93, 168, 56, 0.35)');
    g.addColorStop(1, 'rgba(124, 200, 74, 0.9)');
    return g;
  }

  // Minecraft diamond-cyan gradient for 24h line area.
  function diamondGradient(ctx) {
    const chart = ctx.chart;
    const { ctx: c, chartArea } = chart;
    if (!chartArea) return 'rgba(74, 237, 217, 0.1)';
    const g = c.createLinearGradient(0, chartArea.bottom, 0, chartArea.top);
    g.addColorStop(0, 'rgba(74, 237, 217, 0.02)');
    g.addColorStop(1, 'rgba(74, 237, 217, 0.35)');
    return g;
  }

  function paintChart30(history) {
    const ctx = document.getElementById('chart30d');
    if (!ctx) return;
    // If no real samples yet, show honest empty-state message.
    if (history.length === 0) {
      if (chart30) { chart30.destroy(); chart30 = null; }
      const canvas = ctx;
      const c2d = canvas.getContext('2d');
      // The Chart.js canvas — we can't easily draw text on it, so just
      // show the meta line. The chart will render on next poll when
      // today's sample lands.
      return;
    }
    const labels = history.map(d => shamsiLabel(d.date));
    const data = history.map(d => d.today);
    const meta = document.getElementById('chart30Meta');
    if (meta) {
      const realCount = history.length;
      if (realCount === 0) {
        meta.textContent = `هنوز نمونه‌ای ثبت نشده — اولین نمونه همین الان ثبت می‌شه.`;
      } else if (realCount === 1) {
        meta.textContent = `۱ نمونه‌ی واقعی (امروز) — روز‌های بعد بیشتر می‌شه.`;
      } else {
        const max = Math.max(...data, 0);
        meta.textContent = `${fmtFa(realCount)} نمونه‌ی واقعی · اوج: ${fmtFa(max)}`;
      }
    }

    if (chart30) chart30.destroy();
    chart30 = new Chart(ctx, {
      type: 'bar',
      data: {
        labels,
        datasets: [{
          label: 'بازدید روزانه',
          data,
          backgroundColor: grassGradient,
          borderColor: '#7cc84a',
          borderWidth: 1,
          borderRadius: 2,
          maxBarThickness: 28,
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 800, easing: 'easeOutQuart' },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#0d0d18',
            titleColor: '#f0f0fa',
            bodyColor: '#9a9ab8',
            borderColor: '#2e2e4a',
            borderWidth: 1,
            padding: 10,
            cornerRadius: 0,
            rtl: true,
            titleFont: { family: 'Press Start 2P', size: 8 },
            bodyFont: { family: 'Rooyin', size: 11 },
            callbacks: { label: (ctx) => fmtFa(ctx.parsed.y) + ' بازدید' },
          },
        },
        scales: {
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(46, 46, 74, 0.5)' },
            ticks: { color: '#8585a3', font: { size: 10 } },
            border: { display: false },
          },
          x: {
            grid: { display: false },
            ticks: { color: '#8585a3', font: { size: 9 }, maxRotation: 0, autoSkip: true, maxTicksLimit: 6 },
            border: { display: false },
          },
        },
      },
    });
  }

  function paintChart24(hourly) {
    const ctx = document.getElementById('chart24h');
    if (!ctx) return;
    const labels = hourly.map(h => h.label);
    const data = hourly.map(h => h.count);
    const total = data.reduce((a, b) => a + b, 0);
    const meta = document.getElementById('chart24Meta');
    if (meta) meta.textContent = `مجموع فعالیت این مرورگر: ${fmtFa(total)} بازدید`;

    if (chart24) chart24.destroy();
    chart24 = new Chart(ctx, {
      type: 'line',
      data: {
        labels,
        datasets: [{
          label: 'بازدید',
          data,
          borderColor: '#4aedd9',
          borderWidth: 2.5,
          backgroundColor: diamondGradient,
          fill: true,
          tension: 0.4,
          pointRadius: 3,
          pointBackgroundColor: '#4aedd9',
          pointBorderColor: '#0d0d18',
          pointBorderWidth: 1.5,
          pointHoverRadius: 6,
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 800, easing: 'easeOutQuart' },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#0d0d18',
            titleColor: '#f0f0fa',
            bodyColor: '#9a9ab8',
            borderColor: '#2e2e4a',
            borderWidth: 1,
            padding: 10,
            cornerRadius: 0,
            rtl: true,
            titleFont: { family: 'Press Start 2P', size: 8 },
            bodyFont: { family: 'Rooyin', size: 11 },
            callbacks: { label: (ctx) => fmtFa(ctx.parsed.y) + ' بازدید' },
          },
        },
        scales: {
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(46, 46, 74, 0.5)' },
            ticks: { color: '#8585a3', font: { size: 10 }, precision: 0 },
            border: { display: false },
          },
          x: {
            grid: { display: false },
            ticks: { color: '#8585a3', font: { size: 10 } },
            border: { display: false },
          },
        },
      },
    });
  }

  function paintTopPages(topPages, localHits) {
    const wrap = document.getElementById('topPagesList');
    const meta = document.getElementById('topMeta');
    const badge = document.getElementById('topBadge');
    if (!wrap) return;

    // If we have real site-wide data from KV, show it.
    if (topPages && topPages.length > 0) {
      if (badge) {
        badge.textContent = 'سایت‌گسترده';
        badge.className = 'text-xs text-mc-text-3 font-mono px-2 py-1 rounded bg-mc-grass-2/10 text-mc-grass-2 border border-mc-grass-2/20';
      }
      const maxCount = topPages[0].count;
      wrap.innerHTML = topPages.map((p, i) => {
        const name = PAGE_NAMES[p.page] || p.page;
        const color = PAGE_COLORS[p.page] || '#7cc84a';
        const pct = (p.count / maxCount) * 100;
        return `<div class="top-row">
          <div class="top-rank">${fmtFa(i + 1)}</div>
          <div><div class="top-label">${name}</div></div>
          <div class="top-count">${fmtFa(p.count)}</div>
          <div class="top-bar-wrap"><div class="top-bar" style="width:${pct}%;background:linear-gradient(90deg,${color},#4aedd9);"></div></div>
        </div>`;
      }).join('');
      const totalVisitors = topPages.reduce((s, p) => s + p.count, 0);
      if (meta) meta.textContent = `${fmtFa(topPages.length)} صفحه · ${fmtFa(totalVisitors)} بازدیدکننده‌ی یکته`;
      // Hide the per-browser warning since we're showing real data now.
      const warn = document.getElementById('topWarn');
      if (warn) warn.style.display = 'none';
      return;
    }

    // Fallback: per-browser data (clearly labeled).
    if (badge) {
      badge.textContent = 'محلی';
      badge.className = 'text-xs text-mc-text-3 font-mono px-2 py-1 rounded bg-mc-amber/10 text-mc-amber border border-mc-amber/20';
    }
    const entries = Object.entries(localHits || {}).sort((a, b) => b[1] - a[1]);
    if (entries.length === 0) {
      wrap.innerHTML = '<p style="text-align:center;color:#8585a3;font-size:0.78rem;padding:1.5rem;">هنوز صفحه‌ای ثبت نشده — بعد از آپدیت Worker، صفحات سایت‌گسترده نمایش داده می‌شن.</p>';
      if (meta) meta.textContent = '—';
      return;
    }
    const maxHits = entries[0][1];
    wrap.innerHTML = entries.map(([path, count], i) => {
      const name = PAGE_NAMES[path] || path;
      const color = PAGE_COLORS[path] || '#7cc84a';
      const pct = (count / maxHits) * 100;
      return `<div class="top-row">
        <div class="top-rank">${fmtFa(i + 1)}</div>
        <div><div class="top-label">${name}</div></div>
        <div class="top-count">${fmtFa(count)}</div>
        <div class="top-bar-wrap"><div class="top-bar" style="width:${pct}%;background:linear-gradient(90deg,${color},#4aedd9);"></div></div>
      </div>`;
    }).join('');
    if (meta) meta.textContent = `${fmtFa(entries.length)} صفحه — محلی`;
  }

  document.getElementById('refreshBtn')?.addEventListener('click', () => {
    const btn = document.getElementById('refreshBtn');
    if (btn) { btn.disabled = true; btn.innerHTML = '<span aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-hourglass"/></svg></span> در حال بارگذاری…'; }
    heartbeat().then(() => setTimeout(() => {
      render();
      if (btn) { btn.disabled = false; btn.innerHTML = '<span aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-refresh"/></svg></span> به‌روزرسانی'; }
    }, 500));
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
</script>
