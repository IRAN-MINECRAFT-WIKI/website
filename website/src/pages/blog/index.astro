---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'وبلاگ', url: '/blog' },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  path="/blog"
  title="وبلاگ ماینکرفت — اخبار، نکات و راهنما"
  description="وبلاگ فارسی ماینکرفت بدراک: اخبار، نکات گیم‌پلی، راهنمای نسخه‌ها و آموزش‌های تخصصی. به‌روزرسانی هفتگی."
>
  <Breadcrumbs items={breadcrumb} />

  <div class="mb-6">
    <h1 class="text-2xl lg:text-3xl font-extrabold mb-2">وبلاگ</h1>
    <p class="text-sm text-mc-text-2">{posts.length} مقاله درباره‌ی ماینکرفت</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {posts.map((post) => (
      <a href={base(`/blog/${post.id}`)} class="mc-card group flex flex-col">
        <div class="aspect-video overflow-hidden bg-mc-panel-2">
          <img
            src={post.data.cover || `${BASE}images/placeholder-blog.svg`}
            alt={post.data.title}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            onerror={`this.src='${BASE}images/placeholder-blog.svg'`}
          />
        </div>
        <div class="p-5 flex-1 flex flex-col">
          <h2 class="text-lg font-extrabold text-mc-text group-hover:text-mc-grass-2 mb-2">{post.data.title}</h2>
          <p class="text-xs text-mc-text-2 mb-3 line-clamp-2 flex-1">{post.data.description}</p>
          <div class="flex items-center justify-between text-xs text-mc-text-3 pt-3 border-t border-mc-line">
            <span>📅 {post.data.pubDate.toLocaleDateString('fa-IR')}</span>
            <span>👤 {post.data.author}</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
