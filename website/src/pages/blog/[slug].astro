---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import BackButton from "@components/BackButton.astro";
import StructuredData from '@components/StructuredData.astro';
import { articleJsonLd, breadcrumbJsonLd } from '@/lib/seo';

const BASE = import.meta.env.BASE_URL;
const base = (p: string) => (p.startsWith('/') ? `${BASE}${p.slice(1)}` : `${BASE}${p}`);

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);
const coverUrl = (post.data.cover || '').startsWith('http')
  ? post.data.cover
  : base(post.data.cover || '');

const breadcrumb = [
  { name: 'خانه', url: '/' },
  { name: 'وبلاگ', url: '/blog' },
  { name: post.data.title, url: base(`/blog/${post.id}`) },
];

const ldArticle = articleJsonLd({
  title: post.data.title,
  description: post.data.description,
  image: coverUrl,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.modDate || post.data.pubDate).toISOString(),
  authorName: post.data.author,
  url: base(`/blog/${post.id}`),
});
const ldBread = breadcrumbJsonLd(breadcrumb);
---

<BaseLayout
  path={`/blog/${post.id}`}
  title={post.data.title}
  description={post.data.description}
  image={coverUrl}
  type="article"
>
  <Breadcrumbs items={breadcrumb} />
  <BackButton />
  <StructuredData data={ldArticle} />
  <StructuredData data={ldBread} />

  <article class="mc-panel p-5 lg:p-8">
    <header class="mb-6 pb-6 border-b border-mc-line">
      <h1 class="text-2xl lg:text-4xl font-extrabold mb-3 leading-tight">{post.data.title}</h1>
      <p class="text-sm text-mc-text-2 mb-3 leading-loose">{post.data.description}</p>
      <div class="flex flex-wrap items-center gap-3 text-xs text-mc-text-3">
        <span>📅 {post.data.pubDate.toLocaleDateString('fa-IR')}</span>
        <span>👤 {post.data.author}</span>
        <span>⏱️ {post.data.readingTime || 5} دقیقه مطالعه</span>
      </div>
      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-3">
          {post.data.tags.map((t) => <span class="mc-chip">#{t}</span>)}
        </div>
      )}
    </header>

    {post.data.cover && (
      <img src={coverUrl} alt={post.data.title} class="w-full aspect-video object-cover mb-6" />
    )}

    <div class="prose prose-invert max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
