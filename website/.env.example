# ============================================
# MineBed — Environment Variables (template)
# ============================================
# Copy this file to ``.env`` (or set the same keys as GitHub Secrets
# for CI). DO NOT COMMIT real secrets — they will be revoked.
#
# Two layers of variables:
#   1. Admin backend (FastAPI + crawler + AI + HuggingFace + GitHub)
#   2. Astro website build-time (PUBLIC_* vars — exposed to client HTML)
#      These are read at build time and inlined into the static HTML.

# ──────────────────────────────────────────────
# Admin auth (frontend sends this in Authorization: Bearer header)
# Two names are accepted: ADMIN_SECRET (preferred) or ADMIN_API_KEY (legacy)
# ──────────────────────────────────────────────
ADMIN_SECRET=change-me-to-a-long-random-string
ADMIN_API_KEY=change-me-to-a-long-random-string

# ──────────────────────────────────────────────
# Agnes AI (Persian content generation)
# ──────────────────────────────────────────────
AGNES_API_KEY=sk-your-agnes-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-3.0-flash

# ──────────────────────────────────────────────
# GitHub (repo: IRAN-MINECRAFT-WIKI/website)
# Create at: Settings → Developer Settings → Personal Access Tokens
# Required scope: ``repo`` (for contents API PUT)
# ──────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_pat_token_here
GITHUB_USER=IRAN-MINECRAFT-WIKI
GITHUB_REPO=website
GITHUB_BRANCH=main

# ──────────────────────────────────────────────
# HuggingFace (mod file hosting — mirrors MCPEDL CDN for Iran)
# Create at: https://huggingface.co/settings/tokens
# Required scope: ``write`` (for datasets)
# ──────────────────────────────────────────────
HF_TOKEN=hf_your_token_here
HF_REPO_ID=Habib91700/minebed-mods_

# ──────────────────────────────────────────────
# Astro data paths (relative to repo root)
# ──────────────────────────────────────────────
ASTRO_DATA_PATH=website/src/data
MODS_JSON_PATH=website/src/data/mods.json

# ──────────────────────────────────────────────
# Local admin server (desktop app)
# ──────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ──────────────────────────────────────────────
# Astro website build-time (PUBLIC_* vars — exposed to client)
# These are read by Astro at build time and inlined into HTML.
# Leave empty to disable the corresponding meta tag.
# ──────────────────────────────────────────────

# Google Search Console verification token
# Get at: https://search.google.com/search-console → Add property →
#   URL prefix → https://iran-minecraft-wiki.github.io/website/ →
#   HTML tag → copy the content="..." value here
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification
# Get at: https://www.bing.com/webmasters → Add site →
#   Meta tag → copy the content="..." value here
PUBLIC_BING_SITE_VERIFICATION=

# Yandex.Webmaster verification (helps with CIS / Iranian traffic)
# Get at: https://webmaster.yandex.com → Add site →
#   Meta tag → copy the content="..." value here
PUBLIC_YANDEX_VERIFICATION=
