# ============================================
# MineBed Astro — Environment Variables
# ============================================
# Copy this file to .env (or set as GitHub Secrets for Actions)
# DO NOT COMMIT real secrets — they will be revoked!

# HuggingFace dataset for hosting mod files
HF_TOKEN=hf_your_token_here
HF_REPO_ID=Habib91700/minebed-mods_

# GitHub (repo: IRAN-MINECRAFT-WIKI/website)
GITHUB_TOKEN=ghp_your_pat_token_here

# AI content generation (optional — defaults to local LM Studio)
LM_STUDIO_URL=http://localhost:1234/v1
MODEL_NAME=google/gemma-3-4b
