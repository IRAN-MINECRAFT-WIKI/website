# ============================================
# MineBed Astro — Environment Variables
# ============================================
# Copy this file to .env (or set as GitHub Secrets for Actions)
# DO NOT COMMIT real secrets — they will be revoked!

# HuggingFace dataset for hosting mod files
HF_TOKEN=hf_your_token_here
HF_REPO_ID=Habib91700/minebed-mods_

# GitHub (repo: IRAN-MINECRAFT-WIKI/website)
GITHUB_USER=IRAN-MINECRAFT-WIKI
GITHUB_REPO=website
GITHUB_BRANCH=main
GITHUB_TOKEN=ghp_your_pat_token_here

# AI content generation (optional — defaults to local LM Studio)
LM_STUDIO_URL=http://localhost:1234/v1
MODEL_NAME=google/gemma-3-4b

# Agnes API (for admin desktop app AI generation)
AGNES_API_KEY=your_agnes_api_key_here
AGNES_BASE_URL=https://api.agnes.ai/v1
AGNES_MODEL=agnes-1

# Admin authentication — shared secret to protect the admin API.
# If unset, admin runs in OPEN mode (no auth) — only safe for local dev.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change_me_to_a_long_random_string
